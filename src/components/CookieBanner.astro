---
---
<div id="cookie-banner" class="cookie-banner" role="dialog" aria-labelledby="cookie-title" aria-describedby="cookie-desc" hidden>
  <div class="cookie-card">
    <div class="cookie-icon" aria-hidden="true">🍪</div>
    <div class="cookie-body">
      <h3 id="cookie-title" class="cookie-title">We value your privacy</h3>
      <p id="cookie-desc" class="cookie-desc">
        We use cookies to improve your experience and analyze site traffic. You can accept or decline non-essential cookies.
      </p>
      <div class="cookie-actions">
        <button type="button" id="cookie-accept" class="cookie-btn cookie-btn-accept">Accept</button>
        <button type="button" id="cookie-decline" class="cookie-btn cookie-btn-decline">Decline</button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .cookie-banner {
    position: fixed;
    z-index: 9999;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transform: translateY(24px) scale(0.96);
    transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1), transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cookie-banner.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .cookie-banner.hiding {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    pointer-events: none;
  }
  .cookie-card {
    width: 100%;
    max-width: 420px;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem 1.35rem;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow:
      0 4px 6px rgba(15, 23, 42, 0.04),
      0 20px 48px rgba(15, 23, 42, 0.12),
      0 0 0 1px rgba(79, 70, 229, 0.06);
  }
  .cookie-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.12), rgba(124, 58, 237, 0.1));
    border: 1px solid rgba(79, 70, 229, 0.12);
  }
  .cookie-body { flex: 1; min-width: 0; }
  .cookie-title {
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #0F172A;
    margin: 0 0 0.35rem;
    line-height: 1.3;
  }
  .cookie-desc {
    font-size: 0.82rem;
    line-height: 1.55;
    color: #64748B;
    margin: 0 0 1rem;
  }
  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .cookie-btn {
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.55rem 1.15rem;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .cookie-btn:active { transform: scale(0.97); }
  .cookie-btn-accept {
    background: linear-gradient(135deg, #4F46E5, #7C3AED);
    color: #fff;
    box-shadow: 0 4px 16px rgba(79, 70, 229, 0.35);
  }
  .cookie-btn-accept:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(79, 70, 229, 0.45);
  }
  .cookie-btn-decline {
    background: rgba(15, 23, 42, 0.04);
    color: #475569;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  .cookie-btn-decline:hover {
    background: rgba(15, 23, 42, 0.07);
    color: #0F172A;
  }
  @media (min-width: 640px) {
    .cookie-banner {
      left: 1.5rem;
      right: auto;
      bottom: 1.5rem;
      justify-content: flex-start;
    }
    .cookie-card { max-width: 400px; }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'creavix_cookie_consent';
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;

    function getConsent() {
      try {
        var raw = localStorage.getItem(KEY);
        if (!raw) return null;
        return JSON.parse(raw);
      } catch (e) {
        return null;
      }
    }

    function setConsent(value) {
      try {
        localStorage.setItem(KEY, JSON.stringify({
          status: value,
          at: new Date().toISOString(),
          version: 1
        }));
      } catch (e) {}
    }

    function hideBanner() {
      banner.classList.remove('visible');
      banner.classList.add('hiding');
      setTimeout(function () {
        banner.hidden = true;
        banner.classList.remove('hiding');
      }, 400);
    }

    function showBanner() {
      banner.hidden = false;
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          banner.classList.add('visible');
        });
      });
    }

    var existing = getConsent();
    if (existing && (existing.status === 'accepted' || existing.status === 'declined')) {
      banner.hidden = true;
      return;
    }

    showBanner();

    var acceptBtn = document.getElementById('cookie-accept');
    var declineBtn = document.getElementById('cookie-decline');

    if (acceptBtn) {
      acceptBtn.addEventListener('click', function () {
        setConsent('accepted');
        hideBanner();
        document.dispatchEvent(new CustomEvent('cookie-consent', { detail: { status: 'accepted' } }));
      });
    }
    if (declineBtn) {
      declineBtn.addEventListener('click', function () {
        setConsent('declined');
        hideBanner();
        document.dispatchEvent(new CustomEvent('cookie-consent', { detail: { status: 'declined' } }));
      });
    }
  })();
</script>
