---
---
<div id="cookie-banner" class="cookie-bar" role="dialog" aria-live="polite" hidden>
  <div class="cookie-bar-inner">
    <p class="cookie-line">
      We use cookies to improve experience and analyze traffic.
      <span class="cookie-line-2">Accept or decline non-essential cookies anytime.</span>
    </p>
    <div class="cookie-btns">
      <button type="button" id="cookie-accept" class="c-btn c-accept">Accept</button>
      <button type="button" id="cookie-decline" class="c-btn c-decline">Decline</button>
    </div>
  </div>
</div>

<style>
  .cookie-bar {
    position: fixed;
    z-index: 9999;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.7rem 1rem;
    background: rgba(255, 255, 255, 0.96);
    border-top: 1px solid rgba(37, 99, 235, 0.12);
    box-shadow: 0 -8px 24px rgba(15, 23, 42, 0.06);
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .cookie-bar {
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
  }
  .cookie-bar.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .cookie-bar.hiding {
    opacity: 0;
    transform: translateY(100%);
    pointer-events: none;
  }
  .cookie-bar-inner {
    max-width: 1140px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem 1rem;
  }
  .cookie-line {
    margin: 0;
    flex: 1 1 220px;
    font-size: 0.8rem;
    line-height: 1.45;
    color: #334155;
  }
  .cookie-line-2 {
    color: #64748B;
  }
  .cookie-btns {
    display: flex;
    gap: 0.45rem;
    flex-shrink: 0;
  }
  .c-btn {
    font-family: Outfit, system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.42rem 1rem;
    border-radius: 999px;
    border: none;
    cursor: pointer;
  }
  .c-accept {
    background: linear-gradient(135deg, #2563EB, #1D4ED8);
    color: #fff;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
  }
  .c-accept:hover { background: #1D4ED8; }
  .c-decline {
    background: rgba(15, 23, 42, 0.05);
    color: #475569;
    border: 1px solid rgba(15, 23, 42, 0.1);
  }
  .c-decline:hover { background: rgba(15, 23, 42, 0.08); }
</style>

<script is:inline>
(function () {
  var KEY = 'creavix_cookie_consent';
  var banner = document.getElementById('cookie-banner');
  if (!banner) return;
  function getConsent() {
    try {
      var raw = localStorage.getItem(KEY);
      return raw ? JSON.parse(raw) : null;
    } catch (e) { return null; }
  }
  function setConsent(value) {
    try {
      localStorage.setItem(KEY, JSON.stringify({ status: value, at: new Date().toISOString(), version: 3 }));
    } catch (e) {}
  }
  function hideBanner() {
    banner.classList.remove('visible');
    banner.classList.add('hiding');
    setTimeout(function () {
      banner.hidden = true;
      banner.classList.remove('hiding');
    }, 320);
  }
  function showBanner() {
    banner.hidden = false;
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        banner.classList.add('visible');
      });
    });
  }
  var existing = getConsent();
  if (existing && (existing.status === 'accepted' || existing.status === 'declined')) {
    banner.hidden = true;
    return;
  }
  showBanner();
  var acceptBtn = document.getElementById('cookie-accept');
  var declineBtn = document.getElementById('cookie-decline');
  if (acceptBtn) acceptBtn.addEventListener('click', function () { setConsent('accepted'); hideBanner(); });
  if (declineBtn) declineBtn.addEventListener('click', function () { setConsent('declined'); hideBanner(); });
})();
</script>
