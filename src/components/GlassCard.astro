---
interface Props {
  variant?: 'default' | 'strong' | 'gold' | 'light';
  class?: string;
}

const { 
  variant = 'default', 
  class: className = ''
} = Astro.props;

const variantClass = {
  default: 'glass-card',
  strong: 'glass-card glass-strong',
  gold: 'glass-card glass-gold',
  light: 'glass-card glass-light'
}[variant];
---

<div class:list={[variantClass, className]}>
  <slot />
</div>
