---
/**
 * GlassCard — Reusable premium glassmorphism card
 * Usage:
 *   <GlassCard>
 *     <h3>Title</h3>
 *     <p>Content</p>
 *   </GlassCard>
 *
 * Props:
 *   - variant: "default" | "strong" | "gold" | "light"
 *   - class: extra Tailwind / custom classes
 *   - hover: boolean (default true)
 */
interface Props {
  variant?: 'default' | 'strong' | 'gold' | 'light';
  class?: string;
  hover?: boolean;
}

const { 
  variant = 'default', 
  class: className = '', 
  hover = true 
} = Astro.props;

const variantClass = {
  default: 'glass-card',
  strong: 'glass-card glass-strong',
  gold: 'glass-card glass-gold',
  light: 'glass-card glass-light'
}[variant];
---

<div class:list={[variantClass, hover && 'group', className]}>
  <slot />
</div>
