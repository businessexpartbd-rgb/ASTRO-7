---
/**
 * GlassCard — Premium glassmorphism component
 * Variants: default | strong | gold | light
 */
interface Props {
  variant?: 'default' | 'strong' | 'gold' | 'light';
  class?: string;
  hover?: boolean;
}

const { 
  variant = 'default', 
  class: className = '', 
  hover = true 
} = Astro.props;

const variantClass = {
  default: 'glass-card',
  strong: 'glass-card glass-strong',
  gold: 'glass-card glass-gold',
  light: 'glass-card glass-light'
}[variant];
---

<div class:list={[variantClass, className]}>
  <slot />
</div>
