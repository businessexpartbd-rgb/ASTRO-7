---
import { SITE } from '../data/site';

const models = [
  {
    label: 'Fast launch',
    title: 'Focused Sprint',
    copy: 'A defined deliverable with a clear timeline—ideal for a campaign video, landing page, audit or focused upgrade.',
    items: ['Fixed project scope', 'Milestone-based delivery', 'Human quality review'],
    tone: 'orange',
  },
  {
    label: 'Most flexible',
    title: 'Project Partnership',
    copy: 'A complete production or build for brands that need strategy, creative and technical execution from one team.',
    items: ['Discovery and solution plan', 'Dedicated production workflow', 'Launch and handover support'],
    tone: 'navy',
    featured: true,
  },
  {
    label: 'Continuous growth',
    title: 'Ongoing Support',
    copy: 'A recurring collaboration for content, optimization, campaigns, SEO or product improvements that evolve over time.',
    items: ['Monthly priority planning', 'Reporting and optimization', 'Scalable specialist support'],
    tone: 'green',
  },
];
---
<section id="pricing" class="engagement" aria-labelledby="engagement-title">
  <div class="container">
    <header class="engagement-head reveal">
      <div><p class="eyebrow">Ways to work with us</p><h2 id="engagement-title">Clear engagement.<br /><span>Built around your goal.</span></h2></div>
      <p>Every project is scoped before pricing. You receive a clear deliverable, timeline and commercial plan—without hidden packages or invented starting prices.</p>
    </header>
    <div class="engagement-grid">
      {models.map((model, index) => (
        <article class:list={['engagement-card', `tone-${model.tone}`, { featured: model.featured }]}>
          <div class="engagement-top"><span class="engagement-index">0{index + 1}</span><span class="engagement-label">{model.label}</span></div>
          <h3>{model.title}</h3><p>{model.copy}</p>
          <ul>{model.items.map((item) => <li><i aria-hidden="true">✓</i>{item}</li>)}</ul>
          <div class="engagement-price"><span>Investment</span><strong>Custom scope</strong></div>
          <a href="#project-brief" class="engagement-link">Request a proposal <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
    <div class="engagement-note"><span aria-hidden="true">●</span><p><strong>Need a quick answer?</strong> Share the service and outcome you need. Our team will recommend the right engagement model.</p><a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Ask on WhatsApp</a></div>
  </div>
</section>
<style>
  .engagement{padding:clamp(4.5rem,8vw,7rem) 1.25rem;background:radial-gradient(circle at 8% 0,#fff2e7,transparent 28%),linear-gradient(180deg,#fff,#f7f9fc)}
  .engagement-head{max-width:1120px;margin:0 auto 2rem;display:grid;grid-template-columns:1fr .72fr;gap:clamp(1.5rem,5vw,5rem);align-items:end}.engagement-head .eyebrow{margin:0 0 .75rem;color:#c44b0b!important}.engagement-head h2{margin:0;color:#0b0f19;font-size:clamp(2rem,4vw,3.6rem);line-height:1.1;letter-spacing:-.05em}.engagement-head h2 span{color:#c44b0b}.engagement-head>p{margin:0;color:#586a7f!important;line-height:1.75}
  .engagement-grid{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.engagement-card{--tone:#c44b0b;position:relative;min-width:0;padding:1.5rem;display:flex;flex-direction:column;border:1px solid #e1e7ed;border-radius:25px;background:#fff;box-shadow:0 14px 40px #0a25400d;overflow:hidden;transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}.engagement-card:before{content:'';position:absolute;inset:0 0 auto;height:4px;background:var(--tone)}.engagement-card.tone-navy{--tone:#0a2540}.engagement-card.tone-green{--tone:#137849}.engagement-card.featured{background:linear-gradient(150deg,#0a2540,#102f4d);border-color:#0a2540;box-shadow:0 24px 60px #0a254026}.engagement-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.3rem}.engagement-index{width:42px;height:42px;display:grid;place-items:center;border-radius:50%;background:color-mix(in srgb,var(--tone) 10%,white);color:var(--tone);font-size:.72rem;font-weight:800}.engagement-label{padding:.33rem .6rem;border-radius:999px;background:#f2f5f8;color:#56677b;font-size:.64rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em}.engagement-card h3{margin:0 0 .65rem;color:#0a2540;font-size:1.35rem}.engagement-card>p{margin:0 0 1.2rem;color:#607186!important;line-height:1.7;font-size:.86rem}.engagement-card ul{margin:0 0 1.4rem;padding:0;display:grid;gap:.65rem;list-style:none}.engagement-card li{display:flex;gap:.55rem;color:#34495e;font-size:.78rem;font-weight:650}.engagement-card li i{width:19px;height:19px;flex:0 0 19px;display:grid;place-items:center;border-radius:50%;background:#eaf7f0;color:#137849;font-size:.62rem;font-style:normal}.engagement-price{margin-top:auto;padding:1rem 0;border-top:1px solid #e8edf2}.engagement-price span,.engagement-price strong{display:block}.engagement-price span{color:#8090a1;font-size:.64rem;text-transform:uppercase;letter-spacing:.08em}.engagement-price strong{margin-top:.2rem;color:#0b0f19;font-size:1.05rem}.engagement-link{min-height:46px;padding:.72rem .9rem;display:flex;align-items:center;justify-content:space-between;border-radius:12px;background:#0a2540;color:#fff;font-size:.78rem;font-weight:800}.engagement-card.featured :is(h3,.engagement-price strong){color:#fff}.engagement-card.featured>p,.engagement-card.featured li{color:#c8d6e4!important}.engagement-card.featured .engagement-label{background:#ffffff17;color:#dfe9f3}.engagement-card.featured .engagement-index{background:#ffffff13;color:#fff}.engagement-card.featured .engagement-price{border-color:#ffffff1f}.engagement-card.featured .engagement-price span{color:#8fa8bf}.engagement-card.featured .engagement-link{background:#f47721}.engagement-note{max-width:1120px;margin:1rem auto 0;padding:1rem 1.2rem;display:flex;align-items:center;gap:.8rem;border:1px solid #e0e6ec;border-radius:18px;background:#fff}.engagement-note>span{color:#137849}.engagement-note p{margin:0;flex:1;color:#5c6f83!important;font-size:.8rem}.engagement-note p strong{color:#0a2540}.engagement-note a{color:#175cd3;font-size:.76rem;font-weight:800;white-space:nowrap}
  @media(hover:hover) and (prefers-reduced-motion:no-preference){.engagement-card:hover{transform:translateY(-6px);border-color:var(--tone);box-shadow:0 24px 55px color-mix(in srgb,var(--tone) 12%,transparent)}}
  @media(max-width:850px){.engagement-head{grid-template-columns:1fr}.engagement-grid{grid-template-columns:1fr 1fr}.engagement-card.featured{grid-row:1;grid-column:1/-1}.engagement-note{align-items:flex-start;flex-wrap:wrap}.engagement-note p{min-width:80%}}
  @media(max-width:580px){.engagement{padding:4rem .9rem}.engagement-grid{grid-template-columns:1fr}.engagement-card.featured{grid-column:auto}.engagement-card{border-radius:21px}.engagement-note a{width:100%;padding-left:1.25rem}}
  @media(prefers-reduced-motion:reduce){.engagement-card{transition:none!important}}
</style>
