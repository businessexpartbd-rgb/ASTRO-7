---
import { SITE } from '../data/site';
const wa = SITE.whatsappLink || 'https://wa.me/8801890484355';
const waDisplay = '01890-484355';
---
<div class="support-root" id="support-root">
  <div class="support-actions" aria-label="Quick contact and navigation">
    <button type="button" class="back-top" id="back-top" aria-label="Back to top" hidden>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
    </button>
    <a class="wa-fab" href={wa} target="_blank" rel="noopener noreferrer" aria-label="Open WhatsApp Business">
      <svg width="25" height="25" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 3.5A11 11 0 0 0 3.2 17.7L2 22l4.4-1.15A11 11 0 1 0 20.5 3.5zM12 19.5a7.5 7.5 0 0 1-3.82-1.04l-.27-.16-2.85.75.76-2.78-.18-.29A7.5 7.5 0 1 1 12 19.5z"></path></svg>
      <span class="wa-business-mark" aria-hidden="true">B</span>
    </a>
    <div class="support-launcher">
      <div class="support-invite" id="support-invite">
        <button type="button" id="support-invite-open" aria-controls="support-panel" aria-expanded="false"><strong>Help Center</strong><span>How can I help?</span></button>
        <button type="button" id="support-motion-toggle" aria-label="Pause helper animation" aria-pressed="false" title="Pause helper animation" hidden><span class="support-pause-icon" aria-hidden="true">Ⅱ</span><span class="support-play-icon" aria-hidden="true">▶</span></button>
      </div>
      <button type="button" class="support-fab" id="support-open" aria-label="Open Creavix Help Center — automated assistant" aria-controls="support-panel" aria-expanded="false">
        <span class="support-robot-look" id="support-robot-look"><span class="support-robot-float"><img src="/brands/help-robot.webp" alt="" width="64" height="64" loading="lazy" decoding="async" fetchpriority="low" draggable="false" /></span></span>
      </button>
    </div>
  </div>
  <div class="support-panel" id="support-panel" hidden aria-hidden="true" role="dialog" aria-labelledby="support-title">
    <div class="support-head">
      <div class="support-identity"><img src="/brands/help-robot.webp" alt="" width="42" height="42" loading="lazy" decoding="async" fetchpriority="low" /><div class="support-brand"><strong id="support-title">Creavix Help Center</strong><span class="support-status"><span id="support-status-text">Instant service guide</span></span></div></div>
      <button type="button" class="support-close" id="support-close" aria-label="Close Help Center">×</button>
    </div>
    <div class="support-body" id="support-body" aria-live="polite">
      <div class="support-msg bot">Hello! I can guide you to the right Creavix service, engagement model or delivery path. For a human response, use <a class="wa-inline" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp {waDisplay}</a>.</div>
    </div>
    <div class="support-typing" id="support-typing" hidden aria-live="polite"><span></span><span></span><span></span> Preparing a reply…</div>
    <div class="support-quick" id="support-quick" aria-label="Suggested questions">
      <div class="support-quick-track">
        <button type="button" data-q="What services do you offer?">Services</button><button type="button" data-q="Tell me about video editing">Video Editing</button><button type="button" data-q="Tell me about AI video marketing">AI Video</button><button type="button" data-q="Do you build websites?">Websites</button><button type="button" data-q="Do you build applications?">Apps</button><button type="button" data-q="Tell me about SEO">SEO</button><button type="button" data-q="Tell me about automation">Automation</button><button type="button" data-q="Tell me about digital marketing">Marketing</button><button type="button" data-q="Can you support Facebook Pages?">Facebook</button><button type="button" data-q="Tell me about boosting">Boosting</button><button type="button" data-q="Tell me about campaigns">Campaigns</button><button type="button" data-q="Do you create branding?">Branding</button><button type="button" data-q="Show me your portfolio">Portfolio</button><button type="button" data-q="How much does it cost?">Pricing</button><button type="button" data-q="How fast is delivery?">Delivery</button><button type="button" data-q="How can I contact you?">Contact</button>
      </div>
      <div class="support-quick-track" aria-hidden="true">
        <button type="button" data-q="What services do you offer?" tabindex="-1">Services</button><button type="button" data-q="Tell me about video editing" tabindex="-1">Video Editing</button><button type="button" data-q="Tell me about AI video marketing" tabindex="-1">AI Video</button><button type="button" data-q="Do you build websites?" tabindex="-1">Websites</button><button type="button" data-q="Do you build applications?" tabindex="-1">Apps</button><button type="button" data-q="Tell me about SEO" tabindex="-1">SEO</button><button type="button" data-q="Tell me about automation" tabindex="-1">Automation</button><button type="button" data-q="Tell me about digital marketing" tabindex="-1">Marketing</button><button type="button" data-q="Can you support Facebook Pages?" tabindex="-1">Facebook</button><button type="button" data-q="Tell me about boosting" tabindex="-1">Boosting</button><button type="button" data-q="Tell me about campaigns" tabindex="-1">Campaigns</button><button type="button" data-q="Do you create branding?" tabindex="-1">Branding</button><button type="button" data-q="Show me your portfolio" tabindex="-1">Portfolio</button><button type="button" data-q="How much does it cost?" tabindex="-1">Pricing</button><button type="button" data-q="How fast is delivery?" tabindex="-1">Delivery</button><button type="button" data-q="How can I contact you?" tabindex="-1">Contact</button>
      </div>
    </div>
    <form class="support-form" id="support-form"><input type="text" id="support-input" placeholder="Ask a question…" maxlength="200" autocomplete="off" aria-label="Your question" /><button type="submit" aria-label="Send">➤</button></form>
  </div>
</div>
<style>
  .support-root .support-actions{bottom:calc(1rem + env(safe-area-inset-bottom,0px));right:calc(1rem + env(safe-area-inset-right,0px))}
  .support-launcher{position:relative;width:64px;height:64px}
  .support-root .support-fab{width:64px;height:64px;border-radius:22px;background:#ebedfa;border:1px solid #ccd9f3;box-shadow:0 8px 28px #0a25401f;overflow:hidden;perspective:400px}
  .support-root .support-fab:hover{transform:none;box-shadow:0 8px 28px #175cd32a}
  .support-robot-look{display:block;transform:rotateY(var(--helper-y,0deg)) rotateX(var(--helper-x,0deg));transition:transform .35s ease;pointer-events:none}
  .support-robot-float{display:block;transform-origin:50% 65%}
  .support-robot-float img{display:block;width:64px;height:64px;object-fit:contain;user-select:none;-webkit-user-drag:none}
  .support-invite{position:absolute;right:74px;bottom:5px;display:flex;align-items:center;border:1px solid #dce5f1;background:#fff;box-shadow:0 5px 20px #0a254010;border-radius:15px;white-space:nowrap}
  .support-invite[hidden]{display:none}
  .support-invite button{border:0;background:transparent;cursor:pointer;color:#0a2540;font-family:var(--font-b,system-ui,sans-serif);min-height:44px}
  #support-invite-open{padding:8px 12px;text-align:left;border-radius:14px}
  #support-invite-open strong{display:block;font-size:12px;line-height:1.5;font-weight:800}
  #support-invite-open span{display:block;font-size:10px;line-height:1.5;color:#536478}
  #support-motion-toggle{width:44px;min-width:44px;border-left:1px solid #e5eaf2;border-radius:0 14px 14px 0;font-size:17px;color:#536478}
  #support-motion-toggle[hidden]{display:none}
  .support-play-icon{display:none;font-size:12px}
  #support-motion-toggle[aria-pressed="true"] .support-pause-icon{display:none}
  #support-motion-toggle[aria-pressed="true"] .support-play-icon{display:inline}
  .support-invite button:hover{background:#f1f6ff}
  .support-root button:focus-visible{outline:3px solid #175cd3;outline-offset:3px}
  .support-root .support-panel{bottom:calc(92px + env(safe-area-inset-bottom,0px));max-height:min(70dvh,520px)}
  .support-identity{display:flex;align-items:center;gap:10px;min-width:0}
  .support-identity>img{width:42px;height:42px;border-radius:14px;flex:none}
  .support-root .support-close{width:44px;height:44px;flex:none}
  .support-root .support-body{min-height:0;overscroll-behavior:contain}
  .support-root .support-form input{font-size:16px}
  .support-root .support-typing[hidden]{display:none}
  .support-root .support-quick-track,.support-root .support-typing span{animation-play-state:paused}
  .support-root.is-chat-visible:not(.helper-motion-paused) .support-quick-track,.support-root.is-chat-visible:not(.helper-motion-paused) .support-typing span{animation-play-state:running}
  .support-root .support-quick:hover .support-quick-track,.support-root .support-quick:focus-within .support-quick-track{animation-play-state:paused}
  @media(prefers-reduced-motion:no-preference){
    .support-robot-float{animation:helper-curious 7.5s ease-in-out infinite;animation-play-state:paused}
    .support-root.is-helper-running .support-robot-float{animation-play-state:running;will-change:transform}
    .support-root .support-fab:focus-visible .support-robot-float{animation-play-state:paused}
    @keyframes helper-curious{0%,100%{transform:translateY(0) rotate(0)}18%{transform:translateY(-2px) rotate(-5deg)}32%{transform:translateY(-1px) rotate(3deg)}46%{transform:translateY(0) rotate(0)}68%{transform:translateY(-2px) rotate(4deg)}80%{transform:translateY(1px) rotate(-2deg)}}
  }
  @media(prefers-reduced-motion:reduce){.support-robot-float{animation:none!important}.support-robot-look{transform:none;transition:none}.support-root .support-fab{transition:none}}
  @media(max-width:767px){
    .support-root .support-actions{right:calc(.72rem + env(safe-area-inset-right,0px));bottom:calc(.72rem + env(safe-area-inset-bottom,0px))}
    .support-launcher,.support-root .support-fab{width:60px;height:60px}.support-root .support-fab{border-radius:20px}.support-robot-float img{width:60px;height:60px}
    .support-invite{right:68px;bottom:7px}#support-invite-open{padding:7px 10px}#support-invite-open span{display:none}#support-invite-open strong{font-size:11px}
    .support-root .support-panel{bottom:calc(83px + env(safe-area-inset-bottom,0px));max-height:min(68dvh,500px)}
  }
</style>
<script is:inline>
(function () {
  var WA='https://wa.me/8801890484355',WA_LABEL='01890-484355';
  var openBtn=document.getElementById('support-open'),closeBtn=document.getElementById('support-close'),panel=document.getElementById('support-panel'),body=document.getElementById('support-body'),form=document.getElementById('support-form'),input=document.getElementById('support-input'),typing=document.getElementById('support-typing'),statusText=document.getElementById('support-status-text'),backTop=document.getElementById('back-top');
  var root=document.getElementById('support-root'),invite=document.getElementById('support-invite'),inviteBtn=document.getElementById('support-invite-open'),motionBtn=document.getElementById('support-motion-toggle'),look=document.getElementById('support-robot-look');
  var reduced=window.matchMedia('(prefers-reduced-motion: reduce)'),paused=false,frame=0,rx=0,ry=0,lastTrigger=openBtn,pending=0;
  try{paused=localStorage.getItem('creavix-helper-motion-paused')==='1';}catch(e){}
  function resetLook(){if(frame)cancelAnimationFrame(frame);frame=0;rx=ry=0;if(look){look.style.setProperty('--helper-x','0deg');look.style.setProperty('--helper-y','0deg');}}
  function syncMotion(){
    var active=!paused&&!reduced.matches&&!document.hidden;
    if(root){root.classList.toggle('is-helper-running',active&&panel.hidden);root.classList.toggle('is-chat-visible',!document.hidden&&!panel.hidden);root.classList.toggle('helper-motion-paused',paused||reduced.matches);}
    if(motionBtn){motionBtn.hidden=reduced.matches;motionBtn.setAttribute('aria-pressed',String(paused));motionBtn.setAttribute('aria-label',paused?'Play helper animation':'Pause helper animation');motionBtn.title=paused?'Play helper animation':'Pause helper animation';}
    if(!active||!panel.hidden)resetLook();
  }
  if(motionBtn)motionBtn.addEventListener('click',function(){paused=!paused;try{localStorage.setItem('creavix-helper-motion-paused',paused?'1':'0');}catch(e){}syncMotion();});
  reduced.addEventListener('change',syncMotion);document.addEventListener('visibilitychange',syncMotion);
  if(openBtn){
    openBtn.addEventListener('pointermove',function(e){
      if(e.pointerType==='touch'||!e.isPrimary||paused||reduced.matches||document.hidden||!panel.hidden)return;
      var rect=openBtn.getBoundingClientRect();if(!rect.width||!rect.height)return;
      ry=Math.max(-8,Math.min(8,((e.clientX-rect.left)/rect.width-.5)*16));rx=Math.max(-6,Math.min(6,(.5-(e.clientY-rect.top)/rect.height)*12));
      if(!frame)frame=requestAnimationFrame(function(){frame=0;look.style.setProperty('--helper-x',rx.toFixed(2)+'deg');look.style.setProperty('--helper-y',ry.toFixed(2)+'deg');});
    },{passive:true});
    ['pointerleave','pointercancel','blur'].forEach(function(type){openBtn.addEventListener(type,resetLook);});
  }
  function setPanel(willOpen,trigger){
    if(willOpen)lastTrigger=trigger||openBtn;
    panel.hidden=!willOpen;panel.setAttribute('aria-hidden',String(!willOpen));
    [openBtn,inviteBtn].forEach(function(btn){if(btn)btn.setAttribute('aria-expanded',String(willOpen));});
    if(invite)invite.hidden=willOpen;
    syncMotion();
    if(willOpen&&input)setTimeout(function(){if(!panel.hidden)input.focus();},80);
    else if(lastTrigger)lastTrigger.focus();
  }
  syncMotion();
  function waHtml(){return '<a class="wa-inline" href="'+WA+'" target="_blank" rel="noopener noreferrer">WhatsApp '+WA_LABEL+'</a>';}
  var replies=[
    {keys:['service','offer','what do you','সেবা'],text:'We provide professional video editing, AI video marketing, web and app development, SEO, automation and digital campaigns. Continue on '},
    {keys:['contact','phone','email','whatsapp','number','যোগাযোগ'],text:'Connect directly with our team on '},
    {keys:['price','cost','budget','মূল্য','খরচ'],text:'Pricing is tailored to your scope, quality and delivery requirements. Request a precise quote on '},
    {keys:['deliver','fast','time','সময়','ডেলিভারি'],text:'Short-form video delivery often starts from 24–48 hours. Project timelines are confirmed before work begins on '},
    {keys:['web','website','ওয়েবসাইট'],text:'Yes — we build premium, responsive and SEO-ready websites, applications and landing pages. Start on '},
    {keys:['app','application'],text:'We build fast, scalable applications and business dashboards. Discuss your idea on '},
    {keys:['video','ai','edit','gallery','ভিডিও'],text:'We create human-like AI videos and professional edits for brands, products and campaigns. Send your brief on '},
    {keys:['seo','search engine'],text:'We improve technical SEO, on-page structure, content signals and search visibility for sustainable organic growth. Discuss your site on '},
    {keys:['automation','chatbot','messenger'],text:'We build Messenger, Instagram, WhatsApp and website automation flows with clear human handoff. Plan yours on '},
    {keys:['marketing','campaign','boost'],text:'We plan digital campaigns, creative strategy, paid promotion and conversion-focused growth. Start on '},
    {keys:['facebook','page'],text:'We support Facebook Page setup, management, content, verification guidance and campaign readiness. Ask on '},
    {keys:['brand','branding','logo'],text:'We create brand identity, logo systems, campaign visuals and consistent digital presentation. Share your idea on '},
    {keys:['portfolio','work','project'],text:'Explore our selected client work and request a similar production through '},
    {keys:['hello','hi','hey','হ্যালো'],text:'Hello! Tell us what you want to create, or contact the Creavix team on '}
  ];
  function addMsg(text,who,html){if(!body)return;var div=document.createElement('div');div.className='support-msg '+who;if(html)div.innerHTML=text;else div.textContent=text;body.appendChild(div);body.scrollTop=body.scrollHeight;}
  function answer(q){var lower=(q||'').toLowerCase();for(var i=0;i<replies.length;i++){for(var k=0;k<replies[i].keys.length;k++){if(lower.indexOf(replies[i].keys[k])!==-1)return replies[i].text+waHtml();}}return 'Thanks for your question. For an accurate human response, continue on '+waHtml()+'.';}
  function respond(q){if(!q)return;pending++;addMsg(q,'user',false);if(typing)typing.hidden=false;if(statusText)statusText.textContent='Preparing a reply…';var delay=1000+(q.length*37%1001);setTimeout(function(){pending--;if(typing)typing.hidden=pending===0;if(statusText&&pending===0)statusText.textContent='Instant service guide';addMsg(answer(q),'bot',true);},delay);}
  [openBtn,inviteBtn].forEach(function(btn){if(btn&&panel)btn.addEventListener('click',function(){setPanel(panel.hidden,btn);});});
  if(closeBtn&&panel)closeBtn.addEventListener('click',function(){setPanel(false);});
  document.addEventListener('keydown',function(e){if(!panel||panel.hidden)return;if(e.key==='Escape'){e.preventDefault();setPanel(false);return;}if(e.key==='Tab'){var focusable=Array.prototype.slice.call(panel.querySelectorAll('button:not([disabled]),a[href],input:not([disabled])'));if(!focusable.length)return;var first=focusable[0],last=focusable[focusable.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}}});
  if(form&&input)form.addEventListener('submit',function(e){e.preventDefault();var q=(input.value||'').trim();if(!q)return;input.value='';respond(q);});
  document.querySelectorAll('#support-quick [data-q]').forEach(function(button){button.addEventListener('click',function(){respond(button.getAttribute('data-q')||'');});});
  if((document.documentElement.lang||'').toLowerCase().indexOf('bn')===0){var names=['সেবা','ভিডিও','এআই ভিডিও','ওয়েবসাইট','অ্যাপ','এসইও','অটোমেশন','মার্কেটিং','ফেসবুক','বুস্টিং','ক্যাম্পেইন','ব্র্যান্ডিং','পোর্টফোলিও','মূল্য','সময়','যোগাযোগ'];document.querySelectorAll('.support-quick-track').forEach(function(track){track.querySelectorAll('[data-q]').forEach(function(button,i){if(names[i])button.textContent=names[i];});});if(input)input.placeholder='প্রশ্ন লিখুন…';}
  if(backTop){window.addEventListener('scroll',function(){backTop.hidden=window.scrollY<=400;},{passive:true});backTop.addEventListener('click',function(){window.scrollTo({top:0,behavior:reduced.matches?'auto':'smooth'});});}
})();
</script>
