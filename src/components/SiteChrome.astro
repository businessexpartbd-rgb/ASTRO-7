---
import { SITE } from '../data/site';
const wa = SITE.whatsappLink || 'https://wa.me/8801890484355';
const waDisplay = '01890-484355';
---
<button type="button" class="back-top" id="back-top" aria-label="Back to top" hidden>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
</button>

<a class="wa-fab" href={wa} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Creavix">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 3.5A11 11 0 0 0 3.2 17.7L2 22l4.4-1.15A11 11 0 1 0 20.5 3.5zM12 19.5a7.5 7.5 0 0 1-3.82-1.04l-.27-.16-2.85.75.76-2.78-.18-.29A7.5 7.5 0 1 1 12 19.5z"></path></svg>
</a>

<div class="support-root" id="support-root">
  <button type="button" class="support-fab" id="support-open" aria-label="Open live support">
    <span class="support-live-dot" aria-hidden="true"></span>
    <span class="support-fab-text">Support</span>
  </button>

  <div class="support-panel" id="support-panel" hidden aria-hidden="true">
    <div class="support-head">
      <div class="support-brand">
        <strong>Creavix Support</strong>
        <span class="support-status"><span class="support-live-dot"></span> 24/7 Live</span>
      </div>
      <button type="button" class="support-close" id="support-close" aria-label="Close">×</button>
    </div>
    <div class="support-body" id="support-body">
      <div class="support-msg bot">
        Hello! Welcome to <b>Creavix iT Solution</b> support. Ask about services, pricing or delivery — or message us on
        <a class="wa-inline" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp {waDisplay}</a>.
      </div>
      <div class="support-quick" id="support-quick">
        <button type="button" data-q="What services do you offer?">Services</button>
        <button type="button" data-q="How can I contact you?">Contact</button>
        <button type="button" data-q="How fast is delivery?">Delivery</button>
        <button type="button" data-q="Do you build websites?">Websites</button>
      </div>
    </div>
    <div class="support-typing" id="support-typing" hidden>Creavix is typing…</div>
    <form class="support-form" id="support-form">
      <input type="text" id="support-input" placeholder="Ask a question…" maxlength="200" autocomplete="off" />
      <button type="submit" aria-label="Send">➤</button>
    </form>
  </div>
</div>

<script is:inline>
(function () {
  var WA = 'https://wa.me/8801890484355';
  var WA_LABEL = '01890-484355';
  var openBtn = document.getElementById('support-open');
  var closeBtn = document.getElementById('support-close');
  var panel = document.getElementById('support-panel');
  var body = document.getElementById('support-body');
  var form = document.getElementById('support-form');
  var input = document.getElementById('support-input');
  var typing = document.getElementById('support-typing');
  var backTop = document.getElementById('back-top');

  function waHtml() {
    return '<a class="wa-inline" href="' + WA + '" target="_blank" rel="noopener noreferrer">WhatsApp ' + WA_LABEL + '</a>';
  }

  var replies = [
    { keys: ['service', 'offer', 'what do you'], text: 'Creavix offers Web Development, Apps, Authentication, AI Video Marketing, Video Editing, Facebook Page, Boosting and Campaigns. Chat on ' },
    { keys: ['contact', 'phone', 'email', 'whatsapp', 'number'], text: 'Tap to message us now: ' },
    { keys: ['price', 'cost', 'budget'], text: 'Pricing depends on scope. Get a quote on ' },
    { keys: ['deliver', 'fast', 'time'], text: 'Short videos often 24–48h. Websites follow an agreed timeline. Ask details on ' },
    { keys: ['web', 'website'], text: 'Yes — SEO-ready websites and landing pages. Start on ' },
    { keys: ['app', 'application'], text: 'We build custom apps and dashboards. Talk on ' },
    { keys: ['video', 'ai', 'edit', 'gallery'], text: 'AI video & editing live in our Video Gallery. Order via ' },
    { keys: ['hello', 'hi', 'hey'], text: 'Hello! How can Creavix help? Message ' },
  ];

  function addMsg(text, who, html) {
    if (!body) return;
    var div = document.createElement('div');
    div.className = 'support-msg ' + who;
    if (html) div.innerHTML = text;
    else div.textContent = text;
    body.appendChild(div);
    body.scrollTop = body.scrollHeight;
  }

  function answer(q) {
    var lower = (q || '').toLowerCase();
    for (var i = 0; i < replies.length; i++) {
      for (var k = 0; k < replies[i].keys.length; k++) {
        if (lower.indexOf(replies[i].keys[k]) !== -1) {
          return replies[i].text + waHtml();
        }
      }
    }
    return 'Thanks! For a fast reply, open ' + waHtml() + ' — our team is available.';
  }

  function respond(q) {
    if (!q) return;
    addMsg(q, 'user', false);
    if (typing) typing.hidden = false;
    setTimeout(function () {
      if (typing) typing.hidden = true;
      addMsg(answer(q), 'bot', true);
    }, 650 + Math.min(1000, q.length * 15));
  }

  if (openBtn && panel) openBtn.addEventListener('click', function () {
    panel.hidden = false;
    panel.setAttribute('aria-hidden', 'false');
  });
  if (closeBtn && panel) closeBtn.addEventListener('click', function () {
    panel.hidden = true;
    panel.setAttribute('aria-hidden', 'true');
  });
  if (form && input) form.addEventListener('submit', function (e) {
    e.preventDefault();
    var q = (input.value || '').trim();
    if (!q) return;
    input.value = '';
    respond(q);
  });
  document.querySelectorAll('#support-quick [data-q]').forEach(function (b) {
    b.addEventListener('click', function () { respond(b.getAttribute('data-q') || ''); });
  });
  if (backTop) {
    window.addEventListener('scroll', function () {
      backTop.hidden = window.scrollY <= 400;
    }, { passive: true });
    backTop.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
})();
</script>
