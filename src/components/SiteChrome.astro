  .support-root .support-typing span{width:6px;height:6px;border-radius:50%;background:#2563eb;animation-duration:1s!important}
  .support-root .support-quick{display:block;overflow-x:auto;overscroll-behavior-inline:contain;scroll-snap-type:x mandatory;scrollbar-width:none;padding:10px 12px;background:linear-gradient(90deg,#fff7ed,#eff6ff 55%,#f0fdf4);touch-action:pan-x}
