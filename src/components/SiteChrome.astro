    {keys:['marketing','campaign','ads','digital marketing','মার্কেটিং','ক্যাম্পেইন','বিজ্ঞাপন'],en:'We plan creative strategy, paid campaigns and conversion-focused digital marketing for Meta, YouTube and other relevant channels.',bn:'আমরা Meta, YouTube ও প্রয়োজনীয় অন্যান্য চ্যানেলের জন্য creative strategy, paid campaign এবং conversion-focused digital marketing করি।'},
    {keys:['facebook','meta','page','ফেসবুক','পেজ'],en:'We support Facebook Page setup, optimization, content structure, campaign readiness and verification guidance.',bn:'আমরা Facebook Page setup, optimization, content structure, campaign readiness ও verification guidance দিই।'},
    {keys:['boost','boosting','বুস্ট','বুস্টিং'],en:'Yes. We manage targeted Meta boosting and ad campaigns based on your goal, audience and budget.',bn:'হ্যাঁ। আপনার লক্ষ্য, audience ও budget অনুযায়ী targeted Meta boosting এবং ad campaign পরিচালনা করি।'},
    {keys:['brand','branding','logo','ব্র্যান্ড','লোগো'],en:'We create logos, brand identity systems, campaign visuals and consistent digital presentation.',bn:'আমরা logo, brand identity system, campaign visual এবং consistent digital presentation তৈরি করি।'},
    {keys:['auth','authentication','login','security','অথেন্টিকেশন','লগইন','নিরাপত্তা'],en:'We build secure login, role-based access and authentication flows for websites and applications.',bn:'ওয়েবসাইট ও অ্যাপের জন্য secure login, role-based access এবং authentication flow তৈরি করি।'},
    {keys:['portfolio','work','sample','project','পোর্টফোলিও','কাজ','নমুনা'],en:'You can view selected work on our Portfolio page. Tell us your industry and we’ll guide you to the closest examples.',bn:'আমাদের Portfolio পেজে নির্বাচিত কাজ দেখতে পারবেন। আপনার industry বললে কাছাকাছি উদাহরণ দেখাতে পারব।'},
    {keys:['price','pricing','cost','budget','quote','মূল্য','খরচ','বাজেট','কোটেশন'],en:'Pricing depends on scope, quality and delivery time. Share your goal and references for an accurate quote.',bn:'মূল্য কাজের পরিধি, মান ও delivery time-এর ওপর নির্ভর করে। সঠিক quotation-এর জন্য আপনার লক্ষ্য ও reference জানান।'},
    {keys:['delivery','time','fast','deadline','ডেলিভারি','সময়','ডেডলাইন'],en:'Short-form video delivery often starts from 24–48 hours. Larger projects receive a confirmed timeline before work begins.',bn:'Short-form ভিডিও সাধারণত ২৪–৪৮ ঘণ্টা থেকে delivery শুরু হয়। বড় প্রজেক্টের timeline কাজ শুরুর আগে নিশ্চিত করা হয়।'},
    {keys:['contact','phone','email','whatsapp','number','যোগাযোগ','ফোন','ইমেইল','হোয়াটসঅ্যাপ'],en:'You can contact our team on WhatsApp '+WA_LABEL+' for the fastest response.',bn:'দ্রুত যোগাযোগের জন্য WhatsApp '+WA_LABEL+' নম্বরে আমাদের টিমকে মেসেজ করুন।'},
    {keys:['location','address','office','studio','ঠিকানা','অফিস','স্টুডিও'],en:'Our studio is in Hemayetpur, Savar, Dhaka, Bangladesh. We also work with clients remotely.',bn:'আমাদের স্টুডিও হেমায়েতপুর, সাভার, ঢাকা, বাংলাদেশে। আমরা remote client-এর সঙ্গেও কাজ করি।'},
    {keys:['creavix','company','about','কোম্পানি','ক্রিয়াভিক্স'],en:'Creavix IT Solution is a Bangladesh-based video marketing and IT agency serving local and global clients.',bn:'Creavix IT Solution একটি বাংলাদেশভিত্তিক video marketing ও IT agency, যা দেশি ও আন্তর্জাতিক client-এর সঙ্গে কাজ করে।'}
  ];

  function isBn(q){return bnPage||bnChars.test(q||'');}
  function resetLook(){if(frame)cancelAnimationFrame(frame);frame=0;rx=ry=0;if(look){look.style.setProperty('--helper-x','0deg');look.style.setProperty('--helper-y','0deg');}}
  function stopSlider(){if(slideTimer)clearInterval(slideTimer);slideTimer=0;}
  function startSlider(){
    stopSlider();
    if(!quick||panel.hidden||document.hidden||reduced.matches||quickButtons.length<2)return;
    slideTimer=window.setInterval(function(){
      slideIndex=(slideIndex+1)%quickButtons.length;
      var button=quickButtons[slideIndex];
      quick.scrollTo({left:Math.max(0,button.offsetLeft-10),behavior:'smooth'});
    },1000);
  }
  function pauseSlider(){
    stopSlider();
    if(slideResumeTimer)clearTimeout(slideResumeTimer);
    slideResumeTimer=window.setTimeout(startSlider,3500);
  }
  if(quick){
    ['pointerdown','touchstart','mouseenter','focusin'].forEach(function(type){quick.addEventListener(type,pauseSlider,{passive:type!=='focusin'});});
    ['mouseleave','focusout'].forEach(function(type){quick.addEventListener(type,function(){if(slideResumeTimer)clearTimeout(slideResumeTimer);slideResumeTimer=window.setTimeout(startSlider,1800);});});
  }
  function syncMotion(){
    var active=!reduced.matches&&!document.hidden;
    if(root){root.classList.toggle('is-helper-running',active&&panel.hidden);root.classList.toggle('is-chat-visible',active&&!panel.hidden);root.classList.toggle('helper-motion-paused',reduced.matches);}
    if(!active||!panel.hidden)resetLook();
    if(active&&!panel.hidden)startSlider();else stopSlider();
  }
  reduced.addEventListener('change',syncMotion);document.addEventListener('visibilitychange',syncMotion);
  if(openBtn){
    openBtn.addEventListener('pointermove',function(e){
      if(e.pointerType==='touch'||!e.isPrimary||reduced.matches||document.hidden||!panel.hidden)return;
      var rect=openBtn.getBoundingClientRect();if(!rect.width||!rect.height)return;
      ry=Math.max(-8,Math.min(8,((e.clientX-rect.left)/rect.width-.5)*16));rx=Math.max(-6,Math.min(6,(.5-(e.clientY-rect.top)/rect.height)*12));
      if(!frame)frame=requestAnimationFrame(function(){frame=0;look.style.setProperty('--helper-x',rx.toFixed(2)+'deg');look.style.setProperty('--helper-y',ry.toFixed(2)+'deg');});
    },{passive:true});
    ['pointerleave','pointercancel','blur'].forEach(function(type){openBtn.addEventListener(type,resetLook);});
  }
  function applyLanguage(){
    bnPage=(document.documentElement.lang||'').toLowerCase().indexOf('bn')===0||bnChars.test(document.body.innerText.slice(0,900));
    var greeting=document.querySelector('[data-support-greeting]');
    if(greeting)greeting.textContent=bnPage?'আসসালামু আলাইকুম 👋 Creavix IT Solution-এর পক্ষ থেকে স্বাগতম। আমরা কীভাবে আপনাকে সাহায্য করতে পারি?':'Assalamu Alaikum 👋 Welcome to Creavix IT Solution. How can we help you today?';
    if(input)input.placeholder=bnPage?'আপনার প্রশ্ন লিখুন…':'Ask a question…';
    var namesBn=['সেবা','ভিডিও এডিটিং','AI ভিডিও','ওয়েবসাইট','অ্যাপ','SEO','অটোমেশন','মার্কেটিং','ফেসবুক','বুস্টিং','ক্যাম্পেইন','ব্র্যান্ডিং','পোর্টফোলিও','মূল্য','ডেলিভারি','যোগাযোগ'];
    var namesEn=['Services','Video Editing','AI Video','Websites','Apps','SEO','Automation','Marketing','Facebook','Boosting','Campaigns','Branding','Portfolio','Pricing','Delivery','Contact'];
    quickButtons.forEach(function(button,i){button.textContent=(bnPage?namesBn:namesEn)[i]||button.textContent;});
  }
  function setPanel(willOpen,trigger){
    if(willOpen)lastTrigger=trigger||openBtn;
    panel.hidden=!willOpen;panel.setAttribute('aria-hidden',String(!willOpen));
    [openBtn,inviteBtn].forEach(function(btn){if(btn)btn.setAttribute('aria-expanded',String(willOpen));});
    if(invite)invite.hidden=willOpen;
    if(willOpen)applyLanguage();
    syncMotion();
    if(willOpen&&input)setTimeout(function(){if(!panel.hidden)input.focus();},80);
    else if(lastTrigger)lastTrigger.focus();
  }
  function waHtml(){return '<a class="wa-inline" href="'+WA+'" target="_blank" rel="noopener noreferrer">WhatsApp '+WA_LABEL+'</a>';}
  function pageAnswer(q,bn){
    var tokens=(q.toLowerCase().match(/[a-z0-9\u0980-\u09ff]+/g)||[]).filter(function(t){return t.length>2&&stopWords.indexOf(t)===-1;});
    if(!tokens.length)return '';
    var candidates=Array.prototype.slice.call(document.querySelectorAll('main h1,main h2,main h3,main p,main li')).filter(function(el){return !el.closest('#support-root');}).map(function(el){return (el.textContent||'').replace(/\s+/g,' ').trim();}).filter(function(t){return t.length>=35&&t.length<=260;});
    var best='',score=0;
    candidates.forEach(function(text){var low=text.toLowerCase(),next=0;tokens.forEach(function(token){if(low.indexOf(token)!==-1)next++;});if(next>score){score=next;best=text;}});
    if(score<2||!best)return '';
    return (bn?'এই পেজের তথ্য অনুযায়ী: ':'From this page: ')+best;
  }
  function answer(q){
    var lower=(q||'').toLowerCase(),bn=isBn(q);
    var best=null,bestScore=0;
    knowledge.forEach(function(item){var score=0;item.keys.forEach(function(key){if(lower.indexOf(key)!==-1)score+=key.indexOf(' ')>-1?3:1;});if(score>bestScore){bestScore=score;best=item;}});
    if(best&&bestScore>0)return best[bn?'bn':'en'];
    var contextual=pageAnswer(q,bn);if(contextual)return contextual;
    return bn?'ধন্যবাদ 🙂 সঠিক উত্তর দিতে আপনার প্রয়োজনটি আরেকটু বিস্তারিত লিখুন। চাইলে আমাদের টিমের সঙ্গে '+waHtml()+'-এ কথা বলতে পারেন।':'Thanks 🙂 Please share a little more detail so we can answer accurately. You can also talk with our team on '+waHtml()+'.';
  }
  function addMsg(text,who,html){if(!body)return;var div=document.createElement('div');div.className='support-msg '+who;if(html)div.innerHTML=text;else div.textContent=text;body.appendChild(div);body.scrollTop=body.scrollHeight;}
  function respond(q){
    if(!q)return;var replyBn=isBn(q);pending++;addMsg(q,'user',false);
    if(typing)typing.hidden=false;if(statusText)statusText.textContent=replyBn?'টাইপিং…':'Typing…';
    window.setTimeout(function(){pending--;if(typing)typing.hidden=pending===0;if(statusText&&pending===0)statusText.textContent=replyBn?'২৪/৭ সাপোর্ট · লাইভ':'24/7 Support · Live';var reply=answer(q);addMsg(reply,'bot',reply.indexOf('<a ')!==-1);},1000);
  }
  [openBtn,inviteBtn].forEach(function(btn){if(btn&&panel)btn.addEventListener('click',function(){setPanel(panel.hidden,btn);});});
  if(closeBtn&&panel)closeBtn.addEventListener('click',function(){setPanel(false);});
  document.addEventListener('keydown',function(e){if(!panel||panel.hidden)return;if(e.key==='Escape'){e.preventDefault();setPanel(false);return;}if(e.key==='Tab'){var focusable=Array.prototype.slice.call(panel.querySelectorAll('button:not([disabled]),a[href],input:not([disabled])'));if(!focusable.length)return;var first=focusable[0],last=focusable[focusable.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}}});
  if(form&&input)form.addEventListener('submit',function(e){e.preventDefault();var q=(input.value||'').trim();if(!q)return;input.value='';respond(q);});
  quickButtons.forEach(function(button){button.addEventListener('click',function(){respond(button.getAttribute('data-q')||'');pauseSlider();});});
  if(backTop){window.addEventListener('scroll',function(){backTop.hidden=window.scrollY<=400;},{passive:true});backTop.addEventListener('click',function(){window.scrollTo({top:0,behavior:reduced.matches?'auto':'smooth'});});}
  applyLanguage();syncMotion();
})();
</script>
