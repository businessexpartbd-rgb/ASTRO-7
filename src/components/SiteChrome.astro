  .support-root .support-msg{max-width:88%;border-radius:17px;font-size:14px;line-height:1.58;box-shadow:0 7px 18px rgba(15,23,42,.06)}
  .support-root .support-msg.bot{border:1px solid rgba(37,99,235,.1);border-bottom-left-radius:6px;background:linear-gradient(135deg,#fff,#eff6ff);color:#1e293b}
