  .support-root .support-fab::before{content:'';position:absolute;z-index:0;inset:0;background:linear-gradient(135deg,rgba(249,115,22,.2),rgba(37,99,235,.16) 48%,rgba(34,197,94,.18));opacity:.72;pointer-events:none}
  .support-root .support-fab::after{content:'';position:absolute;z-index:1;inset:4px;border-radius:18px;background:radial-gradient(circle at 50% 28%,#fff 0%,#eaf2ff 47%,#dbeafe 100%);box-shadow:inset 0 1px 0 #fff,0 0 16px rgba(37,99,235,.28)}
  .support-root .support-fab:hover{transform:translateY(-2px);box-shadow:0 16px 34px rgba(37,99,235,.3),0 0 0 1px rgba(255,255,255,.8)}
  .support-robot-look{position:relative;z-index:2;display:block;transform:rotateY(var(--helper-y,0deg)) rotateX(var(--helper-x,0deg));transition:transform .35s ease;transform-style:preserve-3d;pointer-events:none}
  .support-robot-float{display:block;transform-origin:50% 55%;transform-style:preserve-3d;backface-visibility:visible}
  .support-robot-float img{display:block;width:64px;height:64px;object-fit:contain;user-select:none;-webkit-user-drag:none}
  .support-invite{position:absolute;right:74px;bottom:5px;display:flex;align-items:center;border:1px solid transparent;background:linear-gradient(#fff,#fff) padding-box,linear-gradient(110deg,#f97316,#2563eb 55%,#22c55e) border-box;box-shadow:0 9px 28px rgba(15,23,42,.11),0 0 24px rgba(37,99,235,.08);border-radius:15px;white-space:nowrap}
  .support-invite[hidden]{display:none}
  .support-invite button{border:0;background:transparent;cursor:pointer;color:#0a2540;font-family:var(--font-b,system-ui,sans-serif);min-height:44px}
  #support-invite-open{position:relative;display:flex;align-items:center;gap:8px;padding:8px 13px;text-align:left;border-radius:14px}
  #support-invite-open strong{display:block;color:#0a2540;font-size:12px;line-height:1.45;font-weight:800}
  .support-live-light{width:9px;height:9px;flex:0 0 9px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.13),0 0 14px rgba(34,197,94,.65);animation:ask-light-pulse 1.8s ease-in-out infinite alternate}
  .support-invite button:hover{background:#f1f6ff}
  .support-root button:focus-visible{outline:3px solid #175cd3;outline-offset:3px}
  .support-root .support-panel{bottom:calc(92px + env(safe-area-inset-bottom,0px));max-height:min(70dvh,520px)}
  .support-root .support-head{background:linear-gradient(110deg,#f8fbff 0%,#eef5ff 55%,#fff7ed 100%);border-bottom-color:rgba(37,99,235,.13)}
  .support-identity{display:flex;align-items:center;gap:10px;min-width:0}
  .support-identity>img{width:42px;height:42px;padding:2px;border:1px solid rgba(37,99,235,.14);border-radius:14px;background:#fff;box-shadow:0 6px 15px rgba(37,99,235,.12);flex:none}
  .support-brand strong{font-family:'Li Ador Noirrit'!important;letter-spacing:-.015em}
  .support-status::before{background:#22c55e!important;box-shadow:0 0 0 4px rgba(34,197,94,.13),0 0 12px rgba(34,197,94,.35)!important}
  .support-root .support-close{width:44px;height:44px;flex:none}
  .support-root .support-body{min-height:0;overscroll-behavior:contain}
  .support-root .support-form input{font-size:16px}
  .support-root .support-typing[hidden]{display:none}
  .support-root .support-quick-track,.support-root .support-typing span{animation-play-state:paused}
  .support-root.is-chat-visible:not(.helper-motion-paused) .support-quick-track,.support-root.is-chat-visible:not(.helper-motion-paused) .support-typing span{animation-play-state:running}
  .support-root .support-quick:hover .support-quick-track,.support-root .support-quick:focus-within .support-quick-track{animation-play-state:paused}
  @media(prefers-reduced-motion:no-preference){
    .support-robot-float{animation:assistant-slide-swivel 3s cubic-bezier(.45,0,.2,1) infinite;animation-play-state:paused}
    .support-root.is-helper-running .support-robot-float{animation-play-state:running;will-change:transform}
    .support-root .support-fab:focus-visible .support-robot-float{animation-play-state:paused}
    @keyframes assistant-slide-swivel{0%,52%,100%{transform:translate3d(0,0,0) rotateY(0deg) scale(1)}66%{transform:translate3d(-5px,-2px,0) rotateY(-20deg) scale(1.04)}80%{transform:translate3d(5px,-1px,0) rotateY(20deg) scale(1.04)}92%{transform:translate3d(0,0,0) rotateY(0deg) scale(1)}}
  }
  @keyframes ask-light-pulse{to{opacity:.55;box-shadow:0 0 0 6px rgba(34,197,94,.08),0 0 20px rgba(34,197,94,.8)}}
  @keyframes assistant-breathe{to{opacity:.55;transform:scale(1.16)}}
  @media(prefers-reduced-motion:reduce){.support-robot-float{animation:none!important}.support-robot-look{transform:none;transition:none}.support-root .support-fab{transition:none}}
  @media(max-width:767px){
    .support-root .support-actions{right:calc(.72rem + env(safe-area-inset-right,0px));bottom:calc(.72rem + env(safe-area-inset-bottom,0px))}
