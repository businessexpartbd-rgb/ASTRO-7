---
const brands = [
  { name: 'Datara', image: '/media/branding/datara.webp', accent: '#f5a900', label: 'Data intelligence identity' },
  { name: 'Addiba', image: '/media/branding/addiba.webp', accent: '#118eea', label: 'Digital product ecosystem' },
  { name: 'PrimeTalent', image: '/media/branding/primetalent.webp', accent: '#168ee6', label: 'People-first visual system' },
  { name: 'Pirate', image: '/media/branding/pirate.webp', accent: '#0cb4be', label: 'Lifestyle brand application' },
  { name: 'Aurora', image: '/media/branding/aurora.webp', accent: '#16b98b', label: 'Complete identity direction' },
  { name: 'Valor City', image: '/media/branding/valor-city.webp', accent: '#167dc7', label: 'Multi-product brand world' },
];
---

<section class="brand-cinema" aria-labelledby="brand-cinema-title" data-brand-cinema>
  <div class="brand-glow brand-glow-a"></div><div class="brand-glow brand-glow-b"></div>
  <div class="container brand-cinema-grid">
    <div class="brand-copy reveal">
      <p class="brand-kicker"><span></span>Brand identity in motion</p>
      <h2 id="brand-cinema-title">One Brand.<br /><em>Every Touchpoint.</em></h2>
      <p class="brand-lead">We turn a visual identity into a complete, memorable brand world—digital products, packaging, apparel and every customer-facing detail.</p>
      <div class="brand-proof" aria-label="Branding capabilities">
        <span>Identity systems</span><span>Product mockups</span><span>Digital presence</span>
      </div>
      <div class="brand-status" aria-live="polite"><i></i><div><small>Now presenting</small><strong data-brand-name>Four-brand overview</strong></div></div>
    </div>

    <div class="brand-stage reveal" role="region" aria-label="Animated branding portfolio">
      <div class="stage-toolbar"><span class="stage-dots"><i></i><i></i><i></i></span><b>CREAVIX · BRAND STUDIO</b><small data-brand-count>01 / 08</small></div>
      <div class="stage-viewport">
        <div class="brand-mosaic is-active" data-brand-mosaic>
          {brands.slice(0, 4).map((brand, index) => (
            <figure style={`--mosaic-index:${index};--accent:${brand.accent}`}><img src={brand.image} alt={`${brand.name} brand identity preview`} width="900" height="1350" loading="lazy" decoding="async" fetchpriority="low" /><figcaption>{brand.name}</figcaption></figure>
          ))}
          <div class="mosaic-title"><span>Selected identities</span><strong>Four brands. Four visual worlds.</strong></div>
        </div>

        <figure class="brand-focus" data-brand-focus>
          <div class="focus-frame"><img data-brand-image src={brands[0].image} alt="Datara complete brand identity" width="900" height="1350" loading="lazy" decoding="async" fetchpriority="low" /></div>
          <figcaption><span data-brand-label>{brands[0].label}</span><strong data-brand-caption>{brands[0].name}</strong></figcaption>
        </figure>

        <div class="brand-finale" data-brand-finale>
          {brands.map((brand) => <img src={brand.image} alt="" width="900" height="1350" loading="lazy" decoding="async" fetchpriority="low" />)}
          <div><small>Complete brand universe</small><strong>Built to be remembered.</strong></div>
        </div>
        <div class="stage-scan"></div>
      </div>
      <div class="stage-progress"><i data-brand-progress></i></div>
      <div class="stage-footer"><span>Strategy</span><span>Identity</span><span>Applications</span><span>Launch</span></div>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-brand-cinema]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const items = [
      ['/media/branding/datara.webp','Datara','Data intelligence identity','#f5a900'],
      ['/media/branding/addiba.webp','Addiba','Digital product ecosystem','#118eea'],
      ['/media/branding/primetalent.webp','PrimeTalent','People-first visual system','#168ee6'],
      ['/media/branding/pirate.webp','Pirate','Lifestyle brand application','#0cb4be'],
      ['/media/branding/aurora.webp','Aurora','Complete identity direction','#16b98b'],
      ['/media/branding/valor-city.webp','Valor City','Multi-product brand world','#167dc7']
    ];
    const mosaic = root.querySelector('[data-brand-mosaic]');
    const focus = root.querySelector('[data-brand-focus]');
    const finale = root.querySelector('[data-brand-finale]');
    const image = root.querySelector('[data-brand-image]');
    const caption = root.querySelector('[data-brand-caption]');
    const label = root.querySelector('[data-brand-label]');
    const name = root.querySelector('[data-brand-name]');
    const count = root.querySelector('[data-brand-count]');
    const progress = root.querySelector('[data-brand-progress]');
    if (!mosaic || !focus || !finale || !image || !caption || !label || !name || !count || !progress) return;
    let step = 0, timer;
    const total = items.length + 2;
    const render = () => {
      mosaic.classList.toggle('is-active', step === 0);
      focus.classList.toggle('is-active', step > 0 && step <= items.length);
      finale.classList.toggle('is-active', step === total - 1);
      if (step > 0 && step <= items.length) {
        const item = items[step - 1];
        focus.classList.remove('angle-left','angle-right');
        focus.classList.add(step % 2 ? 'angle-left' : 'angle-right');
        image.src = item[0]; image.alt = `${item[1]} complete brand identity`;
        caption.textContent = item[1]; label.textContent = item[2]; name.textContent = item[1];
        root.style.setProperty('--active-accent', item[3]);
      } else if (step === 0) name.textContent = 'Four-brand overview';
      else name.textContent = 'Complete brand universe';
      count.textContent = `${String(step + 1).padStart(2,'0')} / ${String(total).padStart(2,'0')}`;
      progress.style.transform = `scaleX(${(step + 1) / total})`;
    };
    const advance = () => { step = (step + 1) % total; render(); };
    const start = () => { clearInterval(timer); timer = setInterval(advance, 3600); };
    const stop = () => clearInterval(timer);
    render();
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(([entry]) => entry.isIntersecting ? start() : stop(), { threshold: .15 });
      observer.observe(root);
      document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
    }
  })();
</script>

<style>
  .brand-cinema{--active-accent:#2563eb;position:relative;isolation:isolate;overflow:hidden;padding:clamp(4.5rem,9vw,8rem) 1.25rem;background:linear-gradient(135deg,#eef1f5 0%,#f8fbff 46%,#e9f1ff 100%);border-block:1px solid rgba(15,23,42,.07)}
  .brand-glow{position:absolute;z-index:-1;width:38rem;height:38rem;border-radius:50%;filter:blur(2px);opacity:.42}.brand-glow-a{left:-20rem;top:-18rem;background:radial-gradient(circle,#93c5fd,transparent 68%)}.brand-glow-b{right:-18rem;bottom:-22rem;background:radial-gradient(circle,#c4b5fd,transparent 68%)}
  .brand-cinema-grid{display:grid;gap:clamp(2rem,6vw,5rem);align-items:center}.brand-copy{max-width:600px}.brand-kicker{display:flex;align-items:center;gap:.55rem;margin:0 0 1rem;color:#2563eb;font-size:.72rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.brand-kicker span{width:28px;height:2px;background:linear-gradient(90deg,#2563eb,#8b5cf6)}.brand-copy h2{margin:0;color:#0b0f19;font-size:clamp(2.5rem,6vw,5.7rem);line-height:.92;letter-spacing:-.065em}.brand-copy h2 em{color:#2563eb;font-style:normal}.brand-lead{max-width:540px;margin:1.35rem 0 0;color:#526075;font-size:clamp(.95rem,1.5vw,1.12rem);line-height:1.75}.brand-proof{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1.35rem}.brand-proof span{padding:.46rem .72rem;border:1px solid rgba(37,99,235,.13);border-radius:999px;background:rgba(255,255,255,.7);color:#334155;font-size:.7rem;font-weight:750}.brand-status{display:flex;align-items:center;gap:.7rem;margin-top:1.5rem}.brand-status>i{width:10px;height:10px;border-radius:50%;background:var(--active-accent);box-shadow:0 0 0 6px color-mix(in srgb,var(--active-accent) 14%,transparent);transition:background .5s}.brand-status div{display:grid}.brand-status small{color:#8793a6;font-size:.62rem;text-transform:uppercase;letter-spacing:.09em}.brand-status strong{font-size:.86rem;color:#162033}
  .brand-stage{min-width:0;overflow:hidden;border:1px solid rgba(15,23,42,.12);border-radius:clamp(22px,4vw,34px);background:rgba(255,255,255,.84);box-shadow:0 38px 100px rgba(15,23,42,.16),inset 0 1px 0 #fff;backdrop-filter:blur(12px)}.stage-toolbar{height:52px;display:flex;align-items:center;justify-content:space-between;padding:0 1rem;border-bottom:1px solid rgba(15,23,42,.08);color:#64748b}.stage-toolbar b{font-size:.62rem;letter-spacing:.16em}.stage-toolbar small{font-size:.62rem;font-weight:800}.stage-dots{display:flex;gap:6px}.stage-dots i{width:8px;height:8px;border-radius:50%;background:#f87171}.stage-dots i:nth-child(2){background:#fbbf24}.stage-dots i:nth-child(3){background:#22c55e}
  .stage-viewport{position:relative;aspect-ratio:1/1;overflow:hidden;background:radial-gradient(circle at 50% 35%,#f8fbff,#dfe8f5)}.stage-viewport:before{content:'';position:absolute;inset:0;z-index:8;pointer-events:none;background:linear-gradient(115deg,transparent 15%,rgba(255,255,255,.36) 42%,transparent 60%);transform:translateX(-130%);animation:stageLight 7s ease-in-out infinite}.brand-mosaic,.brand-focus,.brand-finale{position:absolute;inset:0;opacity:0;visibility:hidden;transform:scale(.94);transition:opacity .72s ease,transform 1.1s cubic-bezier(.16,1,.3,1),visibility .72s}.brand-mosaic.is-active,.brand-focus.is-active,.brand-finale.is-active{opacity:1;visibility:visible;transform:scale(1)}
  .brand-mosaic{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;padding:clamp(12px,2vw,20px)}.brand-mosaic figure{position:relative;min-width:0;margin:0;overflow:hidden;border-radius:16px;background:#fff;box-shadow:0 10px 22px rgba(15,23,42,.11);transform:translateY(calc((var(--mosaic-index) % 2) * 8px))}.brand-mosaic img{width:100%;height:100%;object-fit:cover;object-position:50% 24%;transition:transform 4s ease}.brand-mosaic.is-active figure:nth-child(odd) img{transform:scale(1.08) translateY(-2%)}.brand-mosaic figure:after{content:'';position:absolute;inset:auto 0 0;height:44%;background:linear-gradient(transparent,rgba(5,12,27,.72))}.brand-mosaic figcaption{position:absolute;z-index:2;left:12px;bottom:10px;color:#fff;font-size:.7rem;font-weight:800}.mosaic-title{position:absolute;z-index:5;left:50%;top:50%;display:grid;width:max-content;max-width:75%;padding:.75rem 1rem;border:1px solid rgba(255,255,255,.65);border-radius:15px;background:rgba(7,16,35,.76);color:#fff;text-align:center;transform:translate(-50%,-50%);backdrop-filter:blur(12px);box-shadow:0 18px 36px rgba(0,0,0,.22)}.mosaic-title span{font-size:.55rem;letter-spacing:.13em;text-transform:uppercase}.mosaic-title strong{font-size:clamp(.75rem,2vw,1rem)}
  .brand-focus{margin:0;perspective:1200px}.focus-frame{position:absolute;inset:5% 8% 15%;overflow:hidden;border-radius:22px;background:#fff;box-shadow:0 28px 55px rgba(15,23,42,.23);transition:transform 1.1s cubic-bezier(.16,1,.3,1)}.brand-focus.angle-left .focus-frame{transform:rotateY(3deg) rotateZ(-.7deg) scale(1.02)}.brand-focus.angle-right .focus-frame{transform:rotateY(-3deg) rotateZ(.7deg) scale(1.02)}.brand-focus img{width:100%;height:100%;object-fit:cover;object-position:50% 20%;animation:cinemaDrift 3.6s ease-out both}.brand-focus figcaption{position:absolute;z-index:3;left:11%;right:11%;bottom:5%;display:flex;align-items:end;justify-content:space-between;gap:1rem;padding:.8rem 1rem;border-radius:15px;background:rgba(8,18,38,.9);color:#fff;box-shadow:0 14px 30px rgba(15,23,42,.22);backdrop-filter:blur(10px)}.brand-focus figcaption span{font-size:.58rem;color:#bfdbfe;letter-spacing:.07em;text-transform:uppercase}.brand-focus figcaption strong{font-size:clamp(.85rem,2vw,1.1rem)}
  .brand-finale{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:12px}.brand-finale img{width:100%;height:100%;min-height:0;object-fit:cover;border-radius:11px;box-shadow:0 8px 18px rgba(15,23,42,.12)}.brand-finale div{position:absolute;z-index:4;left:50%;top:50%;display:grid;width:max-content;max-width:78%;padding:.85rem 1.2rem;border-radius:16px;background:rgba(7,16,35,.88);color:#fff;text-align:center;transform:translate(-50%,-50%);box-shadow:0 20px 45px rgba(0,0,0,.28);backdrop-filter:blur(12px)}.brand-finale small{color:#93c5fd;font-size:.55rem;letter-spacing:.13em;text-transform:uppercase}.brand-finale strong{font-size:clamp(.9rem,2.2vw,1.2rem)}
  .stage-scan{position:absolute;z-index:10;left:0;right:0;top:0;height:1px;background:linear-gradient(90deg,transparent,#60a5fa,transparent);opacity:.7;animation:stageScan 4.2s linear infinite}.stage-progress{height:4px;background:#e8edf5}.stage-progress i{display:block;width:100%;height:100%;background:linear-gradient(90deg,#2563eb,#8b5cf6,#ec4899);transform-origin:left;transition:transform .65s ease}.stage-footer{display:grid;grid-template-columns:repeat(4,1fr);padding:.8rem 1rem;gap:.3rem;color:#64748b;font-size:.55rem;font-weight:750;text-align:center;text-transform:uppercase;letter-spacing:.07em}
  @keyframes cinemaDrift{from{transform:scale(1.08) translate3d(1.5%,1%,0);filter:saturate(.92)}to{transform:scale(1.01) translate3d(-1%,-1.5%,0);filter:saturate(1.05)}}@keyframes stageLight{0%,45%{transform:translateX(-130%)}70%,100%{transform:translateX(130%)}}@keyframes stageScan{from{transform:translateY(0)}to{transform:translateY(100cqw)}}
  @media(min-width:900px){.brand-cinema-grid{grid-template-columns:.82fr 1.18fr}.brand-stage{transform:perspective(1300px) rotateY(-2deg);transition:transform .7s}.brand-stage:hover{transform:perspective(1300px) rotateY(0)}}
  @media(max-width:639px){.brand-cinema{padding-inline:.85rem}.brand-cinema-grid{gap:1.65rem}.brand-copy h2{font-size:clamp(2.45rem,13vw,3.65rem)}.brand-lead{font-size:.91rem}.brand-proof{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.3rem}.brand-proof span{min-width:0;padding:.4rem .2rem;text-align:center;font-size:.58rem;white-space:nowrap}.brand-stage{border-radius:22px}.stage-toolbar{height:44px;padding:0 .75rem}.stage-toolbar b{font-size:.52rem}.stage-viewport{aspect-ratio:4/5}.focus-frame{inset:4% 5% 14%}.brand-focus figcaption{left:7%;right:7%;bottom:4%;padding:.65rem .75rem}.brand-mosaic{padding:9px;gap:6px}.brand-mosaic figure{border-radius:11px}.stage-footer{padding:.7rem .35rem;font-size:.47rem}}
  @media(prefers-reduced-motion:reduce){.stage-viewport:before,.stage-scan,.brand-focus img{animation:none}.brand-mosaic,.brand-focus,.brand-finale,.focus-frame,.stage-progress i{transition:none}}
</style>
