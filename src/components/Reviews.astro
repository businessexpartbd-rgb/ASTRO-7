---
/** Lightweight, database-backed guest reviews for Cloudflare Workers + D1. */
---
<section id="reviews" class="reviews-section" aria-labelledby="reviews-title">
  <div class="container">
    <header class="reviews-heading reveal">
      <p class="eyebrow">Client Reviews</p>
      <h2 id="reviews-title">Real Experiences. Real Results.</h2>
      <p>Share your experience without login or email. It takes less than a minute.</p>
    </header>

    <div class="rating-overview glass-card reveal">
      <div class="rating-score">
        <strong id="avg-score">4.8</strong>
        <span id="avg-stars" class="gold-stars" aria-label="Average rating">★★★★★</span>
        <small id="rating-count">5 ratings</small>
      </div>
      <div id="rating-bars" class="rating-bars" aria-label="Rating distribution"></div>
    </div>

    <div id="reviews-list" class="reviews-grid" aria-live="polite"></div>
    <button id="btn-see-more" class="see-all" type="button" hidden>
      See all reviews <span aria-hidden="true">→</span>
    </button>

    <div class="review-form-card glass-card reveal">
      <div class="form-copy">
        <span class="form-icon" aria-hidden="true">★</span>
        <div>
          <h3>Write a review</h3>
          <p>No login or email required.</p>
        </div>
      </div>
      <form id="review-form" novalidate>
        <fieldset class="star-field">
          <legend>Your rating</legend>
          <div id="star-picker" class="star-picker" role="radiogroup" aria-label="Choose a rating from 1 to 5">
            <button type="button" class="star-btn" data-star="1" role="radio" aria-checked="false" aria-label="1 star">★</button>
            <button type="button" class="star-btn" data-star="2" role="radio" aria-checked="false" aria-label="2 stars">★</button>
            <button type="button" class="star-btn" data-star="3" role="radio" aria-checked="false" aria-label="3 stars">★</button>
            <button type="button" class="star-btn" data-star="4" role="radio" aria-checked="false" aria-label="4 stars">★</button>
            <button type="button" class="star-btn" data-star="5" role="radio" aria-checked="false" aria-label="5 stars">★</button>
          </div>
          <span id="star-label" class="star-label">Tap a star to rate</span>
        </fieldset>

        <div class="form-grid">
          <label>
            <span>Your name</span>
            <input id="review-name" type="text" minlength="2" maxlength="60" autocomplete="name" placeholder="আপনার নাম" required />
          </label>
          <label>
            <span>Service</span>
            <select id="review-service">
              <option>Video Marketing</option>
              <option>AI Video</option>
              <option>Web Development</option>
              <option>SEO</option>
              <option>Digital Marketing</option>
              <option>App Development</option>
              <option>Other Service</option>
            </select>
          </label>
        </div>
        <label>
          <span>Your experience</span>
          <textarea id="review-text" minlength="3" maxlength="600" rows="4" placeholder="Write in Bangla or English…" required></textarea>
        </label>
        <input id="review-company" name="company" class="hp-field" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div id="turnstile-wrap" class="turnstile-wrap" hidden><div id="turnstile-widget"></div></div>
        <div class="submit-row">
          <button id="btn-submit-review" class="btn btn-primary" type="submit">Post review</button>
          <small>By posting, you confirm this is your genuine experience.</small>
        </div>
        <p id="form-msg" class="form-msg" role="status" hidden></p>
      </form>
    </div>
  </div>

  <div id="reviews-modal" class="reviews-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-hidden="true">
    <button id="modal-backdrop" class="modal-backdrop" type="button" aria-label="Close all reviews"></button>
    <section class="modal-panel">
      <header class="modal-head">
        <div><p class="modal-kicker">Creavix clients</p><h3 id="modal-title">All reviews</h3></div>
        <button id="modal-close" class="modal-close" type="button" aria-label="Close">×</button>
      </header>
      <div id="modal-body" class="modal-body"></div>
    </section>
  </div>
</section>

<style>
  .reviews-section{padding:5rem 1.25rem;background:radial-gradient(circle at 8% 8%,rgba(37,99,235,.08),transparent 30%),linear-gradient(180deg,#f8fbff,#fff)}
  .reviews-heading{text-align:center;max-width:700px;margin:0 auto 2rem}
  .reviews-heading .eyebrow{margin:0 auto 1rem}.reviews-heading h2{margin-bottom:.75rem}.reviews-heading>p:last-child{color:var(--text-2,#475569)}
  .rating-overview{max-width:780px;margin:0 auto 2rem;padding:1.35rem 1.5rem!important;display:grid;grid-template-columns:180px 1fr;align-items:center;gap:1.75rem}
  .rating-score{text-align:center;border-right:1px solid rgba(15,23,42,.1);display:flex;flex-direction:column;align-items:center}
  .rating-score strong{font:800 3.4rem/1 Outfit,system-ui;color:#0b0f19;letter-spacing:-.05em}
  .gold-stars{color:#fbbc04;font-size:1.18rem;letter-spacing:2px;margin:.45rem 0 .25rem;text-shadow:0 1px 1px rgba(146,97,0,.12)}
  .rating-score small{color:#64748b}.rating-bars{display:grid;gap:.45rem}
  .bar-row{display:grid;grid-template-columns:26px 1fr 34px;align-items:center;gap:.6rem;color:#64748b;font-size:.78rem}
  .bar-label{color:#334155;font-weight:700}.bar-track{height:8px;background:#e9eef5;border-radius:99px;overflow:hidden}
  .bar-fill{height:100%;width:0;background:linear-gradient(90deg,#fbbc04,#f9ab00);border-radius:inherit;transition:width .55s ease}
  .reviews-grid{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  .review-item{min-width:0;background:#fff;border:1px solid #e6ebf2;border-radius:20px;padding:1.25rem;box-shadow:0 10px 30px rgba(15,23,42,.055)}
  .review-top{display:flex;gap:.75rem;align-items:center;margin-bottom:.8rem}.avatar{width:42px;height:42px;flex:0 0 42px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,#2563eb,#7c3aed);color:#fff;font-weight:800}
  .review-name{font-weight:700;color:#0f172a;overflow-wrap:anywhere}.review-meta{font-size:.74rem;color:#94a3b8;margin-top:.12rem}
  .review-stars{color:#fbbc04;letter-spacing:1.5px;font-size:1rem;margin-bottom:.55rem}.review-body{color:#475569;line-height:1.65;font-size:.9rem;overflow-wrap:anywhere}
  .review-service{display:inline-flex;margin-top:.9rem;padding:.3rem .55rem;border-radius:999px;background:#eff6ff;color:#2563eb;font-size:.7rem;font-weight:700}
  .see-all{display:flex;align-items:center;justify-content:center;gap:.5rem;margin:1.25rem auto 0;padding:.8rem 1.2rem;border:1px solid #dbe3ed;border-radius:999px;background:#fff;color:#0f172a;font:700 .9rem Outfit,system-ui;cursor:pointer;box-shadow:0 6px 18px rgba(15,23,42,.05)}
  .see-all:hover{border-color:#2563eb;color:#2563eb}.see-all[hidden]{display:none}
  .review-form-card{max-width:900px;margin:2.25rem auto 0;padding:1.5rem!important}.form-copy{display:flex;align-items:center;gap:.8rem;margin-bottom:1.15rem}.form-copy h3{margin:0;font-size:1.2rem}.form-copy p{margin:.15rem 0 0;color:#64748b;font-size:.84rem}
  .form-icon{width:44px;height:44px;display:grid;place-items:center;border-radius:14px;background:#fff7dd;color:#f9ab00;font-size:1.4rem}
  .star-field{border:0;padding:0;margin:0 0 1rem}.star-field legend,label>span{font-size:.78rem;font-weight:700;color:#334155;margin-bottom:.4rem;display:block}
  .star-picker{display:flex;gap:.15rem;width:max-content}.star-btn{border:0;background:transparent;color:#d8dee8;font-size:2.25rem;line-height:1;padding:.08rem .12rem;cursor:pointer;filter:drop-shadow(0 1px 1px rgba(0,0,0,.08));transition:transform .16s ease,color .16s ease}
  .star-btn:hover,.star-btn:focus-visible{transform:scale(1.12)}.star-btn.on{color:#fbbc04}.star-label{display:block;color:#64748b;font-size:.78rem;margin-top:.35rem}
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:.85rem}label{display:block}
  input,select,textarea{width:100%;box-sizing:border-box;border:1px solid #dbe3ed;border-radius:13px;background:#fff;color:#0f172a;font:inherit;padding:.78rem .9rem;outline:0;transition:border-color .2s,box-shadow .2s}
  input:focus,select:focus,textarea:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1)}textarea{resize:vertical;min-height:110px;margin-bottom:1rem}
  .hp-field{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;opacity:0}.turnstile-wrap{margin-bottom:1rem}
  .submit-row{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}.submit-row small{color:#64748b;line-height:1.45}.form-msg{margin:.8rem 0 0;color:#166534;font-size:.86rem}.form-msg.err{color:#be123c}
  .reviews-modal{position:fixed;inset:0;z-index:10000;display:none;place-items:center;padding:1rem}.reviews-modal.is-open{display:grid}
  .modal-backdrop{position:absolute;inset:0;border:0;background:rgba(15,23,42,.62);backdrop-filter:blur(5px)}.modal-panel{position:relative;width:min(920px,100%);max-height:min(86vh,850px);display:flex;flex-direction:column;border-radius:24px;background:#f8fafc;box-shadow:0 24px 80px rgba(0,0,0,.25);overflow:hidden}
  .modal-head{display:flex;justify-content:space-between;align-items:center;padding:1.15rem 1.3rem;background:#fff;border-bottom:1px solid #e6ebf2}.modal-head h3{margin:0}.modal-kicker{margin:0 0 .1rem;color:#2563eb;font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}
  .modal-close{width:42px;height:42px;border:0;border-radius:13px;background:#f1f5f9;color:#0f172a;font-size:1.6rem;cursor:pointer}.modal-body{padding:1.2rem;overflow:auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;-webkit-overflow-scrolling:touch}
  @media(max-width:760px){.reviews-section{padding:4rem 1rem}.rating-overview{grid-template-columns:1fr;gap:1rem}.rating-score{border-right:0;border-bottom:1px solid rgba(15,23,42,.1);padding-bottom:1rem}.reviews-grid{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.review-form-card{padding:1.15rem!important}.modal-body{grid-template-columns:1fr}.modal-panel{width:100%;max-height:92dvh;border-radius:22px 22px 0 0;align-self:end}.reviews-modal{padding:0;place-items:end center}.star-btn{font-size:2.1rem}.submit-row .btn{width:100%}}
  @media(prefers-reduced-motion:reduce){.bar-fill,.star-btn{transition:none}}
</style>

<script is:inline>
(() => {
  'use strict';
  const seed = [
    {id:'seed_1',name:'Rafiul Islam',stars:5,text:'Creavix delivered our brand film in 48 hours. Cinematic quality and clear communication throughout.',createdAt:'2026-06-12T10:00:00.000Z',service:'Video Marketing'},
    {id:'seed_2',name:'Nusrat Jahan',stars:5,text:'AI প্রোডাক্ট ভিডিওগুলো দেখে ক্লায়েন্টরা রিয়েল মনে করেছে। Meta অ্যাডে কনভার্সন বেড়েছে।',createdAt:'2026-05-28T14:20:00.000Z',service:'AI Video'},
    {id:'seed_3',name:'Karim Hassan',stars:5,text:'They rebuilt our company website — fast, mobile-perfect and SEO-ready.',createdAt:'2026-04-03T09:15:00.000Z',service:'Web Development'},
    {id:'seed_4',name:'Sadia Rahman',stars:4,text:'Facebook page setup ও boosting campaign—দুটির reporting খুব পরিষ্কার ছিল।',createdAt:'2026-03-18T16:40:00.000Z',service:'Digital Marketing'},
    {id:'seed_5',name:'Tanvir Ahmed',stars:5,text:'Application UI and authentication flow were clean, fast and secure.',createdAt:'2026-02-09T11:05:00.000Z',service:'App Development'}
  ];
  const $ = id => document.getElementById(id);
  const labels = ['', 'Poor', 'Fair', 'Good', 'Very good', 'Excellent'];
  let reviews = seed, selected = 0, turnstileToken = '', widgetId = null, lastFocus = null;

  const esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const stars = n => Array.from({length:5},(_,i)=>i<n?'★':'☆').join('');
  const unique = list => Array.from(new Map(list.filter(Boolean).map(r=>[r.id,r])).values()).sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt));
  const stats = list => {
    const counts=[0,0,0,0,0,0]; let total=0;
    list.forEach(r=>{const n=Math.max(1,Math.min(5,Number(r.stars)||1));counts[n]++;total+=n});
    return {counts,total:list.length,avg:list.length?total/list.length:0};
  };
  function card(r){
    const date=r.createdAt?new Date(r.createdAt).toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'}):'';
    return `<article class="review-item"><div class="review-top"><div class="avatar" aria-hidden="true">${esc((r.name||'U').trim().charAt(0).toUpperCase())}</div><div><div class="review-name">${esc(r.name||'Guest')}</div><div class="review-meta">${esc(date)}</div></div></div><div class="review-stars" aria-label="${Number(r.stars)||0} out of 5 stars">${stars(Number(r.stars)||0)}</div><div class="review-body">${esc(r.text||'')}</div><span class="review-service">${esc(r.service||'Creavix Service')}</span></article>`;
  }
  function render(){
    const s=stats(reviews);
    $('avg-score').textContent=s.avg.toFixed(1); $('avg-stars').textContent=stars(Math.round(s.avg));
    $('rating-count').textContent=`${s.total} ${s.total===1?'rating':'ratings'}`;
    $('rating-bars').innerHTML=[5,4,3,2,1].map(n=>{const p=s.total?Math.round(s.counts[n]/s.total*100):0;return `<div class="bar-row"><span class="bar-label">${n}★</span><div class="bar-track"><div class="bar-fill" style="width:${p}%"></div></div><span>${p}%</span></div>`}).join('');
    $('reviews-list').innerHTML=reviews.slice(0,3).map(card).join('');
    $('modal-body').innerHTML=reviews.map(card).join('');
    $('btn-see-more').hidden=reviews.length<=3;
    $('btn-see-more').firstChild.textContent=`See all ${reviews.length} reviews `;
  }
  function setStars(n){
    selected=n;
    document.querySelectorAll('.star-btn').forEach(btn=>{const on=Number(btn.dataset.star)<=n;btn.classList.toggle('on',on);btn.setAttribute('aria-checked',String(Number(btn.dataset.star)===n))});
    $('star-label').textContent=n?`${n} out of 5 · ${labels[n]}`:'Tap a star to rate';
  }
  function message(text,error=false){const el=$('form-msg');el.hidden=false;el.className='form-msg'+(error?' err':'');el.textContent=text}
  function visitorId(){let id=localStorage.getItem('creavix_visitor_id');if(!id){id=crypto.randomUUID?.()||Date.now().toString(36)+Math.random().toString(36).slice(2);localStorage.setItem('creavix_visitor_id',id)}return id}
  function openModal(){lastFocus=document.activeElement;$('reviews-modal').classList.add('is-open');$('reviews-modal').setAttribute('aria-hidden','false');document.body.style.overflow='hidden';$('modal-close').focus()}
  function closeModal(){$('reviews-modal').classList.remove('is-open');$('reviews-modal').setAttribute('aria-hidden','true');document.body.style.overflow='';lastFocus?.focus?.()}
  async function loadReviews(){
    try{const response=await fetch('/api/reviews',{headers:{Accept:'application/json'}});if(!response.ok)return;const data=await response.json();if(data.ok&&Array.isArray(data.reviews))reviews=unique(data.reviews)}
    catch{} render();
  }
  function loadTurnstile(key){
    if(!key||key.startsWith('1x000000'))return;
    $('turnstile-wrap').hidden=false;
    const script=document.createElement('script');script.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';script.async=true;
    script.onload=()=>{widgetId=turnstile.render('#turnstile-widget',{sitekey:key,theme:'light',size:'flexible',callback:t=>turnstileToken=t,'expired-callback':()=>turnstileToken=''})};
    document.head.appendChild(script);
  }
  async function boot(){
    render(); loadReviews();
    try{const cfg=await fetch('/config.json').then(r=>r.ok?r.json():{});loadTurnstile(cfg.turnstileSiteKey)}catch{}
    $('star-picker').addEventListener('click',e=>{const b=e.target.closest('.star-btn');if(b)setStars(Number(b.dataset.star))});
    $('star-picker').addEventListener('keydown',e=>{if(!['ArrowLeft','ArrowRight'].includes(e.key))return;e.preventDefault();setStars(Math.max(1,Math.min(5,(selected||1)+(e.key==='ArrowRight'?1:-1))))});
    $('btn-see-more').addEventListener('click',openModal);$('modal-close').addEventListener('click',closeModal);$('modal-backdrop').addEventListener('click',closeModal);
    document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
    $('review-form').addEventListener('submit',async e=>{
      e.preventDefault();
      if($('review-company').value)return;
      const name=$('review-name').value.trim(),text=$('review-text').value.trim();
      if(!selected)return message('Please choose a star rating.',true);
      if(name.length<2)return message('Please enter your name.',true);
      if(text.length<3)return message('Please write a short review.',true);
      const button=$('btn-submit-review');button.disabled=true;button.textContent='Posting…';
      try{
        const response=await fetch('/api/reviews',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,text,stars:selected,service:$('review-service').value,company:$('review-company').value,visitorId:visitorId(),turnstileToken})});
        const data=await response.json();
        if(!response.ok||!data.ok)throw new Error(data.error||'Review could not be posted.');
        reviews=unique([data.review,...reviews]);render();e.target.reset();setStars(0);message('Thank you! Your review has been published.');
        turnstileToken='';if(window.turnstile&&widgetId!==null)turnstile.reset(widgetId);
      }catch(error){message(error.message||'Review could not be posted. Please try again.',true)}
      finally{button.disabled=false;button.textContent='Post review'}
    });
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>
