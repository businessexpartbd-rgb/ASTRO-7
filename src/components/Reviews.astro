---
---
<section id="reviews" class="section-reviews">
  <div class="container">
    <div class="text-center mb-8 reveal">
      <p class="eyebrow" style="margin:0 auto 1rem">Client Reviews</p>
      <h2 class="mb-4">Ratings & Reviews</h2>
      <p style="max-width:36rem;margin:0 auto">Share your experience in Bangla or English. Protected by Cloudflare Turnstile.</p>
    </div>

    <div class="reviews-layout reveal">
      <div class="reviews-summary glass-card">
        <div class="rating-score">
          <div class="score-num" id="avg-score">0.0</div>
          <div class="score-stars" id="avg-stars" aria-hidden="true"></div>
          <div class="score-count" id="rating-count">0 ratings</div>
        </div>
        <div class="rating-bars" id="rating-bars"></div>
      </div>

      <div class="reviews-main">
        <div class="reviews-list" id="reviews-list">
          <div class="reviews-empty" id="reviews-empty">
            <div class="empty-icon">⭐</div>
            <p><strong>No reviews yet</strong></p>
            <p class="empty-sub">Be the first to leave an honest rating.</p>
          </div>
        </div>
        <button type="button" class="btn-see-more" id="btn-see-more" hidden>See all reviews</button>

        <div class="review-form-card glass-card" id="review-form-card">
          <h3 class="form-heading">Write a review</h3>
          <form id="review-form" class="review-form">
            <div class="star-picker" id="star-picker" role="radiogroup" aria-label="Your rating">
              <button type="button" data-star="1" class="star-btn" aria-label="1 star">★</button>
              <button type="button" data-star="2" class="star-btn" aria-label="2 stars">★</button>
              <button type="button" data-star="3" class="star-btn" aria-label="3 stars">★</button>
              <button type="button" data-star="4" class="star-btn" aria-label="4 stars">★</button>
              <button type="button" data-star="5" class="star-btn" aria-label="5 stars">★</button>
            </div>
            <p class="star-label" id="star-label">Tap to rate</p>

            <input type="text" id="review-name" class="review-input" maxlength="60" placeholder="Your name / আপনার নাম" required autocomplete="name" />
            <textarea id="review-text" class="review-textarea" rows="3" maxlength="600" placeholder="Write in Bangla or English… আপনার মতামত লিখুন" required></textarea>

            <!-- Honeypot (bots) -->
            <input type="text" id="review-company" name="company" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="cf-turnstile-wrap" id="turnstile-wrap">
              <div id="turnstile-widget"></div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary" id="btn-submit-review">Post review</button>
            </div>
            <p class="form-msg" id="form-msg" hidden></p>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="reviews-modal" id="reviews-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-backdrop" id="modal-backdrop"></div>
    <div class="modal-panel" role="document">
      <div class="modal-head">
        <h3 id="modal-title">All reviews</h3>
        <button type="button" class="modal-close" id="modal-close" aria-label="Close">×</button>
      </div>
      <div class="modal-body" id="modal-body"></div>
    </div>
  </div>
</section>

<style is:global>
  .section-reviews {
    padding: 4.5rem 1.25rem;
    background:
      radial-gradient(ellipse 60% 40% at 20% 0%, rgba(79,70,229,.07), transparent 55%),
      radial-gradient(ellipse 50% 40% at 90% 100%, rgba(245,158,11,.06), transparent 50%),
      #F8FAFC;
  }
  .reviews-layout { display: grid; gap: 1.5rem; max-width: 960px; margin: 0 auto; }
  @media (min-width: 800px) {
    .reviews-layout { grid-template-columns: 280px 1fr; align-items: start; gap: 2rem; }
  }
  .reviews-summary { padding: 1.5rem !important; display: flex; flex-direction: column; gap: 1.25rem; }
  .rating-score { text-align: center; }
  .score-num { font-family: var(--font-h); font-size: 3.25rem; font-weight: 800; line-height: 1; color: var(--text); letter-spacing: -0.03em; }
  .score-stars { margin: 0.4rem 0 0.35rem; font-size: 1.15rem; letter-spacing: 2px; color: #F59E0B; }
  .score-count { font-size: 0.85rem; color: var(--text-3); }
  .rating-bars { display: flex; flex-direction: column; gap: 0.4rem; }
  .bar-row { display: grid; grid-template-columns: 12px 1fr 28px; align-items: center; gap: 0.5rem; font-size: 0.75rem; color: var(--text-3); }
  .bar-track { height: 8px; border-radius: 99px; background: rgba(15,23,42,.06); overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg, #F59E0B, #FBBF24); width: 0%; transition: width 0.6s cubic-bezier(.22,1,.36,1); }
  .reviews-list { display: flex; flex-direction: column; gap: 1rem; }
  .reviews-empty { text-align: center; padding: 2rem 1rem; color: var(--text-2); }
  .empty-icon { font-size: 2rem; margin-bottom: 0.5rem; }
  .empty-sub { font-size: 0.9rem; color: var(--text-3); margin-top: 0.25rem; }
  .review-item { background: rgba(255,255,255,.75); border: 1px solid rgba(255,255,255,.9); border-radius: 18px; padding: 1.15rem 1.25rem; box-shadow: 0 4px 20px rgba(15,23,42,.04); }
  .review-top { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.55rem; }
  .review-avatar-fallback { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem; color: #fff; background: linear-gradient(135deg, #4F46E5, #7C3AED); }
  .review-name { font-weight: 600; font-size: 0.95rem; color: var(--text); }
  .review-meta { font-size: 0.75rem; color: var(--text-3); }
  .review-stars { color: #F59E0B; font-size: 0.9rem; letter-spacing: 1px; margin-bottom: 0.4rem; }
  .review-body { font-size: 0.9rem; line-height: 1.6; color: var(--text-2); white-space: pre-wrap; }
  .btn-see-more { display: block; width: 100%; margin: 1rem 0 0; padding: 0.75rem; border-radius: 14px; border: 1.5px solid rgba(15,23,42,.1); background: #fff; font-family: var(--font-h); font-weight: 600; font-size: 0.9rem; color: var(--text); cursor: pointer; }
  .btn-see-more[hidden] { display: none !important; }
  .btn-see-more:hover { border-color: var(--primary); color: var(--primary); }
  .review-form-card { margin-top: 1.5rem; padding: 1.5rem !important; }
  .form-heading { font-size: 1.1rem; margin-bottom: 1rem; }
  .star-picker { display: flex; gap: 0.35rem; margin-bottom: 0.35rem; }
  .star-btn { background: none; border: none; cursor: pointer; font-size: 1.75rem; color: #CBD5E1; line-height: 1; padding: 0.15rem; }
  .star-btn:hover, .star-btn.on { color: #F59E0B; }
  .star-label { font-size: 0.8rem; color: var(--text-3); margin-bottom: 0.85rem; }
  .review-input {
    width: 100%; padding: 0.75rem 1rem; border-radius: 14px;
    border: 1.5px solid rgba(15,23,42,.1); background: #fff;
    font-family: var(--font-b); font-size: 0.95rem; margin-bottom: 0.75rem; outline: none;
  }
  .review-input:focus { border-color: var(--primary); }
  .review-textarea {
    width: 100%; padding: 0.85rem 1rem; border-radius: 14px;
    border: 1.5px solid rgba(15,23,42,.1); background: #fff;
    font-family: var(--font-b); font-size: 0.95rem; resize: vertical;
    margin-bottom: 1rem; outline: none;
  }
  .review-textarea:focus { border-color: var(--primary); }
  .hp-field { position: absolute; left: -9999px; opacity: 0; height: 0; width: 0; }
  .cf-turnstile-wrap { margin-bottom: 1rem; min-height: 65px; display: flex; justify-content: flex-start; }
  .form-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; }
  .form-msg { font-size: 0.85rem; margin-top: 0.75rem; color: var(--emerald); }
  .form-msg.err { color: var(--rose); }
  .reviews-modal { position: fixed; inset: 0; z-index: 10000; display: none; align-items: flex-end; justify-content: center; pointer-events: none; }
  .reviews-modal.is-open { display: flex; pointer-events: auto; }
  @media (min-width: 640px) { .reviews-modal.is-open { align-items: center; } }
  .modal-backdrop { position: absolute; inset: 0; background: rgba(15,23,42,.45); backdrop-filter: blur(4px); }
  .modal-panel { position: relative; z-index: 1; width: 100%; max-width: 520px; max-height: 85vh; background: #fff; border-radius: 24px 24px 0 0; box-shadow: 0 -8px 40px rgba(15,23,42,.15); display: flex; flex-direction: column; }
  @media (min-width: 640px) { .modal-panel { border-radius: 24px; max-height: 80vh; } }
  .modal-head { display: flex; align-items: center; justify-content: space-between; padding: 1.15rem 1.35rem; border-bottom: 1px solid rgba(15,23,42,.06); }
  .modal-head h3 { font-size: 1.1rem; margin: 0; }
  .modal-close { width: 40px; height: 40px; border: none; border-radius: 10px; background: rgba(15,23,42,.06); font-size: 1.5rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .modal-body { padding: 1.15rem 1.35rem 1.5rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; }
</style>

<script is:inline>
(function () {
  'use strict';
  try {
  var STORAGE_KEY = 'creavix_reviews_v3';
  var starLabels = ['', 'Poor', 'Fair', 'Good', 'Very good', 'Excellent'];
  var reviews = [];
  var selectedStars = 0;
  var turnstileToken = '';
  var turnstileWidgetId = null;
  var siteKey = '1x00000000000000000000AA';

  function $(id) { return document.getElementById(id); }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function starsHtml(n) {
    var s = '';
    for (var i = 1; i <= 5; i++) s += i <= n ? '★' : '☆';
    return s;
  }

  function loadLocal() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch (e) { return []; }
  }

  function saveLocal(list) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); } catch (e) {}
  }

  function stats(list) {
    var counts = [0, 0, 0, 0, 0, 0];
    var sum = 0;
    list.forEach(function (r) {
      var s = Math.min(5, Math.max(1, parseInt(r.stars, 10) || 0));
      counts[s]++;
      sum += s;
    });
    var n = list.length;
    return { counts: counts, total: n, avg: n ? sum / n : 0 };
  }

  function renderSummary(list) {
    var st = stats(list);
    if ($('avg-score')) $('avg-score').textContent = st.total ? st.avg.toFixed(1) : '0.0';
    if ($('avg-stars')) $('avg-stars').textContent = starsHtml(Math.round(st.avg));
    if ($('rating-count')) $('rating-count').textContent = st.total + (st.total === 1 ? ' rating' : ' ratings');
    var bars = $('rating-bars');
    if (!bars) return;
    var html = '';
    for (var i = 5; i >= 1; i--) {
      var pct = st.total ? Math.round((st.counts[i] / st.total) * 100) : 0;
      html += '<div class="bar-row"><span>' + i + '</span><div class="bar-track"><div class="bar-fill" style="width:' + pct + '%"></div></div><span>' + pct + '%</span></div>';
    }
    bars.innerHTML = html;
  }

  function reviewCard(r) {
    var initial = (r.name || 'U').charAt(0).toUpperCase();
    var date = r.createdAt
      ? new Date(r.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
      : '';
    return (
      '<article class="review-item">' +
        '<div class="review-top">' +
          '<div class="review-avatar-fallback">' + initial + '</div>' +
          '<div><div class="review-name">' + escapeHtml(r.name || 'User') + '</div>' +
          '<div class="review-meta">' + date + '</div></div></div>' +
        '<div class="review-stars">' + starsHtml(r.stars) + '</div>' +
        '<div class="review-body">' + escapeHtml(r.text || '') + '</div>' +
      '</article>'
    );
  }

  function renderList(list) {
    var listEl = $('reviews-list');
    var emptyEl = $('reviews-empty');
    var moreBtn = $('btn-see-more');
    if (!listEl) return;
    if (!list.length) {
      listEl.innerHTML = '';
      if (emptyEl) { listEl.appendChild(emptyEl); emptyEl.hidden = false; }
      if (moreBtn) moreBtn.hidden = true;
      return;
    }
    if (emptyEl) emptyEl.hidden = true;
    listEl.innerHTML = list.slice(0, 3).map(reviewCard).join('');
    if (moreBtn) {
      moreBtn.hidden = list.length <= 3;
      moreBtn.textContent = 'See all ' + list.length + ' reviews';
    }
  }

  function renderModal(list) {
    var body = $('modal-body');
    if (body) {
      body.innerHTML = list.map(reviewCard).join('') ||
        '<p style="color:#64748B;text-align:center;padding:1rem">No reviews yet</p>';
    }
  }

  function refresh() {
    renderSummary(reviews);
    renderList(reviews);
    renderModal(reviews);
  }

  function setStars(n) {
    selectedStars = n;
    document.querySelectorAll('#star-picker .star-btn').forEach(function (btn) {
      var v = parseInt(btn.getAttribute('data-star'), 10);
      btn.classList.toggle('on', v <= n);
    });
    if ($('star-label')) $('star-label').textContent = n ? n + ' · ' + starLabels[n] : 'Tap to rate';
  }

  function closeModal() {
    var m = $('reviews-modal');
    if (!m) return;
    m.classList.remove('is-open');
    m.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function openModal() {
    var m = $('reviews-modal');
    if (!m) return;
    m.classList.add('is-open');
    m.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function loadTurnstile(key) {
    siteKey = key || siteKey;
    var s = document.createElement('script');
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    s.async = true;
    s.onload = function () {
      if (!window.turnstile || !$('turnstile-widget')) return;
      try {
        turnstileWidgetId = window.turnstile.render('#turnstile-widget', {
          sitekey: siteKey,
          theme: 'light',
          callback: function (token) { turnstileToken = token || ''; },
          'error-callback': function () { turnstileToken = ''; },
          'expired-callback': function () { turnstileToken = ''; },
        });
      } catch (e) {
        console.warn('Turnstile render failed', e);
      }
    };
    document.head.appendChild(s);
  }

  function resetTurnstile() {
    turnstileToken = '';
    try {
      if (window.turnstile && turnstileWidgetId !== null) {
        window.turnstile.reset(turnstileWidgetId);
      }
    } catch (e) {}
  }

  async function boot() {
    closeModal();
    try {
      var res = await fetch('/config.json?t=' + Date.now(), { cache: 'no-store' });
      if (res.ok) {
        var cfg = await res.json();
        if (cfg && cfg.turnstileSiteKey) siteKey = cfg.turnstileSiteKey;
      }
    } catch (e) {}

    reviews = loadLocal();
    refresh();
    loadTurnstile(siteKey);

    var starPicker = $('star-picker');
    if (starPicker) {
      starPicker.addEventListener('click', function (e) {
        var t = e.target.closest('.star-btn');
        if (t) setStars(parseInt(t.getAttribute('data-star'), 10));
      });
    }

    var form = $('review-form');
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var msg = $('form-msg');
        var btn = $('btn-submit-review');

        // Honeypot
        if (($('review-company') && $('review-company').value || '').trim()) return;

        if (!selectedStars) {
          if (msg) { msg.hidden = false; msg.className = 'form-msg err'; msg.textContent = 'Please select a star rating.'; }
          return;
        }
        var name = (($('review-name') && $('review-name').value) || '').trim();
        if (name.length < 2) {
          if (msg) { msg.hidden = false; msg.className = 'form-msg err'; msg.textContent = 'Please enter your name.'; }
          return;
        }
        var text = (($('review-text') && $('review-text').value) || '').trim();
        if (text.length < 3) {
          if (msg) { msg.hidden = false; msg.className = 'form-msg err'; msg.textContent = 'Please write a short comment.'; }
          return;
        }
        if (!turnstileToken) {
          if (msg) { msg.hidden = false; msg.className = 'form-msg err'; msg.textContent = 'Please complete the human verification.'; }
          return;
        }

        if (btn) btn.disabled = true;

        var entry = {
          id: 'r_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8),
          name: name,
          stars: selectedStars,
          text: text,
          createdAt: new Date().toISOString(),
        };

        reviews.unshift(entry);
        if (reviews.length > 200) reviews = reviews.slice(0, 200);
        saveLocal(reviews);
        refresh();

        if ($('review-name')) $('review-name').value = '';
        if ($('review-text')) $('review-text').value = '';
        setStars(0);
        resetTurnstile();

        if (msg) {
          msg.hidden = false;
          msg.className = 'form-msg';
          msg.textContent = 'Thank you! Your review has been posted.';
        }
        if (btn) btn.disabled = false;
      });
    }

    if ($('btn-see-more')) $('btn-see-more').addEventListener('click', openModal);
    if ($('modal-close')) $('modal-close').addEventListener('click', closeModal);
    if ($('modal-backdrop')) $('modal-backdrop').addEventListener('click', closeModal);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  } catch (err) {
    var m = document.getElementById('reviews-modal');
    if (m) {
      m.classList.remove('is-open');
      m.setAttribute('aria-hidden', 'true');
    }
    document.body.style.overflow = '';
  }
})();
</script>
