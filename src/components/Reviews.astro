---
/** Premium, database-backed reviews for Cloudflare Workers + D1. */
---
<section id="reviews" class="reviews-section" aria-labelledby="reviews-title">
  <div class="reviews-orb reviews-orb-a" aria-hidden="true"></div>
  <div class="reviews-orb reviews-orb-b" aria-hidden="true"></div>
  <div class="container reviews-container">
    <header class="reviews-heading reveal">
      <div>
        <p class="eyebrow"><span aria-hidden="true"></span> Client experiences</p>
        <h2 id="reviews-title">Trusted work.<br /><em>Shared in their words.</em></h2>
      </div>
      <p>Authentic feedback from businesses that chose Creavix for creative, technology and growth services.</p>
    </header>

    <div class="reviews-dashboard reveal">
      <div class="rating-score-panel">
        <div class="score-line"><strong id="avg-score">4.8</strong><span>/ 5</span></div>
        <span id="avg-stars" class="gold-stars" aria-label="Average rating">★★★★★</span>
        <small id="rating-count">5 published ratings</small>
      </div>
      <div class="rating-distribution">
        <p>Rating distribution</p>
        <div id="rating-bars" class="rating-bars" aria-label="Rating distribution"></div>
      </div>
      <div class="reviews-trust" aria-label="Review protections">
        <span class="trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24"><path d="M12 2.8 19 5.7v5.5c0 4.6-2.9 8.7-7 10-4.1-1.3-7-5.4-7-10V5.7l7-2.9Z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m8.7 12 2.1 2.1 4.6-4.7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <div><strong>Protected submissions</strong><small id="review-protection-note">Cloudflare D1 storage · moderated before publishing</small></div>
      </div>
    </div>

    <div class="reviews-showcase-head">
      <div><span>Featured feedback</span><strong>Latest published experiences</strong></div>
      <button id="btn-see-more" class="see-all" type="button" hidden>View all reviews <span aria-hidden="true">↗</span></button>
    </div>
    <div id="reviews-list" class="reviews-grid" aria-live="polite"></div>

    <div class="review-compose reveal">
      <div class="compose-copy">
        <span class="compose-mark" aria-hidden="true">★</span>
        <p class="eyebrow">Your experience matters</p>
        <h3>Worked with Creavix?</h3>
        <p>Rate your experience in under a minute. No login or email is required, and your review is published only after moderation.</p>
        <div class="compose-points">
          <span><i aria-hidden="true">✓</i> Stored securely in Cloudflare D1</span>
          <span><i aria-hidden="true">✓</i> 1–5 star rating</span>
          <span><i aria-hidden="true">✓</i> Bangla or English</span>
        </div>
      </div>
      <form id="review-form" class="review-form" novalidate>
        <fieldset class="star-field">
          <legend>Your rating</legend>
          <div id="star-picker" class="star-picker" role="radiogroup" aria-label="Choose a rating from 1 to 5">
            <button type="button" class="star-btn" data-star="1" role="radio" aria-checked="false" aria-label="1 star">★</button>
            <button type="button" class="star-btn" data-star="2" role="radio" aria-checked="false" aria-label="2 stars">★</button>
            <button type="button" class="star-btn" data-star="3" role="radio" aria-checked="false" aria-label="3 stars">★</button>
            <button type="button" class="star-btn" data-star="4" role="radio" aria-checked="false" aria-label="4 stars">★</button>
            <button type="button" class="star-btn" data-star="5" role="radio" aria-checked="false" aria-label="5 stars">★</button>
          </div>
          <span id="star-label" class="star-label">Choose 1–5 stars</span>
        </fieldset>
        <div class="form-grid">
          <label><span>Your name <small>(optional)</small></span><input id="review-name" type="text" maxlength="60" autocomplete="name" placeholder="Guest Client" /></label>
          <label><span>Service</span><select id="review-service">
            <option>Professional Video Editing</option><option>AI Video Marketing</option><option>Human-like Content</option>
            <option>Web Development</option><option>App Development</option><option>Authentication Systems</option>
            <option>Business Automation</option><option>Digital Marketing</option><option>SEO</option>
            <option>Facebook Page Services</option><option>Facebook Boosting</option><option>Meta &amp; YouTube Campaigns</option><option>Other Service</option>
          </select></label>
        </div>
        <label><span>Your experience</span><textarea id="review-text" minlength="10" maxlength="600" rows="4" placeholder="What did we help you achieve?" required></textarea></label>
        <input id="review-company" name="company" class="hp-field" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div id="turnstile-wrap" class="turnstile-wrap" hidden><div id="turnstile-widget"></div></div>
        <div class="submit-row">
          <button id="btn-submit-review" class="btn btn-primary" type="submit">Submit for review <span aria-hidden="true">→</span></button>
          <small>Genuine experiences only. Spam and promotional content are rejected.</small>
        </div>
        <p id="form-msg" class="form-msg" role="status" hidden></p>
      </form>
    </div>
  </div>

  <div id="reviews-modal" class="reviews-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-hidden="true">
    <button id="modal-backdrop" class="modal-backdrop" type="button" aria-label="Close all reviews"></button>
    <section class="modal-panel">
      <header class="modal-head"><div><p class="modal-kicker">Published feedback</p><h3 id="modal-title">All client reviews</h3></div><button id="modal-close" class="modal-close" type="button" aria-label="Close reviews">×</button></header>
      <div id="modal-body" class="modal-body"></div>
    </section>
  </div>
</section>

<style>
  .reviews-section{position:relative;isolation:isolate;padding:clamp(4.5rem,8vw,7.5rem) 1.25rem;background:linear-gradient(180deg,#fff 0%,#f8fbff 52%,#fff 100%);overflow:clip}
  .reviews-container{position:relative;z-index:1}.reviews-orb{position:absolute;z-index:0;border-radius:50%;filter:blur(1px);pointer-events:none}.reviews-orb-a{width:390px;height:390px;left:-240px;top:8%;background:radial-gradient(circle,rgba(23,92,211,.12),transparent 68%)}.reviews-orb-b{width:430px;height:430px;right:-260px;bottom:3%;background:radial-gradient(circle,rgba(196,75,11,.11),transparent 68%)}
  .reviews-heading{max-width:1120px;margin:0 auto 2.2rem;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);align-items:end;gap:clamp(1.25rem,5vw,5rem)}
  .reviews-heading .eyebrow{display:flex;align-items:center;gap:.55rem;margin:0 0 .85rem;color:#c44b0b!important}.reviews-heading .eyebrow span{width:24px;height:2px;border-radius:9px;background:#c44b0b}.reviews-heading h2{margin:0;color:#101722;font-size:clamp(2.1rem,4.2vw,4rem);line-height:1.08;letter-spacing:-.052em}.reviews-heading h2 em{color:#c44b0b;font-style:normal}.reviews-heading>p{max-width:520px;margin:0;color:#5f7188!important;font-size:clamp(.98rem,1.2vw,1.1rem);line-height:1.75}
  .reviews-dashboard{max-width:1120px;margin:0 auto 2.4rem;padding:clamp(1.15rem,2.2vw,1.65rem);display:grid;grid-template-columns:200px minmax(250px,1fr) minmax(260px,.9fr);align-items:center;gap:clamp(1rem,2.5vw,2.2rem);border:1px solid rgba(15,42,69,.1);border-radius:28px;background:rgba(255,255,255,.88);box-shadow:0 22px 60px rgba(10,37,64,.08),inset 0 1px 0 #fff;backdrop-filter:blur(14px)}
  .rating-score-panel{padding-right:1.6rem;border-right:1px solid #e4eaf0}.score-line{display:flex;align-items:flex-end;gap:.35rem}.score-line strong{color:#0a2540;font:800 3.65rem/.9 var(--font-h);letter-spacing:-.065em}.score-line span{margin-bottom:.28rem;color:#8190a2;font:700 .85rem var(--font-h)}.gold-stars{display:block;margin:.65rem 0 .2rem;color:#fbbc04;font-size:1.08rem;letter-spacing:2.5px;text-shadow:0 1px 1px rgba(146,97,0,.12)}.rating-score-panel small{color:#6a7b8f;font-size:.74rem}
  .rating-distribution>p{margin:0 0 .55rem;color:#0a2540!important;font-size:.72rem!important;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.rating-bars{display:grid;gap:.38rem}.bar-row{display:grid;grid-template-columns:24px 1fr 32px;align-items:center;gap:.55rem;color:#7a899b;font-size:.7rem}.bar-label{color:#334155;font-weight:800}.bar-track{height:7px;border-radius:99px;background:#edf1f5;overflow:hidden}.bar-fill{height:100%;width:0;border-radius:inherit;background:linear-gradient(90deg,#fbbc04,#f59e0b);transition:width .65s cubic-bezier(.2,.7,.3,1)}
  .reviews-trust{min-width:0;padding:1rem;display:flex;gap:.8rem;align-items:center;border:1px solid #dcefe5;border-radius:18px;background:linear-gradient(135deg,#f4fbf7,#fff)}.trust-icon{width:44px;height:44px;flex:0 0 44px;display:grid;place-items:center;border-radius:14px;background:#e4f6ec;color:#137849}.reviews-trust strong,.reviews-trust small{display:block}.reviews-trust strong{color:#0a2540;font-size:.84rem}.reviews-trust small{margin-top:.2rem;color:#687b8e;line-height:1.45;font-size:.68rem}
  .reviews-showcase-head{max-width:1120px;margin:0 auto 1rem;display:flex;justify-content:space-between;align-items:end;gap:1rem}.reviews-showcase-head>div span,.reviews-showcase-head>div strong{display:block}.reviews-showcase-head span{color:#8190a2;font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;font-weight:800}.reviews-showcase-head strong{margin-top:.18rem;color:#0a2540;font-size:1rem}
  .reviews-grid{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.review-item{--review-tone:#175cd3;position:relative;min-width:0;min-height:270px;padding:1.35rem;display:flex;flex-direction:column;border:1px solid #e2e8f0;border:1px solid color-mix(in srgb,var(--review-tone) 14%,#e2e8f0);border-radius:24px;background:#fff;background:linear-gradient(145deg,#fff 72%,color-mix(in srgb,var(--review-tone) 5%,#fff));box-shadow:0 12px 34px rgba(10,37,64,.065);overflow:hidden;transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease}.review-item:nth-child(3n+2){--review-tone:#c44b0b}.review-item:nth-child(3n){--review-tone:#137849}.review-item:before{content:'“';position:absolute;right:16px;top:-15px;color:#edf3f9;color:color-mix(in srgb,var(--review-tone) 11%,white);font:800 7rem/1 Georgia,serif}.review-top{position:relative;display:flex;gap:.75rem;align-items:center;margin-bottom:1rem}.avatar{width:46px;height:46px;flex:0 0 46px;display:grid;place-items:center;border-radius:15px;background:var(--review-tone);background:linear-gradient(145deg,var(--review-tone),color-mix(in srgb,var(--review-tone) 66%,#0a2540));color:#fff;font-weight:800;box-shadow:0 7px 16px rgba(10,37,64,.15)}.review-name{max-width:24ch;color:#0a2540;font-weight:800;line-height:1.25;overflow-wrap:anywhere}.review-meta{margin-top:.2rem;color:#8997a7;font-size:.7rem}.review-stars{position:relative;margin:0 0 .65rem;color:#fbbc04;letter-spacing:1.7px;font-size:.96rem}.review-body{position:relative;flex:1;color:#506176;line-height:1.72;font-size:.88rem;overflow-wrap:anywhere}.review-foot{position:relative;margin-top:1rem;padding-top:.8rem;display:flex;align-items:center;justify-content:space-between;gap:.6rem;border-top:1px solid #edf1f5}.review-service{max-width:75%;padding:.32rem .58rem;border-radius:999px;background:#eff6ff;background:color-mix(in srgb,var(--review-tone) 9%,white);color:var(--review-tone);font-size:.65rem;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.review-public{display:flex;align-items:center;gap:.28rem;color:#6b7c90;font-size:.61rem;font-weight:700}.review-public:before{content:'';width:6px;height:6px;border-radius:50%;background:#22a06b;box-shadow:0 0 0 3px #e7f7ef}
  .see-all{min-height:44px;padding:.68rem 1rem;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border:1px solid #d9e2eb;border-radius:13px;background:#fff;color:#0a2540;font:800 .78rem var(--font-h);cursor:pointer;box-shadow:0 7px 18px rgba(10,37,64,.05)}.see-all:hover{border-color:#175cd3;color:#175cd3}.see-all[hidden]{display:none}
  .review-compose{max-width:1120px;margin:clamp(2rem,5vw,4rem) auto 0;padding:clamp(1.3rem,3vw,2.3rem);display:grid;grid-template-columns:minmax(250px,.72fr) minmax(0,1.28fr);gap:clamp(1.5rem,5vw,4rem);border:1px solid #dfe7ee;border-radius:30px;background:radial-gradient(circle at 0 0,#fff1e5,transparent 38%),linear-gradient(135deg,#fff,#f7faff);box-shadow:0 22px 62px rgba(10,37,64,.08)}.compose-mark{width:48px;height:48px;margin-bottom:1.15rem;display:grid;place-items:center;border-radius:16px;background:#fff3d2;color:#f9ab00;font-size:1.45rem;box-shadow:0 8px 20px rgba(196,75,11,.1)}.compose-copy .eyebrow{margin:0 0 .35rem;color:#c44b0b!important}.compose-copy h3{margin:0;color:#0a2540;font-size:clamp(1.6rem,2.6vw,2.35rem);line-height:1.15;letter-spacing:-.04em}.compose-copy>p:not(.eyebrow){margin:.8rem 0 1.1rem;color:#5f7187!important;line-height:1.7;font-size:.9rem}.compose-points{display:grid;gap:.55rem}.compose-points span{display:flex;align-items:center;gap:.55rem;color:#385067;font-size:.75rem;font-weight:700}.compose-points i{width:19px;height:19px;display:grid;place-items:center;border-radius:50%;background:#e5f6ed;color:#137849;font-style:normal;font-size:.65rem}
  .review-form{min-width:0;padding:1.25rem;border:1px solid #e1e7ed;border-radius:22px;background:rgba(255,255,255,.9);box-shadow:inset 0 1px 0 #fff}.star-field{margin:0 0 1rem;padding:0;border:0}.star-field legend,.review-form label>span{display:block;margin-bottom:.42rem;color:#33475b;font-size:.74rem;font-weight:800}.review-form label>span small{color:#8997a7;font-weight:600}.star-picker{display:flex;width:max-content;gap:.1rem}.star-btn{min-width:42px;min-height:42px;padding:0;border:0;background:transparent;color:#d8dee7;font-size:2.15rem;line-height:1;cursor:pointer;filter:drop-shadow(0 1px 1px rgba(0,0,0,.07));transition:transform .16s ease,color .16s ease}.star-btn:hover,.star-btn:focus-visible{transform:translateY(-2px) scale(1.06)}.star-btn.on{color:#fbbc04}.star-label{display:block;margin-top:.25rem;color:#6f8093;font-size:.72rem}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.review-form label{display:block}.review-form :is(input,select,textarea){width:100%;box-sizing:border-box;padding:.78rem .85rem;border:1px solid #d9e2eb;border-radius:12px;background:#fff;color:#0f172a;font:inherit;outline:0;transition:border-color .2s,box-shadow .2s}.review-form :is(input,select,textarea):focus{border-color:#175cd3;box-shadow:0 0 0 3px rgba(23,92,211,.1)}.review-form textarea{min-height:108px;margin-bottom:.9rem;resize:vertical}.hp-field{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;opacity:0}.turnstile-wrap{margin-bottom:.9rem}.submit-row{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap}.submit-row .btn{display:inline-flex;align-items:center;gap:.55rem}.submit-row small{max-width:310px;color:#718195;line-height:1.45;font-size:.67rem}.form-msg{margin:.8rem 0 0;padding:.7rem .8rem;border-radius:10px;background:#edf9f2;color:#166534;font-size:.8rem}.form-msg.err{background:#fff1f2;color:#be123c}
  .reviews-modal{position:fixed;inset:0;z-index:10000;display:none;place-items:center;padding:1rem}.reviews-modal.is-open{display:grid}.modal-backdrop{position:absolute;inset:0;border:0;background:rgba(8,23,39,.66);backdrop-filter:blur(8px)}.modal-panel{position:relative;width:min(980px,100%);max-height:min(88vh,860px);display:flex;flex-direction:column;border:1px solid rgba(255,255,255,.6);border-radius:28px;background:#f7faff;box-shadow:0 30px 100px rgba(0,0,0,.3);overflow:hidden}.modal-head{padding:1.15rem 1.3rem;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e2e8f0;background:#fff}.modal-head h3{margin:0;color:#0a2540}.modal-kicker{margin:0 0 .1rem;color:#c44b0b!important;font-size:.66rem!important;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.modal-close{width:44px;height:44px;border:1px solid #e0e7ee;border-radius:14px;background:#f8fafc;color:#0a2540;font-size:1.5rem;cursor:pointer}.modal-body{padding:1.2rem;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;overflow:auto;-webkit-overflow-scrolling:touch}.modal-body .review-item{min-height:245px}
  @media(hover:hover) and (prefers-reduced-motion:no-preference){.review-item:hover{transform:translateY(-6px);border-color:color-mix(in srgb,var(--review-tone) 42%,white);box-shadow:0 22px 52px color-mix(in srgb,var(--review-tone) 11%,transparent)}}
  @media(max-width:900px){.reviews-dashboard{grid-template-columns:180px 1fr}.reviews-trust{grid-column:1/-1}.reviews-heading{grid-template-columns:1fr}.reviews-heading>p{max-width:650px}.review-compose{grid-template-columns:1fr}.compose-points{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:700px){.reviews-section{padding:4.2rem .9rem}.reviews-heading{margin-bottom:1.5rem}.reviews-dashboard{grid-template-columns:1fr;padding:1.1rem;border-radius:22px}.rating-score-panel{padding:0 0 1rem;border-right:0;border-bottom:1px solid #e4eaf0;text-align:center}.score-line{justify-content:center}.reviews-grid{grid-template-columns:1fr}.review-item{min-height:0;border-radius:20px}.reviews-showcase-head{align-items:center}.review-compose{padding:1.05rem;border-radius:23px}.compose-points{grid-template-columns:1fr}.review-form{padding:1rem}.form-grid{grid-template-columns:1fr}.submit-row .btn{width:100%;justify-content:center}.modal-body{grid-template-columns:1fr}.modal-panel{width:100%;max-height:92dvh;align-self:end;border-radius:24px 24px 0 0}.reviews-modal{padding:0;place-items:end center}.star-picker{width:100%;justify-content:space-between}.star-btn{min-width:44px;min-height:44px;font-size:2rem}.reviews-orb{display:none}}
  @media(prefers-reduced-motion:reduce){.bar-fill,.star-btn,.review-item{transition:none!important}}
</style>

<script is:inline>
(() => {
  'use strict';
  const seed=[
    {id:'seed_1',name:'Rafiul Islam',stars:5,text:'Creavix delivered our brand film in 48 hours. Cinematic quality and clear communication throughout.',createdAt:'2026-06-12T10:00:00.000Z',service:'Video Marketing'},
    {id:'seed_2',name:'Nusrat Jahan',stars:5,text:'The AI product videos looked convincingly real and helped improve our Meta ad conversions.',createdAt:'2026-05-28T14:20:00.000Z',service:'AI Video'},
    {id:'seed_3',name:'Karim Hassan',stars:5,text:'They rebuilt our company website — fast, mobile-perfect and SEO-ready.',createdAt:'2026-04-03T09:15:00.000Z',service:'Web Development'},
    {id:'seed_4',name:'Sadia Rahman',stars:4,text:'The Facebook page setup, boosting campaign and reporting were all clear and professionally managed.',createdAt:'2026-03-18T16:40:00.000Z',service:'Digital Marketing'},
    {id:'seed_5',name:'Tanvir Ahmed',stars:5,text:'Application UI and authentication flow were clean, fast and secure.',createdAt:'2026-02-09T11:05:00.000Z',service:'App Development'}
  ];
  const $=id=>document.getElementById(id),labels=['','Needs improvement','Fair','Good','Very good','Excellent'];
  let reviews=seed,selected=0,turnstileToken='',widgetId=null,lastFocus=null;
  const esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const stars=n=>Array.from({length:5},(_,i)=>i<n?'★':'☆').join('');
  const unique=list=>Array.from(new Map(list.filter(Boolean).map(r=>[r.id,r])).values()).sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt));
  const stats=list=>{const counts=[0,0,0,0,0,0];let points=0;list.forEach(r=>{const n=Math.max(1,Math.min(5,Number(r.stars)||1));counts[n]++;points+=n});return{counts,total:list.length,avg:list.length?points/list.length:0}};
  function card(r){const date=r.createdAt?new Date(r.createdAt).toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'}):'';return `<article class="review-item"><div class="review-top"><div class="avatar" aria-hidden="true">${esc((r.name||'G').trim().charAt(0).toUpperCase())}</div><div><div class="review-name">${esc(r.name||'Guest Client')}</div><div class="review-meta">${esc(date)}</div></div></div><div class="review-stars" aria-label="${Number(r.stars)||0} out of 5 stars">${stars(Number(r.stars)||0)}</div><div class="review-body">${esc(r.text||'')}</div><div class="review-foot"><span class="review-service">${esc(r.service||'Creavix Service')}</span><span class="review-public">Published</span></div></article>`}
  function render(){const s=stats(reviews);$('avg-score').textContent=s.avg.toFixed(1);$('avg-stars').textContent=stars(Math.round(s.avg));$('rating-count').textContent=`${s.total} published ${s.total===1?'rating':'ratings'}`;$('rating-bars').innerHTML=[5,4,3,2,1].map(n=>{const p=s.total?Math.round(s.counts[n]/s.total*100):0;return `<div class="bar-row"><span class="bar-label">${n}★</span><div class="bar-track"><div class="bar-fill" style="width:${p}%"></div></div><span>${p}%</span></div>`}).join('');$('reviews-list').innerHTML=reviews.slice(0,3).map(card).join('');$('modal-body').innerHTML=reviews.map(card).join('');$('btn-see-more').hidden=reviews.length<=3;$('btn-see-more').firstChild.textContent=`View all ${reviews.length} reviews `}
  function setStars(n){selected=n;document.querySelectorAll('.star-btn').forEach(btn=>{const value=Number(btn.dataset.star),on=value<=n;btn.classList.toggle('on',on);btn.setAttribute('aria-checked',String(value===n));btn.tabIndex=value===(n||1)?0:-1});$('star-label').textContent=n?`${n} out of 5 · ${labels[n]}`:'Choose 1–5 stars'}
  function message(text,error=false){const el=$('form-msg');el.hidden=false;el.className='form-msg'+(error?' err':'');el.textContent=text}
  function visitorId(){try{let id=localStorage.getItem('creavix_visitor_id');if(!id){id=crypto.randomUUID?.()||Date.now().toString(36)+Math.random().toString(36).slice(2);localStorage.setItem('creavix_visitor_id',id)}return id}catch{return''}}
  function openModal(){lastFocus=document.activeElement;$('reviews-modal').classList.add('is-open');$('reviews-modal').setAttribute('aria-hidden','false');document.body.style.overflow='hidden';$('modal-close').focus()}
  function closeModal(){if(!$('reviews-modal').classList.contains('is-open'))return;$('reviews-modal').classList.remove('is-open');$('reviews-modal').setAttribute('aria-hidden','true');document.body.style.overflow='';lastFocus?.focus?.()}
  async function loadReviews(){try{const response=await fetch('/api/reviews',{headers:{Accept:'application/json'}});if(!response.ok)return;const data=await response.json();if(data.ok&&Array.isArray(data.reviews))reviews=unique(data.reviews)}catch{}render()}
  function loadTurnstile(key){if(!key||key.startsWith('1x000000'))return;$('review-protection-note').textContent='Cloudflare human-check · moderated before publishing';$('turnstile-wrap').hidden=false;const script=document.createElement('script');script.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';script.async=true;script.onload=()=>{widgetId=turnstile.render('#turnstile-widget',{sitekey:key,theme:'light',size:'flexible',appearance:'interaction-only',callback:t=>turnstileToken=t,'expired-callback':()=>turnstileToken=''})};document.head.appendChild(script)}
  async function boot(){render();loadReviews();try{const cfg=await fetch('/config.json').then(r=>r.ok?r.json():{});loadTurnstile(cfg.turnstileSiteKey)}catch{}
    $('star-picker').addEventListener('click',e=>{const b=e.target.closest('.star-btn');if(b)setStars(Number(b.dataset.star))});$('star-picker').addEventListener('keydown',e=>{if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(e.key))return;e.preventDefault();const next=Math.max(1,Math.min(5,(selected||1)+(['ArrowRight','ArrowUp'].includes(e.key)?1:-1)));setStars(next);document.querySelector(`[data-star="${next}"]`)?.focus()});
    $('btn-see-more').addEventListener('click',openModal);$('modal-close').addEventListener('click',closeModal);$('modal-backdrop').addEventListener('click',closeModal);document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();if(e.key==='Tab'&&$('reviews-modal').classList.contains('is-open')){const focusable=[...$('reviews-modal').querySelectorAll('button,[href],input,select,textarea,[tabindex]:not([tabindex="-1"])')].filter(el=>!el.disabled);if(!focusable.length)return;const first=focusable[0],last=focusable.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}});
    $('review-form').addEventListener('submit',async e=>{e.preventDefault();if($('review-company').value)return;const name=$('review-name').value.trim(),text=$('review-text').value.trim();if(!selected)return message('Please choose a star rating.',true);if(name.length>60)return message('Please use a shorter name.',true);if(text.length<10)return message('Please write at least 10 characters.',true);const button=$('btn-submit-review');button.disabled=true;button.textContent='Submitting…';try{const response=await fetch('/api/reviews',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,text,stars:selected,service:$('review-service').value,company:$('review-company').value,visitorId:visitorId(),turnstileToken})});const data=await response.json();if(!response.ok||!data.ok)throw new Error(data.error||'Review could not be submitted.');e.target.reset();setStars(0);message('Thank you. Your review is saved and awaiting moderation.');turnstileToken='';if(window.turnstile&&widgetId!==null)turnstile.reset(widgetId)}catch(error){message(error.message||'Review could not be submitted. Please try again.',true)}finally{button.disabled=false;button.innerHTML='Submit for review <span aria-hidden="true">→</span>'}})
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>
