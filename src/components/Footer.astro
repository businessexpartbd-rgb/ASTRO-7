---
import { SITE } from '../data/site';
import SocialIcons from './SocialIcons.astro';
import SiteChrome from './SiteChrome.astro';
---
<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo footer-logo">
        <img src="/logo.png" alt={SITE.brand} class="logo-img" width="36" height="36" />
        Creavix <span>iT</span> Solution
      </a>
      <p class="footer-desc">{SITE.shortDesc}</p>
      <div style="margin-top:1rem">
        <SocialIcons size="md" />
      </div>
    </div>
    <div class="footer-col">
      <h4>Services</h4>
      <ul>
        <li><a href="/services/video-editing">Video Editing</a></li>
        <li><a href="/services/ai-video-marketing">AI Video Marketing</a></li>
        <li><a href="/services/web-development">Web Development</a></li>
        <li><a href="/services/application-build">Application Build</a></li>
        <li><a href="/services/campaign">Campaign</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Company</h4>
      <ul>
        <li><a href="/about">About Us</a></li>
        <li><a href="/#portfolio">Portfolio</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/#reviews">Reviews</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Contact</h4>
      <ul>
        <li><a href={`tel:${SITE.hotline.replace(/\s/g, '')}`}>{SITE.hotline}</a></li>
        <li><a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">WhatsApp {SITE.whatsapp}</a></li>
        <li><a href={`mailto:${SITE.email1}`}>{SITE.email1}</a></li>
        <li><a href={`mailto:${SITE.email2}`}>{SITE.email2}</a></li>
        <li><span style="color:var(--text-3);font-size:.85rem">{SITE.address}</span></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div>© {new Date().getFullYear()} {SITE.brand}. All rights reserved.</div>
    <div class="footer-links">
      <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a href={`mailto:${SITE.email1}`}>{SITE.email1}</a>
    </div>
  </div>
</footer>
<SiteChrome />
