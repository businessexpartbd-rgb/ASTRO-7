---
/** Comprehensive 4-column footer — Creavix IT Solution */
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="f-brand">
      <a href="/" class="f-logo">
        <img src="/logo.png" alt="" width="36" height="36" />
        <span>Creavix <em>IT Solution</em></span>
      </a>
      <p class="f-bio">
        Creavix IT Solution delivers 360° digital marketing and software solutions — SEO, social, web development and branding that drive measurable growth.
      </p>
      <div class="f-social" aria-label="Social media">
        <a href="#" aria-label="Facebook">f</a>
        <a href="#" aria-label="Instagram">ig</a>
        <a href="#" aria-label="LinkedIn">in</a>
        <a href="#" aria-label="YouTube">yt</a>
        <a href="#" aria-label="X">x</a>
      </div>
    </div>

    <div class="f-col">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/#blog">Blog</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>

    <div class="f-col">
      <h4>Our Services</h4>
      <ul>
        <li><a href="/services/seo">SEO</a></li>
        <li><a href="/services/web-development">Web Dev</a></li>
        <li><a href="/services/digital-marketing">Digital Marketing</a></li>
        <li><a href="/services/application-build">UI/UX &amp; Branding</a></li>
      </ul>
    </div>

    <div class="f-col">
      <h4>Contact Info</h4>
      <ul class="f-contact">
        <li>Address placeholder, City, Country</li>
        <li><a href="tel:+8800000000000">+880 0000-000000</a></li>
        <li><a href="mailto:info@creavixit.com">info@creavixit.com</a></li>
      </ul>
      <form class="f-news" action="/contact" method="get">
        <label class="sr-only" for="newsletter-email">Email</label>
        <input id="newsletter-email" type="email" name="email" placeholder="Your email" required />
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </div>

  <div class="container f-bottom">
    <p>Copyright © 2026 Creavix IT Solution. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #0B0F19;
    color: #94A3B8;
    padding: 3.5rem 0 1.5rem;
    font-family: var(--font-b);
  }
  .footer-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 640px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 960px) {
    .footer-grid { grid-template-columns: 1.5fr 1fr 1fr 1.2fr; gap: 1.75rem; }
  }
  .f-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1rem;
    color: #fff;
  }
  .f-logo img { border-radius: 8px; }
  .f-logo span {
    font-family: var(--font-h);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .f-logo em { font-style: normal; color: #60A5FA; }
  .f-bio {
    font-size: 0.9rem;
    line-height: 1.65;
    max-width: 280px;
    margin: 0 0 1.15rem;
  }
  .f-social { display: flex; gap: 0.45rem; }
  .f-social a {
    width: 32px; height: 32px; border-radius: 50%;
    background: rgba(255,255,255,.08);
    display: grid; place-items: center;
    font-size: 0.7rem; font-weight: 700; color: #E2E8F0;
  }
  .f-social a:hover { background: #2563EB; color: #fff; }
  .f-col h4 {
    font-family: var(--font-h);
    font-size: 0.88rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 1rem;
    letter-spacing: 0.02em;
  }
  .f-col ul { list-style: none; display: grid; gap: 0.55rem; }
  .f-col a {
    font-size: 0.9rem;
    color: #94A3B8;
  }
  .f-col a:hover { color: #fff; }
  .f-contact li { font-size: 0.9rem; line-height: 1.5; }
  .f-news {
    display: flex;
    gap: 0.4rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }
  .f-news input {
    flex: 1;
    min-width: 140px;
    padding: 0.65rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(148,163,184,.25);
    background: rgba(255,255,255,.06);
    color: #fff;
    font-family: var(--font-b);
    font-size: 0.88rem;
  }
  .f-news input::placeholder { color: #64748B; }
  .f-news button {
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    border: none;
    background: #2563EB;
    color: #fff;
    font-family: var(--font-h);
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .f-news button:hover { background: #1D4ED8; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); border: 0;
  }
  .f-bottom {
    margin-top: 2.5rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(148,163,184,.15);
  }
  .f-bottom p {
    margin: 0;
    font-size: 0.82rem;
    color: #64748B;
  }
</style>
