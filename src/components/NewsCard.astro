---
import type { NewsItem } from '../data/news';
interface Props { item: NewsItem; compact?: boolean; }
const { item, compact = false } = Astro.props;
const date = new Intl.DateTimeFormat('bn-BD',{day:'numeric',month:'long',year:'numeric', timeZone:'Asia/Dhaka'}).format(new Date(item.publishedAt));
---
<article class:list={['news-card', compact && 'compact']} data-search={`${item.title} ${item.titleEn} ${item.category} ${item.district}`.toLowerCase()} data-category={item.category}>
  <a href={`/news/${item.slug}/`} class="card-image"><img src={item.image} alt={item.title} width="800" height="534" loading="lazy" decoding="async" /></a>
  <div class="card-content"><div class="card-meta"><span>{item.category}</span><span>{item.district}</span></div><h3><a href={`/news/${item.slug}/`} data-bn={item.title} data-en={item.titleEn}>{item.title}</a></h3>{!compact && <p data-bn={item.excerpt} data-en={item.excerptEn}>{item.excerpt}</p>}<time datetime={item.publishedAt}>{date}</time></div>
</article>
