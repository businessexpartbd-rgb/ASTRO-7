---
/**
 * Realistic open book — continuous 3D page fold (no reset),
 * main video moments always playing (muted, ~2x feel),
 * soft white pages + corner curl, angled view, AI blue electric glow.
 */
import { SHOWCASES, ytThumb } from '../data/site';

const longIds = [
  ...SHOWCASES.find((s) => s.id === 'cinematic')!.ids.slice(0, 4),
  ...SHOWCASES.find((s) => s.id === 'custom')!.ids.slice(0, 2),
];

const starts = [3, 10, 6, 14, 5, 12];

const pages = longIds.map((id, i) => ({
  id,
  thumb: ytThumb(id),
  start: starts[i % starts.length],
  label: i % 2 === 0 ? 'Cinematic' : 'Brand Film',
}));
---

<div class="bk" data-book role="img" aria-label="Creavix cinematic video book showcase">
  <!-- AI electric aura -->
  <div class="bk-aura" aria-hidden="true">
    <span class="bk-ring bk-ring-1"></span>
    <span class="bk-ring bk-ring-2"></span>
    <span class="bk-ring bk-ring-3"></span>
    <span class="bk-bolt bk-bolt-a"></span>
    <span class="bk-bolt bk-bolt-b"></span>
  </div>

  <div class="bk-shadow" aria-hidden="true"></div>

  <div class="bk-angled">
    <div class="bk-open">
      <!-- Fixed left leaf -->
      <div class="bk-left">
        <div class="bk-left-paper">
          <div class="bk-left-media" data-left-media>
            <img data-left-thumb src={pages[pages.length - 1].thumb} alt="" width="480" height="270" decoding="async" />
            <div data-left-slot class="bk-slot"></div>
          </div>
          <div class="bk-left-caption">
            <strong>Creavix</strong>
            <span>AI · Video · IT</span>
          </div>
        </div>
        <div class="bk-spine"></div>
      </div>

      <!-- Right flipping stack -->
      <div class="bk-right" data-stack>
        {pages.map((p, i) => (
          <article
            class:list={['bk-page', i === 0 && 'is-front']}
            data-page
            data-yt={p.id}
            data-start={String(p.start)}
            data-thumb={p.thumb}
            style={`z-index:${pages.length - i}`}
          >
            <div class="bk-face">
              <div class="bk-media">
                <img class="bk-thumb" src={p.thumb} alt="" width="640" height="360" decoding="async" loading={i < 2 ? 'eager' : 'lazy'} />
                <div class="bk-slot" data-slot></div>
                <!-- paper corner curl -->
                <span class="bk-curl" aria-hidden="true"></span>
              </div>
              <div class="bk-bar">
                <span class="bk-label">{p.label}</span>
                <span class="bk-live"><i></i> Live</span>
              </div>
            </div>
            <div class="bk-back" aria-hidden="true">
              <div class="bk-back-lines"></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <div class="bk-pills" aria-hidden="true">
    <span>Video Editing</span>
    <span>AI Video</span>
    <span>Web &amp; App</span>
  </div>
</div>

<style>
  .bk {
    --w: min(100%, 460px);
    position: relative;
    width: var(--w);
    margin: 0 auto;
    padding: 1.25rem 0.5rem 1.4rem;
  }

  /* —— AI blue electric aura —— */
  .bk-aura {
    position: absolute;
    inset: -8% -6%;
    pointer-events: none;
    z-index: 0;
  }
  .bk-ring {
    position: absolute;
    inset: 10%;
    border-radius: 28px;
    border: 1.5px solid rgba(59, 130, 246, 0.35);
    box-shadow:
      0 0 24px rgba(59, 130, 246, 0.25),
      inset 0 0 24px rgba(96, 165, 250, 0.12);
    animation: bk-pulse 3.2s ease-in-out infinite;
  }
  .bk-ring-2 {
    inset: 4%;
    border-radius: 34px;
    border-color: rgba(37, 99, 235, 0.22);
    animation-delay: 0.6s;
  }
  .bk-ring-3 {
    inset: -2%;
    border-radius: 40px;
    border-color: rgba(147, 197, 253, 0.18);
    animation-delay: 1.2s;
  }
  @keyframes bk-pulse {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.02); }
  }
  .bk-bolt {
    position: absolute;
    width: 2px;
    height: 28%;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(147, 197, 253, 0.95),
      rgba(37, 99, 235, 0.8),
      transparent
    );
    filter: blur(0.5px);
    opacity: 0;
    animation: bk-zap 2.8s ease-in-out infinite;
  }
  .bk-bolt-a { top: 8%; right: 6%; animation-delay: 0.2s; }
  .bk-bolt-b { bottom: 12%; left: 8%; height: 22%; animation-delay: 1.4s; }
  @keyframes bk-zap {
    0%, 70%, 100% { opacity: 0; transform: scaleY(0.4); }
    75% { opacity: 1; transform: scaleY(1); }
    82% { opacity: 0.3; }
    88% { opacity: 0.9; }
  }

  .bk-shadow {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 0.2rem;
    height: 20px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(15, 23, 42, 0.28), transparent 72%);
    filter: blur(5px);
    z-index: 0;
  }

  /* Angled book stage */
  .bk-angled {
    position: relative;
    z-index: 1;
    perspective: 1600px;
    perspective-origin: 50% 40%;
  }

  .bk-open {
    display: grid;
    grid-template-columns: 0.42fr 0.58fr;
    transform-style: preserve-3d;
    transform: rotateX(10deg) rotateY(-14deg) rotateZ(-1deg);
    transition: transform 0.4s ease;
  }

  /* Left fixed page */
  .bk-left {
    position: relative;
    transform-style: preserve-3d;
  }
  .bk-left-paper {
    height: 100%;
    min-height: 100%;
    background: #fff;
    border-radius: 14px 0 0 14px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-right: none;
    box-shadow:
      -8px 12px 32px rgba(15, 23, 42, 0.1),
      inset 0 1px 0 #fff;
    padding: 0.5rem 0.45rem 0.45rem 0.5rem;
    display: flex;
    flex-direction: column;
  }
  .bk-left-media {
    position: relative;
    flex: 1;
    min-height: 120px;
    border-radius: 10px;
    overflow: hidden;
    background: #0f172a;
  }
  .bk-left-media img,
  .bk-left-media .bk-slot,
  .bk-left-media iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .bk-left-media iframe {
    pointer-events: none;
    transform: scale(1.12);
  }
  .bk-left-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.35rem;
    padding: 0 0.15rem;
  }
  .bk-left-caption strong {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #0f172a;
  }
  .bk-left-caption span {
    font-size: 0.58rem;
    font-weight: 600;
    color: #64748b;
  }
  .bk-spine {
    position: absolute;
    right: -3px;
    top: 2%;
    bottom: 2%;
    width: 6px;
    background: linear-gradient(90deg, rgba(15, 23, 42, 0.12), rgba(15, 23, 42, 0.02));
    border-radius: 2px;
    z-index: 5;
  }

  /* Right stack */
  .bk-right {
    position: relative;
    aspect-ratio: 16 / 12;
    transform-style: preserve-3d;
  }

  .bk-page {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform-style: preserve-3d;
    border-radius: 0 14px 14px 0;
    transition: transform 0.75s cubic-bezier(0.33, 0.1, 0.2, 1);
    will-change: transform;
  }

  .bk-face,
  .bk-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 0 14px 14px 0;
  }

  .bk-face {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-left: 1px solid rgba(15, 23, 42, 0.04);
    box-shadow:
      10px 14px 36px rgba(15, 23, 42, 0.12),
      2px 0 0 rgba(255, 255, 255, 0.9) inset;
    padding: 0.5rem 0.5rem 0.4rem;
    display: flex;
    flex-direction: column;
  }

  .bk-back {
    background:
      linear-gradient(105deg, #e8eef5 0%, #f8fafc 22%, #ffffff 100%);
    transform: rotateY(180deg);
    border: 1px solid rgba(15, 23, 42, 0.06);
    box-shadow: inset 8px 0 20px rgba(15, 23, 42, 0.05);
  }
  .bk-back-lines {
    position: absolute;
    inset: 12% 14%;
    background: repeating-linear-gradient(
      180deg,
      transparent 0 14px,
      rgba(148, 163, 184, 0.2) 14px 15px
    );
    border-radius: 4px;
    opacity: 0.5;
  }

  .bk-media {
    position: relative;
    flex: 1;
    min-height: 0;
    border-radius: 10px;
    overflow: hidden;
    background: #020617;
  }
  .bk-thumb,
  .bk-slot,
  .bk-media iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .bk-thumb { object-fit: cover; z-index: 1; }
  .bk-slot { z-index: 2; }
  .bk-media iframe {
    pointer-events: none;
    transform: scale(1.14);
    transform-origin: center;
  }

  /* Corner fold cue */
  .bk-curl {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 36px;
    height: 36px;
    z-index: 4;
    background: linear-gradient(
      225deg,
      transparent 48%,
      rgba(15, 23, 42, 0.06) 48%,
      rgba(255, 255, 255, 0.95) 52%,
      #f1f5f9 100%
    );
    box-shadow: -2px -2px 6px rgba(15, 23, 42, 0.08);
    border-radius: 0 0 10px 0;
    pointer-events: none;
  }

  .bk-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.35rem;
    padding: 0 0.1rem;
  }
  .bk-label {
    font-size: 0.68rem;
    font-weight: 700;
    color: #334155;
  }
  .bk-live {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-size: 0.58rem;
    font-weight: 700;
    color: #2563eb;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .bk-live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25);
    animation: bk-blink 1.4s ease infinite;
  }
  @keyframes bk-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  /* Flip states */
  .bk-page.is-folding {
    transform: rotateY(-165deg);
    z-index: 50 !important;
  }
  .bk-page.is-front {
    z-index: 40 !important;
  }

  .bk-pills {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
    margin-top: 1rem;
  }
  .bk-pills span {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    background: #fff;
    color: #0f172a;
    border: 1px solid rgba(37, 99, 235, 0.12);
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.08);
  }

  @media (max-width: 767px) {
    .bk { --w: min(100%, 380px); padding: 1rem 0.25rem 1.1rem; }
    .bk-open {
      transform: rotateX(8deg) rotateY(-8deg);
      grid-template-columns: 0.36fr 0.64fr;
    }
    .bk-left-paper { border-radius: 12px 0 0 12px; padding: 0.4rem; }
    .bk-face { padding: 0.4rem; border-radius: 0 12px 12px 0; }
    .bk-page { transition-duration: 0.65s; }
    .bk-curl { width: 28px; height: 28px; }
    .bk-ring { border-radius: 22px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bk-ring, .bk-bolt, .bk-live i { animation: none !important; }
    .bk-page { transition: none !important; }
  }
</style>

<script is:inline>
(function () {
  var root = document.querySelector('[data-book]');
  if (!root) return;

  var stack = root.querySelector('[data-stack]');
  if (!stack) return;

  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var visible = true;
  var busy = false;
  var timer = null;
  var HOLD = 1200;   /* visible time before next fold */
  var FOLD = 780;    /* fold animation ms */

  var leftSlot = root.querySelector('[data-left-slot]');
  var leftThumb = root.querySelector('[data-left-thumb]');

  function ytSrc(id, start) {
    var s = parseInt(start, 10) || 4;
    /* Short main-moment window; loop playlist keeps it moving (2x-feel via quick cuts) */
    var e = s + 6;
    return (
      'https://www.youtube-nocookie.com/embed/' + id +
      '?autoplay=1&mute=1&controls=0&rel=0&modestbranding=1&playsinline=1' +
      '&iv_load_policy=3&disablekb=1&fs=0&start=' + s + '&end=' + e +
      '&loop=1&playlist=' + id
    );
  }

  function mount(slot, id, start) {
    if (!slot || !id) return;
    slot.innerHTML =
      '<iframe title="" src="' + ytSrc(id, start) + '" allow="autoplay; encrypted-media" ' +
      'referrerpolicy="strict-origin-when-cross-origin" tabindex="-1"></iframe>';
  }

  function clearSlot(slot) {
    if (slot) slot.innerHTML = '';
  }

  function frontPage() {
    return stack.querySelector('.bk-page.is-front') || stack.querySelector('.bk-page');
  }

  function ensureFrontPlaying() {
    if (reduced || !visible) return;
    var front = frontPage();
    if (!front) return;
    var slot = front.querySelector('[data-slot]');
    var id = front.getAttribute('data-yt');
    var start = front.getAttribute('data-start') || '4';
    /* Only inject if empty — keep continuous play */
    if (slot && !slot.querySelector('iframe')) {
      mount(slot, id, start);
    }
  }

  function playUnderPeek() {
    /* Second page under the front also runs so fold reveals motion */
    if (reduced || !visible) return;
    var pages = stack.querySelectorAll('.bk-page');
    if (pages.length < 2) return;
    var under = pages[1];
    var slot = under.querySelector('[data-slot]');
    if (slot && !slot.querySelector('iframe')) {
      mount(slot, under.getAttribute('data-yt'), under.getAttribute('data-start') || '5');
    }
  }

  function syncLeftFrom(page) {
    if (!page) return;
    var id = page.getAttribute('data-yt');
    var start = page.getAttribute('data-start') || '4';
    var thumb = page.getAttribute('data-thumb');
    if (leftThumb && thumb) leftThumb.src = thumb;
    if (leftSlot) {
      /* Keep left leaf alive with same clip — continuous feel */
      mount(leftSlot, id, start);
    }
  }

  function foldOnce() {
    if (!visible || reduced || busy) return;
    var front = frontPage();
    if (!front) return;

    busy = true;
    playUnderPeek();

    front.classList.remove('is-front');
    front.classList.add('is-folding');

    setTimeout(function () {
      /* Move folded page to end of stack — infinite, no hard reset */
      var slot = front.querySelector('[data-slot]');
      clearSlot(slot);

      front.classList.remove('is-folding');
      /* Instantly flatten without transition */
      front.style.transition = 'none';
      front.style.transform = 'rotateY(0deg)';

      stack.appendChild(front);

      /* Re-stack z-index */
      var all = stack.querySelectorAll('.bk-page');
      all.forEach(function (p, i) {
        p.style.zIndex = String(all.length - i);
        p.classList.remove('is-front');
      });

      var newFront = all[0];
      if (newFront) {
        newFront.classList.add('is-front');
        /* Force reflow then restore transition */
        void front.offsetWidth;
        front.style.transition = '';
        front.style.transform = '';

        ensureFrontPlaying();
        playUnderPeek();
        /* Left page shows the page we just turned */
        syncLeftFrom(front);
      }

      busy = false;
      schedule();
    }, FOLD);
  }

  function schedule() {
    if (timer) clearTimeout(timer);
    if (!visible || reduced) return;
    timer = setTimeout(foldOnce, HOLD);
  }

  function start() {
    if (reduced) {
      var f = frontPage();
      if (f) f.classList.add('is-front');
      return;
    }
    /* Bootstrap continuous playback */
    var all = stack.querySelectorAll('.bk-page');
    all.forEach(function (p, i) {
      p.classList.toggle('is-front', i === 0);
      p.style.zIndex = String(all.length - i);
    });
    ensureFrontPlaying();
    playUnderPeek();
    var last = all[all.length - 1];
    if (last) syncLeftFrom(last);
    schedule();
  }

  function stop() {
    if (timer) clearTimeout(timer);
    timer = null;
    busy = false;
    stack.querySelectorAll('[data-slot]').forEach(clearSlot);
    clearSlot(leftSlot);
  }

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        visible = e.isIntersecting;
        if (visible) start();
        else stop();
      });
    }, { threshold: 0.12 });
    io.observe(root);
  } else {
    start();
  }

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stop();
    else if (visible) start();
  });
})();
</script>
