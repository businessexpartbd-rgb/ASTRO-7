---
/**
 * AI-first hero visual for Creavix IT Solution.
 * The experience is intentionally cinematic—not an editing-software dashboard.
 */
const shots = [
  {
    src: '/media/hero-studio-bangladesh.webp',
    small: '/media/hero-studio-bangladesh-480.webp',
    alt: 'Creavix AI video marketing concept with a human creative director',
  },
  {
    src: '/media/hero-ai-product.webp',
    small: '/media/hero-ai-product-480.webp',
    alt: '',
  },
];
---

<div class="ai-hero-visual" data-ai-hero-visual aria-label="Creavix prompt-to-campaign AI video generation experience">
  <div class="ai-ambient" aria-hidden="true">
    <i></i><i></i><i></i>
  </div>

  <div class="ai-orbit orbit-one" aria-hidden="true"></div>
  <div class="ai-orbit orbit-two" aria-hidden="true"></div>

  <div class="engine-label">
    <img src="/media/creavix-original-logo-56.webp" alt="" width="28" height="28" loading="eager" decoding="async" fetchpriority="high" />
    <span><b>CREAVIX</b> GENERATIVE FILM ENGINE</span>
    <i aria-hidden="true"></i>
  </div>

  <div class="prompt-signal">
    <span class="prompt-mark" aria-hidden="true">✦</span>
    <span class="prompt-copy">
      <small>CREATIVE PROMPT</small>
      <b>Create a cinematic brand story<br />with natural human emotion…</b>
    </span>
    <span class="prompt-caret" aria-hidden="true"></span>
  </div>

  <div class="cinema-canvas">
    <div class="scene-reel" aria-hidden="true">
      {shots.map((shot, index) => (
        <img
          class:list={['scene-shot', `scene-shot-${index + 1}`]}
          src={shot.src}
          srcset={`${shot.small} 480w, ${shot.src} 960w`}
          sizes="(max-width: 899px) 360px, 520px"
          alt={shot.alt}
          width="960"
          height="540"
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={index === 0 ? 'high' : 'low'}
        />
      ))}
    </div>

    <div class="cinema-grade" aria-hidden="true"></div>
    <div class="generation-sweep" aria-hidden="true"></div>
    <div class="neural-field" aria-hidden="true">
      <i></i><i></i><i></i><i></i><i></i><i></i>
    </div>

    <div class="canvas-topline">
      <div class="generation-state">
        <i aria-hidden="true"></i>
        <span class="state-cycle">
          <b>UNDERSTANDING PROMPT</b>
          <b>GENERATING WORLD</b>
          <b>CAMPAIGN READY</b>
        </span>
      </div>
      <span class="master-quality">4K · HUMAN-GUIDED</span>
    </div>

    <div class="ai-core" aria-hidden="true">
      <span class="core-ring core-ring-a"></span>
      <span class="core-ring core-ring-b"></span>
      <span class="core-ring core-ring-c"></span>
      <strong>AI</strong>
      <small>VIDEO<br />INTELLIGENCE</small>
    </div>

    <div class="story-copy">
      <span>FROM ONE IDEA</span>
      <strong>AI films built<br />to move people.</strong>
      <div class="story-flow" aria-label="Prompt to AI film to campaign">
        <b>Prompt</b><i></i><b>AI Film</b><i></i><b>Growth</b>
      </div>
    </div>

    <div class="format-fan" aria-label="Campaign video formats: vertical, square and widescreen">
      <span class="format-card vertical"><i></i><b>9:16</b></span>
      <span class="format-card square"><i></i><b>1:1</b></span>
      <span class="format-card wide"><i></i><b>16:9</b></span>
    </div>

    <div class="signal-rail" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span><i></i>
    </div>
  </div>

  <div class="capability-pill pill-identity">
    <span aria-hidden="true">◎</span>
    <div><small>VISUAL TRUST</small><b>Identity Consistent</b></div>
  </div>
  <div class="capability-pill pill-motion">
    <span aria-hidden="true">↗</span>
    <div><small>REAL-WORLD FEEL</small><b>Natural Motion + Audio</b></div>
  </div>
  <div class="capability-pill pill-scale">
    <span aria-hidden="true">◈</span>
    <div><small>GLOBAL SCALE</small><b>One Idea · Every Screen</b></div>
  </div>

  <div class="future-chip" aria-label="Future-ready AI storytelling">
    <span aria-hidden="true">✦</span>
    <b>Future-ready AI storytelling</b>
  </div>
</div>

<style>
  .ai-hero-visual {
    --orange: #f97316;
    --orange-bright: #fb923c;
    --blue: #2563eb;
    --cyan: #22d3ee;
    --purple: #7c3aed;
    --ink: #07101f;
    position: relative;
    width: min(100%, 570px);
    aspect-ratio: 1.06 / 1;
    margin: 0 auto;
    isolation: isolate;
    font-family: 'Hind Siliguri';
    contain: layout paint;
  }

  .ai-ambient { position: absolute; inset: 3% -7% -5%; z-index: -3; filter: blur(34px); opacity: .72; }
  .ai-ambient i { position: absolute; border-radius: 50%; animation: ambientDrift 8s ease-in-out infinite alternate; }
  .ai-ambient i:nth-child(1) { width: 48%; aspect-ratio: 1; left: 2%; top: 5%; background: rgba(249,115,22,.25); }
  .ai-ambient i:nth-child(2) { width: 58%; aspect-ratio: 1; right: -2%; top: 13%; background: rgba(37,99,235,.28); animation-delay: -2.7s; }
  .ai-ambient i:nth-child(3) { width: 44%; aspect-ratio: 1; left: 30%; bottom: 0; background: rgba(124,58,237,.22); animation-delay: -5.2s; }

  .ai-orbit { position: absolute; z-index: -1; border: 1px solid rgba(37,99,235,.14); border-radius: 50%; pointer-events: none; }
  .ai-orbit::after { content: ''; position: absolute; width: 8px; height: 8px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 0 6px rgba(34,211,238,.11), 0 0 20px rgba(34,211,238,.65); }
  .orbit-one { inset: 7% 1% 8% 2%; transform: rotate(-9deg); animation: orbitTurn 20s linear infinite; }
  .orbit-one::after { left: 12%; top: 8%; }
  .orbit-two { inset: 15% 8% 2% 8%; transform: rotate(17deg); animation: orbitTurnReverse 26s linear infinite; }
  .orbit-two::after { right: 8%; bottom: 16%; background: var(--orange-bright); box-shadow: 0 0 0 6px rgba(251,146,60,.12), 0 0 20px rgba(249,115,22,.65); }

  .engine-label {
    position: absolute; z-index: 8; left: 2%; top: 4%; display: flex; align-items: center; gap: .48rem;
    padding: .4rem .65rem .4rem .45rem; border: 1px solid rgba(255,255,255,.92); border-radius: 999px;
    background: rgba(255,255,255,.92); color: #475569; box-shadow: 0 12px 30px rgba(15,23,42,.12); backdrop-filter: blur(10px);
  }
  .engine-label img { width: 27px; height: 27px; object-fit: contain; }
  .engine-label span { font-size: .49rem; font-weight: 800; letter-spacing: .095em; white-space: nowrap; }
  .engine-label b { color: #0f172a; }
  .engine-label > i { width: 6px; height: 6px; margin-left: .05rem; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 5px rgba(34,197,94,.12); animation: livePulse 1.7s ease-in-out infinite; }

  .prompt-signal {
    position: absolute; z-index: 9; left: -3%; top: 18%; display: flex; align-items: center; gap: .56rem;
    min-width: 51%; padding: .62rem .85rem .62rem .65rem; border: 1px solid rgba(255,255,255,.92);
    border-radius: 20px 20px 20px 7px; background: rgba(255,255,255,.94); box-shadow: 0 17px 40px rgba(15,23,42,.16); backdrop-filter: blur(13px);
    animation: signalFloat 4s ease-in-out infinite alternate;
  }
  .prompt-mark { flex: 0 0 30px; width: 30px; height: 30px; display: grid; place-items: center; border-radius: 11px; color: #fff; font-size: .88rem; background: linear-gradient(135deg,var(--orange),var(--orange-bright)); box-shadow: 0 8px 18px rgba(249,115,22,.3); }
  .prompt-copy { display: grid; min-width: 0; line-height: 1.15; }
  .prompt-copy small { color: var(--orange); font-size: .42rem; font-weight: 900; letter-spacing: .1em; }
  .prompt-copy b { margin-top: .2rem; color: #1e293b; font-size: .57rem; font-weight: 700; }
  .prompt-caret { width: 2px; height: 22px; margin-left: auto; border-radius: 4px; background: var(--blue); animation: caretBlink .9s steps(1) infinite; }

  .cinema-canvas {
    position: absolute; z-index: 2; inset: 11% 4% 10% 7%; overflow: hidden;
    border: 1px solid rgba(255,255,255,.72); border-radius: 42px 86px 48px 104px / 48px 68px 76px 92px;
    background: var(--ink); box-shadow: 0 34px 80px rgba(15,23,42,.23), 0 12px 28px rgba(37,99,235,.12), inset 0 0 0 1px rgba(255,255,255,.08);
    transform: perspective(1200px) rotateY(-1.8deg) rotateX(.7deg); transform-origin: 52% 50%;
  }
  .scene-reel, .scene-shot { position: absolute; inset: 0; width: 100%; height: 100%; }
  .scene-shot { object-fit: cover; opacity: 0; filter: saturate(1.1) contrast(1.06); will-change: transform, opacity; }
  .scene-shot-1 { animation: sceneOne 12s ease-in-out infinite, cinematicMoveOne 7s ease-in-out infinite alternate; }
  .scene-shot-2 { animation: sceneTwo 12s ease-in-out infinite, cinematicMoveTwo 8s ease-in-out infinite alternate; }
  .cinema-grade { position: absolute; inset: 0; background: linear-gradient(90deg,rgba(3,7,18,.86) 0%,rgba(3,7,18,.38) 43%,rgba(3,7,18,.08) 69%,rgba(3,7,18,.44) 100%),linear-gradient(0deg,rgba(3,7,18,.83),transparent 54%); }
  .generation-sweep { position: absolute; inset: -25% auto -25% -34%; width: 28%; transform: skewX(-13deg); background: linear-gradient(90deg,transparent,rgba(125,211,252,.28),rgba(255,255,255,.16),transparent); animation: generationSweep 4.2s ease-in-out infinite; mix-blend-mode: screen; }

  .neural-field { position: absolute; inset: 0; pointer-events: none; opacity: .76; }
  .neural-field i { position: absolute; width: 4px; height: 4px; border-radius: 50%; background: #fff; box-shadow: 0 0 12px 3px rgba(96,165,250,.7); animation: neuralPulse 2.7s ease-in-out infinite alternate; }
  .neural-field i::after { content: ''; position: absolute; left: 2px; top: 2px; width: 78px; height: 1px; transform-origin: left; background: linear-gradient(90deg,rgba(125,211,252,.65),transparent); }
  .neural-field i:nth-child(1) { left: 18%; top: 34%; }
  .neural-field i:nth-child(1)::after { transform: rotate(18deg); }
  .neural-field i:nth-child(2) { left: 35%; top: 41%; animation-delay: -.5s; }
  .neural-field i:nth-child(2)::after { transform: rotate(-26deg); width: 92px; }
  .neural-field i:nth-child(3) { right: 31%; top: 29%; animation-delay: -1s; }
  .neural-field i:nth-child(3)::after { transform: rotate(75deg); width: 62px; }
  .neural-field i:nth-child(4) { right: 18%; top: 46%; animation-delay: -1.5s; }
  .neural-field i:nth-child(4)::after { transform: rotate(146deg); }
  .neural-field i:nth-child(5) { left: 27%; bottom: 29%; animation-delay: -2s; }
  .neural-field i:nth-child(5)::after { transform: rotate(-8deg); width: 110px; }
  .neural-field i:nth-child(6) { right: 27%; bottom: 24%; animation-delay: -2.4s; }
  .neural-field i:nth-child(6)::after { transform: rotate(-118deg); width: 66px; }

  .canvas-topline { position: absolute; z-index: 5; left: 6%; right: 7%; top: 6%; display: flex; align-items: center; justify-content: space-between; gap: .7rem; }
  .generation-state { display: flex; align-items: center; gap: .4rem; color: #fff; }
  .generation-state > i { width: 7px; height: 7px; border-radius: 50%; background: var(--orange-bright); box-shadow: 0 0 12px var(--orange); animation: livePulse 1.4s ease-in-out infinite; }
  .state-cycle { position: relative; display: block; width: 124px; height: .62rem; overflow: hidden; }
  .state-cycle b { position: absolute; inset: 0; opacity: 0; font-size: .46rem; letter-spacing: .11em; white-space: nowrap; animation: stateCycle 9s ease-in-out infinite; }
  .state-cycle b:nth-child(2) { animation-delay: 3s; }
  .state-cycle b:nth-child(3) { animation-delay: 6s; }
  .master-quality { color: #bfdbfe; font-size: .43rem; font-weight: 800; letter-spacing: .09em; }

  .ai-core { position: absolute; z-index: 4; right: 13%; top: 28%; width: 29%; aspect-ratio: 1; display: grid; place-items: center; animation: coreFloat 3.8s ease-in-out infinite alternate; }
  .ai-core strong { position: relative; z-index: 3; width: 48%; aspect-ratio: 1; display: grid; place-items: center; border-radius: 43% 57% 61% 39% / 46% 39% 61% 54%; color: #fff; font: 800 clamp(1rem,3vw,1.55rem)/1 'Li Ador Noirrit'; background: linear-gradient(135deg,var(--orange),#ec4899 42%,var(--purple) 68%,var(--blue)); box-shadow: 0 0 40px rgba(124,58,237,.58), inset 0 0 0 1px rgba(255,255,255,.36); animation: coreMorph 6s ease-in-out infinite alternate; }
  .ai-core small { position: absolute; z-index: 3; top: 74%; color: #e0e7ff; font-size: .35rem; font-weight: 900; line-height: 1.18; letter-spacing: .12em; text-align: center; }
  .core-ring { position: absolute; border: 1px solid rgba(165,243,252,.42); border-radius: 50%; }
  .core-ring-a { inset: 8%; animation: ringSpin 8s linear infinite; }
  .core-ring-b { inset: -5%; border-style: dashed; animation: ringSpinReverse 13s linear infinite; }
  .core-ring-c { inset: -18%; opacity: .42; animation: ringBreathe 2.6s ease-in-out infinite alternate; }
  .core-ring-a::after, .core-ring-b::after { content: ''; position: absolute; width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 14px var(--cyan); }
  .core-ring-a::after { right: 7%; top: 20%; }
  .core-ring-b::after { left: 5%; bottom: 24%; background: var(--orange-bright); box-shadow: 0 0 14px var(--orange); }

  .story-copy { position: absolute; z-index: 5; left: 7%; bottom: 11%; color: #fff; text-shadow: 0 4px 20px rgba(0,0,0,.6); }
  .story-copy > span { color: var(--orange-bright); font-size: .43rem; font-weight: 900; letter-spacing: .15em; }
  .story-copy > strong { display: block; margin-top: .28rem; font: 800 clamp(1.12rem,3.6vw,1.66rem)/.98 'Li Ador Noirrit'; letter-spacing: -.025em; }
  .story-flow { display: flex; align-items: center; gap: .28rem; margin-top: .55rem; text-shadow: none; }
  .story-flow b { color: #e2e8f0; font-size: .42rem; letter-spacing: .04em; }
  .story-flow b:nth-of-type(2) { color: #fdba74; }
  .story-flow i { width: 19px; height: 1px; background: linear-gradient(90deg,var(--orange-bright),var(--cyan)); position: relative; overflow: visible; }
  .story-flow i::after { content: ''; position: absolute; top: -2px; width: 5px; height: 5px; border-radius: 50%; background: #fff; box-shadow: 0 0 8px #fff; animation: flowDot 1.7s linear infinite; }

  .format-fan { position: absolute; z-index: 6; right: 6%; bottom: 8%; width: 31%; height: 24%; }
  .format-card { position: absolute; bottom: 0; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; padding: .24rem; border: 1px solid rgba(255,255,255,.55); border-radius: 7px; background: rgba(15,23,42,.74); box-shadow: 0 8px 20px rgba(0,0,0,.28); backdrop-filter: blur(5px); transform-origin: bottom center; animation: formatLift 3.2s ease-in-out infinite alternate; }
  .format-card i { position: absolute; inset: 3px; z-index: -1; border-radius: 5px; background: linear-gradient(145deg,rgba(249,115,22,.88),rgba(124,58,237,.84) 50%,rgba(37,99,235,.88)); opacity: .72; }
  .format-card b { color: #fff; font-size: .35rem; text-align: center; }
  .format-card.vertical { left: 2%; width: 25%; height: 76%; transform: rotate(-10deg); }
  .format-card.square { left: 29%; width: 34%; aspect-ratio: 1; transform: translateY(-5px); animation-delay: -.8s; }
  .format-card.wide { right: 0; width: 45%; height: 44%; transform: rotate(8deg); animation-delay: -1.6s; }

  .signal-rail { position: absolute; z-index: 4; left: 7%; right: 7%; bottom: 4%; height: 3px; display: flex; gap: 4px; }
  .signal-rail span { flex: 1; border-radius: 9px; background: rgba(255,255,255,.17); }
  .signal-rail span:nth-child(2), .signal-rail span:nth-child(3) { background: linear-gradient(90deg,var(--orange),#ec4899); }
  .signal-rail i { position: absolute; left: 0; top: -2px; width: 7px; height: 7px; border-radius: 50%; background: #fff; box-shadow: 0 0 11px #fff; animation: railTravel 6s linear infinite; }

  .capability-pill {
    position: absolute; z-index: 7; display: flex; align-items: center; gap: .45rem; padding: .44rem .64rem;
    border: 1px solid rgba(255,255,255,.9); border-radius: 15px; background: rgba(255,255,255,.93); color: #334155;
    box-shadow: 0 14px 32px rgba(15,23,42,.14); backdrop-filter: blur(10px); animation: pillFloat 4s ease-in-out infinite alternate;
  }
  .capability-pill > span { width: 26px; height: 26px; display: grid; place-items: center; flex: 0 0 26px; border-radius: 9px; color: #fff; font-size: .72rem; font-weight: 900; }
  .capability-pill div { display: grid; line-height: 1.05; }
  .capability-pill small { color: #94a3b8; font-size: .35rem; font-weight: 900; letter-spacing: .09em; }
  .capability-pill b { margin-top: .16rem; color: #1e293b; font-size: .5rem; white-space: nowrap; }
  .pill-identity { right: -2%; top: 18%; animation-delay: -.6s; }
  .pill-identity > span { background: linear-gradient(135deg,var(--purple),#ec4899); }
  .pill-motion { right: -3%; top: 48%; animation-delay: -2.1s; }
  .pill-motion > span { background: linear-gradient(135deg,var(--blue),var(--cyan)); }
  .pill-scale { left: -1%; bottom: 9%; animation-delay: -3.1s; }
  .pill-scale > span { background: linear-gradient(135deg,var(--orange),var(--orange-bright)); }

  .future-chip { position: absolute; z-index: 8; right: 6%; bottom: 1%; display: flex; align-items: center; gap: .35rem; color: #334155; font-size: .49rem; }
  .future-chip span { color: var(--purple); animation: starTwinkle 1.8s ease-in-out infinite; }

  .is-paused * { animation-play-state: paused !important; }

  @keyframes ambientDrift { to { transform: translate3d(4%,-4%,0) scale(1.08); opacity: .76; } }
  @keyframes orbitTurn { to { transform: rotate(351deg); } }
  @keyframes orbitTurnReverse { to { transform: rotate(-343deg); } }
  @keyframes livePulse { 50% { opacity: .35; transform: scale(.72); } }
  @keyframes signalFloat { to { transform: translate3d(4px,-7px,0); } }
  @keyframes caretBlink { 50% { opacity: 0; } }
  @keyframes sceneOne { 0%,42% { opacity: 1; } 51%,91% { opacity: 0; } 100% { opacity: 1; } }
  @keyframes sceneTwo { 0%,42% { opacity: 0; } 51%,91% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes cinematicMoveOne { from { transform: scale(1.02) translate3d(0,0,0); } to { transform: scale(1.11) translate3d(-2%,1%,0); } }
  @keyframes cinematicMoveTwo { from { transform: scale(1.08) translate3d(-1%,0,0); } to { transform: scale(1.02) translate3d(1%,-1%,0); } }
  @keyframes generationSweep { 0%,12% { transform: translateX(0) skewX(-13deg); opacity: 0; } 35% { opacity: 1; } 72%,100% { transform: translateX(590%) skewX(-13deg); opacity: 0; } }
  @keyframes neuralPulse { to { transform: scale(1.7); opacity: .34; } }
  @keyframes stateCycle { 0%,4% { opacity: 0; transform: translateY(7px); } 12%,27% { opacity: 1; transform: none; } 33%,100% { opacity: 0; transform: translateY(-7px); } }
  @keyframes coreFloat { to { transform: translate3d(0,-8px,0) rotate(1.5deg); } }
  @keyframes coreMorph { to { border-radius: 61% 39% 42% 58% / 38% 57% 43% 62%; filter: saturate(1.18); } }
  @keyframes ringSpin { to { transform: rotate(360deg); } }
  @keyframes ringSpinReverse { to { transform: rotate(-360deg); } }
  @keyframes ringBreathe { to { transform: scale(1.13); opacity: .16; } }
  @keyframes flowDot { from { left: 0; } to { left: calc(100% - 5px); } }
  @keyframes formatLift { to { translate: 0 -6px; filter: saturate(1.2); } }
  @keyframes railTravel { to { left: calc(100% - 7px); } }
  @keyframes pillFloat { to { transform: translate3d(5px,-8px,0); } }
  @keyframes starTwinkle { 50% { opacity: .38; transform: rotate(25deg) scale(.78); } }

  @media (max-width: 899px) {
    .ai-hero-visual { width: min(100%, 430px); aspect-ratio: 1.04 / 1; }
    .cinema-canvas { inset: 10% 3% 10% 5%; transform: none; border-radius: 34px 66px 40px 76px / 38px 54px 62px 70px; }
    .engine-label { left: 1%; top: 2%; }
    .prompt-signal { left: -1%; top: 16%; min-width: 53%; }
    .pill-identity { right: -1%; top: 18%; }
    .pill-motion { right: -1%; top: 49%; }
    .pill-scale { left: 0; bottom: 8%; }
    .future-chip { right: 4%; bottom: 0; }
  }

  @media (max-width: 520px) {
    .ai-hero-visual { width: 100%; max-width: 370px; aspect-ratio: 1 / .98; }
    .ai-ambient { inset: 5% 0 0; filter: blur(25px); }
    .cinema-canvas { inset: 11% 2% 10% 3%; border-radius: 28px 52px 34px 58px / 34px 44px 50px 54px; }
    .engine-label { left: 1%; padding: .3rem .48rem .3rem .34rem; }
    .engine-label img { width: 22px; height: 22px; }
    .engine-label span { font-size: .39rem; }
    .prompt-signal { left: 0; top: 17%; min-width: 55%; padding: .46rem .56rem; border-radius: 15px 15px 15px 6px; gap: .38rem; }
    .prompt-mark { flex-basis: 24px; width: 24px; height: 24px; border-radius: 8px; font-size: .66rem; }
    .prompt-copy small { font-size: .32rem; }
    .prompt-copy b { font-size: .43rem; }
    .prompt-caret { height: 17px; }
    .canvas-topline { left: 5%; right: 5%; }
    .master-quality { display: none; }
    .ai-core { right: 10%; top: 29%; width: 31%; }
    .story-copy { left: 6%; bottom: 12%; }
    .story-copy > strong { font-size: 1rem; }
    .story-flow { gap: .2rem; }
    .story-flow i { width: 13px; }
    .format-fan { right: 4%; bottom: 9%; width: 33%; }
    .capability-pill { padding: .31rem .42rem; gap: .3rem; border-radius: 11px; }
    .capability-pill > span { width: 21px; height: 21px; flex-basis: 21px; border-radius: 7px; font-size: .57rem; }
    .capability-pill small { font-size: .27rem; }
    .capability-pill b { font-size: .38rem; }
    .pill-identity { right: 0; top: 19%; }
    .pill-motion { right: -1%; top: 51%; }
    .pill-scale { left: 1%; bottom: 7%; }
    .future-chip { display: none; }
