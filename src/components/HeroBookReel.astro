---
/** Premium portfolio-backed AI + professional video production hero. */
import { SHOWCASES, ytThumb } from '../data/site';
const cinematic = SHOWCASES.find((group) => group.id === 'cinematic')!;
const productAi = SHOWCASES.find((group) => group.id === 'product-ai')!;
const brand = SHOWCASES.find((group) => group.id === 'brand')!;
const heroVideos = [cinematic.ids[0], productAi.ids[0], brand.ids[0]];
const heroPosters = heroVideos.map((id) => ytThumb(id, 'hq'));
const steps = ['Creative brief', 'AI generation', 'Human-like scene', 'Pro editing', 'Campaign ready'];
---
<div class="vs" data-video-studio data-video-ids={heroVideos.join(',')} aria-label="Creavix AI and professional video production workflow">
  <div class="vs-aura" aria-hidden="true"></div>
  <div class="vs-window">
    <div class="vs-titlebar">
      <div class="vs-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="vs-brand"><span class="vs-mark">C</span><strong>CREAVIX STUDIO</strong></div>
      <div class="vs-live"><i></i> LIVE WORKFLOW</div>
    </div>

    <div class="vs-screen">
      <div class="vs-panel is-active" data-scene="0">
        <div class="brief-board">
          <div class="brief-copy">
            <span class="scene-kicker">01 · Creative direction</span>
            <strong>From idea to a story<br />people remember.</strong>
            <div class="brief-tags"><span>Brand</span><span>Audience</span><span>Emotion</span></div>
          </div>
          <div class="storyboard" aria-hidden="true">
            <i class="shot-one"><img src={heroPosters[0]} alt="" width="480" height="360" decoding="async" fetchpriority="high" /></i>
            <i class="shot-two"><img src={heroPosters[1]} alt="" width="480" height="360" loading="lazy" decoding="async" /></i>
            <i class="shot-three"><img src={heroPosters[2]} alt="" width="480" height="360" loading="lazy" decoding="async" /></i>
            <span class="story-line"></span>
          </div>
        </div>
      </div>

      <div class="vs-panel" data-scene="1">
        <div class="ai-console">
          <div class="prompt-box">
            <span class="scene-kicker">02 · AI generation</span>
            <p><b>Prompt</b> Human-like product film,<br />cinematic light, authentic emotion…</p>
            <span class="typing-line"></span>
          </div>
          <div class="generation-core" aria-hidden="true">
            <div class="core-ring ring-a"></div><div class="core-ring ring-b"></div>
            <div class="core-logo">AI</div>
          </div>
          <div class="frame-stack" aria-hidden="true">
            <i><img src={heroPosters[1]} alt="" width="480" height="360" loading="lazy" decoding="async" /></i>
            <i><img src={heroPosters[2]} alt="" width="480" height="360" loading="lazy" decoding="async" /></i>
            <i><img src={heroPosters[0]} alt="" width="480" height="360" loading="lazy" decoding="async" /></i>
          </div>
        </div>
      </div>

      <div class="vs-panel" data-scene="2">
        <div class="cinema-frame">
          <img class="cinema-poster" src={heroPosters[0]} alt="Creavix cinematic video preview" width="480" height="360" decoding="async" fetchpriority="high" />
          <div class="cinema-player" data-hero-player aria-hidden="true"></div>
          <div class="cinema-light"></div>
          <span class="scene-kicker cinema-kicker">03 · Human-like visual</span>
          <span class="cinema-rec"><i></i> REC</span>
          <div class="cinema-caption"><strong>Cinematic. Authentic. Different.</strong><small>Real Creavix work · AI precision × human direction</small></div>
        </div>
      </div>

      <div class="vs-panel" data-scene="3">
        <div class="edit-suite">
          <div class="edit-preview">
            <img src={heroPosters[2]} alt="" width="480" height="360" loading="lazy" decoding="async" />
            <div class="play-icon" aria-hidden="true"></div>
          </div>
          <div class="edit-controls">
            <span class="scene-kicker">04 · Professional finishing</span>
            <div class="edit-labels"><b>Color</b><b>Sound</b><b>Motion</b><b>Story</b></div>
            <div class="timeline">
              <div class="track video"><i></i><i></i><i></i></div>
              <div class="track audio"><i></i><i></i></div>
              <div class="track effects"><i></i><i></i><i></i></div>
              <span class="playhead"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="vs-panel" data-scene="4">
        <div class="delivery">
          <div class="delivery-rings" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="delivery-card">
            <span class="delivery-check">✓</span>
            <span class="scene-kicker">05 · Campaign ready</span>
            <strong>One idea.<br />Every screen.</strong>
            <div class="format-row"><span>9:16</span><span>1:1</span><span>16:9</span></div>
          </div>
          <div class="device phone" aria-hidden="true"><i style={`background-image:url('${heroPosters[1]}')`}></i></div>
          <div class="device desktop" aria-hidden="true"><i style={`background-image:url('${heroPosters[0]}')`}></i></div>
        </div>
      </div>

      <div class="vs-corner top-left" aria-hidden="true"></div><div class="vs-corner top-right" aria-hidden="true"></div>
      <div class="vs-corner bottom-left" aria-hidden="true"></div><div class="vs-corner bottom-right" aria-hidden="true"></div>
    </div>

    <div class="vs-status">
      <div class="vs-progress"><i data-progress></i></div>
      <div class="vs-step-copy"><span data-step-number>01</span><strong data-step-label>Creative brief</strong></div>
      <div class="vs-quality"><span>4K</span><span>AI + HUMAN</span><span>24–48H</span></div>
    </div>
  </div>

  <div class="vs-nav" aria-label="Video production animation steps">
    {steps.map((step, i) => (
      <button type="button" class:list={['vs-nav-btn', { 'is-active': i === 0 }]} data-step={i} aria-label={step} aria-pressed={i === 0 ? 'true' : 'false'}>
        <span>{String(i + 1).padStart(2, '0')}</span>
      </button>
    ))}
  </div>
  <div class="vs-float-chip chip-ai"><i>✦</i><span>Human-like AI</span></div>
  <div class="vs-float-chip chip-pro"><i>◆</i><span>Pro Editing</span></div>
</div>

<style>
  .vs{--blue:#2563eb;--ink:#0b1220;position:relative;width:100%;max-width:520px;margin:0 auto;padding:1.25rem .3rem .4rem;isolation:isolate}
  .vs-aura{position:absolute;inset:5% -12% 2%;z-index:-1;border-radius:50%;background:radial-gradient(circle at 25% 30%,rgba(37,99,235,.28),transparent 42%),radial-gradient(circle at 76% 25%,rgba(168,85,247,.24),transparent 43%),radial-gradient(circle at 60% 85%,rgba(249,115,22,.18),transparent 42%);filter:blur(30px);animation:aura 5s ease-in-out infinite alternate;pointer-events:none}
  .vs-window{overflow:hidden;border:1px solid rgba(255,255,255,.9);border-radius:22px;background:rgba(255,255,255,.9);box-shadow:0 30px 80px rgba(15,23,42,.16),0 7px 20px rgba(37,99,235,.08);transform:perspective(1200px) rotateY(-2deg) rotateX(1deg);transform-origin:center}
  .vs-titlebar{height:42px;padding:0 .8rem;display:flex;align-items:center;border-bottom:1px solid #e7ebf2;background:rgba(255,255,255,.96)}
  .vs-dots{display:flex;gap:5px}.vs-dots i{width:7px;height:7px;border-radius:50%;background:#ff665d}.vs-dots i:nth-child(2){background:#ffbd2e}.vs-dots i:nth-child(3){background:#27c840}
  .vs-brand{display:flex;align-items:center;gap:.35rem;margin-left:.75rem;color:#0f172a;font-size:.58rem;letter-spacing:.09em}.vs-mark{width:20px;height:20px;display:grid;place-items:center;border-radius:7px;background:linear-gradient(135deg,#2563eb,#7c3aed);color:#fff;font-weight:900}
  .vs-live{margin-left:auto;display:flex;align-items:center;gap:.3rem;color:#64748b;font-size:.5rem;font-weight:800;letter-spacing:.08em}.vs-live i{width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.12);animation:blink 1.4s ease-in-out infinite}
  .vs-screen{position:relative;aspect-ratio:16/10;overflow:hidden;background:#0b1220}
  .vs-panel{position:absolute;inset:0;opacity:0;transform:translate3d(18px,0,0) scale(.985);transition:opacity .42s ease,transform .52s cubic-bezier(.2,.8,.2,1);pointer-events:none}.vs-panel.is-active{opacity:1;transform:none;pointer-events:auto}
  .scene-kicker{display:block;color:#60a5fa;font-size:.52rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
  .brief-board{height:100%;padding:12% 9%;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:7%;background:linear-gradient(135deg,#0f172a,#18264a)}
  .brief-copy strong{display:block;margin:.65rem 0 1rem;color:#fff;font:800 clamp(1rem,3vw,1.55rem)/1.15 Outfit,system-ui;letter-spacing:-.03em}.brief-tags{display:flex;gap:.35rem;flex-wrap:wrap}.brief-tags span{padding:.28rem .48rem;border:1px solid rgba(255,255,255,.14);border-radius:99px;color:#cbd5e1;font-size:.52rem}
  .storyboard{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:5px;transform:rotate(2deg)}.storyboard i{height:58px;border:2px solid rgba(255,255,255,.8);border-radius:8px;box-shadow:0 8px 22px rgba(0,0,0,.25)}.storyboard .shot-one{grid-row:span 2;height:auto;background:linear-gradient(145deg,#fde68a,#fb7185 50%,#312e81)}.storyboard .shot-two{background:linear-gradient(145deg,#93c5fd,#1e3a8a)}.storyboard .shot-three{background:linear-gradient(145deg,#fda4af,#7c3aed)}.story-line{position:absolute;left:-9%;right:-4%;bottom:-12%;height:2px;background:linear-gradient(90deg,transparent,#60a5fa,transparent)}
  .ai-console{height:100%;padding:9%;display:grid;grid-template-columns:1.15fr .7fr .6fr;align-items:center;gap:5%;background:radial-gradient(circle at 55% 50%,#172554,#080d19 62%)}
  .prompt-box{padding:.85rem;border:1px solid rgba(96,165,250,.3);border-radius:13px;background:rgba(15,23,42,.82);box-shadow:inset 0 0 22px rgba(37,99,235,.08)}.prompt-box p{margin:.55rem 0;color:#cbd5e1;font:500 .62rem/1.55 ui-monospace,monospace}.prompt-box b{color:#c084fc}.typing-line{display:block;width:70%;height:3px;border-radius:5px;background:linear-gradient(90deg,#2563eb,#c084fc);animation:type 1.8s ease-in-out infinite}
  .generation-core{position:relative;aspect-ratio:1;display:grid;place-items:center}.core-logo{width:55%;aspect-ratio:1;display:grid;place-items:center;border-radius:35%;background:linear-gradient(135deg,#3b82f6,#8b5cf6 55%,#ec4899);color:#fff;font:900 1rem Outfit;box-shadow:0 0 30px rgba(99,102,241,.55)}.core-ring{position:absolute;inset:4%;border:1px solid rgba(147,197,253,.45);border-radius:42%;animation:spin 7s linear infinite}.ring-b{inset:-8%;border-style:dashed;animation-direction:reverse;animation-duration:11s}
  .frame-stack{position:relative;height:65%;min-width:48px}.frame-stack i{position:absolute;inset:0;border:1px solid rgba(255,255,255,.25);border-radius:9px;background:linear-gradient(145deg,#fbbf24,#db2777 54%,#1e3a8a);box-shadow:0 8px 18px rgba(0,0,0,.3);animation:frames 2s ease-in-out infinite}.frame-stack i:nth-child(2){transform:translate(-7px,7px);opacity:.55;animation-delay:.25s}.frame-stack i:nth-child(3){transform:translate(-14px,14px);opacity:.25;animation-delay:.5s}
  .cinema-frame{position:relative;height:100%;overflow:hidden;background:#182444}.cinema-sky{position:absolute;inset:0 0 38%;background:linear-gradient(#365789,#f8b47a 70%,#ffd4a5)}.cinema-city{position:absolute;inset:23% 0 35%;opacity:.4;background:repeating-linear-gradient(90deg,#1e293b 0 18px,transparent 18px 25px)}.cinema-floor{position:absolute;inset:62% 0 0;background:linear-gradient(#334155,#0f172a)}
  .cinema-person{position:absolute;left:25%;bottom:14%;width:18%;height:50%;animation:heroFloat 3s ease-in-out infinite alternate}.cinema-person:before{content:'';position:absolute;left:26%;top:0;width:48%;aspect-ratio:1;border-radius:50%;background:#d59a72}.cinema-person i{position:absolute;inset:23% 0 0;border-radius:40% 40% 15% 15%;background:linear-gradient(120deg,#f8fafc,#cbd5e1)}
  .cinema-product{position:absolute;right:24%;bottom:18%;width:19%;height:39%;display:grid;place-items:center;border-radius:12% 12% 7% 7%;background:linear-gradient(145deg,#fafafa,#dbeafe);box-shadow:0 18px 30px rgba(0,0,0,.32),inset 0 0 0 1px #fff;transform:rotate(3deg)}.cinema-product span{text-align:center;color:#1d4ed8;font:900 .48rem/1.15 Outfit}
  .cinema-light{position:absolute;inset:-35% -10%;background:linear-gradient(110deg,transparent 28%,rgba(255,235,185,.28) 45%,transparent 59%);animation:lightSweep 3.2s ease-in-out infinite}.cinema-kicker{position:absolute;left:5%;top:6%;color:#fff}.cinema-rec{position:absolute;right:5%;top:6%;display:flex;align-items:center;gap:.3rem;color:#fff;font-size:.52rem;font-weight:800}.cinema-rec i{width:6px;height:6px;border-radius:50%;background:#ef4444;animation:blink 1s infinite}
  .cinema-caption{position:absolute;left:5%;bottom:6%;display:flex;flex-direction:column;color:#fff;text-shadow:0 2px 8px rgba(0,0,0,.3)}.cinema-caption strong{font-size:.72rem}.cinema-caption small{font-size:.48rem;color:#dbeafe;margin-top:.15rem}
  .edit-suite{height:100%;display:grid;grid-template-columns:.78fr 1.22fr;gap:4px;padding:4px;background:#101827}.edit-preview{position:relative;display:grid;place-items:center;overflow:hidden;border-radius:8px;background:linear-gradient(145deg,#fbbf24,#ec4899 48%,#1e3a8a)}.edit-shot{position:absolute;inset:0}.edit-shot:before{content:'';position:absolute;left:38%;top:24%;width:24%;height:55%;border-radius:45% 45% 10% 10%;background:rgba(255,255,255,.8)}.edit-shot i{position:absolute;left:42%;top:12%;width:16%;aspect-ratio:1;border-radius:50%;background:#d89b72}.play-icon{position:relative;width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.9);box-shadow:0 8px 20px rgba(0,0,0,.25)}.play-icon:after{content:'';position:absolute;left:42%;top:31%;border-left:12px solid #2563eb;border-top:7px solid transparent;border-bottom:7px solid transparent}
  .edit-controls{padding:7% 6%;display:flex;flex-direction:column}.edit-labels{display:flex;gap:.3rem;margin:.6rem 0}.edit-labels b{padding:.25rem .4rem;border-radius:6px;background:#1e293b;color:#94a3b8;font-size:.45rem}.timeline{position:relative;flex:1;padding:.45rem;background:#080d16;border-radius:8px;overflow:hidden}.track{display:flex;gap:3px;height:18%;margin-bottom:5%}.track i{display:block;flex:1;border-radius:3px}.video i{background:#6366f1}.video i:nth-child(2){flex:1.5;background:#8b5cf6}.audio i{background:#10b981}.effects i{background:#f43f5e}.effects i:nth-child(2){background:#f59e0b}.playhead{position:absolute;top:0;bottom:0;left:8%;width:2px;background:#fff;box-shadow:0 0 7px #fff;animation:scrub 3s linear infinite}
  .delivery{position:relative;height:100%;display:grid;place-items:center;background:radial-gradient(circle at center,#1e3a8a,#080d19 65%)}.delivery-rings i{position:absolute;inset:13%;border:1px solid rgba(96,165,250,.2);border-radius:50%;animation:deliveryPulse 3s ease-out infinite}.delivery-rings i:nth-child(2){inset:4%;animation-delay:1s}.delivery-rings i:nth-child(3){inset:-5%;animation-delay:2s}
  .delivery-card{position:relative;z-index:2;width:48%;padding:1rem;border:1px solid rgba(255,255,255,.2);border-radius:16px;background:rgba(15,23,42,.72);box-shadow:0 18px 50px rgba(0,0,0,.35);text-align:center;backdrop-filter:blur(10px)}.delivery-check{width:35px;height:35px;margin:0 auto .55rem;display:grid;place-items:center;border-radius:50%;background:#22c55e;color:#fff;font-weight:900}.delivery-card strong{display:block;margin:.5rem 0;color:#fff;font:800 1.05rem/1.1 Outfit}.format-row{display:flex;gap:.3rem;justify-content:center}.format-row span{padding:.25rem .4rem;border-radius:5px;background:rgba(255,255,255,.09);color:#bfdbfe;font-size:.46rem;font-weight:700}
  .device{position:absolute;border:2px solid rgba(255,255,255,.5);background:#111827;box-shadow:0 10px 30px rgba(0,0,0,.3)}.device i{display:block;position:absolute;inset:5px;border-radius:inherit;background:linear-gradient(145deg,#fbbf24,#db2777 50%,#2563eb)}.device.phone{left:12%;bottom:15%;width:10%;height:38%;border-radius:8px;transform:rotate(-8deg)}.device.desktop{right:8%;top:18%;width:23%;height:36%;border-radius:6px;transform:rotate(6deg)}.device.desktop:after{content:'';position:absolute;left:35%;right:35%;bottom:-20%;height:20%;background:#64748b}
  .storyboard i,.frame-stack i{overflow:hidden}.storyboard i img,.frame-stack i img{width:100%;height:100%;display:block;object-fit:cover}.storyboard .shot-one,.storyboard .shot-two,.storyboard .shot-three,.frame-stack i{background:#172554}
  .cinema-poster,.cinema-player,.cinema-player iframe{position:absolute;inset:0;width:100%;height:100%;display:block;border:0;object-fit:cover}.cinema-poster{z-index:0}.cinema-player{z-index:1;opacity:0;background:#000;pointer-events:none;transition:opacity .4s ease}.cinema-player.is-playing{opacity:1}
  .cinema-light{z-index:2;pointer-events:none}.cinema-kicker,.cinema-rec,.cinema-caption{z-index:3}.cinema-caption{text-shadow:0 2px 9px rgba(0,0,0,.7)}
  .edit-preview{background:#0f172a}.edit-preview>img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover}
  .device i{background-size:cover;background-position:center}
  .vs-corner{position:absolute;width:13px;height:13px;border-color:rgba(255,255,255,.65);border-style:solid;z-index:10}.top-left{left:10px;top:10px;border-width:1px 0 0 1px}.top-right{right:10px;top:10px;border-width:1px 1px 0 0}.bottom-left{left:10px;bottom:10px;border-width:0 0 1px 1px}.bottom-right{right:10px;bottom:10px;border-width:0 1px 1px 0}
  .vs-status{padding:.65rem .8rem .7rem;background:#fff}.vs-progress{height:3px;border-radius:5px;background:#e7ebf2;overflow:hidden}.vs-progress i{display:block;height:100%;width:20%;border-radius:inherit;background:linear-gradient(90deg,#2563eb,#8b5cf6,#ec4899);transition:width .45s ease}
  .vs-step-copy{display:flex;align-items:baseline;gap:.45rem;margin-top:.5rem}.vs-step-copy span{color:#2563eb;font-size:.54rem;font-weight:800}.vs-step-copy strong{color:#0f172a;font-size:.64rem}.vs-quality{display:flex;gap:.35rem;margin-left:auto;justify-content:flex-end;margin-top:-.8rem}.vs-quality span{padding:.2rem .35rem;border-radius:5px;background:#f1f5f9;color:#64748b;font-size:.42rem;font-weight:800}
  .vs-nav{display:flex;justify-content:center;gap:.4rem;margin-top:.8rem}.vs-nav-btn{width:32px;height:7px;padding:0;border:0;border-radius:99px;background:#cbd5e1;cursor:pointer;overflow:hidden;transition:width .3s,background .3s}.vs-nav-btn span{position:absolute;clip:rect(0 0 0 0)}.vs-nav-btn.is-active{width:58px;background:linear-gradient(90deg,#2563eb,#8b5cf6)}
  .vs-float-chip{position:absolute;z-index:3;display:flex;align-items:center;gap:.35rem;padding:.45rem .62rem;border:1px solid rgba(255,255,255,.9);border-radius:12px;background:rgba(255,255,255,.92);box-shadow:0 10px 26px rgba(15,23,42,.12);color:#334155;font-size:.55rem;font-weight:800;backdrop-filter:blur(9px);animation:chipFloat 3s ease-in-out infinite alternate}.vs-float-chip i{width:22px;height:22px;display:grid;place-items:center;border-radius:7px;color:#fff;font-style:normal}.chip-ai{left:-4%;top:25%}.chip-ai i{background:linear-gradient(135deg,#7c3aed,#ec4899)}.chip-pro{right:-3%;bottom:20%;animation-delay:1s}.chip-pro i{background:linear-gradient(135deg,#2563eb,#06b6d4)}
  @keyframes aura{to{opacity:.72;transform:scale(1.06)}}@keyframes blink{50%{opacity:.25}}@keyframes type{50%{width:35%;opacity:.6}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes frames{50%{transform:translateY(-5px) rotate(2deg)}}@keyframes heroFloat{to{transform:translateY(-4px)}}@keyframes lightSweep{50%{transform:translateX(18%)}}@keyframes scrub{to{left:90%}}@keyframes deliveryPulse{0%{transform:scale(.8);opacity:.7}100%{transform:scale(1.15);opacity:0}}@keyframes chipFloat{to{transform:translateY(-7px)}}
  @media(max-width:899px){.vs{max-width:460px;padding-top:.4rem}.vs-window{transform:none}.vs-float-chip{display:none}}
  @media(max-width:520px){.vs{max-width:100%;padding-inline:0}.vs-window{border-radius:17px}.vs-titlebar{height:36px}.vs-brand strong{font-size:.5rem}.vs-live{font-size:.42rem}.vs-screen{aspect-ratio:16/10.6}.brief-board{padding:9% 7%;gap:5%}.storyboard i{height:43px}.ai-console{padding:7%;grid-template-columns:1.2fr .72fr .45fr}.prompt-box{padding:.58rem}.prompt-box p{font-size:.5rem}.edit-suite{grid-template-columns:.72fr 1.28fr}.delivery-card{width:58%;padding:.7rem}.vs-quality span:nth-child(2){display:none}}
  @media(prefers-reduced-motion:reduce){.vs *{animation:none!important;transition:none!important}.vs-panel:not(.is-active){display:none}}
</style>

<script is:inline>
(() => {
  const root=document.querySelector('[data-video-studio]');if(!root)return;
  const scenes=[...root.querySelectorAll('[data-scene]')],buttons=[...root.querySelectorAll('[data-step]')];
  const label=root.querySelector('[data-step-label]'),number=root.querySelector('[data-step-number]'),progress=root.querySelector('[data-progress]');
  const player=root.querySelector('[data-hero-player]'),videoId=(root.dataset.videoIds||'').split(',')[0];
  const names=['Creative brief','AI generation','Human-like scene','Pro editing','Campaign ready'];
  const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const connection=navigator.connection||navigator.mozConnection||navigator.webkitConnection;
  const allowVideo=!reduced&&!connection?.saveData&&!/2g/.test(connection?.effectiveType||'');
  let index=0,timer=null,visible=true,playerTimer=null;
  function mountVideo(){
    if(!allowVideo||!visible||!player||!videoId||player.firstChild)return;
    const iframe=document.createElement('iframe');
    iframe.title='Muted Creavix portfolio video preview';
    iframe.loading='lazy';
    iframe.allow='autoplay; encrypted-media; picture-in-picture';
    iframe.referrerPolicy='strict-origin-when-cross-origin';
    iframe.style.cssText='position:absolute;inset:0;width:100%;height:100%;display:block;border:0';
    iframe.src='https://www.youtube-nocookie.com/embed/'+encodeURIComponent(videoId)+'?autoplay=1&mute=1&controls=0&loop=1&playlist='+encodeURIComponent(videoId)+'&playsinline=1&rel=0&modestbranding=1&iv_load_policy=3&origin='+encodeURIComponent(location.origin);
    iframe.addEventListener('load',()=>player.classList.add('is-playing'),{once:true});
    player.appendChild(iframe);
  }
  function unmountVideo(){clearTimeout(playerTimer);playerTimer=null;if(player){player.classList.remove('is-playing');player.replaceChildren()}}
  function show(next){index=(next+scenes.length)%scenes.length;scenes.forEach((el,i)=>el.classList.toggle('is-active',i===index));buttons.forEach((el,i)=>{el.classList.toggle('is-active',i===index);el.setAttribute('aria-pressed',String(i===index))});number.textContent=String(index+1).padStart(2,'0');label.textContent=names[index];progress.style.width=((index+1)/scenes.length*100)+'%'}
  function stop(){clearInterval(timer);timer=null}function start(){stop();if(!reduced&&visible)timer=setInterval(()=>show(index+1),2600);if(allowVideo&&visible&&!playerTimer)playerTimer=setTimeout(mountVideo,1800)}
  buttons.forEach(button=>button.addEventListener('click',()=>{show(Number(button.dataset.step));start()}));
  if('IntersectionObserver'in window){new IntersectionObserver(entries=>{visible=entries[0]?.isIntersecting??true;if(visible)start();else{stop();unmountVideo()}},{threshold:.15}).observe(root)}else start();
  document.addEventListener('visibilitychange',()=>{if(document.hidden){stop();unmountVideo()}else start()});
})();
</script>
