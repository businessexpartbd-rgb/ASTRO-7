---
/**
 * Hero book-page video reel — landscape YouTube previews cycle like turning pages.
 * Speed-first: posters + one muted iframe at a time, CSS scroll, reduced-motion safe.
 */
import { SHOWCASES, ytThumb } from '../data/site';

const longIds = [
  ...SHOWCASES.find((s) => s.id === 'cinematic')!.ids.slice(0, 4),
  ...SHOWCASES.find((s) => s.id === 'custom')!.ids.slice(0, 2),
];

const pages = longIds.map((id, i) => ({
  id,
  thumb: ytThumb(id),
  label: i % 2 === 0 ? 'Cinematic' : 'Brand Film',
}));

const services = [
  { t: 'Video Editing', c: '#2563EB' },
  { t: 'AI Video', c: '#7C3AED' },
  { t: 'Web Dev', c: '#0D9488' },
  { t: 'App Build', c: '#D97706' },
];
---

<div class="hbr" data-hbr role="img" aria-label="Creavix video portfolio preview reel">
  <div class="hbr-frame">
    <div class="hbr-chrome">
      <span class="hbr-dot r"></span>
      <span class="hbr-dot y"></span>
      <span class="hbr-dot g"></span>
      <span class="hbr-title">Creavix · Long-form Showcase</span>
    </div>

    <div class="hbr-stage">
      <!-- Active muted player (one at a time) -->
      <div class="hbr-player" data-hbr-player>
        <iframe
          data-hbr-iframe
          title="Showcase preview"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
        <img data-hbr-poster class="hbr-poster" alt="" width="640" height="360" decoding="async" />
        <div class="hbr-play-hint" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </div>
      </div>

      <!-- Book-page vertical reel -->
      <div class="hbr-reel-mask">
        <div class="hbr-reel" data-hbr-reel>
          {[...pages, ...pages].map((p, i) => (
            <article class="hbr-page" data-yt={p.id} data-i={i % pages.length}>
              <img src={p.thumb} alt="" width="320" height="180" loading="lazy" decoding="async" />
              <span class="hbr-tag">{p.label}</span>
            </article>
          ))}
        </div>
      </div>
    </div>

    <div class="hbr-services">
      {services.map((s) => (
        <span class="hbr-chip" style={`--c:${s.c}`}>{s.t}</span>
      ))}
    </div>
  </div>

  <!-- Soft floating badges -->
  <div class="hbr-float hbr-f1" aria-hidden="true">16:9</div>
  <div class="hbr-float hbr-f2" aria-hidden="true">4K</div>
  <div class="hbr-float hbr-f3" aria-hidden="true">24–48h</div>
</div>

<style>
  .hbr {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
  }

  .hbr-frame {
    position: relative;
    z-index: 1;
    background: linear-gradient(165deg, #0F172A 0%, #1E293B 55%, #0B1220 100%);
    border-radius: 22px;
    padding: 0.65rem 0.65rem 0.85rem;
    box-shadow:
      0 28px 56px rgba(15, 23, 42, 0.28),
      0 0 0 1px rgba(255, 255, 255, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .hbr-chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.35rem 0.55rem;
  }
  .hbr-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .hbr-dot.r { background: #F87171; }
  .hbr-dot.y { background: #FBBF24; }
  .hbr-dot.g { background: #34D399; }
  .hbr-title {
    margin-left: 0.4rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(226, 232, 240, 0.7);
  }

  .hbr-stage {
    display: grid;
    gap: 0.55rem;
  }

  .hbr-player {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: #020617;
  }
  .hbr-player iframe,
  .hbr-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .hbr-player iframe {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
  }
  .hbr-player.is-playing iframe {
    opacity: 1;
  }
  .hbr-player.is-playing .hbr-poster,
  .hbr-player.is-playing .hbr-play-hint {
    opacity: 0;
  }
  .hbr-poster {
    transition: opacity 0.4s ease;
  }
  .hbr-play-hint {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(2, 6, 23, 0.25);
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .hbr-play-hint svg {
    width: 44px;
    height: 44px;
    padding: 10px;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.92);
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.45);
  }

  .hbr-reel-mask {
    height: 118px;
    overflow: hidden;
    border-radius: 12px;
    mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
  }
  .hbr-reel {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    animation: hbr-scroll 28s linear infinite;
    will-change: transform;
  }
  @keyframes hbr-scroll {
    0% { transform: translateY(0); }
    100% { transform: translateY(-50%); }
  }

  .hbr-page {
    position: relative;
    flex-shrink: 0;
    height: 54px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }
  .hbr-page img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hbr-tag {
    position: absolute;
    left: 8px;
    bottom: 6px;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.72);
    color: #E2E8F0;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .hbr-services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.65rem;
    padding: 0 0.15rem;
  }
  .hbr-chip {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    color: #fff;
    background: color-mix(in srgb, var(--c) 88%, #000);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--c) 35%, transparent);
  }

  .hbr-float {
    position: absolute;
    z-index: 2;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.55rem;
    border-radius: 10px;
    background: #fff;
    color: #0B0F19;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
    border: 1px solid rgba(15, 23, 42, 0.06);
    animation: hbr-bob 4.5s ease-in-out infinite;
  }
  .hbr-f1 { top: 12%; left: -8px; animation-delay: 0s; }
  .hbr-f2 { top: 42%; right: -10px; animation-delay: -1.2s; }
  .hbr-f3 { bottom: 18%; left: -6px; animation-delay: -2.4s; color: #2563EB; }
  @keyframes hbr-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @media (max-width: 767px) {
    .hbr { max-width: 100%; }
    .hbr-frame { border-radius: 18px; }
    .hbr-reel-mask { height: 100px; }
    .hbr-page { height: 46px; }
    .hbr-float { font-size: 0.62rem; padding: 0.28rem 0.45rem; }
    .hbr-f1 { left: 0; }
    .hbr-f2 { right: 0; }
    .hbr-f3 { left: 4px; bottom: 14%; }
    .hbr-reel { animation-duration: 32s; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hbr-reel,
    .hbr-float {
      animation: none !important;
    }
  }
</style>

<script is:inline>
(function () {
  var root = document.querySelector('[data-hbr]');
  if (!root) return;

  var pages = Array.prototype.slice.call(root.querySelectorAll('.hbr-page'));
  if (!pages.length) return;

  var unique = [];
  var seen = {};
  pages.forEach(function (p) {
    var id = p.getAttribute('data-yt');
    if (id && !seen[id]) {
      seen[id] = true;
      unique.push(id);
    }
  });
  if (!unique.length) return;

  var player = root.querySelector('[data-hbr-player]');
  var iframe = root.querySelector('[data-hbr-iframe]');
  var poster = root.querySelector('[data-hbr-poster]');
  var idx = 0;
  var timer = null;
  var visible = true;
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function thumb(id) {
    return 'https://i.ytimg.com/vi/' + id + '/hqdefault.jpg';
  }

  function embed(id) {
    // mute + autoplay + short window; modestbranding for clean UI
    return 'https://www.youtube-nocookie.com/embed/' + id +
      '?autoplay=1&mute=1&controls=0&rel=0&modestbranding=1&playsinline=1&loop=0&start=3&end=12';
  }

  function show(i) {
    idx = i % unique.length;
    var id = unique[idx];
    if (poster) {
      poster.src = thumb(id);
      poster.alt = 'Video preview';
    }
    if (!iframe || reduced || !visible) {
      if (player) player.classList.remove('is-playing');
      return;
    }
    if (player) player.classList.remove('is-playing');
    // slight delay so poster paints first
    setTimeout(function () {
      if (!visible || reduced) return;
      iframe.src = embed(id);
      if (player) player.classList.add('is-playing');
    }, 180);
  }

  function next() {
    show(idx + 1);
  }

  function startCycle() {
    if (timer) clearInterval(timer);
    show(0);
    if (reduced) return;
    timer = setInterval(next, 9000);
  }

  function stopCycle() {
    if (timer) clearInterval(timer);
    timer = null;
    if (iframe) iframe.src = '';
    if (player) player.classList.remove('is-playing');
  }

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        visible = e.isIntersecting;
        if (visible) startCycle();
        else stopCycle();
      });
    }, { threshold: 0.2 });
    io.observe(root);
  } else {
    startCycle();
  }

  // Pause when tab hidden (saves CPU / bandwidth)
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stopCycle();
    else if (visible) startCycle();
  });
})();
</script>
