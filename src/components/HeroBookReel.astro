---
const scenes = [
  {
    src: '/media/hero-studio-bangladesh.webp',
    small: '/media/hero-studio-bangladesh-480.webp',
    alt: 'AI video marketing production by Creavix IT Solution',
  },
  {
    src: '/media/hero-ai-product.webp',
    small: '/media/hero-ai-product-480.webp',
    alt: '',
  },
];
---

<figure class="cinematic-hero" data-cinematic-hero aria-label="Creavix AI video marketing film-generation experience">
  <div class="ambient-light" aria-hidden="true"><i></i><i></i><i></i></div>

  <svg class="energy-loop" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <path class="energy-track" pathLength="1" d="M10 20 C3 34 4 73 16 87 C32 101 72 99 88 84 C99 69 99 31 89 17 C72 2 27 3 10 20 Z"></path>
    <path class="energy-signal signal-cyan" pathLength="1" d="M10 20 C3 34 4 73 16 87 C32 101 72 99 88 84 C99 69 99 31 89 17 C72 2 27 3 10 20 Z"></path>
    <path class="energy-signal signal-orange" pathLength="1" d="M10 20 C3 34 4 73 16 87 C32 101 72 99 88 84 C99 69 99 31 89 17 C72 2 27 3 10 20 Z"></path>
  </svg>

  <div class="film-shell">
    <div class="scene-stack">
      {scenes.map((scene, index) => (
        <img
          class:list={['film-scene', 'film-scene-' + (index + 1)]}
          src={scene.src}
          srcset={scene.small + ' 480w, ' + scene.src + ' 960w'}
          sizes="(max-width: 640px) 360px, (max-width: 1024px) 460px, 560px"
          width="960"
          height="540"
          alt={scene.alt}
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={index === 0 ? 'high' : 'low'}
        />
      ))}
    </div>

    <div class="cinema-tone" aria-hidden="true"></div>
    <div class="light-scan" aria-hidden="true"></div>
    <div class="film-grain" aria-hidden="true"></div>

    <header class="engine-bar">
      <div class="engine-brand">
        <span class="brand-mark">
          <img src="/media/creavix-original-logo-56.webp" alt="" width="28" height="28" loading="eager" decoding="async" />
        </span>
        <span class="brand-copy"><b>CREAVIX AI</b><small>GENERATIVE FILM ENGINE</small></span>
      </div>
      <span class="engine-live"><i></i> LIVE</span>
    </header>

    <div class="prompt-console">
      <span class="prompt-icon" aria-hidden="true">✦</span>
      <span><small>CREATIVE DIRECTION</small><b>Create a cinematic campaign<br />with human emotion.</b></span>
      <i class="typing-caret" aria-hidden="true"></i>
    </div>

    <div class="ai-nucleus" aria-hidden="true">
      <span class="ray-field"></span>
      <span class="orbit orbit-a"><i></i></span>
      <span class="orbit orbit-b"><i></i></span>
      <span class="orbit orbit-c"></span>
      <span class="core"><strong>AI</strong><small>FILM<br />INTELLIGENCE</small></span>
    </div>

    <div class="film-message">
      <small>IDEA TO INFLUENCE</small>
      <strong>Stories engineered<br />to move people.</strong>
    </div>

    <div class="campaign-flow" aria-label="Prompt to AI film to campaign">
      <span><i>01</i><b>Prompt</b></span><em></em>
      <span><i>02</i><b>AI Film</b></span><em></em>
      <span><i>03</i><b>Growth</b></span>
    </div>

    <div class="format-deck" aria-label="Vertical, square and widescreen campaign formats">
      <span class="format format-vertical"><i></i><b>9:16</b></span>
      <span class="format format-square"><i></i><b>1:1</b></span>
      <span class="format format-wide"><i></i><b>16:9</b></span>
    </div>

    <div class="scene-progress" aria-hidden="true"><span></span><span></span><i></i></div>
  </div>

  <div class="ai-glass-card glass-identity">
    <span class="card-icon purple" aria-hidden="true">◉</span>
    <span><small>BRAND MEMORY</small><b>Identity Locked</b></span>
  </div>
  <div class="ai-glass-card glass-motion">
    <span class="card-icon cyan" aria-hidden="true">↗</span>
    <span><small>HUMAN REALISM</small><b>Natural Motion</b></span>
  </div>
  <div class="ai-glass-card glass-scale">
    <span class="card-icon orange" aria-hidden="true">◆</span>
    <span><small>GLOBAL CAMPAIGN</small><b>Every Screen</b></span>
  </div>

  <figcaption class="future-note"><span aria-hidden="true">✦</span>Future-ready AI storytelling</figcaption>
</figure>

<style>
  .cinematic-hero {
    --orange:#ff6b18; --orange-soft:#ff9a4a; --blue:#1d4ed8; --cyan:#22d3ee;
    --purple:#7c3aed; --pink:#ec4899; --ink:#030712;
    position:relative; isolation:isolate; width:min(100%,590px); aspect-ratio:1.08/1;
    margin:0 auto; contain:layout paint; font-family:'Hind Siliguri';
  }

  .ambient-light {
    position:absolute; z-index:-4; inset:2% -7% -6%; overflow:hidden; opacity:.72;
    filter:blur(34px); pointer-events:none;
  }
  .ambient-light i { position:absolute; border-radius:999px; animation:ambientMove 9s ease-in-out infinite alternate; }
  .ambient-light i:nth-child(1) { width:48%; aspect-ratio:1; left:0; top:4%; background:rgba(255,107,24,.25); }
  .ambient-light i:nth-child(2) { width:56%; aspect-ratio:1; right:-3%; top:12%; background:rgba(29,78,216,.28); animation-delay:-3s; }
  .ambient-light i:nth-child(3) { width:45%; aspect-ratio:1; left:31%; bottom:0; background:rgba(124,58,237,.23); animation-delay:-6s; }

  .energy-loop { position:absolute; z-index:1; inset:5% 0 5% 1%; width:98%; height:90%; overflow:visible; pointer-events:none; }
  .energy-track,.energy-signal { fill:none; vector-effect:non-scaling-stroke; }
  .energy-track { stroke:rgba(37,99,235,.16); stroke-width:1; }
  .energy-signal { stroke-linecap:round; stroke-width:2; filter:drop-shadow(0 0 4px currentColor) drop-shadow(0 0 10px currentColor); }
  .signal-cyan { color:var(--cyan); stroke:currentColor; stroke-dasharray:.075 .925; animation:signalTravel 4.2s linear infinite; }
  .signal-orange { color:var(--orange-soft); stroke:currentColor; stroke-dasharray:.035 .965; stroke-dashoffset:-.48; animation:signalTravel 6.8s linear infinite reverse; }

  .film-shell {
    position:absolute; z-index:2; inset:9% 5% 9% 6%; overflow:hidden;
    border:1px solid rgba(255,255,255,.2); border-radius:52px 116px 58px 136px/70px 88px 102px 118px;
    background:var(--ink);
    box-shadow:0 38px 90px rgba(15,23,42,.27),0 16px 38px rgba(37,99,235,.15),inset 0 1px 0 rgba(255,255,255,.16);
    transform:perspective(1200px) rotateY(-1.5deg) rotateX(.5deg); transform-origin:52% 50%;
  }

  .scene-stack,.film-scene { position:absolute; inset:0; width:100%; height:100%; }
  .scene-stack { overflow:hidden; border-radius:inherit; }
  .film-scene { object-fit:cover; opacity:0; will-change:transform,opacity; }
  .film-scene-1 { animation:sceneFirst 14s cubic-bezier(.4,0,.2,1) infinite; }
  .film-scene-2 { animation:sceneSecond 14s cubic-bezier(.4,0,.2,1) infinite; }

  .cinema-tone {
    position:absolute; inset:0; z-index:1;
    background:linear-gradient(90deg,rgba(2,6,23,.9) 0%,rgba(2,6,23,.53) 36%,rgba(2,6,23,.12) 65%,rgba(2,6,23,.45) 100%),
      linear-gradient(0deg,rgba(2,6,23,.88) 0%,transparent 52%),
      radial-gradient(circle at 70% 40%,rgba(37,99,235,.12),transparent 38%);
  }

  .light-scan {
    position:absolute; z-index:2; inset:-25% auto -25% -32%; width:22%; transform:skewX(-14deg);
    background:linear-gradient(90deg,transparent,rgba(34,211,238,.08),rgba(255,255,255,.24),rgba(124,58,237,.12),transparent);
    mix-blend-mode:screen; animation:scanAcross 5.4s ease-in-out infinite;
  }

  .film-grain {
    position:absolute; z-index:2; inset:0; opacity:.075; pointer-events:none;
    background-image:radial-gradient(circle at 20% 30%,#fff 0 .5px,transparent .8px),
      radial-gradient(circle at 80% 70%,#fff 0 .5px,transparent .8px);
    background-size:7px 7px,9px 9px;
  }

  .engine-bar {
    position:absolute; z-index:7; top:5%; left:5%; right:5%; display:flex;
    align-items:center; justify-content:space-between; gap:.75rem;
  }
  .engine-brand { display:flex; align-items:center; gap:.52rem; min-width:0; }
  .brand-mark {
    display:grid; place-items:center; width:34px; height:34px; flex:0 0 34px;
    border:1px solid rgba(255,255,255,.24); border-radius:12px; background:rgba(255,255,255,.1);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.16); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);
  }
  .brand-mark img { width:25px; height:25px; object-fit:contain; }
  .brand-copy { display:grid; color:#fff; line-height:1.05; }
  .brand-copy b { font-size:.64rem; letter-spacing:.11em; }
  .brand-copy small { margin-top:.18rem; color:#94a3b8; font-size:.45rem; font-weight:800; letter-spacing:.12em; }

  .engine-live {
    display:inline-flex; align-items:center; gap:.32rem; padding:.32rem .52rem;
    border:1px solid rgba(34,197,94,.24); border-radius:999px; color:#bbf7d0;
    background:rgba(15,23,42,.5); font-size:.5rem; font-weight:900; letter-spacing:.09em;
    backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);
  }
  .engine-live i {
    width:6px; height:6px; border-radius:50%; background:#4ade80;
    box-shadow:0 0 0 4px rgba(74,222,128,.13),0 0 12px #4ade80;
    animation:livePulse 1.8s ease-in-out infinite;
  }

  .prompt-console,.ai-glass-card {
    border:1px solid rgba(255,255,255,.25);
    background:linear-gradient(135deg,rgba(15,23,42,.72),rgba(30,41,59,.38));
    box-shadow:0 18px 44px rgba(2,6,23,.2),inset 0 1px 0 rgba(255,255,255,.16);
    backdrop-filter:blur(13px) saturate(1.22); -webkit-backdrop-filter:blur(13px) saturate(1.22);
  }

  .prompt-console {
    position:absolute; z-index:8; left:4.5%; top:20%; display:flex; align-items:center; gap:.62rem;
    min-width:52%; padding:.68rem .82rem; border-radius:20px 20px 20px 7px; color:#fff;
  }
  .prompt-icon {
    display:grid; place-items:center; width:31px; height:31px; flex:0 0 31px; border-radius:11px;
    color:#fff; background:linear-gradient(135deg,var(--orange),var(--pink));
    box-shadow:0 8px 22px rgba(255,107,24,.3),0 0 20px rgba(236,72,153,.2);
  }
  .prompt-console>span:nth-child(2) { display:grid; line-height:1.15; }
  .prompt-console small { color:#fdba74; font-size:.45rem; font-weight:900; letter-spacing:.12em; }
  .prompt-console b { margin-top:.22rem; font-size:.61rem; font-weight:700; }
  .typing-caret { width:2px; height:25px; margin-left:auto; border-radius:99px; background:var(--cyan); box-shadow:0 0 10px var(--cyan); animation:caretBlink 1s steps(1) infinite; }

  .ai-nucleus {
    position:absolute; z-index:6; right:11%; top:27%; display:grid; place-items:center;
    width:32%; aspect-ratio:1; animation:nucleusFloat 4s ease-in-out infinite alternate;
  }
  .ray-field {
    position:absolute; inset:-44%; border-radius:50%;
    background:repeating-conic-gradient(from 0deg,transparent 0 11deg,rgba(34,211,238,.42) 12deg 13deg,
      transparent 14deg 27deg,rgba(255,154,74,.32) 28deg 29deg,transparent 30deg 45deg);
    -webkit-mask-image:radial-gradient(circle,transparent 0 27%,#000 42%,transparent 72%);
    mask-image:radial-gradient(circle,transparent 0 27%,#000 42%,transparent 72%);
    animation:rayRotate 18s linear infinite;
  }
  .orbit { position:absolute; border:1px solid rgba(165,243,252,.5); border-radius:50%; }
  .orbit-a { inset:10%; animation:orbitRotate 8s linear infinite; }
  .orbit-b { inset:-3%; border-style:dashed; border-color:rgba(196,181,253,.46); animation:orbitReverse 13s linear infinite; }
  .orbit-c { inset:-17%; border-color:rgba(96,165,250,.22); animation:orbitBreathe 2.8s ease-in-out infinite alternate; }
  .orbit-a i,.orbit-b i { position:absolute; width:8px; height:8px; border-radius:50%; }
  .orbit-a i { right:6%; top:18%; background:var(--cyan); box-shadow:0 0 16px var(--cyan),0 0 0 5px rgba(34,211,238,.12); }
  .orbit-b i { left:4%; bottom:22%; background:var(--orange-soft); box-shadow:0 0 16px var(--orange),0 0 0 5px rgba(255,107,24,.12); }

  .core {
    position:relative; z-index:3; display:grid; place-items:center; width:49%; aspect-ratio:1;
    border:1px solid rgba(255,255,255,.42); border-radius:44% 56% 61% 39%/48% 41% 59% 52%;
    color:#fff; background:linear-gradient(135deg,var(--orange),var(--pink) 38%,var(--purple) 67%,var(--blue));
    box-shadow:0 0 28px rgba(34,211,238,.4),0 0 58px rgba(124,58,237,.62),0 0 90px rgba(29,78,216,.25),inset 0 1px 5px rgba(255,255,255,.4);
    animation:coreMorph 6s ease-in-out infinite alternate;
  }
  .core strong { font:900 clamp(1.2rem,3.4vw,1.85rem)/1 'Li Ador Noirrit'; letter-spacing:-.04em; text-shadow:0 0 10px rgba(255,255,255,.85),0 0 24px rgba(34,211,238,.8); }
  .core small { position:absolute; top:78%; color:#e0e7ff; font-size:.34rem; font-weight:900; line-height:1.15; letter-spacing:.11em; text-align:center; }

  .film-message { position:absolute; z-index:6; left:6%; bottom:17%; color:#fff; text-shadow:0 5px 24px rgba(0,0,0,.65); }
  .film-message small { display:block; color:var(--orange-soft); font-size:.48rem; font-weight:900; letter-spacing:.17em; }
  .film-message strong { display:block; margin-top:.36rem; font:800 clamp(1.22rem,3.9vw,1.8rem)/.98 'Li Ador Noirrit'; letter-spacing:-.025em; }

  .campaign-flow { position:absolute; z-index:7; left:6%; bottom:7.5%; display:flex; align-items:center; gap:.35rem; }
  .campaign-flow span { display:inline-flex; align-items:center; gap:.24rem; }
  .campaign-flow i {
    display:grid; place-items:center; width:18px; height:18px; border:1px solid rgba(255,255,255,.23);
    border-radius:50%; color:#bfdbfe; background:rgba(15,23,42,.7); font-size:.32rem; font-style:normal; font-weight:900;
  }
  .campaign-flow b { color:#e2e8f0; font-size:.45rem; letter-spacing:.03em; }
  .campaign-flow span:nth-of-type(2) b { color:#fdba74; }
  .campaign-flow em { position:relative; width:20px; height:1px; overflow:visible; background:linear-gradient(90deg,var(--orange-soft),var(--cyan)); }
  .campaign-flow em::after {
    content:''; position:absolute; top:-2px; left:0; width:5px; height:5px; border-radius:50%;
    background:#fff; box-shadow:0 0 8px #fff; animation:flowTravel 1.8s linear infinite;
  }

  .format-deck { position:absolute; z-index:7; right:5.5%; bottom:7%; width:31%; height:23%; }
  .format {
    position:absolute; bottom:0; overflow:hidden; display:flex; align-items:flex-end; justify-content:center;
    padding:.26rem; border:1px solid rgba(255,255,255,.3); border-radius:8px; color:#fff;
    background:rgba(15,23,42,.72); box-shadow:0 10px 28px rgba(0,0,0,.32); transform-origin:bottom center;
  }
  .format i { position:absolute; z-index:-1; inset:3px; border-radius:5px; background:linear-gradient(150deg,rgba(255,107,24,.95),rgba(124,58,237,.9) 52%,rgba(29,78,216,.95)); opacity:.78; }
  .format b { font-size:.38rem; }
  .format-vertical { left:2%; width:25%; height:78%; transform:rotate(-10deg); }
  .format-square { left:30%; width:34%; aspect-ratio:1; transform:translateY(-5px); }
  .format-wide { right:0; width:45%; height:45%; transform:rotate(8deg); }

  .scene-progress { position:absolute; z-index:8; left:6%; right:6%; bottom:3.5%; display:flex; gap:5px; height:3px; }
  .scene-progress span { flex:1; border-radius:99px; background:rgba(255,255,255,.15); }
  .scene-progress span:first-child { background:linear-gradient(90deg,var(--orange),var(--pink)); }
  .scene-progress i {
    position:absolute; left:0; top:-2px; width:7px; height:7px; border-radius:50%;
    background:#fff; box-shadow:0 0 12px #fff,0 0 22px var(--cyan); animation:progressTravel 14s linear infinite;
  }

  .ai-glass-card {
    position:absolute; z-index:9; display:flex; align-items:center; gap:.48rem; padding:.48rem .66rem;
    border-radius:17px 17px 17px 7px; color:#fff; animation:cardFloat 4.4s ease-in-out infinite alternate;
  }
  .ai-glass-card>span:last-child { display:grid; line-height:1.05; }
  .ai-glass-card small { color:#94a3b8; font-size:.42rem; font-weight:900; letter-spacing:.09em; }
  .ai-glass-card b { margin-top:.18rem; font-size:.56rem; white-space:nowrap; }
  .card-icon { display:grid; place-items:center; width:28px; height:28px; flex:0 0 28px; border-radius:10px; font-size:.7rem; font-weight:900; }
  .card-icon.purple { background:linear-gradient(135deg,var(--purple),var(--pink)); box-shadow:0 8px 20px rgba(124,58,237,.35); }
  .card-icon.cyan { background:linear-gradient(135deg,var(--blue),var(--cyan)); box-shadow:0 8px 20px rgba(34,211,238,.28); }
  .card-icon.orange { background:linear-gradient(135deg,var(--orange),var(--orange-soft)); box-shadow:0 8px 20px rgba(255,107,24,.3); }
  .glass-identity { right:0; top:20%; animation-delay:-.8s; }
  .glass-motion { right:-1%; top:50%; animation-delay:-2.4s; }
  .glass-scale { left:0; bottom:9%; animation-delay:-3.3s; }

  .future-note { position:absolute; z-index:10; right:5%; bottom:1%; display:flex; align-items:center; gap:.34rem; color:#475569; font-size:.52rem; font-weight:700; }
  .future-note span { color:var(--purple); animation:noteTwinkle 2s ease-in-out infinite; }

  .is-paused * { animation-play-state:paused !important; }
  .motion-ready .film-shell,.motion-ready .ai-glass-card,.motion-ready .future-note { opacity:0; }
  .motion-ready.is-visible .film-shell { animation:stageReveal .72s cubic-bezier(.16,1,.3,1) both; }
  .motion-ready.is-visible .ai-glass-card {
    animation:cardReveal .58s cubic-bezier(.16,1,.3,1) both;
  }
  .motion-ready.is-visible .glass-identity { animation-delay:.16s; }
  .motion-ready.is-visible .glass-motion { animation-delay:.25s; }
  .motion-ready.is-visible .glass-scale { animation-delay:.34s; }
  .motion-ready.is-visible .future-note { animation:noteReveal .55s .42s cubic-bezier(.16,1,.3,1) both; }

  @keyframes ambientMove { to { transform:translate3d(5%,-4%,0) scale(1.09); } }
  @keyframes signalTravel { to { stroke-dashoffset:-1; } }
  @keyframes sceneFirst {
    0%,42% { opacity:1; transform:translate3d(0,0,0) scale(1.04); }
    49%,92% { opacity:0; transform:translate3d(-6%,0,0) scale(1.085); }
    93% { opacity:0; transform:translate3d(6%,0,0) scale(1.04); }
    100% { opacity:1; transform:translate3d(0,0,0) scale(1.04); }
  }
  @keyframes sceneSecond {
    0%,42% { opacity:0; transform:translate3d(6%,0,0) scale(1.04); }
    49%,91% { opacity:1; transform:translate3d(0,0,0) scale(1.085); }
    98%,100% { opacity:0; transform:translate3d(-6%,0,0) scale(1.04); }
  }
  @keyframes scanAcross {
    0%,12% { transform:translateX(0) skewX(-14deg); opacity:0; }
    35% { opacity:1; }
    72%,100% { transform:translateX(660%) skewX(-14deg); opacity:0; }
  }
  @keyframes livePulse { 50% { opacity:.38; transform:scale(.7); } }
  @keyframes caretBlink { 50% { opacity:0; } }
  @keyframes nucleusFloat { to { transform:translate3d(0,-8px,0) rotate(1.4deg); } }
  @keyframes rayRotate { to { transform:rotate(360deg); } }
  @keyframes orbitRotate { to { transform:rotate(360deg); } }
  @keyframes orbitReverse { to { transform:rotate(-360deg); } }
  @keyframes orbitBreathe { to { transform:scale(1.12); opacity:.28; } }
  @keyframes coreMorph { to { border-radius:61% 39% 43% 57%/39% 57% 43% 61%; filter:saturate(1.18); } }
  @keyframes flowTravel { to { left:calc(100% - 5px); } }
  @keyframes progressTravel { to { left:calc(100% - 7px); } }
  @keyframes cardFloat { to { transform:translate3d(4px,-7px,0); } }
  @keyframes noteTwinkle { 50% { opacity:.4; transform:rotate(20deg) scale(.78); } }
  @keyframes stageReveal {
    from { opacity:0; transform:perspective(1200px) translate3d(0,24px,0) scale(.96) rotateY(-2deg); }
    to { opacity:1; transform:perspective(1200px) translate3d(0,0,0) scale(1) rotateY(-1.5deg) rotateX(.5deg); }
  }
  @keyframes cardReveal {
    from { opacity:0; transform:translate3d(0,16px,0) scale(.86); }
    to { opacity:1; transform:translate3d(0,0,0) scale(1); }
  }
  @keyframes noteReveal { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }

  @media (max-width:900px) {
    .cinematic-hero { width:min(100%,460px); aspect-ratio:1.04/1; }
    .film-shell { inset:8% 3% 9% 4%; border-radius:44px 88px 50px 98px/60px 72px 84px 92px; transform:none; }
    .energy-loop { inset:4% 0 5%; width:100%; height:91%; }
    .glass-identity { right:0; top:20%; }
    .glass-motion { right:0; top:51%; }
    .glass-scale { left:0; bottom:8%; }
  }

  @media (max-width:640px) {
    .cinematic-hero { width:100%; max-width:390px; aspect-ratio:1/1.02; }
    .ambient-light { inset:7% 0 2%; opacity:.52; filter:blur(18px); }
    .ambient-light i { animation:none; }
    .film-shell {
      inset:9% 1.5% 9% 2%; border-radius:38px 76px 44px 88px/54px 62px 74px 80px;
      box-shadow:0 24px 54px rgba(15,23,42,.22),0 9px 24px rgba(37,99,235,.12);
    }
    .energy-loop { inset:5% 0 5%; height:90%; }
    .energy-signal { stroke-width:1.5; }
    .brand-mark { width:29px; height:29px; flex-basis:29px; border-radius:10px; backdrop-filter:blur(5px); -webkit-backdrop-filter:blur(5px); }
    .brand-mark img { width:22px; height:22px; }
    .brand-copy b { font-size:.54rem; }
    .brand-copy small { font-size:.38rem; }
    .engine-live { padding:.28rem .42rem; font-size:.42rem; }

    .prompt-console {
      left:3.5%; top:18%; min-width:56%; gap:.42rem; padding:.52rem .58rem;
