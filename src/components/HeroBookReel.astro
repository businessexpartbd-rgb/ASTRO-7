---
/**
 * Hero video stage — reference animation layout:
 * soft aura, single center 16:9 card, bottom glass icon-strip,
 * 3s auto cycle, click thumb → main, continuous muted play,
 * no text, no play button, no channel logo, no side peeks, no black flash.
 */
import { SHOWCASES, ytThumb } from '../data/site';

/* Landscape / long-form only (16:9) — no shorts */
const longIds = [
  ...SHOWCASES.find((s) => s.id === 'cinematic')!.ids,
  ...SHOWCASES.find((s) => s.id === 'custom')!.ids,
];

const starts = [4, 9, 6, 12, 5, 11, 7, 14, 8, 10, 3, 13];

const clips = longIds.map((id, i) => ({
  id,
  thumb: ytThumb(id),
  start: starts[i % starts.length],
}));
---

<div class="hv" data-hv role="img" aria-label="Video showcase">
  <div class="hv-aura" aria-hidden="true"></div>

  <!-- Single center stage — no side cards -->
  <div class="hv-center">
    <div class="hv-card" data-card>
      <img class="hv-poster" data-poster src={clips[0].thumb} alt="" width="1280" height="720" decoding="async" fetchpriority="high" />
      <div class="hv-layer" data-layer></div>
    </div>
  </div>

  <!-- Bottom glass strip — same videos as thumbs -->
  <div class="hv-dock" data-dock>
    <div class="hv-dock-track" data-track>
      {clips.map((c, i) => (
        <button
          type="button"
          class:list={['hv-btn', i === 0 && 'is-on']}
          data-btn
          data-i={String(i)}
          data-yt={c.id}
          data-start={String(c.start)}
          data-src={c.thumb}
          aria-label={`Clip ${i + 1}`}
        >
          <img src={c.thumb} alt="" width="80" height="45" loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .hv {
    --r: 22px;
    position: relative;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
    padding: 1.75rem 0.5rem 0.35rem;
  }

  /* Soft multi-hue glow — matches reference */
  .hv-aura {
    position: absolute;
    left: 50%;
    top: 36%;
    width: 110%;
    height: 72%;
    translate: -50% -50%;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(circle at 28% 42%, rgba(253, 186, 116, 0.35), transparent 52%),
      radial-gradient(circle at 72% 38%, rgba(196, 181, 253, 0.38), transparent 50%),
      radial-gradient(circle at 50% 68%, rgba(110, 231, 183, 0.28), transparent 55%),
      radial-gradient(circle at 55% 48%, rgba(147, 197, 253, 0.3), transparent 58%);
    filter: blur(32px);
    animation: hv-breathe 5.5s ease-in-out infinite alternate;
  }
  @keyframes hv-breathe {
    from { opacity: 0.7; transform: scale(0.98); }
    to { opacity: 1; transform: scale(1.05); }
  }

  .hv-center {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
  }

  .hv-card {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--r);
    overflow: hidden;
    background: #f8fafc;
    box-shadow:
      0 28px 56px rgba(15, 23, 42, 0.12),
      0 0 0 1px rgba(255, 255, 255, 0.7);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease, filter 0.4s ease;
  }

  /* Crossfade states */
  .hv-card.is-out {
    opacity: 0;
    transform: scale(0.94) translateY(6px);
    filter: blur(6px);
  }
  .hv-card.is-in {
    animation: hv-pop 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes hv-pop {
    from { opacity: 0; transform: scale(0.94) translateY(8px); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  .hv-poster,
  .hv-layer,
  .hv-layer iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .hv-poster {
    object-fit: cover;
    z-index: 1;
    /* always visible under player — prevents black flash */
    background: #e2e8f0;
  }

  .hv-layer {
    z-index: 2;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .hv-layer.is-live {
    opacity: 1;
  }

  .hv-layer iframe {
    pointer-events: none;
    /* crop YouTube chrome / logo / any residual controls */
    width: 100%;
    height: 100%;
    transform: scale(1.28);
    transform-origin: center center;
  }

  /* Bottom dock — glass buttons, active larger (reference style) */
  .hv-dock {
    position: relative;
    z-index: 2;
    margin-top: 1.35rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .hv-dock-track {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.55rem;
    padding: 0.55rem 1rem 0.65rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .hv-dock-track::-webkit-scrollbar { display: none; }

  .hv-btn {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    border-radius: 14px;
    overflow: hidden;
    cursor: pointer;
    scroll-snap-align: center;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      0 6px 18px rgba(15, 23, 42, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
    opacity: 0.55;
    transform: scale(0.88);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease,
      box-shadow 0.3s ease,
      width 0.35s ease,
      height 0.35s ease;
  }
  .hv-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hv-btn.is-on {
    width: 58px;
    height: 58px;
    opacity: 1;
    transform: scale(1);
    border-radius: 16px;
    box-shadow:
      0 12px 28px rgba(15, 23, 42, 0.14),
      0 0 0 2px rgba(255, 255, 255, 0.95),
      inset 0 1px 0 #fff;
  }
  .hv-btn:hover {
    opacity: 0.9;
  }

  @media (max-width: 767px) {
    .hv {
      max-width: 100%;
      padding: 1rem 0.15rem 0.25rem;
      --r: 16px;
    }
    .hv-aura {
      width: 120%;
      height: 68%;
      filter: blur(24px);
    }
    .hv-dock { margin-top: 1.1rem; }
    .hv-btn {
      width: 42px;
      height: 42px;
      border-radius: 12px;
    }
    .hv-btn.is-on {
      width: 50px;
      height: 50px;
      border-radius: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hv-aura { animation: none !important; }
    .hv-card.is-in { animation: none !important; }
  }
</style>

<script is:inline>
(function () {
  var root = document.querySelector('[data-hv]');
  if (!root) return;

  var btns = Array.prototype.slice.call(root.querySelectorAll('[data-btn]'));
  if (!btns.length) return;

  var card = root.querySelector('[data-card]');
  var poster = root.querySelector('[data-poster]');
  var layer = root.querySelector('[data-layer]');
  var track = root.querySelector('[data-track]');

  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var visible = true;
  var idx = 0;
  var timer = null;
  var switching = false;
  var HOLD = 3000; /* exactly ~3 seconds */

  function item(i) {
    var b = btns[((i % btns.length) + btns.length) % btns.length];
    return {
      id: b.getAttribute('data-yt'),
      start: parseInt(b.getAttribute('data-start') || '4', 10),
      src: b.getAttribute('data-src'),
      el: b,
    };
  }

  function embedUrl(id, start) {
    var s = start || 4;
    var e = s + 8; /* slightly longer than hold so it never ends early */
    return (
      'https://www.youtube-nocookie.com/embed/' + id +
      '?autoplay=1&mute=1&controls=0&rel=0&modestbranding=1&playsinline=1' +
      '&iv_load_policy=3&disablekb=1&fs=0&cc_load_policy=0' +
      '&start=' + s + '&end=' + e +
      '&loop=1&playlist=' + id +
      '&origin=' + encodeURIComponent(location.origin || '')
    );
  }

  function paintPoster(src) {
    if (poster && src) {
      poster.src = src;
      poster.style.opacity = '1';
    }
  }

  function mount(id, start) {
    if (!layer || reduced || !visible) return;
    /* keep poster under iframe so no black frame */
    layer.classList.remove('is-live');
    layer.innerHTML =
      '<iframe title="" src="' + embedUrl(id, start) + '" ' +
      'allow="autoplay; encrypted-media; picture-in-picture" ' +
      'referrerpolicy="strict-origin-when-cross-origin" tabindex="-1"></iframe>';
    /* reveal after a tick so first paint is poster, not black */
    requestAnimationFrame(function () {
      setTimeout(function () {
        if (layer) layer.classList.add('is-live');
      }, 120);
    });
  }

  function clearLayer() {
    if (layer) {
      layer.classList.remove('is-live');
      layer.innerHTML = '';
    }
  }

  function centerBtn(i) {
    var el = btns[i];
    if (!el || !track) return;
    var left = el.offsetLeft - track.clientWidth / 2 + el.clientWidth / 2;
    track.scrollTo({ left: Math.max(0, left), behavior: reduced ? 'auto' : 'smooth' });
  }

  function mark(i) {
    btns.forEach(function (b, j) {
      b.classList.toggle('is-on', j === i);
    });
    centerBtn(i);
  }

  function go(i, animate) {
    if (switching) return;
    idx = ((i % btns.length) + btns.length) % btns.length;
    var c = item(idx);
    mark(idx);

    function apply() {
      paintPoster(c.src);
      if (visible && !reduced) mount(c.id, c.start);
      else clearLayer();
      switching = false;
    }

    if (animate && card && !reduced) {
      switching = true;
      card.classList.remove('is-in');
      card.classList.add('is-out');
      setTimeout(function () {
        card.classList.remove('is-out');
        apply();
        card.classList.add('is-in');
        setTimeout(function () {
          if (card) card.classList.remove('is-in');
        }, 450);
      }, 320);
    } else {
      apply();
    }
  }

  function schedule() {
    if (timer) clearTimeout(timer);
    if (!visible || reduced) return;
    timer = setTimeout(function () {
      go(idx + 1, true);
      schedule();
    }, HOLD);
  }

  function start() {
    go(idx, false);
    schedule();
  }

  function stop() {
    if (timer) clearTimeout(timer);
    timer = null;
    clearLayer();
  }

  btns.forEach(function (b, i) {
    b.addEventListener('click', function () {
      go(i, true);
      schedule();
    });
  });

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        visible = e.isIntersecting;
        if (visible) start();
        else stop();
      });
    }, { threshold: 0.1 });
    io.observe(root);
  } else {
    start();
  }

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stop();
    else if (visible) start();
  });
})();
</script>
