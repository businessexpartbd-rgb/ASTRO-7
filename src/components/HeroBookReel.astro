---
/** Premium original-media AI + professional video production hero. */
const heroPosters = [
  '/media/hero-studio-bangladesh.webp',
  '/media/hero-ai-product.webp',
  '/media/hero-edit-suite.webp',
];
const heroSmall = (poster: string) => poster.replace('.webp', '-480.webp');
const steps = ['Studio opening', 'AI enhancement', 'Image to video', 'Cinematic result', 'Pro editing', 'Human quality', 'Campaign ready'];
---
<div class="vs" data-video-studio aria-label="Creavix AI and professional video production workflow">
  <div class="vs-aura" aria-hidden="true"></div>
  <div class="vs-window">
    <div class="vs-titlebar">
      <div class="vs-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="vs-brand"><img src="/media/creavix-original-logo-56.webp" alt="" width="28" height="28" /><strong>CREAVIX STUDIO</strong></div>
      <div class="vs-live"><i></i> LIVE WORKFLOW</div>
    </div>

    <div class="vs-screen">
      <div class="vs-panel is-active" data-scene="0">
        <div class="studio-opening">
          <div class="opening-reel" aria-label="Creavix cinematic production studio">
            {heroPosters.map((poster, i) => (
              <img src={poster} srcset={`${heroSmall(poster)} 480w, ${poster} 960w`} sizes="(max-width: 899px) 350px, 480px" alt={i === 0 ? 'Creavix cinematic production studio' : ''} width="960" height="540" decoding="async" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} />
            ))}
          </div>
          <div class="opening-grade"></div><div class="opening-scan"></div><div class="opening-grain"></div>
          <div class="opening-top"><span class="scene-kicker">01 · CREAVIX ORIGINAL PRODUCTION</span><b><i></i> REC 00:00:12:18</b></div>
          <div class="opening-focus" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <div class="opening-copy"><small>AI × CAMERA × HUMAN DIRECTION</small><strong>Ideas in motion.<br />Stories that stop the scroll.</strong><span><i></i> 4K MASTERING</span></div>
          <div class="opening-timeline" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
        </div>
      </div>

      <div class="vs-panel" data-scene="1">
        <div class="enhance-lab">
          <span class="scene-kicker">02 · AI image enhancement</span>
          <div class="compare-stage"><div class="compare-side"><img src={heroPosters[0]} srcset={`${heroSmall(heroPosters[0])} 480w, ${heroPosters[0]} 960w`} sizes="350px" alt="" width="480" height="360" loading="lazy" /><b>ORIGINAL</b></div><div class="compare-side enhanced"><img src={heroPosters[1]} srcset={`${heroSmall(heroPosters[1])} 480w, ${heroPosters[1]} 960w`} sizes="350px" alt="" width="480" height="360" loading="lazy" /><b>ENHANCED</b></div><i class="compare-scan"></i></div>
          <div class="ai-mini-tools"><span><b>ChatGPT</b> Concept</span><span><img src="/brands/googlegemini.svg" alt="" />Gemini</span><span><b>G</b> Grok</span><span><b>◆</b> Identity Lock</span></div>
        </div>
      </div>

      <div class="vs-panel" data-scene="2">
        <div class="ai-console">
          <div class="prompt-box">
            <span class="scene-kicker">03 · Image-to-video</span>
            <p><b>Prompt</b> Human-like product film,<br />cinematic light, authentic emotion…</p>
            <span class="typing-line"></span>
          </div>
          <div class="generation-core" aria-hidden="true">
            <div class="core-ring ring-a"></div><div class="core-ring ring-b"></div>
            <div class="core-logo">AI</div>
          </div>
          <div class="frame-stack" aria-hidden="true">
            <i><img src={heroSmall(heroPosters[1])} alt="" width="480" height="360" loading="lazy" decoding="async" /></i>
            <i><img src={heroSmall(heroPosters[2])} alt="" width="480" height="360" loading="lazy" decoding="async" /></i>
            <i><img src={heroSmall(heroPosters[0])} alt="" width="480" height="360" loading="lazy" decoding="async" /></i>
          </div>
        </div>
      </div>

      <div class="vs-panel" data-scene="3">
        <div class="cinema-frame">
          <div class="cinema-reel" aria-label="Original Creavix cinematic concept preview">
            {heroPosters.map((poster, i) => (
              <img src={poster} srcset={`${heroSmall(poster)} 480w, ${poster} 960w`} sizes="(max-width: 899px) 350px, 480px" alt={i === 0 ? 'Bangladeshi cinematic production studio' : ''} width="960" height="540" decoding="async" loading="lazy" fetchpriority="low" />
            ))}
          </div>
          <div class="cinema-light"></div>
          <span class="scene-kicker cinema-kicker">04 · Human-like visual</span>
          <span class="cinema-rec"><i></i> REC</span>
          <div class="cinema-caption"><strong>Cinematic. Authentic. Different.</strong><small>Real Creavix work · AI precision × human direction</small></div>
        </div>
      </div>

      <div class="vs-panel" data-scene="4">
        <div class="edit-suite">
          <div class="edit-preview">
            <img src={heroSmall(heroPosters[2])} alt="" width="480" height="360" loading="lazy" decoding="async" />
            <div class="play-icon" aria-hidden="true"></div>
          </div>
          <div class="edit-controls">
            <span class="scene-kicker">05 · Professional finishing</span>
            <div class="edit-labels"><b>Color</b><b>Sound</b><b>Motion</b><b>Story</b></div>
            <div class="timeline">
              <div class="track video"><i></i><i></i><i></i></div>
              <div class="track audio"><i></i><i></i></div>
              <div class="track effects"><i></i><i></i><i></i></div>
              <span class="playhead"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="vs-panel" data-scene="5">
        <div class="quality-lab">
          <img src={heroPosters[2]} srcset={`${heroSmall(heroPosters[2])} 480w, ${heroPosters[2]} 960w`} sizes="(max-width: 899px) 350px, 480px" alt="Creavix team reviewing final production" width="960" height="540" loading="lazy" />
          <div class="quality-copy"><span class="scene-kicker">06 · Human quality control</span><strong>AI Precision × Human Creativity</strong></div>
          <div class="quality-grid"><span>✓ Face consistency</span><span>✓ Product accuracy</span><span>✓ Natural motion</span><span>✓ Brand colour</span><span>✓ Sound sync</span><span>✓ Final review</span></div>
        </div>
      </div>

      <div class="vs-panel" data-scene="6">
        <div class="delivery">
          <div class="delivery-rings" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="delivery-card">
            <span class="delivery-check">✓</span>
            <span class="scene-kicker">07 · Campaign ready</span>
            <strong>One idea.<br />Every screen.</strong>
            <div class="format-row"><span>9:16</span><span>1:1</span><span>16:9</span></div>
          </div>
          <div class="device phone" aria-hidden="true"><i style={`background-image:url('${heroSmall(heroPosters[1])}')`}></i></div>
          <div class="device desktop" aria-hidden="true"><i style={`background-image:url('${heroSmall(heroPosters[0])}')`}></i></div>
        </div>
      </div>

      <div class="vs-corner top-left" aria-hidden="true"></div><div class="vs-corner top-right" aria-hidden="true"></div>
      <div class="vs-corner bottom-left" aria-hidden="true"></div><div class="vs-corner bottom-right" aria-hidden="true"></div>
    </div>

    <div class="vs-status">
      <div class="vs-progress"><i data-progress></i></div>
      <div class="vs-step-copy"><span data-step-number>01</span><strong data-step-label>Studio opening</strong></div>
      <div class="vs-quality"><span>4K</span><span>AI + HUMAN</span><span>24–48H</span></div>
    </div>
  </div>

  <div class="vs-nav" aria-label="Video production animation steps">
    {steps.map((step, i) => (
      <button type="button" class:list={['vs-nav-btn', { 'is-active': i === 0 }]} data-step={i} aria-label={step} aria-pressed={i === 0 ? 'true' : 'false'}>
        <span>{String(i + 1).padStart(2, '0')}</span>
      </button>
    ))}
  </div>
  <div class="vs-float-chip chip-ai"><i>✦</i><span>Human-like AI</span></div>
  <div class="vs-float-chip chip-pro"><i>◆</i><span>Pro Editing</span></div>
  <div class="editor-orbit" aria-label="Professional editing applications used by Creavix">
    <span class="editor-node node-pr"><i>Pr</i><b>Premiere Pro</b></span>
    <span class="editor-node node-ae"><i>Ae</i><b>After Effects</b></span>
    <span class="editor-node node-cap"><i>✂</i><b>CapCut</b></span>
    <span class="editor-node node-film"><i><img src="/brands/wondersharefilmora.svg" alt="" width="20" height="20" /></i><b>Filmora</b></span>
  </div>
  <div class="tool-orbit" aria-label="Creative production tools">
    <span class="tool-badge wa"><i><img src="/brands/whatsapp.svg" alt="" /></i>WhatsApp</span>
    <span class="tool-badge pr"><i>Pr</i>Premiere Pro</span>
    <span class="tool-badge ae"><i>Ae</i>After Effects</span>
    <span class="tool-badge cap"><i>✂</i>CapCut</span>
    <span class="tool-badge film"><i><img src="/brands/wondersharefilmora.svg" alt="" /></i>Filmora</span>
    <span class="tool-badge gem"><i><img src="/brands/googlegemini.svg" alt="" /></i>Gemini</span>
    <span class="tool-badge grok"><i>G</i>Grok</span>
    <span class="tool-badge kling"><i>K</i>Kling</span>
    <span class="tool-badge veo"><i>V</i>Veo</span>
  </div>
  <div class="action-rig" aria-hidden="true">
    <span class="rig-light"></span>
    <span class="rig-camera"><i></i></span>
    <span class="rig-clap"><i></i></span>
    <strong>READY <b>●</b> ACTION</strong>
  </div>
</div>

<style>
  .vs{--blue:#2563eb;--ink:#0b1220;position:relative;width:100%;max-width:520px;margin:0 auto;padding:1.25rem .3rem .4rem;isolation:isolate}
  .vs-aura{position:absolute;inset:5% -12% 2%;z-index:-1;border-radius:50%;background:radial-gradient(circle at 25% 30%,rgba(37,99,235,.28),transparent 42%),radial-gradient(circle at 76% 25%,rgba(168,85,247,.24),transparent 43%),radial-gradient(circle at 60% 85%,rgba(249,115,22,.18),transparent 42%);filter:blur(30px);animation:aura 5s ease-in-out infinite alternate;pointer-events:none}
  .vs-window{overflow:hidden;border:1px solid rgba(255,255,255,.9);border-radius:22px;background:rgba(255,255,255,.9);box-shadow:0 30px 80px rgba(15,23,42,.16),0 7px 20px rgba(37,99,235,.08);transform:perspective(1200px) rotateY(-2deg) rotateX(1deg);transform-origin:center}
  .vs-titlebar{height:42px;padding:0 .8rem;display:flex;align-items:center;border-bottom:1px solid #e7ebf2;background:rgba(255,255,255,.96)}
  .vs-dots{display:flex;gap:5px}.vs-dots i{width:7px;height:7px;border-radius:50%;background:#ff665d}.vs-dots i:nth-child(2){background:#ffbd2e}.vs-dots i:nth-child(3){background:#27c840}
  .vs-brand{display:flex;align-items:center;gap:.35rem;margin-left:.75rem;color:#0f172a;font-size:.58rem;letter-spacing:.09em}.vs-brand img{width:26px;height:26px;object-fit:contain}
  .vs-live{margin-left:auto;display:flex;align-items:center;gap:.3rem;color:#64748b;font-size:.5rem;font-weight:800;letter-spacing:.08em}.vs-live i{width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.12);animation:blink 1.4s ease-in-out infinite}
  .vs-screen{position:relative;aspect-ratio:16/10;overflow:hidden;background:#0b1220}
  .vs-panel{position:absolute;inset:0;opacity:0;transform:translate3d(18px,0,0) scale(.985);transition:opacity .42s ease,transform .52s cubic-bezier(.2,.8,.2,1);pointer-events:none}.vs-panel.is-active{opacity:1;transform:none;pointer-events:auto}
  .scene-kicker{display:block;color:#60a5fa;font-size:.52rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
  .studio-opening{position:relative;height:100%;overflow:hidden;background:#050914}.opening-reel{position:absolute;inset:0}.opening-reel img{position:absolute;inset:-4%;width:108%;height:108%;object-fit:cover;opacity:0;filter:saturate(1.08) contrast(1.05);animation:openingCut 7.8s linear infinite,openingCamera 5.2s cubic-bezier(.2,.65,.3,1) infinite alternate}.opening-reel img:nth-child(2){animation-delay:-5.2s,-1.7s}.opening-reel img:nth-child(3){animation-delay:-2.6s,-3.4s}.opening-grade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,7,18,.88),rgba(3,7,18,.16) 54%,rgba(3,7,18,.52)),linear-gradient(0deg,rgba(3,7,18,.72),transparent 48%);mix-blend-mode:multiply}.opening-scan{position:absolute;inset:-15% auto -15% -20%;width:24%;transform:skewX(-14deg);background:linear-gradient(90deg,transparent,rgba(147,197,253,.22),transparent);animation:openingScan 3.4s ease-in-out infinite}.opening-grain{position:absolute;inset:0;opacity:.13;background-image:radial-gradient(rgba(255,255,255,.8) .45px,transparent .55px);background-size:4px 4px;animation:grainShift .22s steps(2) infinite}.opening-top{position:absolute;z-index:3;left:5%;right:5%;top:7%;display:flex;align-items:center;justify-content:space-between;gap:.5rem}.opening-top b{display:flex;align-items:center;gap:.28rem;color:#fff;font-size:.42rem;letter-spacing:.08em}.opening-top b i{width:6px;height:6px;border-radius:50%;background:#ef4444;box-shadow:0 0 10px #ef4444;animation:blink 1s infinite}.opening-focus{position:absolute;z-index:2;inset:15% 5% 18%}.opening-focus i{position:absolute;width:19px;height:19px;border-color:rgba(255,255,255,.72);border-style:solid}.opening-focus i:nth-child(1){left:0;top:0;border-width:1px 0 0 1px}.opening-focus i:nth-child(2){right:0;top:0;border-width:1px 1px 0 0}.opening-focus i:nth-child(3){left:0;bottom:0;border-width:0 0 1px 1px}.opening-focus i:nth-child(4){right:0;bottom:0;border-width:0 1px 1px 0}.opening-copy{position:absolute;z-index:3;left:6%;bottom:14%;display:grid;gap:.25rem;color:#fff;text-shadow:0 3px 18px rgba(0,0,0,.75)}.opening-copy small{color:#93c5fd;font-size:.42rem;font-weight:800;letter-spacing:.14em}.opening-copy strong{font:800 clamp(.92rem,3.3vw,1.38rem)/1.05 Outfit,system-ui;letter-spacing:-.035em}.opening-copy>span{display:flex;align-items:center;gap:.28rem;color:#bbf7d0;font-size:.4rem;font-weight:800}.opening-copy>span i{width:16px;height:2px;background:#22c55e;box-shadow:0 0 8px #22c55e}.opening-timeline{position:absolute;z-index:3;left:5%;right:5%;bottom:6%;height:4px;display:flex;gap:3px}.opening-timeline i{flex:1;border-radius:5px;background:rgba(255,255,255,.22)}.opening-timeline i:nth-child(2){flex:1.5;background:linear-gradient(90deg,#2563eb,#8b5cf6)}.opening-timeline b{position:absolute;top:-3px;left:12%;width:2px;height:10px;background:#fff;box-shadow:0 0 8px #fff;animation:openingPlayhead 2.6s linear infinite}
  .wa-intake{height:100%;display:grid;grid-template-columns:.82fr 1.18fr;align-items:center;gap:7%;padding:7%;background:radial-gradient(circle at 15% 20%,#173a35,#09141d 58%)}.wa-phone{height:90%;overflow:hidden;border:4px solid #172033;border-radius:18px;background:#efeae2;box-shadow:0 18px 35px rgba(0,0,0,.42);transform:rotate(-2deg);animation:phoneIn 2.6s ease-in-out infinite alternate}.wa-head{height:18%;display:flex;align-items:center;gap:.35rem;padding:.45rem;background:#075e54;color:#fff;font-size:.5rem}.wa-head img{filter:brightness(0) invert(1)}.wa-head i{margin-left:auto}.wa-chat{height:82%;padding:.45rem;background:#efeae2}.wa-chat>span{display:block;width:max-content;margin:0 auto .3rem;padding:.12rem .35rem;border-radius:5px;background:#d9f1f5;color:#64748b;font-size:.37rem}.wa-photo{height:53%;overflow:hidden;border-radius:7px 7px 0 0}.wa-photo img{width:100%;height:100%;object-fit:cover}.wa-chat p{margin:0;padding:.32rem;border-radius:0 0 7px 7px;background:#d9fdd3;color:#263238;font-size:.42rem;line-height:1.35}.wa-chat small{color:#1aa7e8}.intake-copy strong{display:block;margin:.6rem 0;color:#fff;font:800 1.18rem/1.12 Outfit}.transfer-line{display:flex;align-items:center;gap:.35rem;color:#86efac;font-size:.4rem;letter-spacing:.09em}.transfer-line i{width:44%;height:2px;background:linear-gradient(90deg,#25d366,#60a5fa);position:relative}.transfer-line i:after{content:'›';position:absolute;right:-2px;top:-8px;font-size:.9rem;animation:transfer 1s linear infinite}
  .enhance-lab{height:100%;padding:6%;display:grid;grid-template-rows:auto 1fr auto;gap:.45rem;background:radial-gradient(circle at 70% 40%,#312e81,#090d18 65%)}.compare-stage{position:relative;display:grid;grid-template-columns:1fr 1fr;overflow:hidden;border:1px solid rgba(255,255,255,.2);border-radius:12px}.compare-side{position:relative;overflow:hidden;filter:saturate(.6)}.compare-side.enhanced{filter:saturate(1.25) contrast(1.05)}.compare-side img{width:100%;height:100%;display:block;object-fit:cover}.compare-side b{position:absolute;left:.4rem;bottom:.35rem;padding:.18rem .32rem;border-radius:4px;background:rgba(3,7,18,.72);color:#fff;font-size:.38rem}.compare-scan{position:absolute;z-index:2;top:0;bottom:0;left:50%;width:2px;background:#fff;box-shadow:0 0 18px 5px #60a5fa;animation:compare 3s ease-in-out infinite alternate}.ai-mini-tools{display:flex;gap:.3rem;overflow:hidden}.ai-mini-tools span{display:flex;align-items:center;gap:.22rem;padding:.26rem .36rem;border:1px solid rgba(255,255,255,.14);border-radius:6px;background:rgba(15,23,42,.72);color:#cbd5e1;font-size:.37rem;white-space:nowrap}.ai-mini-tools img{width:14px;height:14px}.ai-mini-tools b{color:#c4b5fd}
  .brief-board{height:100%;padding:12% 9%;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:7%;background:linear-gradient(135deg,#0f172a,#18264a)}
  .brief-copy strong{display:block;margin:.65rem 0 1rem;color:#fff;font:800 clamp(1rem,3vw,1.55rem)/1.15 Outfit,system-ui;letter-spacing:-.03em}.brief-tags{display:flex;gap:.35rem;flex-wrap:wrap}.brief-tags span{padding:.28rem .48rem;border:1px solid rgba(255,255,255,.14);border-radius:99px;color:#cbd5e1;font-size:.52rem}
  .storyboard{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:5px;transform:rotate(2deg)}.storyboard i{height:58px;border:2px solid rgba(255,255,255,.8);border-radius:8px;box-shadow:0 8px 22px rgba(0,0,0,.25)}.storyboard .shot-one{grid-row:span 2;height:auto;background:linear-gradient(145deg,#fde68a,#fb7185 50%,#312e81)}.storyboard .shot-two{background:linear-gradient(145deg,#93c5fd,#1e3a8a)}.storyboard .shot-three{background:linear-gradient(145deg,#fda4af,#7c3aed)}.story-line{position:absolute;left:-9%;right:-4%;bottom:-12%;height:2px;background:linear-gradient(90deg,transparent,#60a5fa,transparent)}
  .ai-console{height:100%;padding:9%;display:grid;grid-template-columns:1.15fr .7fr .6fr;align-items:center;gap:5%;background:radial-gradient(circle at 55% 50%,#172554,#080d19 62%)}
  .prompt-box{padding:.85rem;border:1px solid rgba(96,165,250,.3);border-radius:13px;background:rgba(15,23,42,.82);box-shadow:inset 0 0 22px rgba(37,99,235,.08)}.prompt-box p{margin:.55rem 0;color:#cbd5e1;font:500 .62rem/1.55 ui-monospace,monospace}.prompt-box b{color:#c084fc}.typing-line{display:block;width:70%;height:3px;border-radius:5px;background:linear-gradient(90deg,#2563eb,#c084fc);animation:type 1.8s ease-in-out infinite}
  .generation-core{position:relative;aspect-ratio:1;display:grid;place-items:center}.core-logo{width:55%;aspect-ratio:1;display:grid;place-items:center;border-radius:35%;background:linear-gradient(135deg,#3b82f6,#8b5cf6 55%,#ec4899);color:#fff;font:900 1rem Outfit;box-shadow:0 0 30px rgba(99,102,241,.55)}.core-ring{position:absolute;inset:4%;border:1px solid rgba(147,197,253,.45);border-radius:42%;animation:spin 7s linear infinite}.ring-b{inset:-8%;border-style:dashed;animation-direction:reverse;animation-duration:11s}
  .frame-stack{position:relative;height:65%;min-width:48px}.frame-stack i{position:absolute;inset:0;border:1px solid rgba(255,255,255,.25);border-radius:9px;background:linear-gradient(145deg,#fbbf24,#db2777 54%,#1e3a8a);box-shadow:0 8px 18px rgba(0,0,0,.3);animation:frames 2s ease-in-out infinite}.frame-stack i:nth-child(2){transform:translate(-7px,7px);opacity:.55;animation-delay:.25s}.frame-stack i:nth-child(3){transform:translate(-14px,14px);opacity:.25;animation-delay:.5s}
  .cinema-frame{position:relative;height:100%;overflow:hidden;background:#182444}.cinema-sky{position:absolute;inset:0 0 38%;background:linear-gradient(#365789,#f8b47a 70%,#ffd4a5)}.cinema-city{position:absolute;inset:23% 0 35%;opacity:.4;background:repeating-linear-gradient(90deg,#1e293b 0 18px,transparent 18px 25px)}.cinema-floor{position:absolute;inset:62% 0 0;background:linear-gradient(#334155,#0f172a)}
  .cinema-person{position:absolute;left:25%;bottom:14%;width:18%;height:50%;animation:heroFloat 3s ease-in-out infinite alternate}.cinema-person:before{content:'';position:absolute;left:26%;top:0;width:48%;aspect-ratio:1;border-radius:50%;background:#d59a72}.cinema-person i{position:absolute;inset:23% 0 0;border-radius:40% 40% 15% 15%;background:linear-gradient(120deg,#f8fafc,#cbd5e1)}
  .cinema-product{position:absolute;right:24%;bottom:18%;width:19%;height:39%;display:grid;place-items:center;border-radius:12% 12% 7% 7%;background:linear-gradient(145deg,#fafafa,#dbeafe);box-shadow:0 18px 30px rgba(0,0,0,.32),inset 0 0 0 1px #fff;transform:rotate(3deg)}.cinema-product span{text-align:center;color:#1d4ed8;font:900 .48rem/1.15 Outfit}
