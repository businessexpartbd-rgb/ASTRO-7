---
/**
 * Realistic book — white pages, soft shadow, 3D page-flip ~1s, continuous muted video.
 * No play button. No dark chrome. Speed-first: one iframe at a time.
 */
import { SHOWCASES, ytThumb } from '../data/site';

const longIds = [
  ...SHOWCASES.find((s) => s.id === 'cinematic')!.ids.slice(0, 4),
  ...SHOWCASES.find((s) => s.id === 'custom')!.ids.slice(0, 2),
];

/* Vary start seconds so each page shows a different “main moment” */
const starts = [4, 12, 8, 18, 6, 15];

const pages = longIds.map((id, i) => ({
  id,
  thumb: ytThumb(id),
  start: starts[i % starts.length],
  label: i % 2 === 0 ? 'Cinematic' : 'Brand Film',
}));
---

<div class="book" data-book role="img" aria-label="Creavix cinematic video showcase book">
  <div class="book-shadow" aria-hidden="true"></div>

  <div class="book-body">
    <!-- Left fixed page (cover feel) -->
    <div class="book-cover" aria-hidden="true">
      <div class="book-cover-inner">
        <span class="book-brand">CREAVIX</span>
        <span class="book-sub">Video Portfolio</span>
      </div>
    </div>

    <!-- Flipping stack -->
    <div class="book-stack" data-book-stack>
      {pages.map((p, i) => (
        <article
          class:list={['book-page', i === 0 && 'is-top']}
          data-page
          data-yt={p.id}
          data-start={p.start}
          style={`z-index:${pages.length - i}`}
        >
          <div class="page-face">
            <div class="page-media">
              <img class="page-thumb" src={p.thumb} alt="" width="640" height="360" decoding="async" loading={i < 2 ? 'eager' : 'lazy'} />
              <!-- iframe injected only for active top page -->
              <div class="page-video" data-video-slot></div>
            </div>
            <div class="page-meta">
              <span class="page-label">{p.label}</span>
              <span class="page-num">{String(i + 1).padStart(2, '0')} / {String(pages.length).padStart(2, '0')}</span>
            </div>
          </div>
          <div class="page-back" aria-hidden="true"></div>
        </article>
      ))}
    </div>
  </div>

  <!-- Soft service pills under book -->
  <div class="book-pills" aria-hidden="true">
    <span>Video Editing</span>
    <span>AI Video</span>
    <span>Web &amp; App</span>
  </div>
</div>

<style>
  .book {
    --page-w: min(100%, 420px);
    position: relative;
    width: var(--page-w);
    margin: 0 auto;
    padding: 0.5rem 0 1.25rem;
    perspective: 1400px;
  }

  .book-shadow {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 0.35rem;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(15, 23, 42, 0.22) 0%, transparent 70%);
    filter: blur(4px);
    pointer-events: none;
    z-index: 0;
  }

  .book-body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.22fr 0.78fr;
    gap: 0;
    transform-style: preserve-3d;
    animation: book-float 7s ease-in-out infinite;
  }

  @keyframes book-float {
    0%, 100% { transform: rotateX(2deg) rotateY(-4deg) translateY(0); }
    50% { transform: rotateX(3deg) rotateY(-2deg) translateY(-4px); }
  }

  /* Left cover / spine area */
  .book-cover {
    position: relative;
    border-radius: 10px 0 0 10px;
    background: linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-right: none;
    box-shadow:
      -4px 8px 24px rgba(15, 23, 42, 0.08),
      inset 0 1px 0 #fff;
    min-height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .book-cover::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: linear-gradient(90deg, rgba(15, 23, 42, 0.06), transparent);
  }
  .book-cover-inner {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-align: center;
    padding: 0.75rem 0;
  }
  .book-brand {
    display: block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: #0f172a;
  }
  .book-sub {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #64748b;
  }

  .book-stack {
    position: relative;
    aspect-ratio: 16 / 11;
    transform-style: preserve-3d;
  }

  .book-page {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.45, 0.05, 0.25, 1);
    border-radius: 0 12px 12px 0;
  }

  .page-face,
  .page-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 0 12px 12px 0;
  }

  .page-face {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-left: none;
    box-shadow:
      6px 10px 28px rgba(15, 23, 42, 0.1),
      0 1px 0 rgba(255, 255, 255, 0.9) inset;
    display: flex;
    flex-direction: column;
    padding: 0.55rem 0.55rem 0.45rem;
    overflow: hidden;
  }

  .page-back {
    background: linear-gradient(90deg, #f1f5f9 0%, #ffffff 18%, #f8fafc 100%);
    border: 1px solid rgba(15, 23, 42, 0.06);
    transform: rotateY(180deg);
    box-shadow: inset 4px 0 12px rgba(15, 23, 42, 0.04);
  }

  .page-media {
    position: relative;
    flex: 1;
    min-height: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #0f172a;
  }

  .page-thumb,
  .page-media iframe,
  .page-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .page-thumb {
    object-fit: cover;
    z-index: 1;
  }

  .page-video {
    z-index: 2;
  }

  .page-video iframe {
    pointer-events: none;
    /* hide residual YT chrome as much as possible */
    transform: scale(1.08);
    transform-origin: center center;
  }

  .page-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.4rem;
    padding: 0 0.1rem;
  }
  .page-label {
    font-size: 0.68rem;
    font-weight: 700;
    color: #334155;
    letter-spacing: 0.02em;
  }
  .page-num {
    font-size: 0.62rem;
    font-weight: 600;
    color: #94a3b8;
    font-variant-numeric: tabular-nums;
  }

  /* States */
  .book-page.is-flipping {
    transform: rotateY(-158deg);
    z-index: 40 !important;
  }
  .book-page.is-done {
    transform: rotateY(-180deg);
    pointer-events: none;
    z-index: 1 !important;
  }
  .book-page.is-top {
    z-index: 30 !important;
  }

  .book-pills {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
    margin-top: 0.85rem;
  }
  .book-pills span {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    background: #fff;
    color: #0f172a;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
  }

  @media (max-width: 767px) {
    .book {
      --page-w: min(100%, 360px);
      padding-bottom: 1rem;
    }
    .book-body {
      grid-template-columns: 0.16fr 0.84fr;
      animation-duration: 9s;
    }
    .book-brand { font-size: 0.62rem; letter-spacing: 0.12em; }
    .book-sub { font-size: 0.52rem; }
    .page-face { padding: 0.4rem 0.4rem 0.35rem; }
    .page-label { font-size: 0.62rem; }
    .book-page { transition-duration: 0.6s; }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-body {
      animation: none !important;
    }
    .book-page {
      transition: none !important;
    }
  }
</style>

<script is:inline>
(function () {
  var root = document.querySelector('[data-book]');
  if (!root) return;

  var pages = Array.prototype.slice.call(root.querySelectorAll('[data-page]'));
  if (!pages.length) return;

  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var visible = true;
  var idx = 0;
  var flipTimer = null;
  var holdMs = 1100;      /* ~1s per page visible */
  var flipMs = 700;

  function clearVideo(page) {
    var slot = page.querySelector('[data-video-slot]');
    if (slot) slot.innerHTML = '';
  }

  function playVideo(page) {
    if (reduced || !visible) return;
    var slot = page.querySelector('[data-video-slot]');
    if (!slot) return;
    var id = page.getAttribute('data-yt');
    var start = page.getAttribute('data-start') || '5';
    if (!id) return;

    /* Continuous short window of the “main” part — no controls, muted, autoplay */
    var end = String(parseInt(start, 10) + 9);
    var src =
      'https://www.youtube-nocookie.com/embed/' + id +
      '?autoplay=1&mute=1&controls=0&rel=0&modestbranding=1&playsinline=1' +
      '&iv_load_policy=3&disablekb=1&fs=0&start=' + start + '&end=' + end +
      '&loop=1&playlist=' + id;

    slot.innerHTML =
      '<iframe title="" src="' + src + '" allow="autoplay; encrypted-media" allowfullscreen ' +
      'referrerpolicy="strict-origin-when-cross-origin" tabindex="-1"></iframe>';
  }

  function resetStack() {
    pages.forEach(function (p, i) {
      p.classList.remove('is-flipping', 'is-done', 'is-top');
      p.style.zIndex = String(pages.length - i);
      clearVideo(p);
    });
    idx = 0;
    pages[0].classList.add('is-top');
    playVideo(pages[0]);
  }

  function flipNext() {
    if (!visible || reduced) return;
    if (idx >= pages.length - 1) {
      /* All pages flipped — reset like closing & reopening the book */
      pages.forEach(function (p) {
        p.classList.add('is-done');
        clearVideo(p);
      });
      setTimeout(function () {
        resetStack();
        schedule();
      }, 280);
      return;
    }

    var current = pages[idx];
    current.classList.remove('is-top');
    current.classList.add('is-flipping');
    clearVideo(current);

    var next = pages[idx + 1];
    if (next) {
      next.classList.add('is-top');
      playVideo(next);
    }

    setTimeout(function () {
      current.classList.remove('is-flipping');
      current.classList.add('is-done');
      idx += 1;
      schedule();
    }, flipMs);
  }

  function schedule() {
    if (flipTimer) clearTimeout(flipTimer);
    if (!visible || reduced) return;
    flipTimer = setTimeout(flipNext, holdMs);
  }

  function start() {
    if (reduced) {
      pages[0].classList.add('is-top');
      return;
    }
    resetStack();
    schedule();
  }

  function stop() {
    if (flipTimer) clearTimeout(flipTimer);
    flipTimer = null;
    pages.forEach(clearVideo);
  }

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        visible = e.isIntersecting;
        if (visible) start();
        else stop();
      });
    }, { threshold: 0.15 });
    io.observe(root);
  } else {
    start();
  }

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stop();
    else if (visible) start();
  });
})();
</script>
