---
/**
 * Hero video stage — reference-style floating cards:
 * soft glow, rounded 16:9 main video, blurred side peeks,
 * bottom thumb strip (no frames, no text), auto-cycle + click.
 * Continuous muted playback of main moments at fast (2x / 3x-feel) pace.
 */
import { SHOWCASES, ytThumb } from '../data/site';

const longIds = [
  ...SHOWCASES.find((s) => s.id === 'cinematic')!.ids,
  ...SHOWCASES.find((s) => s.id === 'custom')!.ids.slice(0, 4),
];

const starts = [3, 8, 5, 12, 6, 10, 4, 14, 7, 9];

const clips = longIds.map((id, i) => ({
  id,
  thumb: ytThumb(id),
  start: starts[i % starts.length],
}));
---

<div class="hv" data-hv role="img" aria-label="Creavix video showcase">
  <div class="hv-glow" aria-hidden="true"></div>

  <!-- Main stage: center clear + side peeks blurred -->
  <div class="hv-stage" data-stage>
    <div class="hv-side hv-side-l" data-side="prev" aria-hidden="true">
      <img data-side-prev-img alt="" width="480" height="270" decoding="async" />
    </div>

    <div class="hv-main" data-main>
      <div class="hv-screen">
        <img class="hv-poster" data-poster alt="" width="1280" height="720" decoding="async" />
        <div class="hv-player" data-player></div>
      </div>
    </div>

    <div class="hv-side hv-side-r" data-side="next" aria-hidden="true">
      <img data-side-next-img alt="" width="480" height="270" decoding="async" />
    </div>
  </div>

  <!-- Bottom strip — direct video thumbs, no frames, no text -->
  <div class="hv-strip" data-strip>
    <div class="hv-strip-track" data-track>
      {clips.map((c, i) => (
        <button
          type="button"
          class:list={['hv-thumb', i === 0 && 'is-active']}
          data-thumb
          data-i={i}
          data-yt={c.id}
          data-start={c.start}
          data-thumb-src={c.thumb}
          aria-label={`Video ${i + 1}`}
        >
          <img src={c.thumb} alt="" width="160" height="90" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .hv {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    padding: 1.5rem 0.25rem 0.5rem;
  }

  /* Soft multi-color aura like reference */
  .hv-glow {
    position: absolute;
    left: 50%;
    top: 38%;
    translate: -50% -50%;
    width: 92%;
    height: 70%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 40%, rgba(251, 191, 36, 0.28), transparent 50%),
      radial-gradient(circle at 70% 35%, rgba(167, 139, 250, 0.3), transparent 48%),
      radial-gradient(circle at 50% 70%, rgba(110, 231, 183, 0.22), transparent 55%),
      radial-gradient(circle at 55% 45%, rgba(147, 197, 253, 0.25), transparent 60%);
    filter: blur(28px);
    pointer-events: none;
    z-index: 0;
    animation: hv-aura 6s ease-in-out infinite alternate;
  }
  @keyframes hv-aura {
    from { opacity: 0.75; transform: scale(1); }
    to { opacity: 1; transform: scale(1.06); }
  }

  .hv-stage {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.18fr 0.64fr 0.18fr;
    align-items: center;
    gap: 0.35rem;
    min-height: 200px;
  }

  .hv-main {
    position: relative;
    z-index: 2;
  }

  .hv-screen {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    background: #0f172a;
    box-shadow:
      0 24px 48px rgba(15, 23, 42, 0.14),
      0 0 0 1px rgba(255, 255, 255, 0.55);
  }

  .hv-poster,
  .hv-player,
  .hv-player iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .hv-poster {
    object-fit: cover;
    z-index: 1;
    transition: opacity 0.35s ease;
  }
  .hv-player {
    z-index: 2;
  }
  .hv-player iframe {
    pointer-events: none;
    /* crop residual YT chrome */
    transform: scale(1.12);
    transform-origin: center center;
  }
  .hv.is-playing .hv-poster {
    opacity: 0;
  }

  /* Side peeks — blurred, scaled down */
  .hv-side {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    opacity: 0.55;
    filter: blur(3px);
    transform: scale(0.88);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
    transition: opacity 0.4s ease, filter 0.4s ease, transform 0.4s ease;
  }
  .hv-side img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hv-side-l { justify-self: end; }
  .hv-side-r { justify-self: start; }

  /* Bottom strip */
  .hv-strip {
    position: relative;
    z-index: 2;
    margin-top: 1.15rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .hv-strip-track {
    display: flex;
    gap: 0.55rem;
    justify-content: center;
    align-items: center;
    padding: 0.35rem 0.5rem 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .hv-strip-track::-webkit-scrollbar { display: none; }

  .hv-thumb {
    flex: 0 0 auto;
    width: 72px;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: none;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    background: transparent;
    scroll-snap-align: center;
    opacity: 0.55;
    transform: scale(0.92);
    transition: transform 0.3s ease, opacity 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
  }
  .hv-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hv-thumb.is-active {
    opacity: 1;
    transform: scale(1.12);
    box-shadow:
      0 10px 24px rgba(37, 99, 235, 0.22),
      0 0 0 2px rgba(255, 255, 255, 0.9);
    z-index: 1;
  }
  .hv-thumb:hover {
    opacity: 0.9;
  }

  /* Slide transition when changing main */
  .hv-main.is-slide-out .hv-screen {
    animation: hv-out 0.38s ease forwards;
  }
  .hv-main.is-slide-in .hv-screen {
    animation: hv-in 0.42s ease forwards;
  }
  @keyframes hv-out {
    to { opacity: 0; transform: translateX(-18px) scale(0.96); filter: blur(4px); }
  }
  @keyframes hv-in {
    from { opacity: 0; transform: translateX(18px) scale(0.96); filter: blur(4px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  @media (max-width: 767px) {
    .hv {
      max-width: 100%;
      padding: 0.75rem 0 0.25rem;
    }
    .hv-stage {
      grid-template-columns: 0.12fr 0.76fr 0.12fr;
      gap: 0.2rem;
      min-height: 160px;
    }
    .hv-screen { border-radius: 14px; }
    .hv-side {
      border-radius: 10px;
      filter: blur(4px);
      opacity: 0.4;
      transform: scale(0.82);
    }
    .hv-thumb {
      width: 58px;
      border-radius: 10px;
    }
    .hv-thumb.is-active { transform: scale(1.1); }
    .hv-glow {
      width: 100%;
      height: 65%;
      filter: blur(22px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hv-glow { animation: none !important; }
    .hv-main.is-slide-out .hv-screen,
    .hv-main.is-slide-in .hv-screen {
      animation: none !important;
    }
  }
</style>

<script is:inline>
(function () {
  var root = document.querySelector('[data-hv]');
  if (!root) return;

  var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-thumb]'));
  if (!thumbs.length) return;

  var poster = root.querySelector('[data-poster]');
  var player = root.querySelector('[data-player]');
  var main = root.querySelector('[data-main]');
  var track = root.querySelector('[data-track]');
  var prevImg = root.querySelector('[data-side-prev-img]');
  var nextImg = root.querySelector('[data-side-next-img]');

  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var visible = true;
  var idx = 0;
  var timer = null;
  var HOLD = 2800; /* fast cycle ≈ 3x-feel segment length */

  function clip(i) {
    var t = thumbs[((i % thumbs.length) + thumbs.length) % thumbs.length];
    return {
      id: t.getAttribute('data-yt'),
      start: parseInt(t.getAttribute('data-start') || '4', 10),
      thumb: t.getAttribute('data-thumb-src'),
      el: t,
    };
  }

  function ytSrc(id, start) {
    /* Short main-moment window, muted autoplay, loop — fast turnover */
    var s = start || 4;
    var e = s + 5;
    return (
      'https://www.youtube-nocookie.com/embed/' + id +
      '?autoplay=1&mute=1&controls=0&rel=0&modestbranding=1&playsinline=1' +
      '&iv_load_policy=3&disablekb=1&fs=0&start=' + s + '&end=' + e +
      '&loop=1&playlist=' + id
    );
  }

  function mountPlayer(id, start) {
    if (!player || reduced) return;
    player.innerHTML =
      '<iframe title="" src="' + ytSrc(id, start) + '" allow="autoplay; encrypted-media" ' +
      'referrerpolicy="strict-origin-when-cross-origin" tabindex="-1"></iframe>';
    root.classList.add('is-playing');
  }

  function clearPlayer() {
    if (player) player.innerHTML = '';
    root.classList.remove('is-playing');
  }

  function updateSides(i) {
    var p = clip(i - 1);
    var n = clip(i + 1);
    if (prevImg && p.thumb) prevImg.src = p.thumb;
    if (nextImg && n.thumb) nextImg.src = n.thumb;
  }

  function scrollThumbIntoView(i) {
    var el = thumbs[i];
    if (!el || !track) return;
    var left = el.offsetLeft - (track.clientWidth / 2) + (el.clientWidth / 2);
    track.scrollTo({ left: Math.max(0, left), behavior: reduced ? 'auto' : 'smooth' });
  }

  function setActive(i, animate) {
    idx = ((i % thumbs.length) + thumbs.length) % thumbs.length;
    var c = clip(idx);

    thumbs.forEach(function (t, j) {
      t.classList.toggle('is-active', j === idx);
    });

    function apply() {
      if (poster && c.thumb) poster.src = c.thumb;
      updateSides(idx);
      scrollThumbIntoView(idx);
      if (visible && !reduced) mountPlayer(c.id, c.start);
      else clearPlayer();
    }

    if (animate && main && !reduced) {
      main.classList.remove('is-slide-in');
      main.classList.add('is-slide-out');
      setTimeout(function () {
        main.classList.remove('is-slide-out');
        apply();
        main.classList.add('is-slide-in');
        setTimeout(function () { main.classList.remove('is-slide-in'); }, 420);
      }, 280);
    } else {
      apply();
    }
  }

  function next() {
    setActive(idx + 1, true);
  }

  function schedule() {
    if (timer) clearTimeout(timer);
    if (!visible || reduced) return;
    timer = setTimeout(function () {
      next();
      schedule();
    }, HOLD);
  }

  function start() {
    setActive(idx, false);
    schedule();
  }

  function stop() {
    if (timer) clearTimeout(timer);
    timer = null;
    clearPlayer();
  }

  thumbs.forEach(function (t, i) {
    t.addEventListener('click', function () {
      setActive(i, true);
      schedule();
    });
  });

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        visible = e.isIntersecting;
        if (visible) start();
        else stop();
      });
    }, { threshold: 0.12 });
    io.observe(root);
  } else {
    start();
  }

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stop();
    else if (visible) start();
  });
})();
</script>
