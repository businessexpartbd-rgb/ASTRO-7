---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import IconBox from './IconBox.astro';
import ServiceIcons, { type IconName } from './icons/ServiceIcons.astro';
import { SITE } from '../data/site';

interface Demo {
  title: string;
  desc: string;
  tag?: string;
}
interface Props {
  title: string;
  seoTitle: string;
  seoDescription: string;
  icon: IconName;
  lead: string;
  bullets: string[];
  demos: Demo[];
}
const { title, seoTitle, seoDescription, icon, lead, bullets, demos } = Astro.props;
---
<Layout title={seoTitle} description={seoDescription}>
  <Nav active="services" />
  <section class="hero-premium" style="min-height:auto;padding-top:7.5rem;padding-bottom:3.5rem">
    <div class="hero-bg"><div class="orb orb-1"></div><div class="orb orb-2"></div><div class="grid-overlay"></div></div>
    <div class="container" style="position:relative;z-index:2;max-width:720px">
      <div class="reveal">
        <div class="eyebrow"><span class="dot"></span> Service</div>
        <div class="svc-hero-icon">
          <ServiceIcons name={icon} size={56} />
        </div>
        <h1 class="hero-title title-anim">{title}</h1>
        <p class="hero-lead">{lead}</p>
        <div class="flex-btns">
          <a href={SITE.whatsappLink} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Order on WhatsApp</a>
          <a href="/contact" class="btn btn-outline">Contact</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="container grid-2">
      <div class="reveal">
        <h2 class="mb-6 title-anim">What’s included</h2>
        <ul class="svc-bullets">
          {
            bullets.map((b) => (
              <li>
                <ServiceIcons name="check" size={22} />
                <span>{b}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reveal">
        <div class="glass-card" style="padding:1.75rem">
          <div style="margin-bottom:0.75rem">
            <ServiceIcons name="spark" size={36} />
          </div>
          <h3 class="mb-4">Why Creavix</h3>
          <p style="font-size:.95rem;margin-bottom:1rem">Premium delivery, clear process, SEO-aware builds and campaign-ready creative from one IT solution partner.</p>
          <a href={SITE.whatsappLink} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Get a quote</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-violet">
    <div class="container">
      <div class="text-center mb-8 reveal">
        <p class="eyebrow" style="margin:0 auto 1rem">Demo samples</p>
        <h2 class="mb-4 title-anim">See how this service looks in practice</h2>
        <p style="max-width:36rem;margin:0 auto">Unique sample concepts for this page — replace with your real client work anytime.</p>
      </div>
      <div class="grid-3">
        {
          demos.map((d) => (
            <div class="glass-card reveal">
              <div style="margin-bottom:0.5rem">
                <ServiceIcons name={icon} size={32} />
              </div>
              {d.tag && <span class="demo-tag">{d.tag}</span>}
              <h3 class="mb-4" style="margin-top:.5rem">{d.title}</h3>
              <p style="font-size:.9rem">{d.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-warm">
    <div class="container text-center reveal" style="max-width:40rem">
      <h2 class="mb-4 title-anim">Ready to start?</h2>
      <p class="mb-8">WhatsApp {SITE.whatsapp} · {SITE.email1}</p>
      <a href={SITE.whatsappLink} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Chat now</a>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .svc-hero-icon {
    width: 88px;
    height: 88px;
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    background: rgba(13, 148, 136, 0.1);
    border: 1px solid rgba(13, 148, 136, 0.15);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }
  .svc-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    color: var(--text-2);
  }
  .svc-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }
  .svc-bullets li span { padding-top: 0.1rem; }
  .demo-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--primary);
    background: rgba(13, 148, 136, 0.1);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }
</style>
