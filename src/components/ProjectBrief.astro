---
import { SITE } from '../data/site';
const services = ['Professional Video Editing','AI Video Marketing','Human-like Content','Web Development','App Development','Authentication Systems','Business Automation','Digital Marketing','SEO','Facebook Page Services','Facebook Boosting','Meta & YouTube Campaigns','Other Service'];
---
<section id="contact" class="brief-section" aria-labelledby="brief-title">
  <span id="project-brief" class="brief-anchor" aria-hidden="true"></span>
  <div class="container brief-shell">
    <div class="brief-copy">
      <p class="eyebrow">Start a project</p><h2 id="brief-title">Tell us the goal.<br /><span>We’ll map the next move.</span></h2>
      <p>Send a focused brief directly to the Creavix team. It is securely stored for follow-up; we never ask for passwords or account credentials.</p>
      <div class="brief-contact"><span><b>Call</b>{SITE.hotline}</span><span><b>WhatsApp</b>{SITE.whatsapp}</span><span><b>Email</b>{SITE.email1}</span></div>
    </div>
    <form id="project-brief-form" class="brief-form" novalidate>
      <div class="brief-grid"><label><span>Name</span><input id="brief-name" name="name" minlength="2" maxlength="60" autocomplete="name" required placeholder="Your name" /></label><label><span>Phone / WhatsApp</span><input id="brief-phone" name="phone" minlength="6" maxlength="25" inputmode="tel" autocomplete="tel" required placeholder="+880…" /></label></div>
      <label><span>Service</span><select id="brief-service" name="service">{services.map((service) => <option>{service}</option>)}</select></label>
      <div class="brief-grid"><label><span>Investment range</span><select id="brief-budget" name="budget"><option>Need a recommendation</option><option>Focused starter scope</option><option>Growth project scope</option><option>Long-term partnership</option></select></label><label><span>Preferred timeline</span><select id="brief-timeline" name="timeline"><option>As soon as practical</option><option>Within 1–2 weeks</option><option>Within 1 month</option><option>Planning ahead</option></select></label></div>
      <label><span>What outcome do you need?</span><textarea id="brief-goal" name="goal" minlength="10" maxlength="1000" rows="4" required placeholder="Briefly describe the goal, audience and deliverable…"></textarea></label>
      <input id="brief-company" name="company" class="brief-hp" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="brief-submit"><button id="brief-submit" class="btn btn-primary" type="submit">Send secure brief <span aria-hidden="true">→</span></button><small>Protected by server validation and request limits.</small></div>
      <p id="brief-status" class="brief-status" role="status" hidden></p>
    </form>
  </div>
</section>
<style>
  .brief-section{position:relative;padding:clamp(4.5rem,8vw,7rem) 1.25rem;background:#fff}.brief-anchor{position:absolute;top:-90px}.brief-shell{position:relative;overflow:hidden;display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(1.5rem,5vw,4.5rem);padding:clamp(1.4rem,4vw,3rem);border:1px solid #dfe7ee;border-radius:32px;background:radial-gradient(circle at 0 0,#eef6ff,transparent 42%),linear-gradient(140deg,#fff,#f7f9fc);box-shadow:0 26px 75px #0a254012}.brief-shell:after{content:'';position:absolute;width:240px;height:240px;right:-140px;top:-140px;border:1px solid #175cd326;border-radius:50%;box-shadow:0 0 0 28px #175cd307,0 0 0 58px #c44b0b05;pointer-events:none}.brief-copy,.brief-form{position:relative;z-index:1}.brief-copy .eyebrow{margin:0 0 .75rem;color:#137849!important}.brief-copy h2{margin:0;color:#0b0f19;font-size:clamp(2rem,3.7vw,3.35rem);line-height:1.1;letter-spacing:-.05em}.brief-copy h2 span{color:#175cd3}.brief-copy>p:not(.eyebrow){margin:.9rem 0 1.2rem;color:#5b6d82!important;line-height:1.75}.brief-contact{display:grid;gap:.55rem}.brief-contact span{color:#475d72;font-size:.78rem;overflow-wrap:anywhere}.brief-contact b{display:inline-block;min-width:72px;color:#0a2540}.brief-form{padding:1.25rem;border:1px solid #e1e7ed;border-radius:22px;background:#ffffffeb;box-shadow:inset 0 1px 0 #fff}.brief-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.brief-form label{display:block}.brief-form label>span{display:block;margin-bottom:.38rem;color:#33495d;font-size:.72rem;font-weight:800}.brief-form :is(input,select,textarea){width:100%;box-sizing:border-box;margin:0 0 .8rem;padding:.78rem .85rem;border:1px solid #d8e1ea;border-radius:12px;background:#fff;color:#0b0f19;font:inherit;font-size:.88rem;outline:0}.brief-form :is(input,select,textarea):focus{border-color:#175cd3;box-shadow:0 0 0 3px #175cd319}.brief-form textarea{min-height:110px;resize:vertical}.brief-hp{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;opacity:0}.brief-submit{display:flex;align-items:center;gap:.9rem;flex-wrap:wrap}.brief-submit .btn{display:inline-flex;align-items:center;gap:.55rem}.brief-submit small{color:#718397;font-size:.67rem}.brief-status{margin:.8rem 0 0;padding:.7rem .8rem;border-radius:10px;background:#edf9f2;color:#166534!important;font-size:.78rem!important}.brief-status.err{background:#fff1f2;color:#be123c!important}
  @media(max-width:820px){.brief-shell{grid-template-columns:1fr}.brief-contact{grid-template-columns:repeat(3,minmax(0,1fr))}.brief-contact b{display:block}}
  @media(max-width:580px){.brief-section{padding:4rem .9rem}.brief-shell{padding:1.05rem;border-radius:24px}.brief-form{padding:1rem}.brief-grid,.brief-contact{grid-template-columns:1fr}.brief-contact b{display:inline-block}.brief-submit .btn{width:100%;justify-content:center;min-height:48px}}
</style>
<script is:inline>
(() => {
  const form=document.getElementById('project-brief-form'),status=document.getElementById('brief-status'),button=document.getElementById('brief-submit');
  if(!form||!status||!button)return;
  const show=(text,error=false)=>{status.hidden=false;status.className='brief-status'+(error?' err':'');status.textContent=text};
  form.addEventListener('submit',async event=>{
    event.preventDefault();if(document.getElementById('brief-company').value)return;
    const payload={name:document.getElementById('brief-name').value.trim(),phone:document.getElementById('brief-phone').value.trim(),service:document.getElementById('brief-service').value,budget:document.getElementById('brief-budget').value,timeline:document.getElementById('brief-timeline').value,goal:document.getElementById('brief-goal').value.trim(),company:document.getElementById('brief-company').value};
    if(payload.name.length<2)return show('Please enter your name.',true);if(payload.phone.length<6)return show('Please enter a valid contact number.',true);if(payload.goal.length<10)return show('Please describe the project in at least 10 characters.',true);
    button.disabled=true;button.textContent='Sending…';
    try{const response=await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(payload)});const data=await response.json();if(!response.ok||!data.ok)throw new Error(data.error||'The brief could not be sent.');form.reset();show('Thank you. Your brief is securely saved. The Creavix team will follow up using your contact number.');}
    catch(error){show(error.message||'The brief could not be sent. Please use WhatsApp instead.',true)}finally{button.disabled=false;button.innerHTML='Send secure brief <span aria-hidden="true">→</span>'}
  });
})();
</script>
