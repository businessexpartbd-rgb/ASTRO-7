---
interface Props {
  active?: string;
}
const { active = '' } = Astro.props;
---
<nav class="navbar" id="navbar">
  <div class="nav-inner">
    <a href="/" class="logo">
      <img src="/logo.png" alt="Creavix iT Solution" class="logo-img" width="40" height="40" />
      Creavix <span>iT</span> Solution
    </a>
    <ul class="nav-links">
      <li><a href="/" class={active === 'home' ? 'active' : ''}>Home</a></li>
      <li class="nav-dropdown">
        <button type="button" class={`nav-drop-btn ${active === 'services' ? 'active' : ''}`} id="services-btn" aria-expanded="false" aria-haspopup="true">
          Services
          <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-dropdown-menu" id="services-menu" role="menu">
          <a href="/services/video-editing" role="menuitem">🎬 Video Editing</a>
          <a href="/services/ai-video-marketing" role="menuitem">🤖 AI Video Marketing</a>
          <a href="/services/human-like-content" role="menuitem">👤 Human-like Content</a>
          <a href="/services/web-development" role="menuitem">💻 Web Development</a>
          <a href="/services/application-build" role="menuitem">📱 Application Build</a>
          <a href="/services/authentication" role="menuitem">🔐 Authentication</a>
          <a href="/services/facebook-page" role="menuitem">📘 Facebook Page</a>
          <a href="/services/boosting" role="menuitem">📈 Boosting</a>
          <a href="/services/campaign" role="menuitem">🎯 Campaign</a>
        </div>
      </li>
      <li><a href="/about" class={active === 'about' ? 'active' : ''}>About</a></li>
      <li><a href="/contact" class={active === 'contact' ? 'active' : ''}>Contact</a></li>
    </ul>
    <a href="/contact" class="btn btn-primary nav-cta">Get Started</a>
  </div>
</nav>
<script is:inline>
  (function() {
    const btn = document.getElementById('services-btn');
    const menu = document.getElementById('services-menu');
    const drop = btn && btn.closest('.nav-dropdown');
    if (!btn || !menu || !drop) return;
    function open() {
      menu.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
    }
    function close() {
      menu.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    }
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      menu.classList.contains('open') ? close() : open();
    });
    document.addEventListener('click', function(e) {
      if (!drop.contains(e.target)) close();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') close();
    });
  })();
</script>
