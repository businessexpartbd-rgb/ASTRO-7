---
interface Props { active?: string; }
const { active = '' } = Astro.props;
---
<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Creavix IT Solution Home">
      <img src="/logo.png" alt="" width="40" height="40" class="brand-logo" />
      <span class="brand-name">Creavix <em>IT Solution</em></span>
    </a>

    <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="main-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav" id="main-nav" aria-label="Primary">
      <ul class="nav-list">
        <li><a href="/" class={active === 'home' ? 'active' : ''}>Home</a></li>
        <li class="has-drop">
          <button type="button" class="drop-btn" id="svc-btn" aria-expanded="false">Services</button>
          <div class="drop-panel" id="svc-panel" role="menu">
            <a href="/services/seo" role="menuitem">Search Engine Optimization</a>
            <a href="/services/digital-marketing" role="menuitem">Social Media Marketing</a>
            <a href="/services/web-development" role="menuitem">Web &amp; Software Development</a>
            <a href="/services/application-build" role="menuitem">UI/UX Design &amp; Branding</a>
          </div>
        </li>
        <li><a href="/#industries">Industries</a></li>
        <li><a href="/#case-studies">Case Studies</a></li>
        <li><a href="/#blog">Blog</a></li>
        <li><a href="/about" class={active === 'about' ? 'active' : ''}>About Us</a></li>
        <li><a href="/contact" class={active === 'contact' ? 'active' : ''}>Contact</a></li>
      </ul>
      <a href="/contact" class="btn btn-primary nav-cta">Contact Now</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    font-family: var(--font-b);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    z-index: 102;
  }
  .brand-logo { border-radius: 8px; object-fit: contain; }
  .brand-name {
    font-family: var(--font-h);
    font-weight: 700;
    font-size: 1.05rem;
    color: #0B0F19;
  }
  .brand-name em {
    font-style: normal;
    color: #2563EB;
  }

  .menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 102;
  }
  .menu-btn span {
    display: block;
    width: 22px;
    height: 2px;
    background: #0B0F19;
    border-radius: 2px;
    transition: transform 0.25s, opacity 0.25s;
  }
  .menu-btn.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-btn.open span:nth-child(2) { opacity: 0; }
  .menu-btn.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.35rem;
  }
  .nav-list a, .drop-btn {
    font-family: var(--font-b);
    font-size: 0.92rem;
    font-weight: 500;
    color: #475569;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0;
  }
  .nav-list a:hover, .nav-list a.active, .drop-btn:hover {
    color: #2563EB;
  }
  .has-drop { position: relative; }
  .drop-panel {
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    min-width: 260px;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 14px;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s, transform 0.25s, visibility 0.2s;
    z-index: 120;
  }
  .drop-panel.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .drop-panel a {
    display: block;
    padding: 0.7rem 0.9rem;
    border-radius: 10px;
    font-size: 0.88rem;
    color: #475569;
  }
  .drop-panel a:hover {
    background: rgba(37, 99, 235, 0.08);
    color: #2563EB;
  }
  .nav-cta { padding: 0.65rem 1.25rem; font-size: 0.88rem; }

  @media (max-width: 900px) {
    .menu-btn { display: flex; }
    .main-nav {
      position: fixed;
      inset: 0;
      background: #fff;
      flex-direction: column;
      justify-content: flex-start;
      padding: 5.5rem 1.5rem 2rem;
      gap: 1.5rem;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.3s ease, visibility 0.3s;
      overflow-y: auto;
    }
    .main-nav.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      width: 100%;
    }
    .nav-list a, .drop-btn {
      font-family: var(--font-h);
      font-size: 1.2rem;
      font-weight: 600;
      color: #0B0F19;
      padding: 0.75rem 0;
      width: 100%;
      text-align: left;
    }
    .drop-panel {
      position: static;
      box-shadow: none;
      border: none;
      padding: 0 0 0 0.75rem;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: none;
      min-width: 0;
      width: 100%;
    }
    .drop-panel.open { display: block; }
    .nav-cta { width: 100%; text-align: center; margin-top: 0.5rem; }
  }
</style>

<script is:inline>
(function () {
  var btn = document.getElementById('menu-btn');
  var nav = document.getElementById('main-nav');
  var svcBtn = document.getElementById('svc-btn');
  var svcPanel = document.getElementById('svc-panel');
  if (btn && nav) {
    btn.addEventListener('click', function () {
      var open = nav.classList.toggle('open');
      btn.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.style.overflow = open ? 'hidden' : '';
    });
    nav.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        nav.classList.remove('open');
        btn.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });
  }
  if (svcBtn && svcPanel) {
    svcBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = svcPanel.classList.toggle('open');
      svcBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', function () {
      svcPanel.classList.remove('open');
      svcBtn.setAttribute('aria-expanded', 'false');
    });
  }
})();
</script>
