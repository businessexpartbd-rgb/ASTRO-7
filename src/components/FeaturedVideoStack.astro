---
/**
 * Cinematic stack — ONE sticky stage in the middle of the screen.
 * Outer rail height = 6 × viewport → scroll distance.
 * All 6 videos sit in the SAME absolute slot; scroll progress
 * decides which page is on top (book-page). Under pages blur.
 * Full-width 16:9 on mobile + desktop. One player. Auto-stop.
 */
import { SHOWCASES, ytThumb } from '../data/site';

const cinematic = SHOWCASES.find((s) => s.id === 'cinematic')!;
const videos = cinematic.ids.map((id, i) => ({
  id,
  thumb: ytThumb(id),
  n: i + 1,
}));
const total = videos.length;
---

<section id="featured-videos" class="fvs" data-fvs data-count={String(total)}>
  <div class="fvs-head">
    <p class="eyebrow">Featured Work</p>
    <h2>Cinematic Videos</h2>
    <p class="fvs-lead">Scroll — films stack like book pages in the center. Tap to play with sound.</p>
  </div>

  <!-- Tall scroll track: one viewport of travel per video -->
  <div class="fvs-track" data-track>
    <!-- Single sticky stage locked to vertical middle -->
    <div class="fvs-stage" data-stage>
      <div class="fvs-stage-inner">
        {videos.map((v, i) => (
          <article
            class:list={['fvs-page', i === 0 && 'is-front']}
            data-page
            data-i={String(i)}
            data-vid={v.id}
            style={`--i:${i}`}
          >
            <div class="fvs-frame">
              <img
                class="fvs-poster"
                src={v.thumb}
                alt=""
                width="1280"
                height="720"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="fvs-player" data-player></div>

              <button type="button" class="fvs-play" data-play aria-label={`Play video ${v.n}`}>
                <span class="fvs-play-ic" aria-hidden="true">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
                <span class="fvs-play-txt">Play with sound</span>
              </button>

              <div class="fvs-meta">
                <span class="fvs-num">{String(v.n).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
                <span class="fvs-tag">16:9</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Progress dots -->
      <div class="fvs-dots" data-dots aria-hidden="true">
        {videos.map((_, i) => (
          <span class:list={['fvs-dot', i === 0 && 'is-on']} data-dot={String(i)}></span>
        ))}
      </div>
    </div>
  </div>

  <div class="fvs-more">
    <a href="/portfolio" class="btn btn-outline">View full portfolio →</a>
  </div>
</section>

<style>
  .fvs {
    padding: 2rem 0 0;
    background: linear-gradient(180deg, #F8FAFC 0%, #fff 25%);
  }

  .fvs-head {
    text-align: center;
    padding: 0 1.25rem 1rem;
    max-width: 40rem;
    margin: 0 auto;
  }
  .fvs-head h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .fvs-lead {
    margin: 0;
    color: var(--text-2, #475569);
    font-size: 0.95rem;
  }

  /*
   * Track height = N × 100vh → scroll distance for N pages.
   * Inside: one sticky stage that stays centered while you scroll the track.
   */
  .fvs-track {
    position: relative;
    height: calc(var(--fvs-count, 6) * 100vh);
    height: calc(var(--fvs-count, 6) * 100dvh);
  }

  .fvs-stage {
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5.5rem 0.75rem 1.5rem; /* nav clearance */
    box-sizing: border-box;
    z-index: 5;
  }

  .fvs-stage-inner {
    position: relative;
    width: min(100%, 1100px);
    /* 16:9 box */
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    /* stacking context for absolute pages */
    isolation: isolate;
  }

  /*
   * Every page is ABSOLUTE in the same slot.
   * Only the front page is fully visible; under pages blur.
   */
  .fvs-page {
    position: absolute;
    inset: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    box-shadow:
      0 22px 50px rgba(15, 23, 42, 0.18),
      0 0 0 1px rgba(15, 23, 42, 0.06);
    opacity: 0;
    transform: translate3d(0, 18px, 0) scale(0.97);
    filter: blur(4px);
    pointer-events: none;
    transition:
      opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.45s ease,
      box-shadow 0.35s ease;
    will-change: opacity, transform, filter;
  }

  .fvs-page.is-under {
    opacity: 0.72;
    transform: translate3d(0, 0, 0) scale(0.96);
    filter: blur(2.5px) brightness(0.85);
    z-index: 1;
  }

  .fvs-page.is-front {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: none;
    pointer-events: auto;
    z-index: 3;
    box-shadow:
      0 26px 56px rgba(15, 23, 42, 0.2),
      0 0 0 1px rgba(15, 23, 42, 0.08);
  }

  .fvs-page.is-front.is-playing {
    box-shadow:
      0 28px 56px rgba(13, 148, 136, 0.28),
      0 0 0 2px rgba(13, 148, 136, 0.55);
  }

  /* Pages not yet reached stay hidden below */
  .fvs-page.is-wait {
    opacity: 0;
    transform: translate3d(0, 24px, 0) scale(0.97);
    filter: blur(6px);
    z-index: 0;
  }

  .fvs-frame {
    position: absolute;
    inset: 0;
    background: #000;
  }

  .fvs-poster,
  .fvs-player,
  .fvs-player iframe {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    border: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
  }
  .fvs-poster {
    object-fit: cover;
    z-index: 1;
  }
  .fvs-player {
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    background: #000;
  }
  .fvs-player.is-on {
    opacity: 1;
    pointer-events: auto;
  }

  .fvs-play {
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    border: none;
    background: transparent;
    cursor: pointer;
    color: #fff;
    padding: 0;
  }
  .fvs-play-ic {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(13, 148, 136, 0.92);
    border: 2px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 12px 32px rgba(13, 148, 136, 0.4);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .fvs-play:hover .fvs-play-ic {
    transform: scale(1.07);
    background: #0D9488;
  }
  .fvs-play-txt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }
  .fvs-page.is-playing .fvs-play { display: none !important; }
  .fvs-page.is-playing .fvs-poster { opacity: 0; pointer-events: none; }
  .fvs-page.is-under .fvs-play,
  .fvs-page.is-wait .fvs-play { display: none !important; }

  .fvs-meta {
    position: absolute;
    z-index: 4;
    left: 12px;
    bottom: 12px;
    display: flex;
    gap: 0.4rem;
    pointer-events: none;
  }
  .fvs-num {
    font-family: var(--font-h, Outfit, system-ui, sans-serif);
    font-weight: 800;
    font-size: 0.8rem;
    color: #fff;
    background: rgba(15, 23, 42, 0.55);
    padding: 0.2rem 0.5rem;
    border-radius: 8px;
    backdrop-filter: blur(8px);
  }
  .fvs-tag {
    font-size: 0.62rem;
    font-weight: 600;
    color: #fff;
    background: rgba(13, 148, 136, 0.82);
    padding: 0.2rem 0.5rem;
    border-radius: 8px;
  }
  .fvs-page.is-playing .fvs-meta,
  .fvs-page.is-under .fvs-meta { opacity: 0; }

  .fvs-dots {
    display: flex;
    gap: 0.4rem;
    justify-content: center;
    margin-top: 1rem;
  }
  .fvs-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #CBD5E1;
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .fvs-dot.is-on {
    background: #0D9488;
    transform: scale(1.25);
  }

  .fvs-more {
    text-align: center;
    padding: 1.75rem 1.25rem 2.75rem;
  }

  /* Mobile: full width sides, large 16:9 */
  @media (max-width: 767px) {
    .fvs-stage {
      padding: 4.5rem 0.4rem 1rem;
    }
    .fvs-stage-inner {
      width: 100%;
      border-radius: 12px;
    }
    .fvs-page { border-radius: 12px; }
    .fvs-play-ic { width: 58px; height: 58px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fvs-track { height: auto !important; }
    .fvs-stage {
      position: relative !important;
      height: auto !important;
      padding: 1rem 0.75rem;
    }
    .fvs-stage-inner {
      aspect-ratio: auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .fvs-page {
      position: relative !important;
      inset: auto !important;
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
      pointer-events: auto !important;
      aspect-ratio: 16 / 9;
    }
    .fvs-dots { display: none; }
  }
</style>

<script is:inline>
(function () {
  var root = document.querySelector('[data-fvs]');
  if (!root) return;

  var track = root.querySelector('[data-track]');
  var stage = root.querySelector('[data-stage]');
  var pages = Array.prototype.slice.call(root.querySelectorAll('[data-page]'));
  var dots = Array.prototype.slice.call(root.querySelectorAll('[data-dot]'));
  var count = pages.length || 6;

  if (track) track.style.setProperty('--fvs-count', String(count));

  var reduced =
    window.matchMedia &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var front = 0;
  var playing = null;

  function stopPage(page) {
    if (!page) return;
    var player = page.querySelector('[data-player]');
    if (player) {
      player.classList.remove('is-on');
      player.innerHTML = '';
    }
    page.classList.remove('is-playing');
    if (playing === page) playing = null;
  }

  function stopAll() {
    pages.forEach(stopPage);
  }

  function play(page) {
    if (!page || !page.classList.contains('is-front')) return;
    var id = page.getAttribute('data-vid');
    var player = page.querySelector('[data-player]');
    if (!id || !player) return;

    stopAll();
    playing = page;
    page.classList.add('is-playing');

    var src =
      'https://www.youtube-nocookie.com/embed/' + id +
      '?autoplay=1&rel=0&playsinline=1&modestbranding=1&iv_load_policy=3' +
      '&origin=' + encodeURIComponent(location.origin || '');

    player.innerHTML =
      '<iframe src="' + src + '" title="Video" width="1280" height="720" ' +
      'style="position:absolute;top:0;left:0;width:100%;height:100%;border:0" ' +
      'allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" ' +
      'allowfullscreen loading="eager" referrerpolicy="strict-origin-when-cross-origin"></iframe>';
    player.classList.add('is-on');
  }

  /**
   * Map scroll position inside the track → page index 0..N-1
   * Stage is sticky in the viewport center the whole time.
   */
  function pageFromScroll() {
    if (!track) return 0;
    var rect = track.getBoundingClientRect();
    var trackH = track.offsetHeight;
    var viewH = window.innerHeight || 1;
    /* distance scrolled through the track */
    var scrolled = -rect.top;
    var travel = Math.max(1, trackH - viewH);
    var p = scrolled / travel;
    if (p < 0) p = 0;
    if (p > 1) p = 1;
    var idx = Math.min(count - 1, Math.floor(p * count));
    return idx;
  }

  function paint(idx) {
    pages.forEach(function (page, i) {
      page.classList.remove('is-front', 'is-under', 'is-wait');
      if (i < idx) {
        page.classList.add('is-under');
        if (page.classList.contains('is-playing')) stopPage(page);
      } else if (i === idx) {
        page.classList.add('is-front');
      } else {
        page.classList.add('is-wait');
      }
    });
    dots.forEach(function (d, i) {
      d.classList.toggle('is-on', i === idx);
    });
  }

  function update() {
    if (reduced) {
      pages.forEach(function (p) {
        p.classList.add('is-front');
        p.classList.remove('is-under', 'is-wait');
      });
      return;
    }
    var idx = pageFromScroll();
    if (idx !== front) {
      front = idx;
      paint(idx);
    }
  }

  var ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      update();
      ticking = false;
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  paint(0);
  update();

  pages.forEach(function (page) {
    var btn = page.querySelector('[data-play]');
    if (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        play(page);
      });
    }
    page.addEventListener('click', function (e) {
      if (page.classList.contains('is-playing')) return;
      if (!page.classList.contains('is-front')) return;
      if (e.target.closest('iframe') || e.target.closest('[data-play]')) return;
      play(page);
    });
  });

  /* Stop when the whole section leaves the viewport */
  if ('IntersectionObserver' in window && track) {
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) stopAll();
        });
      },
      { threshold: 0.02 }
    );
    io.observe(track);
  }

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stopAll();
  });
})();
</script>
