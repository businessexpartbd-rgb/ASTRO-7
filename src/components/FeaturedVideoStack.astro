---
/**
 * 6 cinematic videos — sticky book-page stack
 * -----------------------------------------
 * Scroll down → video 1 pins (cannot go higher).
 * Keep scrolling → video 2 slides onto THE SAME spot (covers 1).
 * Video 1 stays underneath, lightly blurred.
 * Same for 3…6 — all share one screen position.
 * Scroll further down → pages leave one-by-one downward.
 * One playback only; auto-stop when covered or off-screen.
 */
import { SHOWCASES, ytThumb } from '../data/site';

const cinematic = SHOWCASES.find((s) => s.id === 'cinematic')!;
const videos = cinematic.ids.map((id, i) => ({
  id,
  thumb: ytThumb(id),
  n: i + 1,
}));
const total = videos.length;
---

<section id="featured-videos" class="fvs" data-fvs>
  <div class="fvs-head container">
    <p class="eyebrow">Featured Work</p>
    <h2>Cinematic Videos</h2>
    <p class="fvs-lead">Scroll — each film pins in one place like a book page. Tap to play with sound.</p>
  </div>

  <!--
    Sticky stack rail — MUST NOT have overflow:hidden
    Each .fvs-page is 100vh tall; .fvs-sticky pins at the same top.
  -->
  <div class="fvs-rail" data-rail>
    {videos.map((v, i) => (
      <div
        class="fvs-page"
        data-page
        data-i={String(i)}
        style={`--i:${i}`}
      >
        <div class="fvs-sticky">
          <article
            class="fvs-card"
            data-card
            data-vid={v.id}
            data-i={String(i)}
          >
            <div class="fvs-frame">
              <img
                class="fvs-poster"
                src={v.thumb}
                alt=""
                width="1280"
                height="720"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="fvs-player" data-player></div>

              <button type="button" class="fvs-play" data-play aria-label={`Play video ${v.n}`}>
                <span class="fvs-play-ic" aria-hidden="true">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
                <span class="fvs-play-txt">Play with sound</span>
              </button>

              <div class="fvs-meta">
                <span class="fvs-num">{String(v.n).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
                <span class="fvs-tag">Cinematic</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    ))}
  </div>

  <div class="fvs-more container">
    <a href="/portfolio" class="btn btn-outline">View full portfolio →</a>
  </div>
</section>

<style>
  .fvs {
    /* no overflow hidden — sticky would break */
    padding: 2rem 0 0;
    background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 30%);
  }

  .fvs-head {
    text-align: center;
    margin-bottom: 0.5rem;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }
  .fvs-head h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .fvs-lead {
    margin: 0 auto 1rem;
    max-width: 28rem;
    color: var(--text-2, #475569);
    font-size: 0.95rem;
  }

  .fvs-rail {
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    padding: 0 1rem;
    /* critical: visible overflow so position:sticky works */
    overflow: visible;
  }

  /*
   * Each page owns one full viewport of scroll distance.
   * While you scroll through that distance, its card stays pinned.
   */
  .fvs-page {
    position: relative;
    height: 100vh;
    height: 100dvh;
    /* keep a sensible cap on very tall monitors */
    max-height: 920px;
  }

  /*
   * THE pin — same top for every card → they all sit on one spot.
   * Higher --i later in DOM → naturally paints on top (stack order).
   */
  .fvs-sticky {
    position: -webkit-sticky;
    position: sticky;
    top: 5.5rem; /* below fixed navbar */
    z-index: calc(20 + var(--i, 0));
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 0.25rem;
  }

  .fvs-card {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    box-shadow:
      0 20px 50px rgba(15, 23, 42, 0.16),
      0 0 0 1px rgba(15, 23, 42, 0.06);
    line-height: 0;
    transform: translate3d(0, 0, 0) scale(1);
    filter: none;
    opacity: 1;
    transform-origin: center top;
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.45s ease,
      opacity 0.45s ease,
      box-shadow 0.35s ease;
    will-change: transform, filter, opacity;
  }

  /* Covered by a newer page — stays in place, soft book-under look */
  .fvs-card.is-under {
    filter: blur(2.5px) brightness(0.82);
    opacity: 0.78;
    transform: translate3d(0, 0, 0) scale(0.965);
    pointer-events: none;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.1);
  }

  /* Active page on top of the stack */
  .fvs-card.is-front {
    filter: none;
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    pointer-events: auto;
  }

  /* Just arrived on top — short page-turn settle */
  .fvs-card.is-arrive {
    animation: fvs-page-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes fvs-page-in {
    from {
      opacity: 0.4;
      transform: translate3d(0, 28px, 0) scale(0.97);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
      filter: none;
    }
  }

  .fvs-card.is-playing.is-front {
    box-shadow:
      0 28px 56px rgba(13, 148, 136, 0.28),
      0 0 0 2px rgba(13, 148, 136, 0.55);
  }

  /* Full 16:9 — no empty dark band */
  .fvs-frame {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 56.25%;
    background: #000;
    overflow: hidden;
  }

  .fvs-poster,
  .fvs-player,
  .fvs-player iframe {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    border: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
  }
  .fvs-poster {
    object-fit: cover;
    z-index: 1;
  }
  .fvs-player {
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    background: #000;
  }
  .fvs-player.is-on {
    opacity: 1;
    pointer-events: auto;
  }

  .fvs-play {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    border: none;
    background: transparent;
    cursor: pointer;
    color: #fff;
    padding: 0;
  }
  .fvs-play-ic {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(13, 148, 136, 0.92);
    border: 2px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 10px 28px rgba(13, 148, 136, 0.4);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .fvs-play:hover .fvs-play-ic {
    transform: scale(1.07);
    background: #0D9488;
  }
  .fvs-play-txt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
  }

  .fvs-card.is-playing .fvs-play { display: none !important; }
  .fvs-card.is-playing .fvs-poster { opacity: 0; pointer-events: none; }
  .fvs-card.is-under .fvs-play { display: none !important; }

  .fvs-meta {
    position: absolute;
    z-index: 3;
    left: 12px;
    bottom: 12px;
    display: flex;
    gap: 0.4rem;
    pointer-events: none;
  }
  .fvs-num {
    font-family: var(--font-h, Outfit, system-ui, sans-serif);
    font-weight: 800;
    font-size: 0.8rem;
    color: #fff;
    background: rgba(15, 23, 42, 0.55);
    padding: 0.2rem 0.5rem;
    border-radius: 8px;
    backdrop-filter: blur(8px);
  }
  .fvs-tag {
    font-size: 0.62rem;
    font-weight: 600;
    color: #fff;
    background: rgba(13, 148, 136, 0.8);
    padding: 0.2rem 0.5rem;
    border-radius: 8px;
  }
  .fvs-card.is-playing .fvs-meta,
  .fvs-card.is-under .fvs-meta { opacity: 0; }

  .fvs-more {
    text-align: center;
    padding: 1.5rem 1.25rem 2.5rem;
  }

  /* —— Mobile: same sticky stack, tighter pin —— */
  @media (max-width: 767px) {
    .fvs-rail { padding: 0 0.5rem; max-width: 100%; }
    .fvs-page {
      height: 100vh;
      height: 100dvh;
      max-height: none;
    }
    .fvs-sticky {
      top: 4.5rem;
    }
    .fvs-card { border-radius: 12px; }
    .fvs-play-ic { width: 56px; height: 56px; }
    .fvs-card.is-under {
      filter: blur(2px) brightness(0.88);
      transform: scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fvs-page {
      height: auto !important;
      margin-bottom: 1rem;
    }
    .fvs-sticky {
      position: relative !important;
      top: auto !important;
    }
    .fvs-card {
      transition: none !important;
      animation: none !important;
      filter: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script is:inline>
(function () {
  var root = document.querySelector('[data-fvs]');
  if (!root) return;

  var pages = Array.prototype.slice.call(root.querySelectorAll('[data-page]'));
  var cards = Array.prototype.slice.call(root.querySelectorAll('[data-card]'));
  if (!cards.length) return;

  var reduced =
    window.matchMedia &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var frontIdx = -1;
  var playing = null;

  function stopCard(card) {
    if (!card) return;
    var p = card.querySelector('[data-player]');
    if (p) {
      p.classList.remove('is-on');
      p.innerHTML = '';
    }
    card.classList.remove('is-playing');
    if (playing === card) playing = null;
  }

  function stopAll() {
    cards.forEach(stopCard);
  }

  function play(card) {
    if (!card || !card.classList.contains('is-front')) return;
    var id = card.getAttribute('data-vid');
    var player = card.querySelector('[data-player]');
    if (!id || !player) return;

    stopAll();
    playing = card;
    card.classList.add('is-playing');

    var src =
      'https://www.youtube-nocookie.com/embed/' + id +
      '?autoplay=1&rel=0&playsinline=1&modestbranding=1&iv_load_policy=3' +
      '&origin=' + encodeURIComponent(location.origin || '');

    player.innerHTML =
      '<iframe src="' + src + '" title="Video" width="1280" height="720" ' +
      'style="position:absolute;top:0;left:0;width:100%;height:100%;border:0" ' +
      'allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" ' +
      'allowfullscreen loading="eager" referrerpolicy="strict-origin-when-cross-origin"></iframe>';
    player.classList.add('is-on');
  }

  /**
   * Front page = highest index whose sticky has engaged
   * (page top has scrolled to or above the sticky offset).
   */
  function updateFront() {
    if (reduced) {
      cards.forEach(function (c) {
        c.classList.add('is-front');
        c.classList.remove('is-under', 'is-arrive');
      });
      return;
    }

    var stickyEl = root.querySelector('.fvs-sticky');
    var pin = 88;
    if (stickyEl) {
      var t = parseFloat(window.getComputedStyle(stickyEl).top);
      if (!isNaN(t)) pin = t;
    }

    var idx = 0;
    pages.forEach(function (page, i) {
      var top = page.getBoundingClientRect().top;
      if (top <= pin + 4) idx = i;
    });

    if (idx !== frontIdx) {
      var prev = frontIdx;
      frontIdx = idx;

      cards.forEach(function (card, i) {
        card.classList.remove('is-front', 'is-under', 'is-arrive');
        if (i < idx) {
          card.classList.add('is-under');
          if (card.classList.contains('is-playing')) stopCard(card);
        } else if (i === idx) {
          card.classList.add('is-front');
          /* page-turn only when advancing forward */
          if (prev >= 0 && idx > prev) {
            card.classList.add('is-arrive');
            setTimeout(function () {
              card.classList.remove('is-arrive');
            }, 560);
          }
        } else {
          /* not yet reached — still normal */
          card.classList.add('is-front');
        }
      });
    }
  }

  var ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      updateFront();
      ticking = false;
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  updateFront();

  cards.forEach(function (card) {
    var btn = card.querySelector('[data-play]');
    if (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        play(card);
      });
    }
    card.addEventListener('click', function (e) {
      if (card.classList.contains('is-playing')) return;
      if (!card.classList.contains('is-front')) return;
      if (card.classList.contains('is-under')) return;
      if (e.target.closest('iframe') || e.target.closest('[data-play]')) return;
      play(card);
    });
  });

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting && en.target.classList.contains('is-playing')) {
            stopCard(en.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    cards.forEach(function (c) { io.observe(c); });
  }

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stopAll();
  });
})();
</script>
