---
/**
 * Homepage only — 6 cinematic videos
 * Sticky stack + deferred YouTube iframe (poster first, play on tap)
 */
import { SHOWCASES, ytThumb } from '../data/site';

const cinematic = SHOWCASES.find((s) => s.id === 'cinematic')!;
const videos = cinematic.ids.map((id, i) => ({
  id,
  thumb: ytThumb(id, i < 2 ? 'hq' : 'mq'),
  n: i + 1,
}));
const total = videos.length;
---

<section id="featured-videos" class="fvs" data-fvs>
  <div class="fvs-head">
    <p class="eyebrow">Featured Work</p>
    <h2>Cinematic Videos</h2>
    <p class="fvs-lead">Scroll — each film locks into a cinematic stack. Only the front film plays when you choose.</p>
  </div>

  <div class="fvs-list" data-list>
    {videos.map((v, i) => (
      <div class="fvs-panel" data-panel data-i={String(i)} style={`--i:${i}`}>
        <div class="fvs-pin">
          <article
            class:list={['fvs-card', i === 0 && 'is-front']}
            data-card
            data-vid={v.id}
            data-i={String(i)}
          >
            <div class="fvs-frame">
              <img
                class="fvs-poster"
                src={v.thumb}
                alt={`Cinematic video ${v.n}`}
                width="640"
                height="360"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={i === 0 ? 'high' : 'low'}
              />
              <div class="fvs-player" data-player></div>

              <button type="button" class="fvs-pause" data-pause aria-label={`Pause video ${v.n}`}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
                <span>Pause</span>
              </button>

              <button type="button" class="fvs-play" data-play aria-label={`Play video ${v.n}`}>
                <span class="fvs-play-ic" aria-hidden="true">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
                <span class="fvs-play-txt">Play with sound</span>
              </button>

              <div class="fvs-meta">
                <span class="fvs-num">{String(v.n).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
                <span class="fvs-tag">16:9 · Cinematic</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    ))}
  </div>

  <div class="fvs-more">
    <a href="/portfolio" class="btn btn-outline">View full portfolio →</a>
  </div>
</section>

<style>
  .fvs {
    padding: 1.75rem 0 0;
    background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 40%);
  }

  .fvs-head {
    text-align: center;
    padding: 0 1rem 1rem;
    max-width: 36rem;
    margin: 0 auto;
  }
  .fvs-head h2 {
    margin: 0 0 0.35rem;
    font-size: clamp(1.45rem, 3vw, 1.95rem);
  }
  .fvs-lead {
    margin: 0;
    color: #475569;
    font-size: 0.92rem;
  }

  .fvs-list {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 0.75rem;
    box-sizing: border-box;
  }

  .fvs-panel {
    position: relative;
    height: 92vh;
    height: 92dvh;
    max-height: 860px;
    min-height: 420px;
  }
  .fvs-panel:last-child {
    height: auto;
    max-height: none;
    min-height: 0;
    padding-bottom: 1.25rem;
  }

  .fvs-pin {
    position: -webkit-sticky;
    position: sticky;
    top: max(4.75rem, calc((100vh - 56.25vw) / 2));
    top: max(4.75rem, calc((100dvh - 56.25vw) / 2));
    z-index: calc(10 + var(--i, 0));
    width: 100%;
  }

  .fvs-card {
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    background: #0B0F19;
    box-shadow:
      0 20px 48px rgba(15, 23, 42, 0.16),
      0 0 0 1px rgba(15, 23, 42, 0.07);
    line-height: 0;
    transform: translateZ(0);
    filter: none;
    opacity: 1;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.35s ease,
      opacity 0.35s ease,
      box-shadow 0.25s ease;
  }

  .fvs-card.is-under {
    filter: brightness(calc(0.9 - (var(--depth, 1) * 0.035)));
    opacity: calc(0.94 - (var(--depth, 1) * 0.08));
    transform:
      translate3d(0, calc(var(--depth, 1) * -9px), 0)
      scale(calc(1 - (var(--depth, 1) * 0.012)));
    pointer-events: none;
  }

  .fvs-card.is-next {
    filter: none;
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .fvs-card.is-front {
    filter: none;
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .fvs-card.is-front::before {
    content: '';
    position: absolute;
    z-index: 5;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.12);
  }

  .fvs-card.is-front.is-playing {
    box-shadow:
      0 26px 52px rgba(37, 99, 235, 0.28),
      0 0 0 2px rgba(37, 99, 235, 0.5);
  }

  .fvs-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0B0F19;
    overflow: hidden;
    contain: layout paint;
  }

  .fvs-poster,
  .fvs-player,
  .fvs-player iframe {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    border: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
  }
  .fvs-poster {
    object-fit: cover;
    z-index: 1;
  }
  .fvs-player {
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    background: #000;
  }
  .fvs-player.is-on {
    opacity: 1;
    pointer-events: auto;
  }

  .fvs-play {
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    border: none;
    background: transparent;
    cursor: pointer;
    color: #fff;
    padding: 0;
    touch-action: manipulation;
  }
  .fvs-play-ic {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(37, 99, 235, 0.94);
    border: 2px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 10px 28px rgba(37, 99, 235, 0.4);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .fvs-play:hover .fvs-play-ic,
  .fvs-play:active .fvs-play-ic {
    transform: scale(1.06);
    background: #1D4ED8;
  }
  .fvs-play-txt {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .fvs-card.is-playing .fvs-play { display: none !important; }
  .fvs-card.is-playing .fvs-poster { opacity: 0; pointer-events: none; }
  .fvs-card.is-under .fvs-play { display: none !important; }
  .fvs-pause {
    position: absolute;
    z-index: 5;
    top: 10px;
    right: 10px;
    display: none;
    align-items: center;
    gap: .3rem;
    min-height: 38px;
    padding: .45rem .65rem;
    border: 1px solid rgba(255,255,255,.32);
    border-radius: 999px;
    color: #fff;
    background: rgba(2,6,23,.72);
    box-shadow: 0 8px 24px rgba(0,0,0,.22);
    backdrop-filter: blur(8px);
    font: 800 .62rem/1 Outfit,system-ui,sans-serif;
    cursor: pointer;
    touch-action: manipulation;
  }
  .fvs-card.is-playing .fvs-pause { display: inline-flex; }

  .fvs-meta {
    position: absolute;
    z-index: 4;
    left: 10px;
    bottom: 10px;
    display: flex;
    gap: 0.35rem;
    pointer-events: none;
  }
  .fvs-num {
    font-family: Outfit, system-ui, sans-serif;
    font-weight: 800;
    font-size: 0.78rem;
    color: #fff;
    background: rgba(15, 23, 42, 0.55);
    padding: 0.18rem 0.45rem;
    border-radius: 7px;
  }
  .fvs-tag {
    font-size: 0.6rem;
    font-weight: 600;
    color: #fff;
    background: rgba(37, 99, 235, 0.85);
    padding: 0.18rem 0.45rem;
    border-radius: 7px;
  }
  .fvs-card.is-playing .fvs-meta,
  .fvs-card.is-under .fvs-meta { opacity: 0; }

  .fvs-more {
    text-align: center;
    padding: 1.25rem 1rem 2.5rem;
  }

  @media (max-width: 767px) {
    .fvs-list { padding: 0 0.4rem; max-width: 100%; }
    .fvs-panel {
      height: 88vh;
      height: 88dvh;
      max-height: none;
      min-height: 360px;
    }
    .fvs-pin { top: max(4.5rem, 14dvh); }
    .fvs-card { border-radius: 12px; }
    .fvs-play-ic { width: 56px; height: 56px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fvs-panel {
      height: auto !important;
      min-height: 0 !important;
      margin-bottom: 1rem;
    }
    .fvs-pin {
      position: relative !important;
      top: auto !important;
    }
    .fvs-card {
      filter: none !important;
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script is:inline>
(function () {
  var root = document.querySelector('[data-fvs]');
  if (!root) return;

  var panels = Array.prototype.slice.call(root.querySelectorAll('[data-panel]'));
  var cards = Array.prototype.slice.call(root.querySelectorAll('[data-card]'));
  if (!cards.length) return;

  var reduced =
    window.matchMedia &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var frontIdx = -1;
  var playing = null;

  function command(card, func) {
    if (!card) return;
    var iframe = card.querySelector('[data-player] iframe');
    if (!iframe || !iframe.contentWindow) return;
    iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: func, args: [] }), '*');
  }

  function stopCard(card, unload) {
    if (!card) return;
    var p = card.querySelector('[data-player]');
    command(card, 'pauseVideo');
    if (p) {
      p.classList.remove('is-on');
      if (unload) p.innerHTML = '';
    }
    card.classList.remove('is-playing');
    if (playing === card) playing = null;
  }

  function stopAll(except) {
    cards.forEach(function (card) {
      if (card !== except) stopCard(card, true);
    });
  }

  function play(card) {
    if (!card || (!reduced && Number(card.getAttribute('data-i')) !== frontIdx)) return;
    var id = card.getAttribute('data-vid');
    var player = card.querySelector('[data-player]');
    if (!id || !player) return;

    stopAll(card);
    playing = card;
    card.classList.add('is-playing');

    var existing = player.querySelector('iframe');
    if (existing) {
      player.classList.add('is-on');
      command(card, 'playVideo');
      return;
    }

    /* Poster-first loading; the iframe is created only after a real user tap. */
    var src =
      'https://www.youtube-nocookie.com/embed/' + id +
      '?autoplay=1&controls=1&rel=0&playsinline=1&modestbranding=1&iv_load_policy=3&enablejsapi=1&fs=1' +
      '&origin=' + encodeURIComponent(location.origin || '');

    var iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = 'Video';
    iframe.width = '1280';
    iframe.height = '720';
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
    iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
    iframe.setAttribute('loading', 'eager');
    iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
    player.innerHTML = '';
    player.appendChild(iframe);
    player.classList.add('is-on');
  }

  function updateFront() {
    if (reduced) {
      cards.forEach(function (c) {
        c.classList.add('is-front');
        c.classList.remove('is-under', 'is-next');
        c.setAttribute('aria-hidden', 'false');
        var reducedBtn = c.querySelector('[data-play]');
        if (reducedBtn) reducedBtn.removeAttribute('tabindex');
      });
      return;
    }

    var pin = 80;
    var sample = root.querySelector('.fvs-pin');
    if (sample) {
      var t = parseFloat(window.getComputedStyle(sample).top);
      if (!isNaN(t)) pin = t;
    }

    var idx = 0;
    panels.forEach(function (panel, i) {
      if (panel.getBoundingClientRect().top <= pin + 6) idx = i;
    });

    if (idx === frontIdx) return;
    if (playing && playing !== cards[idx]) stopCard(playing, true);
    frontIdx = idx;

    cards.forEach(function (card, i) {
      card.classList.remove('is-front', 'is-under', 'is-next');
      card.style.removeProperty('--depth');
      if (i < idx) {
        card.classList.add('is-under');
        card.style.setProperty('--depth', String(Math.min(idx - i, 4)));
        card.setAttribute('aria-hidden', 'true');
      } else if (i === idx) {
        card.classList.add('is-front');
        card.setAttribute('aria-hidden', 'false');
      } else {
        card.classList.add('is-next');
        card.setAttribute('aria-hidden', 'true');
      }
      var cardBtn = card.querySelector('[data-play]');
      if (cardBtn) cardBtn.setAttribute('tabindex', i === idx ? '0' : '-1');
    });
  }

  var ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      updateFront();
      ticking = false;
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  updateFront();

  cards.forEach(function (card) {
    var btn = card.querySelector('[data-play]');
    var pauseBtn = card.querySelector('[data-pause]');
    if (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        play(card);
      }, { passive: false });
    }
    if (pauseBtn) {
      pauseBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        command(card, 'pauseVideo');
        card.classList.remove('is-playing');
        playing = null;
        var resume = card.querySelector('[data-play] .fvs-play-txt');
        if (resume) resume.textContent = 'Resume video';
      }, { passive: false });
    }
    card.addEventListener('click', function (e) {
      if (card.classList.contains('is-playing')) return;
      if (card.classList.contains('is-under')) return;
      if (e.target.closest('iframe') || e.target.closest('[data-play]')) return;
      play(card);
    });
  });

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting && en.target.classList.contains('is-playing')) {
            stopCard(en.target, true);
          }
        });
      },
      { threshold: 0.12 }
    );
    cards.forEach(function (c) { io.observe(c); });
  }

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stopAll(null);
  });
})();
</script>
