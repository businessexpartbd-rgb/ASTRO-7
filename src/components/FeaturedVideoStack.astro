---
/**
 * Homepage cinematic stack — book-page sticky scroll:
 * each video pins at the same center slot; next folds on top;
 * under-cards lightly blur; only one plays; auto-stop off-screen.
 */
import { SHOWCASES, ytThumb } from '../data/site';

const cinematic = SHOWCASES.find((s) => s.id === 'cinematic')!;
const videos = cinematic.ids.map((id, i) => ({
  id,
  thumb: ytThumb(id),
  n: i + 1,
}));
const total = videos.length;
---

<section id="featured-videos" class="fvs" data-fvs data-total={String(total)}>
  <div class="container fvs-head">
    <p class="eyebrow">Featured Work</p>
    <h2>Cinematic Videos</h2>
    <p class="fvs-lead">Scroll — films stack like pages in one place. Tap to play with sound.</p>
  </div>

  <div class="fvs-stack" data-stack>
    {videos.map((v, i) => (
      <div
        class="fvs-slot"
        data-slot
        data-i={String(i)}
        style={`--i:${i}; --z:${i + 1}`}
      >
        <div class="fvs-pin">
          <article
            class:list={['fvs-card', i === 0 && 'is-top']}
            data-card
            data-vid={v.id}
            data-i={String(i)}
          >
            <div class="fvs-frame">
              <img
                class="fvs-poster"
                src={v.thumb}
                alt=""
                width="1280"
                height="720"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="fvs-player" data-player></div>
              <button type="button" class="fvs-play" data-play aria-label={`Play video ${v.n}`}>
                <span class="fvs-play-ic" aria-hidden="true">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
                <span class="fvs-play-txt">Play with sound</span>
              </button>
              <div class="fvs-meta">
                <span class="fvs-num">{String(v.n).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
                <span class="fvs-tag">16:9 · Cinematic</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    ))}
  </div>

  <div class="container fvs-more">
    <a href="/portfolio" class="btn btn-outline">View full portfolio →</a>
  </div>
</section>

<style>
  .fvs {
    padding: 2.25rem 0 2.5rem;
    background: linear-gradient(180deg, #F8FAFC 0%, #fff 20%, #fff 100%);
  }
  .fvs-head {
    text-align: center;
    margin-bottom: 1.25rem;
    padding: 0 1.25rem;
  }
  .fvs-head h2 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .fvs-lead {
    margin: 0 auto;
    max-width: 28rem;
    color: var(--text-2, #475569);
    font-size: 0.95rem;
  }

  .fvs-stack {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  /*
   * Each slot is viewport-tall so the sticky card holds
   * in the same on-screen position until the next page covers it.
   */
  .fvs-slot {
    position: relative;
    height: 100vh;
    height: 100dvh;
    max-height: 900px;
    min-height: 480px;
  }
  .fvs-slot:last-child {
    /* last page: release stack after a short hold */
    height: auto;
    min-height: 0;
    max-height: none;
    padding-bottom: 1.5rem;
  }

  .fvs-pin {
    position: sticky;
    top: max(5.25rem, calc(50vh - 28vw));
    top: max(5.25rem, calc(50dvh - 28vw));
    z-index: var(--z, 1);
    display: flex;
    justify-content: center;
    will-change: transform;
  }

  .fvs-card {
    width: 100%;
    max-width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    box-shadow:
      0 18px 42px rgba(15, 23, 42, 0.16),
      0 0 0 1px rgba(15, 23, 42, 0.06);
    line-height: 0;
    transform-origin: center center;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.45s ease,
      opacity 0.45s ease,
      box-shadow 0.35s ease;
  }

  /* Under pages (already covered by a newer sticky card) */
  .fvs-card.is-under {
    filter: blur(3px) brightness(0.85);
    opacity: 0.72;
    transform: scale(0.96);
    pointer-events: none;
  }

  /* Active top page */
  .fvs-card.is-top {
    filter: none;
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
    box-shadow:
      0 24px 52px rgba(15, 23, 42, 0.18),
      0 0 0 1px rgba(15, 23, 42, 0.08);
  }

  .fvs-card.is-playing.is-top {
    box-shadow:
      0 28px 56px rgba(13, 148, 136, 0.25),
      0 0 0 2px rgba(13, 148, 136, 0.5);
  }

  /* Leaving the stack downward */
  .fvs-card.is-exit {
    filter: blur(6px);
    opacity: 0.35;
    transform: scale(0.92) translateY(12px);
  }

  /* Reliable full 16:9 box */
  .fvs-frame {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 56.25%;
    background: #000;
    overflow: hidden;
  }

  .fvs-poster,
  .fvs-player,
  .fvs-player iframe {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    border: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
  }

  .fvs-poster {
    object-fit: cover;
    z-index: 1;
  }

  .fvs-player {
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    background: #000;
  }
  .fvs-player.is-on {
    opacity: 1;
    pointer-events: auto;
  }

  .fvs-play {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    border: none;
    background: transparent;
    cursor: pointer;
    color: #fff;
    padding: 0;
  }
  .fvs-play-ic {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(13, 148, 136, 0.92);
    border: 2px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 10px 28px rgba(13, 148, 136, 0.4);
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .fvs-play:hover .fvs-play-ic {
    transform: scale(1.08);
    background: #0D9488;
  }
  .fvs-play-txt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
  }
  .fvs-card.is-playing .fvs-play { display: none !important; }
  .fvs-card.is-playing .fvs-poster {
    opacity: 0;
    pointer-events: none;
  }
  .fvs-card.is-under .fvs-play { display: none !important; }

  .fvs-meta {
    position: absolute;
    z-index: 3;
    left: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    pointer-events: none;
  }
  .fvs-num {
    font-family: var(--font-h, Outfit, system-ui, sans-serif);
    font-weight: 800;
    font-size: 0.8rem;
    color: #fff;
    background: rgba(15, 23, 42, 0.55);
    padding: 0.2rem 0.5rem;
    border-radius: 8px;
    backdrop-filter: blur(8px);
  }
  .fvs-tag {
    font-size: 0.62rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.92);
    background: rgba(13, 148, 136, 0.78);
    padding: 0.2rem 0.5rem;
    border-radius: 8px;
  }
  .fvs-card.is-playing .fvs-meta,
  .fvs-card.is-under .fvs-meta { opacity: 0; }

  .fvs-more {
    text-align: center;
    margin-top: 1.25rem;
    padding: 0 1.25rem;
  }

  /* Mobile: same stack logic, tighter pin offset, full width */
  @media (max-width: 767px) {
    .fvs { padding: 1.35rem 0 1.75rem; }
    .fvs-stack { padding: 0 0.5rem; max-width: 100%; }
    .fvs-slot {
      height: 100vh;
      height: 100dvh;
      max-height: none;
      min-height: 420px;
    }
    .fvs-slot:last-child {
      height: auto;
      min-height: 0;
      padding-bottom: 1rem;
    }
    .fvs-pin {
      top: max(4.5rem, calc(50dvh - 32vw));
    }
    .fvs-card { border-radius: 12px; }
    .fvs-play-ic { width: 56px; height: 56px; }
    .fvs-card.is-under {
      filter: blur(2.5px) brightness(0.88);
      transform: scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fvs-slot {
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      margin-bottom: 1rem;
    }
    .fvs-pin {
      position: relative !important;
      top: 0 !important;
    }
    .fvs-card {
      transition: none !important;
      filter: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script is:inline>
(function () {
  var root = document.querySelector('[data-fvs]');
  if (!root) return;

  var slots = Array.prototype.slice.call(root.querySelectorAll('[data-slot]'));
  var cards = Array.prototype.slice.call(root.querySelectorAll('[data-card]'));
  if (!cards.length) return;

  var reduced =
    window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var playingCard = null;

  function stopCard(card) {
    if (!card) return;
    var player = card.querySelector('[data-player]');
    if (player) {
      player.classList.remove('is-on');
      player.innerHTML = '';
    }
    card.classList.remove('is-playing');
    if (playingCard === card) playingCard = null;
  }

  function stopAll() {
    cards.forEach(stopCard);
    playingCard = null;
  }

  function play(card) {
    /* Only top card may play; never two at once */
    if (!card || !card.classList.contains('is-top')) return;
    var id = card.getAttribute('data-vid');
    var player = card.querySelector('[data-player]');
    if (!id || !player) return;

    stopAll();
    playingCard = card;
    card.classList.add('is-playing');

    var src =
      'https://www.youtube-nocookie.com/embed/' + id +
      '?autoplay=1&rel=0&playsinline=1&modestbranding=1&iv_load_policy=3' +
      '&origin=' + encodeURIComponent(location.origin || '');

    player.innerHTML =
      '<iframe src="' + src + '" title="Video" width="1280" height="720" ' +
      'style="position:absolute;top:0;left:0;width:100%;height:100%;border:0" ' +
      'allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" ' +
      'allowfullscreen loading="eager" referrerpolicy="strict-origin-when-cross-origin"></iframe>';
    player.classList.add('is-on');
  }

  /**
   * Which page is on top of the sticky stack?
   * The last slot whose pin has reached the sticky top (slot top <= pin top threshold).
   */
  function updateStack() {
    if (reduced) {
      cards.forEach(function (c) {
        c.classList.add('is-top');
        c.classList.remove('is-under', 'is-exit');
      });
      return;
    }

    var pinTop = 0;
    var samplePin = root.querySelector('.fvs-pin');
    if (samplePin) {
      var cs = window.getComputedStyle(samplePin);
      pinTop = parseFloat(cs.top) || 84;
    }

    var topIdx = 0;
    slots.forEach(function (slot, i) {
      var rect = slot.getBoundingClientRect();
      /* Slot has scrolled so its top is at or above the sticky line */
      if (rect.top <= pinTop + 8) topIdx = i;
    });

    /* If whole stack scrolled past viewport → exit state + stop play */
    var stack = root.querySelector('[data-stack]');
    var stackRect = stack ? stack.getBoundingClientRect() : null;
    var stackGone = stackRect && stackRect.bottom < pinTop + 40;

    cards.forEach(function (card, i) {
      card.classList.remove('is-top', 'is-under', 'is-exit');
      if (stackGone) {
        card.classList.add('is-exit');
        if (card.classList.contains('is-playing')) stopCard(card);
      } else if (i < topIdx) {
        card.classList.add('is-under');
        /* Covered page cannot keep playing */
        if (card.classList.contains('is-playing')) stopCard(card);
      } else if (i === topIdx) {
        card.classList.add('is-top');
      } else {
        /* Upcoming pages below — normal, waiting to rise */
        card.classList.add('is-top');
      }
    });
  }

  var ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      updateStack();
      ticking = false;
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  updateStack();

  cards.forEach(function (card) {
    var btn = card.querySelector('[data-play]');
    if (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        play(card);
      });
    }
    card.addEventListener('click', function (e) {
      if (card.classList.contains('is-playing')) return;
      if (!card.classList.contains('is-top')) return;
      if (e.target.closest('[data-play]') || e.target.closest('iframe')) return;
      play(card);
    });
  });

  /* Safety: stop if card leaves viewport entirely */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting && en.target.classList.contains('is-playing')) {
            stopCard(en.target);
          }
        });
      },
      { threshold: 0.08 }
    );
    cards.forEach(function (c) { io.observe(c); });
  }

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stopAll();
  });
})();
</script>
