---
import { SHOWCASES, ytThumb } from '../data/site';
---
<section id="portfolio" class="section-gallery">
  <div class="container">
    <div class="text-center mb-10 reveal">
      <p class="eyebrow" style="margin:0 auto 1rem">Video Portfolio</p>
      <h2 class="mb-4">Work That Converts</h2>
      <p style="max-width:36rem;margin:0 auto">Cinematic films, AI product ads, financial campaigns and custom projects.</p>
    </div>

    {
      SHOWCASES.map((group) => (
        <div class={`gallery-block reveal format-${group.format}`} id={group.id}>
          <div class="gallery-head">
            <h3 class="gallery-title">{group.title}</h3>
            <p class="gallery-sub">{group.sub}</p>
            <p class="gallery-bn">{group.titleBn}</p>
          </div>
          <div class={`video-grid ${group.format === 'short' ? 'grid-short' : 'grid-wide'}`}>
            {
              group.ids.map((vid) => (
                <button
                  type="button"
                  class={`video-card ${group.format}`}
                  data-yt={vid}
                  data-format={group.format}
                  aria-label={`Play video`}
                >
                  <img
                    src={ytThumb(vid)}
                    alt=""
                    width={group.format === 'short' ? 270 : 480}
                    height={group.format === 'short' ? 480 : 270}
                    loading="lazy"
                    decoding="async"
                    class="video-thumb"
                  />
                  <span class="play-glass" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      ))
    }
  </div>

  <div class="yt-modal" id="yt-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="yt-backdrop" id="yt-backdrop"></div>
    <div class="yt-panel landscape" id="yt-panel">
      <button type="button" class="yt-close" id="yt-close" aria-label="Close">×</button>
      <div class="yt-frame-wrap" id="yt-frame-wrap"></div>
    </div>
  </div>
</section>

<style is:global>
  .section-gallery {
    padding: 4.5rem 1.25rem;
    background: #F8FAFC;
  }
  .gallery-block { margin-bottom: 3.5rem; }
  .gallery-block:last-child { margin-bottom: 0; }
  .gallery-head { margin-bottom: 1.25rem; }
  .gallery-title {
    font-family: var(--font-h);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.35rem;
  }
  .gallery-sub { color: var(--text-2); font-size: 0.95rem; margin: 0 0 0.25rem; max-width: 40rem; }
  .gallery-bn { color: var(--text-3); font-size: 0.85rem; margin: 0; }

  .video-grid.grid-wide {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
  }
  @media (min-width: 720px) {
    .video-grid.grid-wide { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }

  .video-grid.grid-short {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .video-grid.grid-short { grid-template-columns: repeat(3, 1fr); gap: 0.9rem; }
  }
  @media (min-width: 960px) {
    .video-grid.grid-short { grid-template-columns: repeat(6, 1fr); }
  }

  .video-card {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    background: #0f172a;
    box-shadow: 0 8px 28px rgba(15, 23, 42, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .video-card.landscape { aspect-ratio: 16 / 9; }
  .video-card.short { aspect-ratio: 9 / 16; max-height: 320px; margin: 0 auto; }
  @media (min-width: 640px) {
    .video-card.short { max-height: 380px; }
  }
  .video-card:hover { transform: translateY(-3px); box-shadow: 0 14px 36px rgba(15, 23, 42, 0.14); }
  .video-card:hover .play-glass { transform: translate(-50%, -50%) scale(1.06); background: rgba(255,255,255,0.55); }

  .video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Single light glass play button */
  .play-glass {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(255, 255, 255, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
    pointer-events: none;
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .play-glass svg { margin-left: 3px; filter: drop-shadow(0 1px 2px rgba(0,0,0,.25)); }

  .yt-modal {
    position: fixed;
    inset: 0;
    z-index: 10050;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .yt-modal.is-open { display: flex; }
  .yt-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.78);
    backdrop-filter: blur(8px);
  }
  .yt-panel {
    position: relative;
    z-index: 1;
    border-radius: 18px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
  }
  .yt-panel.landscape { width: min(960px, 100%); }
  .yt-panel.short {
    width: min(400px, 92vw);
    max-height: 90vh;
  }
  .yt-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 1.5rem;
    cursor: pointer;
  }
  .yt-frame-wrap { position: relative; width: 100%; }
  .yt-panel.landscape .yt-frame-wrap { padding-top: 56.25%; }
  .yt-panel.short .yt-frame-wrap { padding-top: 177.78%; }
  .yt-frame-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script is:inline>
(function () {
  var modal = document.getElementById('yt-modal');
  var panel = document.getElementById('yt-panel');
  var wrap = document.getElementById('yt-frame-wrap');
  var closeBtn = document.getElementById('yt-close');
  var backdrop = document.getElementById('yt-backdrop');

  function openYt(id, format) {
    if (!modal || !wrap || !panel) return;
    panel.classList.remove('landscape', 'short');
    panel.classList.add(format === 'short' ? 'short' : 'landscape');
    wrap.innerHTML =
      '<iframe src="https://www.youtube-nocookie.com/embed/' +
      id +
      '?autoplay=1&rel=0&playsinline=1" title="Video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="eager"></iframe>';
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeYt() {
    if (!modal || !wrap) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    wrap.innerHTML = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.video-card[data-yt]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-yt');
      var format = btn.getAttribute('data-format') || 'landscape';
      if (id) openYt(id, format);
    });
  });

  if (closeBtn) closeBtn.addEventListener('click', closeYt);
  if (backdrop) backdrop.addEventListener('click', closeYt);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeYt();
  });
})();
</script>
