---
/**
 * Full video gallery — used on /portfolio.
 * Modal playback WITH SOUND (no mute).
 * Optionally skip cinematic group if already featured on homepage.
 */
import { SHOWCASES, ytThumb } from '../data/site';

interface Props {
  excludeCinematic?: boolean;
  portfolioMode?: boolean;
}
const { excludeCinematic = true, portfolioMode = false } = Astro.props;

const groups = excludeCinematic
  ? SHOWCASES.filter((g) => g.id !== 'cinematic')
  : SHOWCASES;
---
<section id="portfolio" class="section-gallery">
  <div class="container">
    {!portfolioMode && (
      <div class="text-center mb-10 reveal">
        <p class="eyebrow" style="margin:0 auto 1rem">Video Portfolio</p>
        <h2 class="mb-4">More Work</h2>
        <p style="max-width:36rem;margin:0 auto">
          AI product ads, financial campaigns and custom projects — play with sound.
        </p>
      </div>
    )}

    {groups.map((group) => (
      <div class="gallery-block reveal" id={group.id}>
        <div class="gallery-head">
          <div class="gallery-label">Case series</div>
          <h3 class="gallery-title">{group.title}</h3>
          <p class="gallery-sub">{group.sub}</p>
          <p class="gallery-bn">{group.titleBn}</p>
        </div>
        <div class:list={['video-grid', group.format === 'short' && 'is-short']}>
          {group.ids.map((vid) => (
            <button
              type="button"
              class="video-card"
              data-yt={vid}
              data-format={group.format}
              aria-label={`Play ${group.title} video`}
            >
              <img
                src={ytThumb(vid)}
                alt=""
                width={group.format === 'short' ? '360' : '480'}
                height={group.format === 'short' ? '640' : '270'}
                loading="lazy"
                decoding="async"
                class="video-thumb"
              />
              <span class="video-shade" aria-hidden="true"></span>
              <span class="play-glass" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
              </span>
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="yt-modal" id="yt-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="yt-backdrop" id="yt-backdrop"></div>
    <div class="yt-panel landscape" id="yt-panel">
      <button type="button" class="yt-close" id="yt-close" aria-label="Close">×</button>
      <div class="yt-frame-wrap" id="yt-frame-wrap"></div>
    </div>
  </div>
</section>

<style>
  .section-gallery {
    padding: 3rem 1.25rem 4.5rem;
    background: #fff;
  }
  .gallery-block {
    margin-bottom: 3.5rem;
  }
  .gallery-block:last-child { margin-bottom: 0; }
  .gallery-head { margin-bottom: 1.25rem; }
  .gallery-label {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0D9488;
    margin-bottom: 0.4rem;
  }
  .gallery-title {
    font-family: var(--font-h);
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 0.4rem;
  }
  .gallery-sub {
    color: var(--text-2);
    font-size: 0.95rem;
    margin: 0 0 0.25rem;
    max-width: 40rem;
  }
  .gallery-bn {
    color: var(--text-3);
    font-size: 0.85rem;
    margin: 0;
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .video-grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }
  .video-grid.is-short {
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 640px) {
    .video-grid.is-short { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 900px) {
    .video-grid.is-short { grid-template-columns: repeat(4, 1fr); }
  }
  .video-card {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    background: #0f172a;
    aspect-ratio: 16 / 9;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
  }
  .video-grid.is-short .video-card {
    aspect-ratio: 9 / 16;
  }
  @media (hover: hover) and (pointer: fine) {
    .video-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
    }
    .video-card:hover .video-thumb { transform: scale(1.05); }
    .video-card:hover .play-glass {
      transform: translate(-50%, -50%) scale(1.08);
      background: rgba(13, 148, 136, 0.92);
    }
  }
  .video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .video-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(15, 23, 42, 0.35) 100%);
    pointer-events: none;
  }
  .play-glass {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 54px;
    height: 54px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(13, 148, 136, 0.88);
    border: 2px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 8px 24px rgba(13, 148, 136, 0.35);
    pointer-events: none;
    transition: transform 0.3s ease, background 0.3s ease;
  }
  .yt-modal {
    position: fixed;
    inset: 0;
    z-index: 10050;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .yt-modal.is-open { display: flex; }
  .yt-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.82);
  }
  .yt-panel {
    position: relative;
    z-index: 1;
    border-radius: 18px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
  }
  .yt-panel.landscape { width: min(960px, 100%); }
  .yt-panel.short { width: min(400px, 92vw); max-height: 90vh; }
  .yt-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    font-size: 1.5rem;
    cursor: pointer;
  }
  .yt-frame-wrap { position: relative; width: 100%; }
  .yt-panel.landscape .yt-frame-wrap { padding-top: 56.25%; }
  .yt-panel.short .yt-frame-wrap { padding-top: 177.78%; }
  .yt-frame-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script is:inline>
(function () {
  var modal = document.getElementById('yt-modal');
  var panel = document.getElementById('yt-panel');
  var wrap = document.getElementById('yt-frame-wrap');
  var closeBtn = document.getElementById('yt-close');
  var backdrop = document.getElementById('yt-backdrop');

  function openYt(id, format) {
    if (!modal || !wrap || !panel) return;
    panel.classList.remove('landscape', 'short');
    panel.classList.add(format === 'short' ? 'short' : 'landscape');
    /* WITH SOUND — no mute parameter (user click enables audio) */
    wrap.innerHTML =
      '<iframe src="https://www.youtube-nocookie.com/embed/' + id +
      '?autoplay=1&rel=0&playsinline=1&modestbranding=1" title="Video" ' +
      'allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" ' +
      'allowfullscreen loading="eager"></iframe>';
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeYt() {
    if (!modal || !wrap) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    wrap.innerHTML = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.video-card[data-yt]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-yt');
      var format = btn.getAttribute('data-format') || 'landscape';
      if (id) openYt(id, format);
    });
  });

  if (closeBtn) closeBtn.addEventListener('click', closeYt);
  if (backdrop) backdrop.addEventListener('click', closeYt);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeYt();
  });
})();
</script>
