---
import ServiceIcons from './icons/ServiceIcons.astro';
import { SERVICE_CATALOG } from '../data/services';

const groups = [
  {
    key: 'Creative',
    number: '01',
    label: 'Creative Production',
    headline: 'Stories people choose to watch.',
    description: 'AI video, professional editing and human-led content for campaigns, products and brands.',
    icon: 'video',
    accent: '#C44B0B',
    wash: 'rgba(234,88,12,.09)',
  },
  {
    key: 'Technology',
    number: '02',
    label: 'Web & Software',
    headline: 'Digital products built to perform.',
    description: 'Fast websites, mobile and web applications, secure access and useful business automation.',
    icon: 'web',
    accent: '#175CD3',
    wash: 'rgba(37,99,235,.09)',
  },
  {
    key: 'Growth',
    number: '03',
    label: 'Digital Growth',
    headline: 'Visibility connected to outcomes.',
    description: 'SEO, digital marketing, Meta services, boosting and campaigns with a clear objective.',
    icon: 'marketing',
    accent: '#137849',
    wash: 'rgba(22,163,74,.09)',
  },
];
---

<section id="what-we-do" class="service-compass" aria-labelledby="service-compass-title">
  <div class="container">
    <header class="compass-head reveal">
      <div>
        <p class="eyebrow">Full-Service IT Company</p>
        <h2 id="service-compass-title">Three disciplines. <span class="brand-accent">One accountable team.</span></h2>
      </div>
      <div class="compass-intro">
        <p>Creavix brings creative production, technology and digital growth together—so every part of your brand works as one connected system.</p>
        <div class="compass-actions">
          <a href="/services">Explore all services <span aria-hidden="true">↗</span></a>
          <a href="/portfolio">View our work <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </header>

    <div class="compass-grid" aria-label="Creavix service categories">
      {groups.map((group, index) => (
        <article class="compass-card reveal" style={`--compass-accent:${group.accent};--compass-wash:${group.wash};--compass-index:${index}`}>
          <div class="compass-card-top">
            <span class="compass-icon"><ServiceIcons name={group.icon} size={30} /></span>
            <span class="compass-number">{group.number}</span>
          </div>
          <p class="compass-label">{group.label}</p>
          <h3>{group.headline}</h3>
          <p class="compass-description">{group.description}</p>
          <nav aria-label={`${group.label} services`}>
            {SERVICE_CATALOG.filter((service) => service.group === group.key).map((service) => (
              <a href={`/services/${service.slug}`}>
                <span>{service.title}</span><b aria-hidden="true">↗</b>
              </a>
            ))}
          </nav>
        </article>
      ))}
    </div>

    <p class="compass-note reveal"><strong>Need several services?</strong> We can connect strategy, production, development and growth under one project plan.</p>
  </div>
</section>

<style>
  .service-compass{position:relative;padding:4.5rem 1.25rem 5rem;overflow:hidden;background:linear-gradient(180deg,#fff 0%,#f8fafc 56%,#fff 100%);border-bottom:1px solid rgba(15,23,42,.06)}
  .service-compass:before{content:'';position:absolute;width:520px;height:520px;right:-260px;top:-260px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.08),transparent 68%);pointer-events:none}
  .compass-head{position:relative;display:grid;gap:1.25rem;margin-bottom:2rem}.compass-head .eyebrow{margin:0 0 .8rem}.compass-head h2{max-width:660px;margin:0;font-size:clamp(1.8rem,4vw,3rem);line-height:1.08}.compass-intro>p{max-width:610px;margin:0;color:#536478;font-size:.98rem;line-height:1.75}.compass-actions{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1rem}.compass-actions a{display:inline-flex;align-items:center;gap:.55rem;min-height:42px;padding:.62rem .86rem;border:1px solid rgba(15,23,42,.1);border-radius:12px;background:#fff;color:#0a2540;font:800 .72rem/1 var(--font-h);text-decoration:none}.compass-actions a:first-child{border-color:#0a2540;background:#0a2540;color:#fff}.compass-actions a:hover,.compass-actions a:focus-visible{border-color:#175cd3;color:#175cd3;outline:3px solid rgba(37,99,235,.16);outline-offset:2px}.compass-actions a:first-child:hover,.compass-actions a:first-child:focus-visible{background:#175cd3;color:#fff}
  .compass-grid{position:relative;display:grid;gap:1rem}.compass-card{position:relative;display:flex;flex-direction:column;min-width:0;padding:1.35rem;border:1px solid rgba(15,23,42,.085);border-radius:24px;background:linear-gradient(150deg,#fff 0%,rgba(255,255,255,.9) 58%,var(--compass-wash) 150%);box-shadow:0 16px 42px rgba(15,23,42,.06),inset 0 1px 0 #fff;overflow:hidden;transition:transform .35s cubic-bezier(.16,1,.3,1),box-shadow .35s,border-color .35s}.compass-card:before{content:'';position:absolute;left:0;right:0;top:0;height:3px;background:var(--compass-accent)}.compass-card:hover{transform:translateY(-5px);border-color:color-mix(in srgb,var(--compass-accent) 28%,transparent);box-shadow:0 24px 55px rgba(15,23,42,.1)}
  .compass-card-top{display:flex;align-items:center;justify-content:space-between}.compass-icon{width:54px;height:54px;display:grid;place-items:center;border:1px solid color-mix(in srgb,var(--compass-accent) 16%,transparent);border-radius:16px;background:var(--compass-wash);color:var(--compass-accent)}.compass-number{font:800 1.05rem/1 var(--font-h);letter-spacing:.08em;color:var(--compass-accent)}.compass-label{margin:1.2rem 0 .48rem;color:var(--compass-accent);font:800 .68rem/1 var(--font-h);letter-spacing:.12em;text-transform:uppercase}.compass-card h3{margin:0;font-size:clamp(1.18rem,2vw,1.42rem);line-height:1.2}.compass-description{margin:.65rem 0 1.15rem;color:#607086;font-size:.82rem;line-height:1.65}
  .compass-card nav{display:grid;gap:.42rem;margin-top:auto}.compass-card nav a{display:flex;align-items:center;justify-content:space-between;gap:.75rem;min-height:43px;padding:.62rem .72rem;border:1px solid rgba(15,23,42,.07);border-radius:12px;background:rgba(255,255,255,.82);color:#20344b;font:700 .73rem/1.3 var(--font-h);text-decoration:none;transition:border-color .2s,background .2s,color .2s,transform .2s}.compass-card nav a b{color:var(--compass-accent)}.compass-card nav a:hover,.compass-card nav a:focus-visible{transform:translateX(3px);border-color:color-mix(in srgb,var(--compass-accent) 30%,transparent);background:#fff;color:var(--compass-accent);outline:none}
  .compass-note{margin:1.25rem 0 0;padding:.85rem 1rem;border:1px solid rgba(37,99,235,.1);border-radius:14px;background:rgba(255,255,255,.76);color:#64748b;font-size:.78rem;line-height:1.55;text-align:center}.compass-note strong{color:#0a2540}
  @media(min-width:720px){.compass-head{grid-template-columns:1.05fr .95fr;align-items:end}.compass-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.compass-card{padding:1.35rem 1.15rem}}
  @media(min-width:1050px){.service-compass{padding-block:5.5rem 6rem}.compass-grid{gap:1.2rem}.compass-card{padding:1.55rem}.compass-description{min-height:4.1rem}}
  @media(max-width:380px){.service-compass{padding-inline:.8rem}.compass-card{padding:1.15rem}.compass-actions{display:grid;grid-template-columns:1fr}.compass-actions a{justify-content:center}}
  @media(prefers-reduced-motion:reduce){.compass-card,.compass-card nav a{transition:none}.compass-card:hover,.compass-card nav a:hover{transform:none}}
</style>
