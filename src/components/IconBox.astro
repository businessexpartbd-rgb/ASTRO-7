---
import ServiceIcons from './icons/ServiceIcons.astro';
interface Props {
  name?: string;
  tone?: string;
  size?: number;
}
const { name = 'web', tone = 'rgba(13,148,136,.12)', size = 44 } = Astro.props;
---
<div class="live-icon-box" style={'background:' + tone}>
  <ServiceIcons name={name} size={size} />
</div>
<style>
  .live-icon-box {
    width: 72px;
    height: 72px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.1rem;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.7), 0 8px 24px rgba(12,18,34,.06);
    border: 1px solid rgba(255,255,255,.65);
  }
  @media (max-width: 639px) {
    .live-icon-box { width: 64px; height: 64px; border-radius: 18px; }
  }
</style>
