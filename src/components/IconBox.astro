---
import ServiceIcons from './icons/ServiceIcons.astro';
interface Props {
  name?: string;
  tone?: string;
  size?: number;
}
const { name = 'web', tone = 'rgba(37,99,235,.1)', size = 44 } = Astro.props;
---
<div class="live-icon-box" style={'--tone:' + tone}>
  <ServiceIcons name={name} size={size} />
</div>
<style>
  .live-icon-box {
    width: 72px;
    height: 72px;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.15rem;
    background: linear-gradient(145deg, #ffffff 0%, #f3f7ff 100%);
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 12px 28px rgba(37, 99, 235, 0.09),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(15, 23, 42, 0.06);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition: transform .45s cubic-bezier(.16,1,.3,1),box-shadow .45s ease;
  }
  .live-icon-box::before {
    content: '';
    position: absolute;
    z-index: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px dashed rgba(37,99,235,.22);
    animation: icon-orbit 12s linear infinite;
  }
  .live-icon-box::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--tone, rgba(37, 99, 235, 0.08));
    pointer-events: none;
    z-index: -1;
  }
  .live-icon-box :global(.live-icon) {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 7px 12px rgba(37,99,235,.16));
    transition: transform .45s cubic-bezier(.16,1,.3,1);
  }
  :global(.service-card:hover) .live-icon-box{transform:translateY(-4px) rotate(-2deg);box-shadow:0 18px 35px rgba(37,99,235,.14),inset 0 1px 0 #fff}
  :global(.service-card:hover) .live-icon-box :global(.live-icon){transform:scale(1.08) rotate(2deg)}
  @keyframes icon-orbit{to{transform:rotate(360deg)}}
  @media (max-width: 639px) {
    .live-icon-box {
      width: 64px;
      height: 64px;
      border-radius: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce){.live-icon-box::before{animation:none}.live-icon-box,.live-icon-box :global(.live-icon){transition:none}}
</style>
