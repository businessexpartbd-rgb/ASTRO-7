---
import ServiceIcons from './icons/ServiceIcons.astro';
interface Props {
  name?: string;
  tone?: string;
  size?: number;
}
const { name = 'web', tone = 'rgba(37,99,235,.1)', size = 44 } = Astro.props;
---
<div class="live-icon-box" style={'--tone:' + tone}>
  <ServiceIcons name={name} size={size} />
</div>
<style>
  .live-icon-box {
    width: 72px;
    height: 72px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.15rem;
    background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 8px 20px rgba(15, 23, 42, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(15, 23, 42, 0.06);
    position: relative;
    overflow: hidden;
  }
  .live-icon-box::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--tone, rgba(37, 99, 235, 0.08));
    pointer-events: none;
  }
  .live-icon-box :global(.live-icon) {
    position: relative;
    z-index: 1;
    color: #2563EB;
  }
  @media (max-width: 639px) {
    .live-icon-box {
      width: 64px;
      height: 64px;
      border-radius: 18px;
    }
  }
</style>
