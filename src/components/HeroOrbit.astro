---
/**
 * Premium 3D iconic hero — services readable by icon only (no label chips).
 * CSS 3D + transform only for speed.
 */
import ServiceIcons from './icons/ServiceIcons.astro';

const outer = [
  { name: 'web', title: 'Web Development' },
  { name: 'app', title: 'Application Build' },
  { name: 'auth', title: 'Authentication' },
  { name: 'ai', title: 'AI Video Marketing' },
  { name: 'video', title: 'Video Editing' },
  { name: 'boost', title: 'Boosting' },
];
const inner = [
  { name: 'campaign', title: 'Campaign' },
  { name: 'facebook', title: 'Facebook Page' },
  { name: 'human', title: 'Human-like Content' },
];
---
<div class="ho3" role="img" aria-label="Creavix IT digital services visualization">
  <div class="ho3-stage">
    <div class="ho3-glow"></div>
    <div class="ho3-floor"></div>

    <!-- Outer orbit -->
    <div class="ho3-orbit ho3-orbit-a">
      {outer.map((item, i) => (
        <div
          class="ho3-slot"
          style={`--i:${i}; --n:${outer.length}`}
          title={item.title}
        >
          <div class="ho3-icon" style={`--spin: ${outer.length}`}>
            <ServiceIcons name={item.name} size={28} />
          </div>
        </div>
      ))}
    </div>

    <!-- Inner orbit (counter) -->
    <div class="ho3-orbit ho3-orbit-b">
      {inner.map((item, i) => (
        <div
          class="ho3-slot ho3-slot-sm"
          style={`--i:${i}; --n:${inner.length}`}
          title={item.title}
        >
          <div class="ho3-icon ho3-icon-sm" style={`--spin: ${inner.length}`}>
            <ServiceIcons name={item.name} size={22} />
          </div>
        </div>
      ))}
    </div>

    <!-- Center hub -->
    <div class="ho3-hub">
      <div class="ho3-hub-ring"></div>
      <div class="ho3-hub-ring ho3-hub-ring2"></div>
      <div class="ho3-hub-core">
        <ServiceIcons name="rocket" size={40} />
      </div>
    </div>
  </div>
</div>

<style>
  .ho3 {
    width: min(100%, 400px);
    margin: 0 auto;
    perspective: 900px;
    perspective-origin: 50% 45%;
  }

  .ho3-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    transform-style: preserve-3d;
    transform: rotateX(18deg);
  }

  .ho3-glow {
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(13, 148, 136, 0.22) 0%,
      rgba(217, 119, 6, 0.08) 45%,
      transparent 70%
    );
    pointer-events: none;
  }

  .ho3-floor {
    position: absolute;
    left: 50%;
    bottom: 6%;
    width: 70%;
    height: 12%;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(15, 23, 42, 0.12), transparent 70%);
    filter: blur(2px);
    pointer-events: none;
  }

  .ho3-orbit {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .ho3-orbit-a {
    animation: ho3-yaw 36s linear infinite;
  }
  .ho3-orbit-b {
    animation: ho3-yaw-rev 24s linear infinite;
  }

  .ho3-slot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    transform-style: preserve-3d;
    /* evenly space on circle */
    transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(148px);
  }
  .ho3-slot-sm {
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    transform: rotateY(calc(var(--i) * 360deg / var(--n) + 20deg)) translateZ(96px);
  }

  .ho3-icon {
    width: 100%;
    height: 100%;
    border-radius: 18px;
    display: grid;
    place-items: center;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.95),
      rgba(255, 255, 255, 0.7)
    );
    border: 1px solid rgba(255, 255, 255, 0.95);
    box-shadow:
      0 10px 28px rgba(13, 148, 136, 0.16),
      0 4px 12px rgba(15, 23, 42, 0.08),
      inset 0 1px 0 #fff;
    color: #0D9488;
    /* keep face toward camera while parent yaws */
    animation: ho3-face 36s linear infinite;
  }
  .ho3-orbit-b .ho3-icon {
    animation-name: ho3-face-rev;
    animation-duration: 24s;
    border-radius: 16px;
    box-shadow:
      0 8px 22px rgba(217, 119, 6, 0.14),
      0 3px 10px rgba(15, 23, 42, 0.06),
      inset 0 1px 0 #fff;
  }
  .ho3-icon-sm {
    border-radius: 14px;
  }

  .ho3-hub {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
    z-index: 2;
  }
  .ho3-hub-core {
    width: 96px;
    height: 96px;
    border-radius: 28px;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, #0D9488, #0F766E);
    color: #fff;
    box-shadow:
      0 16px 40px rgba(13, 148, 136, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transform: translateZ(20px);
  }
  .ho3-hub-core :global(.live-icon) {
    color: #fff !important;
  }
  .ho3-hub-ring,
  .ho3-hub-ring2 {
    position: absolute;
    width: 120px;
    height: 120px;
    border-radius: 32px;
    border: 2px solid rgba(13, 148, 136, 0.28);
    animation: ho3-pulse 2.8s ease-out infinite;
  }
  .ho3-hub-ring2 {
    width: 140px;
    height: 140px;
    border-color: rgba(217, 119, 6, 0.22);
    animation-delay: 0.9s;
  }

  @keyframes ho3-yaw {
    to { transform: rotateY(360deg); }
  }
  @keyframes ho3-yaw-rev {
    to { transform: rotateY(-360deg); }
  }
  @keyframes ho3-face {
    to { transform: rotateY(-360deg); }
  }
  @keyframes ho3-face-rev {
    to { transform: rotateY(360deg); }
  }
  @keyframes ho3-pulse {
    0% { transform: scale(1); opacity: 0.65; }
    70% { transform: scale(1.18); opacity: 0; }
    100% { opacity: 0; }
  }

  @media (max-width: 767px) {
    .ho3 { width: min(100%, 320px); }
    .ho3-stage { transform: rotateX(14deg); }
    .ho3-slot { transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(118px); }
    .ho3-slot-sm { transform: rotateY(calc(var(--i) * 360deg / var(--n) + 20deg)) translateZ(78px); }
    .ho3-hub-core { width: 84px; height: 84px; border-radius: 24px; }
    .ho3-orbit-a { animation-duration: 42s; }
    .ho3-orbit-b { animation-duration: 30s; }
    .ho3-icon { animation-duration: 42s; }
    .ho3-orbit-b .ho3-icon { animation-duration: 30s; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ho3-orbit-a,
    .ho3-orbit-b,
    .ho3-icon,
    .ho3-hub-ring,
    .ho3-hub-ring2 {
      animation: none !important;
    }
  }
</style>
