---
/** Premium process map — matched to reference curriculum animation */
const steps = [
  {
    id: '01',
    title: 'Understanding Client Requirements & Goals',
    chips: [
      { label: 'Growth Strategy', icon: 'spark' },
      { label: 'Identifying Brand', icon: 'check' },
    ],
  },
  {
    id: '02',
    title: 'Conducting Market Research & Planning Strategy',
    chips: [
      { label: 'Audience Insights', icon: 'chart' },
      { label: 'Channel Plan', icon: 'chart' },
    ],
    showChart: true,
  },
  {
    id: '03',
    title: 'Campaign Setup & Content Creation',
    chips: [
      { label: 'Captivating Visuals', icon: 'image' },
      { label: 'Compelling Copywriting', icon: 'pen' },
    ],
  },
  {
    id: '04',
    title: 'Executing Campaigns, AI Integration & Promotion',
    chips: [
      { label: 'Performance Driven SEO', icon: 'seo' },
      { label: 'Targeted Media Buying', icon: 'target' },
    ],
  },
  {
    id: '05',
    title: 'Monitoring, Optimization & Improvement',
    chips: [
      { label: 'Live Tracking', icon: 'pulse' },
      { label: 'A/B Optimize', icon: 'pulse' },
    ],
  },
  {
    id: '06',
    title: 'Reporting Results & Client Support',
    chips: [
      { label: 'Final Output', icon: 'lock' },
      { label: 'Unstoppable Growth', icon: 'trend' },
    ],
  },
];
---
<section id="process" class="pf" aria-labelledby="pf-h">
  <div class="pf-bg" aria-hidden="true">
    <div class="pf-grid"></div>
    <div class="pf-radial"></div>
  </div>

  <div class="pf-inner">
    <header class="pf-head">
      <h2 id="pf-h" class="pf-title">
        Transforming Brands with<br />Strategy, AI &amp; Creative Excellence
      </h2>
      <p class="pf-sub">
        We unleash the power of strategy, design, SEO, ads, content, AI, and
        development to create unstoppable campaigns.
      </p>
    </header>

    <div class="pf-stage" data-pf-stage>
      <!-- Electric connectors -->
      <svg class="pf-svg" viewBox="0 0 1000 620" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <linearGradient id="pfBolt" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#22D3EE" stop-opacity="0" />
            <stop offset="45%" stop-color="#22D3EE" stop-opacity="1" />
            <stop offset="100%" stop-color="#3B82F6" stop-opacity="0.2" />
          </linearGradient>
          <filter id="pfGlow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="2.2" result="b" />
            <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
        </defs>
        <!-- Base faint lines -->
        <path class="pf-base" d="M200 150 C 340 150, 400 250, 500 310" />
        <path class="pf-base" d="M500 110 C 500 180, 500 240, 500 310" />
        <path class="pf-base" d="M800 150 C 660 150, 600 250, 500 310" />
        <path class="pf-base" d="M200 470 C 340 470, 400 370, 500 310" />
        <path class="pf-base" d="M500 520 C 500 450, 500 380, 500 310" />
        <path class="pf-base" d="M800 470 C 660 470, 600 370, 500 310" />
        <!-- Animated bolt overlays -->
        <path class="pf-bolt" style="--d:0s" d="M200 150 C 340 150, 400 250, 500 310" />
        <path class="pf-bolt" style="--d:0.4s" d="M500 110 C 500 180, 500 240, 500 310" />
        <path class="pf-bolt" style="--d:0.8s" d="M800 150 C 660 150, 600 250, 500 310" />
        <path class="pf-bolt" style="--d:1.2s" d="M200 470 C 340 470, 400 370, 500 310" />
        <path class="pf-bolt" style="--d:1.6s" d="M500 520 C 500 450, 500 380, 500 310" />
        <path class="pf-bolt" style="--d:2s" d="M800 470 C 660 470, 600 370, 500 310" />
      </svg>

      <!-- Center hub with real logo -->
      <div class="pf-hub">
        <div class="pf-hub-aura"></div>
        <div class="pf-hub-ring r1"></div>
        <div class="pf-hub-ring r2"></div>
        <div class="pf-hub-core">
          <img src="/logo.png" alt="Creavix" width="48" height="48" loading="eager" decoding="async" />
        </div>
        <div class="pf-hub-reflect" aria-hidden="true"></div>
      </div>

      <!-- Step cards -->
      {steps.map((s, i) => (
        <article
          class={`pf-card pf-c${s.id}`}
          data-step={s.id}
          style={`--i:${i}`}
        >
          <span class="pf-edge tl"></span>
          <span class="pf-edge tr"></span>
          <span class="pf-edge bl"></span>
          <span class="pf-edge br"></span>

          <p class="pf-lbl">Step - {s.id}</p>
          <h3 class="pf-card-t">{s.title}</h3>

          {s.showChart && (
            <div class="pf-mini-chart" aria-hidden="true">
              <i style="--h:40%"></i><i style="--h:70%"></i><i style="--h:55%"></i>
              <i style="--h:85%"></i><i style="--h:60%"></i><i style="--h:95%"></i>
            </div>
          )}

          <div class="pf-chips" data-chips>
            {s.chips.map((c, ci) => (
              <span class={`pf-chip ${ci === 0 ? 'on' : ''}`} data-chip>
                <span class="pf-dot"></span>
                {c.label}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <nav class="pf-dock" aria-label="Quick actions">
      <a href="/">Home</a>
      <a href="#services">Services</a>
      <a class="pf-go" href="/contact">Start Project</a>
      <a href="/video-gallery">Projects</a>
      <a href="#faq">More</a>
    </nav>
  </div>
</section>

<style>
  .pf {
    position: relative;
    padding: 4.25rem 1rem 4.75rem;
    background: #050814;
    color: #E2E8F0;
    overflow: hidden;
  }
  .pf-bg { position: absolute; inset: 0; pointer-events: none; }
  .pf-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(59,130,246,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(59,130,246,.05) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 65% 55% at 50% 48%, #000 15%, transparent 72%);
  }
  .pf-radial {
    position: absolute;
    width: 560px; height: 560px;
    left: 50%; top: 52%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(37,99,235,.28), transparent 68%);
    filter: blur(8px);
  }

  .pf-inner {
    position: relative;
    z-index: 2;
    max-width: 1080px;
    margin: 0 auto;
  }

  .pf-head {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 2.25rem;
  }
  .pf-title {
    margin: 0 0 0.9rem;
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: clamp(1.55rem, 4vw, 2.55rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .pf-sub {
    margin: 0;
    color: #94A3B8;
    font-size: clamp(0.88rem, 1.9vw, 1.02rem);
    line-height: 1.65;
  }

  /* ===== Stage ===== */
  .pf-stage {
    position: relative;
    height: 620px;
    margin: 0 auto 1.75rem;
  }

  .pf-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .pf-base {
    fill: none;
    stroke: rgba(34, 211, 238, 0.22);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .pf-bolt {
    fill: none;
    stroke: url(#pfBolt);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 12 180;
    filter: url(#pfGlow);
    animation: pf-electric 2.8s linear infinite;
    animation-delay: var(--d, 0s);
  }
  @keyframes pf-electric {
    0% { stroke-dashoffset: 0; opacity: 0.2; }
    15% { opacity: 1; }
    100% { stroke-dashoffset: -200; opacity: 0.15; }
  }

  /* ===== Hub + logo ===== */
  .pf-hub {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 128px; height: 128px;
    z-index: 6;
  }
  .pf-hub-aura {
    position: absolute;
    inset: -28px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59,130,246,.55), transparent 70%);
    animation: pf-pulse 2.6s ease-in-out infinite;
  }
  .pf-hub-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(96, 165, 250, 0.4);
  }
  .pf-hub-ring.r1 {
    inset: 0;
    border-style: dashed;
    border-color: rgba(34, 211, 238, 0.4);
    animation: pf-rot 20s linear infinite;
  }
  .pf-hub-ring.r2 {
    inset: 14px;
    border-color: rgba(59, 130, 246, 0.5);
    animation: pf-rot-r 14s linear infinite;
  }
  .pf-hub-core {
    position: absolute;
    inset: 28px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #1E3A8A, #0A1228 72%);
    border: 1px solid rgba(96, 165, 250, 0.65);
    box-shadow:
      0 0 0 6px rgba(37, 99, 235, 0.15),
      0 0 36px rgba(37, 99, 235, 0.55),
      inset 0 0 18px rgba(59, 130, 246, 0.3);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .pf-hub-core img {
    width: 42px;
    height: 42px;
    object-fit: contain;
    filter: drop-shadow(0 0 8px rgba(96, 165, 250, 0.7));
  }
  .pf-hub-reflect {
    position: absolute;
    left: 18%; right: 18%;
    top: 100%;
    height: 36px;
    margin-top: 6px;
    background: radial-gradient(ellipse at top, rgba(59,130,246,.25), transparent 70%);
    filter: blur(4px);
    opacity: 0.7;
  }
  @keyframes pf-pulse {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50% { opacity: 0.9; transform: scale(1.06); }
  }
  @keyframes pf-rot { to { transform: rotate(360deg); } }
  @keyframes pf-rot-r { to { transform: rotate(-360deg); } }

  /* ===== Cards ===== */
  .pf-card {
    position: absolute;
    width: min(268px, 28%);
    padding: 1.05rem 1.1rem 0.95rem;
    border-radius: 16px;
    background: linear-gradient(160deg, rgba(30,41,59,.94), rgba(15,23,42,.9));
    border: 1px solid rgba(148, 163, 184, 0.14);
    box-shadow: 0 14px 36px rgba(0,0,0,.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    opacity: 0;
    transform: translateY(28px) scale(0.96);
    animation: pf-in 0.7s cubic-bezier(0.16,1,0.3,1) forwards;
    animation-delay: calc(0.12s * var(--i) + 0.15s);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    z-index: 5;
  }
  .pf-card:hover {
    border-color: rgba(59, 130, 246, 0.5);
    box-shadow: 0 18px 44px rgba(37, 99, 235, 0.25);
    z-index: 8;
  }
  @keyframes pf-in {
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Cyan corner accents (like reference) */
  .pf-edge {
    position: absolute;
    width: 14px; height: 14px;
    pointer-events: none;
  }
  .pf-edge.tl { top: 0; left: 0; border-top: 2px solid #22D3EE; border-left: 2px solid #22D3EE; border-radius: 16px 0 0 0; }
  .pf-edge.tr { top: 0; right: 0; border-top: 2px solid #22D3EE; border-right: 2px solid #22D3EE; border-radius: 0 16px 0 0; }
  .pf-edge.bl { bottom: 0; left: 0; border-bottom: 2px solid #22D3EE; border-left: 2px solid #22D3EE; border-radius: 0 0 0 16px; opacity: 0.55; }
  .pf-edge.br { bottom: 0; right: 0; border-bottom: 2px solid #22D3EE; border-right: 2px solid #22D3EE; border-radius: 0 0 16px 0; opacity: 0.55; }

  .pf-c01 { left: 0; top: 4%; }
  .pf-c02 { left: 50%; top: 0; transform: translateX(-50%); animation-name: pf-in-x; }
  .pf-c03 { right: 0; top: 4%; }
  .pf-c04 { left: 0; bottom: 2%; }
  .pf-c05 { left: 50%; bottom: 0; transform: translateX(-50%); animation-name: pf-in-x; }
  .pf-c06 { right: 0; bottom: 2%; }

  @keyframes pf-in-x {
    from { opacity: 0; transform: translateX(-50%) translateY(28px) scale(0.96); }
    to { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
  }
  .pf-c02:hover, .pf-c05:hover {
    transform: translateX(-50%) translateY(-3px);
  }
  .pf-c01:hover, .pf-c03:hover, .pf-c04:hover, .pf-c06:hover {
    transform: translateY(-3px);
  }

  .pf-lbl {
    margin: 0 0 0.3rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #64748B;
  }
  .pf-card-t {
    margin: 0 0 0.75rem;
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.35;
    color: #F1F5F9;
  }

  .pf-mini-chart {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 36px;
    margin: 0 0 0.65rem;
    opacity: 0.45;
  }
  .pf-mini-chart i {
    display: block;
    flex: 1;
    height: var(--h);
    border-radius: 3px 3px 0 0;
    background: linear-gradient(180deg, #60A5FA, #1E3A8A);
  }

  .pf-chips {
    position: relative;
    min-height: 32px;
  }
  .pf-chip {
    position: absolute;
    left: 0; top: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.72rem;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(59,130,246,.28), rgba(37,99,235,.18));
    border: 1px solid rgba(96,165,250,.4);
    color: #DBEAFE;
    font-size: 0.7rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    pointer-events: none;
  }
  .pf-chip.on {
    opacity: 1;
    transform: translateY(0);
  }
  .pf-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #60A5FA;
    box-shadow: 0 0 8px rgba(96,165,250,.9);
    flex-shrink: 0;
  }

  /* Dock */
  .pf-dock {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.3rem;
    margin: 0 auto;
    padding: 0.38rem;
    width: fit-content;
    max-width: 100%;
    background: rgba(255,255,255,.96);
    border-radius: 999px;
    box-shadow: 0 14px 40px rgba(0,0,0,.4);
  }
  .pf-dock a {
    padding: 0.52rem 0.9rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #334155;
    text-decoration: none;
    transition: background .2s, color .2s;
  }
  .pf-dock a:hover { background: #F1F5F9; color: #0F172A; }
  .pf-go {
    background: #2563EB !important;
    color: #fff !important;
  }
  .pf-go:hover { background: #1D4ED8 !important; }

  /* ===== Mobile ===== */
  @media (max-width: 900px) {
    .pf-stage {
      height: auto;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.8rem;
      padding-top: 0.5rem;
    }
    .pf-svg { display: none; }
    .pf-hub {
      position: relative;
      left: auto; top: auto;
      transform: none;
      margin: 0 auto 1.25rem;
      width: 100px; height: 100px;
    }
    .pf-hub-core { inset: 22px; }
    .pf-hub-core img { width: 34px; height: 34px; }
    .pf-hub-reflect { display: none; }

    .pf-card {
      position: relative !important;
      left: auto !important;
      right: auto !important;
      top: auto !important;
      bottom: auto !important;
      width: 100% !important;
      transform: none !important;
      animation: pf-in-m 0.55s cubic-bezier(0.16,1,0.3,1) forwards;
      animation-delay: calc(0.08s * var(--i));
    }
    .pf-card:hover {
      transform: translateY(-2px) !important;
    }
    @keyframes pf-in-m {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .pf-chip {
      position: static;
      opacity: 1;
      transform: none;
      margin: 0 0.35rem 0.3rem 0;
    }
    .pf-chips { display: flex; flex-wrap: wrap; min-height: 0; }
  }

  @media (min-width: 641px) and (max-width: 900px) {
    .pf-stage {
      grid-template-columns: 1fr 1fr;
    }
    .pf-hub {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-bolt, .pf-hub-ring, .pf-hub-aura, .pf-card {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script is:inline>
(function () {
  var stage = document.querySelector('[data-pf-stage]');
  if (!stage) return;

  // Cycle chips
  stage.querySelectorAll('[data-chips]').forEach(function (rail) {
    var chips = rail.querySelectorAll('[data-chip]');
    if (chips.length < 2) return;
    var i = 0;
    setInterval(function () {
      chips[i].classList.remove('on');
      i = (i + 1) % chips.length;
      chips[i].classList.add('on');
    }, 2400 + Math.floor(Math.random() * 600));
  });
})();
</script>
