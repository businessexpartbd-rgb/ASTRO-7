---
/** Exact recreation of reference process animation — Creavix logo only change */
const steps = [
  {
    id: '01',
    title: 'Understanding Client Requirements & Goals',
    chips: ['Growth Strategy', 'Identifying Brand'],
  },
  {
    id: '02',
    title: 'Conducting Market Research & Planning Strategy',
    chips: [],
    showChart: true,
  },
  {
    id: '03',
    title: 'Campaign Setup & Content Creation',
    chips: ['Captivating Visuals', 'Compelling Copywriting'],
  },
  {
    id: '04',
    title: 'Executing Campaigns, AI Integration & Promotion',
    chips: ['Performance Driven SEO', 'Targeted Media Buying'],
  },
  {
    id: '05',
    title: 'Monitoring, Optimization & Improvement',
    chips: [],
  },
  {
    id: '06',
    title: 'Reporting Results & Client Support',
    chips: ['Final Output', 'Unstoppable Growth'],
  },
];
---
<section id="process" class="pf" aria-labelledby="pf-h">
  <div class="pf-bg" aria-hidden="true">
    <div class="pf-grid"></div>
    <div class="pf-glow"></div>
  </div>

  <div class="pf-wrap">
    <header class="pf-head">
      <h2 id="pf-h" class="pf-title">
        Transforming Brands with<br />Strategy, AI &amp; Creative Excellence
      </h2>
      <p class="pf-sub">
        We unleash the power of strategy, design, SEO, ads, content, AI, and
        development to create unstoppable campaigns.
      </p>
    </header>

    <div class="pf-stage" data-pf>
      <!-- SVG connectors + traveling light particles -->
      <svg class="pf-svg" viewBox="0 0 1000 640" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <linearGradient id="gLine" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#22D3EE" stop-opacity="0" />
            <stop offset="40%" stop-color="#22D3EE" stop-opacity="1" />
            <stop offset="100%" stop-color="#3B82F6" stop-opacity="0" />
          </linearGradient>
          <filter id="gBlur" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="1.8" result="b" />
            <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
          <radialGradient id="gDot" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#67E8F9" />
            <stop offset="100%" stop-color="#22D3EE" stop-opacity="0" />
          </radialGradient>
        </defs>

        <path class="base" d="M210 155 C 350 155, 420 260, 500 320" />
        <path class="base" d="M500 115 C 500 190, 500 250, 500 320" />
        <path class="base" d="M790 155 C 650 155, 580 260, 500 320" />
        <path class="base" d="M210 485 C 350 485, 420 380, 500 320" />
        <path class="base" d="M500 540 C 500 460, 500 390, 500 320" />
        <path class="base" d="M790 485 C 650 485, 580 380, 500 320" />

        <path class="bolt" pathLength="100" style="--d:0s" d="M210 155 C 350 155, 420 260, 500 320" />
        <path class="bolt" pathLength="100" style="--d:.35s" d="M500 115 C 500 190, 500 250, 500 320" />
        <path class="bolt" pathLength="100" style="--d:.7s" d="M790 155 C 650 155, 580 260, 500 320" />
        <path class="bolt" pathLength="100" style="--d:1.05s" d="M210 485 C 350 485, 420 380, 500 320" />
        <path class="bolt" pathLength="100" style="--d:1.4s" d="M500 540 C 500 460, 500 390, 500 320" />
        <path class="bolt" pathLength="100" style="--d:1.75s" d="M790 485 C 650 485, 580 380, 500 320" />

        <circle r="4" fill="url(#gDot)" filter="url(#gBlur)">
          <animateMotion dur="2.4s" repeatCount="indefinite" begin="0s" path="M500 320 C 420 260, 350 155, 210 155" />
        </circle>
        <circle r="3.5" fill="url(#gDot)" filter="url(#gBlur)">
          <animateMotion dur="2.6s" repeatCount="indefinite" begin="0.4s" path="M500 320 C 500 250, 500 190, 500 115" />
        </circle>
        <circle r="4" fill="url(#gDot)" filter="url(#gBlur)">
          <animateMotion dur="2.5s" repeatCount="indefinite" begin="0.8s" path="M500 320 C 580 260, 650 155, 790 155" />
        </circle>
        <circle r="3.5" fill="url(#gDot)" filter="url(#gBlur)">
          <animateMotion dur="2.7s" repeatCount="indefinite" begin="1.1s" path="M500 320 C 420 380, 350 485, 210 485" />
        </circle>
        <circle r="4" fill="url(#gDot)" filter="url(#gBlur)">
          <animateMotion dur="2.5s" repeatCount="indefinite" begin="1.5s" path="M500 320 C 500 390, 500 460, 500 540" />
        </circle>
        <circle r="3.5" fill="url(#gDot)" filter="url(#gBlur)">
          <animateMotion dur="2.6s" repeatCount="indefinite" begin="1.9s" path="M500 320 C 580 380, 650 485, 790 485" />
        </circle>
      </svg>

      <div class="hub">
        <div class="hub-aura"></div>
        <div class="hub-ring a"></div>
        <div class="hub-ring b"></div>
        <div class="hub-core">
          <img src="/logo.png" alt="Creavix IT Solution" width="72" height="72" loading="eager" decoding="async" />
        </div>
        <div class="hub-reflect" aria-hidden="true"></div>
      </div>

      {steps.map((s, i) => (
        <article class={`card c${s.id}`} style={`--i:${i}`} data-step={s.id}>
          <span class="corner tl"></span>
          <span class="corner tr"></span>

          <p class="lbl">Step - {s.id}</p>
          <h3 class="ct">{s.title}</h3>

          {s.showChart && (
            <div class="chart" aria-hidden="true">
              <i style="--h:38%"></i><i style="--h:62%"></i><i style="--h:48%"></i>
              <i style="--h:78%"></i><i style="--h:55%"></i><i style="--h:92%"></i>
              <i style="--h:70%"></i>
            </div>
          )}

          {s.chips.length > 0 && (
            <div class="chips" data-chips>
              {s.chips.map((label, ci) => (
                <span class={`chip ${ci === 0 ? 'on' : ''}`} data-chip>
                  <i class="dot"></i>{label}
                </span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>

    <nav class="dock" aria-label="Quick navigation">
      <a href="/">Home</a>
      <a href="#services">Services</a>
      <a class="go" href="/contact">Start Project</a>
      <a href="/portfolio">Projects</a>
      <a href="#faq">More</a>
    </nav>
  </div>
</section>

<style>
  .pf {
    position: relative;
    padding: 4.5rem 1rem 5rem;
    background: #050814;
    color: #E2E8F0;
    overflow: hidden;
    isolation: isolate;
  }
  .pf-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .pf-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(59,130,246,.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(59,130,246,.045) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 10%, transparent 75%);
  }
  .pf-glow {
    position: absolute;
    width: 520px; height: 520px;
    left: 50%; top: 54%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(37,99,235,.32), transparent 70%);
    filter: blur(12px);
  }

  .pf-wrap {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
  }

  .pf-head {
    text-align: center;
    max-width: 740px;
    margin: 0 auto 2.4rem;
    position: relative;
    z-index: 3;
  }

  /* Pure white title — forced visibility */
  .pf-title {
    margin: 0 0 0.95rem !important;
    font-family: var(--font-h), system-ui, -apple-system, sans-serif !important;
    font-size: clamp(1.7rem, 4.4vw, 2.75rem) !important;
    font-weight: 800 !important;
    line-height: 1.1 !important;
    letter-spacing: -0.035em !important;
    color: #FFFFFF !important;
    -webkit-text-fill-color: #FFFFFF !important;
    text-shadow: 0 2px 24px rgba(0,0,0,.45), 0 0 40px rgba(255,255,255,.08);
  }
  .pf-sub {
    margin: 0 auto !important;
    max-width: 560px;
    color: #A8B4C8 !important;
    -webkit-text-fill-color: #A8B4C8 !important;
    font-size: clamp(0.9rem, 1.85vw, 1.05rem) !important;
    line-height: 1.65 !important;
  }

  .pf-stage {
    position: relative;
    height: 640px;
    margin: 0 auto 1.85rem;
  }

  .pf-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .base {
    fill: none;
    stroke: rgba(34, 211, 238, 0.2);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .bolt {
    fill: none;
    stroke: url(#gLine);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 18 82;
    filter: url(#gBlur);
    animation: boltRun 2.8s linear infinite;
    animation-delay: var(--d, 0s);
  }
  @keyframes boltRun {
    0% { stroke-dashoffset: 0; opacity: .25; }
    18% { opacity: 1; }
    100% { stroke-dashoffset: -100; opacity: .15; }
  }

  .hub {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 156px;
    height: 156px;
    z-index: 8;
  }
  .hub-aura {
    position: absolute;
    inset: -36px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59,130,246,.6), transparent 68%);
    animation: auraPulse 2.5s ease-in-out infinite;
  }
  .hub-ring { position: absolute; border-radius: 50%; }
  .hub-ring.a {
    inset: 0;
    border: 1.5px dashed rgba(34, 211, 238, 0.45);
    animation: spin 22s linear infinite;
  }
  .hub-ring.b {
    inset: 16px;
    border: 1px solid rgba(96, 165, 250, 0.55);
    animation: spinR 16s linear infinite;
  }
  .hub-core {
    position: absolute;
    inset: 30px;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, #1E40AF, #0A1628 74%);
    border: 1.5px solid rgba(96, 165, 250, 0.7);
    box-shadow:
      0 0 0 8px rgba(37, 99, 235, 0.14),
      0 0 48px rgba(37, 99, 235, 0.65),
      0 0 80px rgba(34, 211, 238, 0.25),
      inset 0 0 22px rgba(59, 130, 246, 0.35);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .hub-core img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    filter: drop-shadow(0 0 12px rgba(96, 165, 250, 0.85));
  }
  .hub-reflect {
    position: absolute;
    left: 20%; right: 20%;
    top: calc(100% + 4px);
    height: 42px;
    background: radial-gradient(ellipse at top, rgba(59,130,246,.35), transparent 72%);
    filter: blur(5px);
    opacity: 0.75;
    pointer-events: none;
  }
  @keyframes auraPulse {
    0%, 100% { opacity: .5; transform: scale(1); }
    50% { opacity: .95; transform: scale(1.08); }
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes spinR { to { transform: rotate(-360deg); } }

  .card {
    position: absolute;
    width: min(270px, 27.5%);
    padding: 1.1rem 1.15rem 1rem;
    border-radius: 18px;
    background: linear-gradient(165deg, rgba(30,41,59,.92), rgba(15,23,42,.88));
    border: 1px solid rgba(148, 163, 184, 0.12);
    box-shadow: 0 16px 40px rgba(0,0,0,.45);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    opacity: 0;
    transform: translateY(24px) scale(.97);
    animation: cardIn .75s cubic-bezier(.16,1,.3,1) forwards;
    animation-delay: calc(.1s * var(--i) + .2s);
    transition: border-color .25s, box-shadow .25s, transform .25s;
    z-index: 5;
  }
  .card:hover {
    border-color: rgba(59, 130, 246, .45);
    box-shadow: 0 20px 48px rgba(37, 99, 235, .22);
    z-index: 9;
  }
  @keyframes cardIn {
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .corner {
    position: absolute;
    width: 16px; height: 16px;
    pointer-events: none;
  }
  .corner.tl {
    top: 0; left: 0;
    border-top: 2px solid #22D3EE;
    border-left: 2px solid #22D3EE;
    border-radius: 18px 0 0 0;
  }
  .corner.tr {
    top: 0; right: 0;
    border-top: 2px solid #22D3EE;
    border-right: 2px solid #22D3EE;
    border-radius: 0 18px 0 0;
  }

  .c01 { left: 0; top: 3%; }
  .c02 { left: 50%; top: 0; transform: translateX(-50%); animation-name: cardInX; }
  .c03 { right: 0; top: 3%; }
  .c04 { left: 0; bottom: 1%; }
  .c05 { left: 50%; bottom: 0; transform: translateX(-50%); animation-name: cardInX; }
  .c06 { right: 0; bottom: 1%; }

  @keyframes cardInX {
    from { opacity: 0; transform: translateX(-50%) translateY(24px) scale(.97); }
    to { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
  }
  .c02:hover, .c05:hover { transform: translateX(-50%) translateY(-4px); }
  .c01:hover, .c03:hover, .c04:hover, .c06:hover { transform: translateY(-4px); }

  .lbl {
    margin: 0 0 .28rem;
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #64748B;
  }
  .ct {
    margin: 0 0 .7rem;
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: .93rem;
    font-weight: 700;
    line-height: 1.35;
    color: #F1F5F9;
  }

  .chart {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 34px;
    margin: 0 0 .55rem;
    opacity: .4;
  }
  .chart i {
    display: block;
    flex: 1;
    height: var(--h);
    border-radius: 2px 2px 0 0;
    background: linear-gradient(180deg, #60A5FA, #1E3A8A);
  }

  /* Soft light-blue chips — exact video match */
  .chips {
    position: relative;
    min-height: 36px;
    overflow: hidden;
  }
  .chip {
    position: absolute;
    left: 0; top: 0;
    display: inline-flex;
    align-items: center;
    gap: .42rem;
    padding: .42rem .85rem;
    border-radius: 999px;
    /* soft light blue like reference video */
    background: linear-gradient(135deg, rgba(191, 219, 254, 0.92), rgba(147, 197, 253, 0.88));
    border: 1px solid rgba(147, 197, 253, 0.65);
    box-shadow: 0 2px 12px rgba(59, 130, 246, 0.18);
    color: #1E3A8A;
    font-size: .72rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-22px);
    transition:
      opacity 0.55s ease,
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  .chip.on {
    opacity: 1;
    transform: translateX(0);
  }
  .chip:not(.on) {
    transform: translateX(18px);
    opacity: 0;
  }
  .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #3B82F6;
    box-shadow: 0 0 8px rgba(59, 130, 246, 0.7);
    flex-shrink: 0;
  }

  .dock {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: .25rem;
    margin: 0 auto;
    padding: .4rem;
    width: fit-content;
    max-width: 100%;
    background: rgba(255,255,255,.97);
    border-radius: 999px;
    box-shadow: 0 16px 44px rgba(0,0,0,.42);
  }
  .dock a {
    padding: .55rem .95rem;
    border-radius: 999px;
    font-size: .8rem;
    font-weight: 600;
    color: #334155;
    text-decoration: none;
    transition: background .2s, color .2s;
  }
  .dock a:hover { background: #F1F5F9; color: #0F172A; }
  .go {
    background: #2563EB !important;
    color: #fff !important;
  }
  .go:hover { background: #1D4ED8 !important; }

  @media (max-width: 900px) {
    .pf-stage {
      height: auto;
      display: grid;
      grid-template-columns: 1fr;
      gap: .85rem;
      padding-top: .4rem;
    }
    .pf-svg { display: none; }
    .hub {
      position: relative;
      left: auto; top: auto;
      transform: none;
      margin: 0 auto 1.35rem;
      width: 120px; height: 120px;
    }
    .hub-core { inset: 24px; }
    .hub-core img { width: 52px; height: 52px; }
    .hub-reflect { display: none; }

    .card {
      position: relative !important;
      left: auto !important;
      right: auto !important;
      top: auto !important;
      bottom: auto !important;
      width: 100% !important;
      transform: none !important;
      animation: cardInM .55s cubic-bezier(.16,1,.3,1) forwards;
      animation-delay: calc(.07s * var(--i));
    }
    .card:hover { transform: translateY(-2px) !important; }
    @keyframes cardInM {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .chip {
      position: static;
      opacity: 1;
      transform: none;
      margin: 0 .35rem .28rem 0;
    }
    .chips { display: flex; flex-wrap: wrap; min-height: 0; overflow: visible; }
  }

  @media (min-width: 641px) and (max-width: 900px) {
    .pf-stage { grid-template-columns: 1fr 1fr; }
    .hub { grid-column: 1 / -1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bolt, .hub-ring, .hub-aura, .card, .chip {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script is:inline>
(function () {
  var root = document.querySelector('[data-pf]');
  if (!root) return;
  root.querySelectorAll('[data-chips]').forEach(function (rail) {
    var chips = rail.querySelectorAll('[data-chip]');
    if (chips.length < 2) return;
    var i = 0;
    setInterval(function () {
      chips[i].classList.remove('on');
      i = (i + 1) % chips.length;
      chips[i].classList.add('on');
    }, 2200 + Math.floor(Math.random() * 400));
  });
})();
</script>
