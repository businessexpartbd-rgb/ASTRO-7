---
const items = [
  'AI Video Marketing',
  'Video Editing',
  'Web Development',
  'App Build',
  'Authentication',
  'Meta Boosting',
  'Campaigns',
  'Human-like Content',
];
---
<section class="brand-strip" aria-label="Capabilities">
  <div class="brand-strip-head">
    <h2 class="brand-strip-title">4,300+ PROJECTS THAT CHOSE US TO GROW</h2>
  </div>
  <div class="brand-strip-track-wrap">
    <div class="brand-strip-track">
      {[...items, ...items].map((t) => (
        <span class="brand-chip">{t}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .brand-strip {
    padding: 2.75rem 0 3.25rem;
    background: #fff;
    border-top: 1px solid rgba(15, 23, 42, 0.05);
    border-bottom: 1px solid rgba(15, 23, 42, 0.05);
  }
  .brand-strip-head {
    text-align: center;
    margin-bottom: 1.6rem;
    padding: 0 1.25rem;
  }
  .brand-strip-title {
    margin: 0;
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: clamp(0.9rem, 2.2vw, 1.15rem);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0B0F19;
  }
  .brand-strip-track-wrap {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .brand-strip-track {
    display: flex;
    gap: 0.75rem;
    width: max-content;
    animation: strip-move 32s linear infinite;
  }
  .brand-chip {
    flex-shrink: 0;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: #F8FAFC;
    font-size: 0.8rem;
    font-weight: 600;
    color: #334155;
    white-space: nowrap;
  }
  @keyframes strip-move {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-strip-track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; padding: 0 1rem; }
  }
</style>
