---
const logos = Array.from({ length: 40 }, (_, index) => ({
  src: `/media/client-logos/client-${String(index + 1).padStart(2, '0')}.webp`,
  alt: `Selected Creavix client brand ${index + 1}`,
}));

const firstRow = logos.filter((_, index) => index % 2 === 0);
const secondRow = logos.filter((_, index) => index % 2 === 1);
---
<section class="client-proof" aria-labelledby="client-proof-title">
  <div class="client-proof-head">
    <p class="client-proof-kicker">Selected client work</p>
    <h2 id="client-proof-title">Trusted by Brands We’ve Helped Grow</h2>
    <p>
      Selected clients and businesses we’ve supported through video production,
      branding, websites and digital growth.
    </p>
  </div>

  <div class="logo-marquee" aria-label="Selected Creavix client brands" data-logo-marquee>
    <div class="logo-row logo-row--forward" data-logo-row>
      {[...firstRow, ...firstRow].map((logo, index) => (
        <span class="logo-slot" aria-hidden={index >= firstRow.length ? 'true' : undefined} data-logo-slot>
          <img src={logo.src} alt={index >= firstRow.length ? '' : logo.alt} width="240" height="100" loading="lazy" decoding="async" />
        </span>
      ))}
    </div>
  </div>

  <div class="logo-marquee" aria-hidden="true" data-logo-marquee>
    <div class="logo-row logo-row--reverse" data-logo-row>
      {[...secondRow, ...secondRow].map((logo) => (
        <span class="logo-slot" data-logo-slot>
          <img src={logo.src} alt="" width="240" height="100" loading="lazy" decoding="async" />
        </span>
      ))}
    </div>
  </div>
</section>

<script>
  const holdLogoRow = (slot: HTMLElement) => {
    const row = slot.closest<HTMLElement>('[data-logo-row]');
    if (!row) return;

    const previousTimer = Number(row.dataset.resumeTimer || 0);
    if (previousTimer) window.clearTimeout(previousTimer);

    row.querySelectorAll('[data-logo-slot].is-active').forEach((item) => item.classList.remove('is-active'));
    slot.classList.add('is-active');
    row.classList.add('is-held');

    const timer = window.setTimeout(() => {
      row.classList.remove('is-held');
      slot.classList.remove('is-active');
      delete row.dataset.resumeTimer;
    }, 2000);

    row.dataset.resumeTimer = String(timer);
  };

  document.querySelectorAll<HTMLElement>('[data-logo-slot]').forEach((slot) => {
    slot.addEventListener('pointerdown', () => holdLogoRow(slot), { passive: true });
  });
</script>

<style>
  .client-proof {
    padding: clamp(3.25rem, 6vw, 5.25rem) 0;
    overflow: hidden;
    background: #fff;
    border-block: 1px solid rgba(15, 23, 42, 0.055);
  }
  .client-proof-head {
    width: min(760px, calc(100% - 2rem));
    margin: 0 auto clamp(1.65rem, 4vw, 2.5rem);
    text-align: center;
  }
  .client-proof-kicker {
    margin: 0 0 .55rem;
    color: #2563eb;
    font: 800 .72rem/1.2 var(--font-h), system-ui, sans-serif;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  .client-proof h2 {
    margin: 0;
    color: #0f172a;
    font: 800 clamp(1.7rem, 4vw, 3rem)/1.06 var(--font-h), system-ui, sans-serif;
    letter-spacing: -.035em;
    text-wrap: balance;
  }
  .client-proof-head > p:last-child {
    max-width: 650px;
    margin: .85rem auto 0;
    color: #64748b;
    font-size: clamp(.9rem, 1.8vw, 1.02rem);
    line-height: 1.65;
    text-wrap: balance;
  }
  .logo-marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  .logo-marquee::before,
  .logo-marquee::after {
    content: '';
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    width: 33.333%;
    pointer-events: none;
    -webkit-backdrop-filter: grayscale(1) saturate(.15);
    backdrop-filter: grayscale(1) saturate(.15);
  }
  .logo-marquee::before {
    left: 0;
    background: linear-gradient(90deg, rgba(255,255,255,.72), rgba(255,255,255,0));
  }
  .logo-marquee::after {
    right: 0;
    background: linear-gradient(270deg, rgba(255,255,255,.72), rgba(255,255,255,0));
  }
  .logo-marquee + .logo-marquee { margin-top: clamp(.55rem, 1.7vw, 1rem); }
  .logo-row {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
  }
  .logo-row--forward { animation: client-logos-forward 54s linear infinite; }
  .logo-row--reverse { animation: client-logos-reverse 60s linear infinite; }
  .logo-row.is-held { animation-play-state: paused; }
  .logo-slot {
    display: grid;
    width: clamp(142px, 15vw, 190px);
    height: clamp(64px, 7vw, 84px);
    flex: 0 0 auto;
    place-items: center;
    margin-inline: clamp(.15rem, .42vw, .42rem);
    transform: scale(1);
    transition: transform .25s cubic-bezier(.16,1,.3,1), filter .25s ease;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .logo-slot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 5px 9px rgba(15, 23, 42, .08));
  }
  .logo-slot.is-active {
    z-index: 5;
    transform: scale(1.09);
    filter: drop-shadow(0 12px 18px rgba(37, 99, 235, .2));
  }
  @keyframes client-logos-forward {
    to { transform: translateX(-50%); }
  }
  @keyframes client-logos-reverse {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  @media (max-width: 640px) {
    .client-proof { padding-block: 3rem; }
    .client-proof-head { margin-bottom: 1.5rem; }
    .logo-slot { width: 118px; height: 56px; margin-inline: .12rem; }
    .logo-row--forward { animation-duration: 46s; }
    .logo-row--reverse { animation-duration: 52s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
      scrollbar-width: none;
    }
    .logo-marquee::-webkit-scrollbar { display: none; }
    .logo-row { animation: none; }
  }
</style>
