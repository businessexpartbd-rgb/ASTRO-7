---
interface Props {
  name?: string;
  size?: number;
}
const { name = 'web', size = 40 } = Astro.props;
const n = String(name || 'web');
---
<span class={'live-icon li-' + n} style={'width:' + size + 'px;height:' + size + 'px'} aria-hidden="true">
  {n === 'web' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><circle class="li-ring" cx="24" cy="24" r="18" stroke="currentColor" stroke-width="2"></circle><ellipse class="li-orbit" cx="24" cy="24" rx="18" ry="8" stroke="currentColor" stroke-width="1.5" opacity="0.7"></ellipse><ellipse class="li-orbit li-orbit-2" cx="24" cy="24" rx="8" ry="18" stroke="currentColor" stroke-width="1.5" opacity="0.7"></ellipse><circle class="li-dot" cx="24" cy="24" r="3" fill="currentColor"></circle><circle class="li-pulse" cx="24" cy="24" r="6" stroke="currentColor" stroke-width="1.2" fill="none"></circle></svg>
  )}
  {n === 'app' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><rect class="li-phone" x="14" y="6" width="20" height="36" rx="4" stroke="currentColor" stroke-width="2"></rect><rect class="li-screen" x="17" y="11" width="14" height="24" rx="1.5" fill="currentColor" opacity="0.12"></rect><circle class="li-dot" cx="24" cy="38" r="1.8" fill="currentColor"></circle><path class="li-wave" d="M20 18h8M20 23h8M20 28h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
  )}
  {n === 'auth' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><rect class="li-lock" x="12" y="20" width="24" height="18" rx="3" stroke="currentColor" stroke-width="2"></rect><path class="li-shackle" d="M17 20v-5a7 7 0 0 1 14 0v5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><circle class="li-dot" cx="24" cy="29" r="2.5" fill="currentColor"></circle><path class="li-key" d="M24 31.5v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
  )}
  {n === 'ai' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><circle class="li-core" cx="24" cy="24" r="8" stroke="currentColor" stroke-width="2"></circle><circle class="li-dot" cx="24" cy="24" r="3" fill="currentColor"></circle><g class="li-spokes"><path d="M24 6v6M24 36v6M6 24h6M36 24h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><path d="M11 11l4.2 4.2M32.8 32.8L37 37M37 11l-4.2 4.2M15.2 32.8L11 37" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.75"></path></g><circle class="li-pulse" cx="24" cy="24" r="12" stroke="currentColor" stroke-width="1" fill="none"></circle></svg>
  )}
  {n === 'video' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><rect class="li-cam" x="6" y="14" width="26" height="20" rx="3" stroke="currentColor" stroke-width="2"></rect><path class="li-lens" d="M32 20l10-5v18l-10-5V20z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path><circle class="li-rec" cx="14" cy="20" r="2.2" fill="currentColor"></circle><path class="li-wave" d="M12 30h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.6"></path></svg>
  )}
  {n === 'human' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><circle class="li-head" cx="24" cy="16" r="7" stroke="currentColor" stroke-width="2"></circle><path class="li-body" d="M12 40c2-8 8-12 12-12s10 4 12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><circle class="li-pulse" cx="24" cy="16" r="10" stroke="currentColor" stroke-width="1" fill="none" opacity="0.5"></circle></svg>
  )}
  {n === 'seo' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><circle cx="21" cy="21" r="12" stroke="currentColor" stroke-width="2.5"/><path d="M30 30l9 9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path class="li-accent" d="M14 23l5-5 4 3 6-7" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/><circle class="li-dot" cx="29" cy="14" r="2.5" fill="currentColor"/></svg>
  )}
  {n === 'automation' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><path d="M14 14h15a7 7 0 017 7v3" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path class="li-accent" d="M33 20l3 4 4-3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M34 34H19a7 7 0 01-7-7v-3" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path class="li-accent" d="M15 28l-3-4-4 3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><circle class="li-dot" cx="24" cy="24" r="5" fill="currentColor" opacity=".18"/></svg>
  )}
  {n === 'marketing' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><path d="M9 29V18l22-8v27L9 29z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path class="li-accent" d="M31 18c5 1 8 4 8 7s-3 6-8 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M14 31l3 9h7l-4-7" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/></svg>
  )}
  {n === 'boosting' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><path d="M9 36l9-10 7 5 13-18" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/><path class="li-accent" d="M30 13h8v8" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><rect x="8" y="10" width="10" height="9" rx="3" fill="currentColor" opacity=".16"/></svg>
  )}
  {n === 'whatsapp' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><path d="M39 23a15 15 0 01-21 13L9 39l3-9A15 15 0 1139 23z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path class="li-accent" d="M19 16c1 8 5 12 13 14" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><circle cx="19" cy="16" r="2" fill="currentColor"/><circle cx="32" cy="30" r="2" fill="currentColor"/></svg>
  )}
  {n === 'phone' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><path d="M14 9l7 8-4 5c3 6 6 9 12 12l5-4 7 7-4 4C22 41 7 26 10 13l4-4z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path class="li-accent" d="M29 10c5 1 8 4 9 9M29 16c2 .5 3.5 2 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  )}
  {n === 'email' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><rect x="7" y="11" width="34" height="26" rx="5" stroke="currentColor" stroke-width="2.4"/><path d="M9 15l15 12 15-12" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path class="li-accent" d="M9 34l11-10M39 34L28 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  )}
  {n === 'production' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><rect x="7" y="13" width="34" height="25" rx="5" stroke="currentColor" stroke-width="2.4"/><path class="li-accent" d="M20 20l11 6-11 6V20z" fill="currentColor"/><path d="M13 9h7M28 9h7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
  )}
  {n === 'global' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><circle cx="24" cy="24" r="17" stroke="currentColor" stroke-width="2.4"/><path d="M7 24h34M24 7c6 6 8 11 8 17s-2 11-8 17c-6-6-8-11-8-17s2-11 8-17z" stroke="currentColor" stroke-width="2"/><circle class="li-accent" cx="34" cy="15" r="4" fill="currentColor"/></svg>
  )}
  {n === 'strategy' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><circle cx="22" cy="25" r="15" stroke="currentColor" stroke-width="2.4"/><circle cx="22" cy="25" r="8" stroke="currentColor" stroke-width="2" opacity=".7"/><circle cx="22" cy="25" r="3" fill="currentColor"/><path class="li-accent" d="M26 21L40 8M33 8h7v7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  )}
  {n === 'search' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><circle cx="21" cy="21" r="12" stroke="currentColor" stroke-width="2.8"/><path class="li-accent" d="M30 30l10 10" stroke="currentColor" stroke-width="4" stroke-linecap="round"/><path d="M16 21h10M21 16v10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
  )}
  {n === 'facebook' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><rect class="li-page" x="10" y="8" width="28" height="32" rx="4" stroke="currentColor" stroke-width="2"></rect><circle class="li-dot" cx="24" cy="18" r="5" stroke="currentColor" stroke-width="1.8"></circle><path class="li-wave" d="M16 30h16M18 35h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
  )}
  {n === 'boost' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><path class="li-chart" d="M8 36V12M8 36h32" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><path class="li-line" d="M12 28l8-10 6 6 10-14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path><circle class="li-dot" cx="36" cy="10" r="3" fill="currentColor"></circle><path class="li-arrow" d="M32 10h6v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  )}
  {n === 'campaign' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><circle class="li-target" cx="24" cy="24" r="16" stroke="currentColor" stroke-width="2"></circle><circle class="li-target li-t2" cx="24" cy="24" r="10" stroke="currentColor" stroke-width="1.6" opacity="0.75"></circle><circle class="li-dot" cx="24" cy="24" r="3.5" fill="currentColor"></circle><path class="li-arrow" d="M34 14l4-4M34 14h5M34 14v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
  )}
  {n === 'rocket' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><path class="li-rocket" d="M24 6c6 6 8 14 8 20l-5 2-3-3-3 3-5-2c0-6 2-14 8-20z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path><circle class="li-dot" cx="24" cy="18" r="2.5" fill="currentColor"></circle><path class="li-flame" d="M20 36c1.5 4 4 6 4 6s2.5-2 4-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
  )}
  {n === 'spark' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><path class="li-star" d="M24 6l3.5 12.5H40l-10 7.5 3.8 12L24 30.5 14.2 38l3.8-12-10-7.5h12.5L24 6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
  )}
  {(n === 'check' || !['web','app','auth','ai','video','human','seo','automation','marketing','boosting','whatsapp','phone','email','production','global','strategy','search','facebook','boost','campaign','rocket','spark'].includes(n)) && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none"><circle class="li-ring" cx="24" cy="24" r="16" stroke="currentColor" stroke-width="2"></circle><path class="li-check" d="M15 24l6 6 12-13" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  )}
</span>

<style>
  .live-icon{display:inline-grid;place-items:center;flex:0 0 auto;color:#2563eb;--accent:#8b5cf6}.live-icon svg{display:block;overflow:visible}.live-icon .li-accent{color:var(--accent)}
  .li-video{color:#7c3aed;--accent:#ec4899}.li-ai{color:#2563eb;--accent:#8b5cf6}.li-human{color:#f43f5e;--accent:#f59e0b}.li-web{color:#0891b2;--accent:#2563eb}.li-app{color:#3b82f6;--accent:#06b6d4}.li-auth{color:#059669;--accent:#14b8a6}.li-automation{color:#0f766e;--accent:#22c55e}.li-marketing{color:#ea580c;--accent:#f59e0b}.li-seo{color:#4f46e5;--accent:#06b6d4}.li-facebook{color:#1877f2;--accent:#60a5fa}.li-boosting{color:#ca8a04;--accent:#f97316}.li-campaign{color:#db2777;--accent:#8b5cf6}.li-whatsapp{color:#16a34a;--accent:#22c55e}.li-phone{color:#0284c7;--accent:#06b6d4}.li-email{color:#7c3aed;--accent:#ec4899}.li-production{color:#7c3aed;--accent:#f43f5e}.li-global{color:#0284c7;--accent:#22c55e}.li-strategy{color:#ea580c;--accent:#facc15}.li-search{color:#2563eb;--accent:#06b6d4}.li-check{color:#16a34a}.li-spark{color:#d97706}.li-rocket{color:#2563eb;--accent:#f43f5e}
</style>
