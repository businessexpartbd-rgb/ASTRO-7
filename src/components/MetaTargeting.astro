---
import ServiceIcons from './icons/ServiceIcons.astro';
import { Picture } from 'astro:assets';
import targetingArtwork from '../assets/meta-targeting-3d.webp';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const stages = [
  { icon: 'search', title: 'Find the right audience', label: 'Audience & intent', detail: 'Business goals · location · relevance' },
  { icon: 'production', title: 'Create a reason to connect', label: 'Creative & message', detail: 'Video hooks · clear offers · landing pages' },
  { icon: 'campaign', title: 'Measure. Learn. Refine.', label: 'Testing & improvement', detail: 'Results · cost per outcome · next steps' },
];
---
<figure class:list={['mt-studio', { 'mt-compact': compact }]} data-meta-studio>
  <div class="mt-toolbar"><span><i></i>CREAVIX / CAMPAIGN STUDIO</span><button type="button" data-meta-toggle aria-pressed="false" hidden>Pause animation</button></div>
  <div class="mt-diagram">
    <div class="mt-platform">
      <div class="mt-scene" data-meta-scene>
        <div class="mt-tilt" data-meta-tilt>
          <div class="mt-art">
            <Picture src={targetingArtwork} alt="Three glossy green darts targeting a sculpted blue Meta logo" widths={[360, 640, 960]} sizes="(max-width: 680px) calc(100vw - 64px), (max-width: 850px) 580px, (max-width: 1200px) 43vw, 580px" formats={['avif', 'webp']} quality={76} loading={compact ? 'eager' : 'lazy'} decoding="async" fetchpriority={compact ? 'auto' : 'low'} draggable="false" />
          </div>
        </div>
      </div>
      <p class="mt-interaction-hint" data-meta-hint hidden>Move, touch or use arrow keys to explore</p>
      <strong>Right people.<br /><span>Relevant creative.</span></strong>
      <p>Facebook + Instagram</p>
    </div>
    <ol class="mt-stages">
      {stages.map((stage, i) => <li class="mt-stage" style={`--stage:${i}`}>
        <span class="mt-number">0{i + 1}</span>
        <span class="mt-stage-icon"><ServiceIcons name={stage.icon} size={26} /></span>
        <div><small>{stage.label}</small><strong>{stage.title}</strong><p>{stage.detail}</p></div>
        <span class="mt-signal" aria-hidden="true"></span>
      </li>)}
    </ol>
  </div>
  <figcaption><span>Illustrative campaign workflow</span><span>Strategy → Creative → Learning</span></figcaption>
</figure>
<style>
  .mt-studio{width:100%;max-width:620px;margin:0 auto;overflow:hidden;isolation:isolate;border:1px solid #dbe5ee;border-radius:28px;background:#fff;box-shadow:0 24px 64px #0a254012;color:#0a2540}
  .mt-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px 20px;background:#f8fafc;border-bottom:1px solid #e4eaf0}
  .mt-toolbar>span{display:flex;align-items:center;gap:7px;font:700 .59rem/1.5 var(--font-h);letter-spacing:.08em}
  .mt-toolbar i{width:7px;height:7px;border-radius:50%;background:#137849}
  .mt-toolbar button{flex-shrink:0;min-height:44px;padding:4px 9px;border:1px solid #d3dfeb;border-radius:9px;color:#31455c;background:#fff;font:600 .61rem/1.3 var(--font-b);cursor:pointer}
  .mt-toolbar button[hidden]{display:none}
  .mt-diagram{position:relative;padding:8px 24px 24px;background:#fff}
  .mt-platform{position:relative;z-index:1;text-align:center;margin-bottom:25px}
  .mt-scene{position:relative;perspective:1000px;touch-action:pan-y pinch-zoom;border-radius:18px;margin:0 -10px 8px;padding:12px 8px;outline-offset:2px}
  .mt-scene[tabindex]{cursor:grab}
  .mt-scene:active{cursor:grabbing}
  .mt-scene:focus-visible,.mt-toolbar button:focus-visible{outline:3px solid #175cd3;outline-offset:3px}
  .mt-tilt{transform:rotateX(var(--meta-rx,0deg)) rotateY(var(--meta-ry,0deg));transition:transform 480ms cubic-bezier(.2,.7,.3,1);transform-style:preserve-3d}
  .mt-art{transform-origin:50% 55%;backface-visibility:hidden}
  .mt-art img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain;user-select:none;-webkit-user-drag:none;pointer-events:none}
  .mt-platform>.mt-interaction-hint{min-height:1.5em;margin:0 0 12px;color:#536478;font:500 .62rem/1.5 var(--font-b)}
  .mt-platform>.mt-interaction-hint[hidden]{display:block;visibility:hidden}
  .mt-platform>strong{display:block;font:800 clamp(1.3rem,2.4vw,1.7rem)/1.22 var(--font-h);letter-spacing:-.04em}
  .mt-platform>strong span{color:#137849}
  .mt-platform>p{margin-top:8px;color:#536478;font:600 .72rem/1.5 var(--font-b)}
  .mt-stages{position:relative;z-index:1;display:grid;gap:10px;list-style:none;margin:0;padding:0}
  .mt-stages::before{content:'';position:absolute;left:22px;top:15px;bottom:15px;width:2px;background:#cfdae3}
  .mt-stage{position:relative;display:grid;grid-template-columns:26px 34px 1fr 8px;align-items:center;gap:10px;padding:13px 14px;border:1px solid #dde6ef;border-radius:15px;background:#fff;box-shadow:0 6px 14px #0a254004}
  .mt-number{display:grid;place-items:center;width:25px;height:25px;background:#fff1e8;border-radius:8px;color:#b34408;font:800 .65rem/1 var(--font-h)}
  .mt-stage:nth-child(2) .mt-number{background:#edf4ff;color:#175cd3}.mt-stage:nth-child(3) .mt-number{background:#edf8f0;color:#137849}
  .mt-stage-icon{display:grid;place-items:center}.mt-stage small{display:block;color:#64748b;font:600 .57rem/1.5 var(--font-b);letter-spacing:.045em;text-transform:uppercase}
  .mt-stage strong{display:block;color:#0a2540;font:800 clamp(.78rem,1.3vw,.94rem)/1.45 var(--font-h)}
  .mt-stage p{margin:3px 0 0;color:#536478;font:400 .66rem/1.55 var(--font-b)}
  .mt-signal{width:6px;height:6px;background:#137849;border-radius:50%}
  figcaption{display:flex;flex-wrap:wrap;justify-content:space-between;gap:5px;padding:13px 20px;border-top:1px solid #e4eaf0;color:#627185;font:500 .59rem/1.5 var(--font-b)}
  @media(prefers-reduced-motion:no-preference){
    .mt-art{animation:mt-float 9s ease-in-out infinite;animation-play-state:paused}
    .mt-studio.is-running .mt-art{animation-play-state:running;will-change:transform}
    .mt-studio.is-running .mt-tilt{will-change:transform}
    @keyframes mt-float{0%,100%{transform:translate3d(0,2px,0) rotateX(1deg) rotateY(-3deg) rotateZ(-.7deg)}50%{transform:translate3d(0,-5px,8px) rotateX(-1deg) rotateY(3deg) rotateZ(.7deg)}}
  }
  @media(prefers-reduced-motion:reduce){.mt-tilt{transform:none;transition:none}.mt-art{animation:none;transform:none}}
  @media(max-width:480px){.mt-studio{border-radius:22px}.mt-toolbar{padding:9px 12px}.mt-toolbar>span{font-size:.5rem;letter-spacing:.035em}.mt-toolbar button{font-size:.55rem}.mt-diagram{padding:8px 12px 16px}.mt-scene{margin-inline:0}.mt-stage{gap:7px;grid-template-columns:23px 25px 1fr 6px;padding:11px 9px}.mt-stage p{font-size:.62rem}.mt-platform>strong{font-size:1.4rem}figcaption{padding:11px 13px;font-size:.55rem}}
  .mt-compact .mt-diagram{padding-top:6px}.mt-compact .mt-platform{margin-bottom:18px}
</style>
<script>
  import { enhanceMetaStudio } from '../scripts/meta-studio';
  let dispose: (() => void)[] = [];
  const initialize = () => {
    dispose.forEach(cleanup => cleanup());
    dispose = Array.from(document.querySelectorAll<HTMLElement>('[data-meta-studio]'), enhanceMetaStudio);
  };
  initialize();
  document.addEventListener('astro:page-load', initialize);
  document.addEventListener('astro:before-swap', () => { dispose.forEach(cleanup => cleanup()); dispose = []; });
</script>
