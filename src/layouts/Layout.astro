---
import CookieBanner from '../components/CookieBanner.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = SITE.seoTitle,
  description = SITE.seoDescription,
} = Astro.props;

const canonical = Astro.url.href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.brand,
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  description: SITE.seoDescription,
  email: SITE.email1,
  telephone: SITE.hotline,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Hemayetpur',
    addressLocality: 'Savar',
    addressRegion: 'Dhaka',
    postalCode: '1340',
    addressCountry: 'BD',
  },
  sameAs: [
    'https://www.facebook.com/CreavixITSolution',
    'https://www.instagram.com/creavixitsolution',
    'https://www.youtube.com/@CreavixiTsolution',
    'https://www.tiktok.com/@creavixitsolution',
    'https://www.linkedin.com/in/creavix-it-solution',
    'https://x.com/creavixit',
  ],
  foundingDate: String(SITE.servingSince),
  founder: { '@type': 'Person', name: SITE.founder.name },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      id="viewport-meta"
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="theme-color" content="#F8FAFC" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE.seoKeywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={SITE.brand} />
    <meta name="geo.region" content="BD-13" />
    <meta name="geo.placename" content="Savar, Dhaka" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/logo.png`} />
    <meta property="og:locale" content="en_BD" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    </noscript>
    <link rel="icon" type="image/png" href="/logo.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script src="/js/perf.js" defer></script>
    <style is:global>
      :root {
        --primary: #4F46E5; --primary-light: #818CF8; --violet: #7C3AED; --accent: #06B6D4;
        --rose: #F43F5E; --amber: #F59E0B; --emerald: #10B981;
        --text: #0F172A; --text-2: #475569; --text-3: #64748B; --bg: #F8FAFC; --white: #FFFFFF;
        --radius: 24px; --font-h: "Outfit", system-ui, sans-serif; --font-b: "Inter", system-ui, sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
        touch-action: manipulation;
      }
      body {
        font-family: var(--font-b);
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        line-height: 1.6;
        overflow-x: hidden;
        touch-action: manipulation;
        overscroll-behavior-y: none;
      }
      a, button, input, textarea, select { touch-action: manipulation; }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; height: auto; display: block; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }

      @media (max-width: 767px) {
        .orb { filter: blur(40px) !important; opacity: 0.32 !important; }
        .navbar.scrolled {
          backdrop-filter: blur(8px);
          -webkit-backdrop-filter: blur(8px);
        }
        .glass-card {
          backdrop-filter: blur(8px);
          -webkit-backdrop-filter: blur(8px);
        }
        .nav-panel {
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
        }
      }

      .text-gradient { background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 50%, #06B6D4 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
      .text-primary { color: var(--primary); }
      .text-violet { color: var(--violet); }

      .navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: .85rem 0; transition: background .3s, box-shadow .3s; }
      .navbar.scrolled { background: rgba(255,255,255,.95); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: 0 1px 0 rgba(15,23,42,.06); }
      .nav-inner { max-width: 1140px; margin: 0 auto; padding: 0 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: .75rem; position: relative; }
      .logo { font-family: var(--font-h); font-weight: 700; font-size: 1.05rem; color: var(--text); display: inline-flex; align-items: center; gap: .5rem; z-index: 102; }
      .logo-text span { background: linear-gradient(135deg, #4F46E5, #7C3AED); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
      .logo-img { width: 36px; height: 36px; object-fit: contain; border-radius: 8px; flex-shrink: 0; }

      .nav-toggle {
        display: flex; align-items: center; justify-content: center;
        width: 44px; height: 44px; border: none; background: transparent; cursor: pointer; z-index: 102; border-radius: 12px;
        transition: background .25s ease;
      }
      .nav-toggle:hover { background: rgba(79,70,229,.08); }
      .hamburger, .hamburger::before, .hamburger::after {
        display: block; width: 22px; height: 2.5px; background: var(--text); border-radius: 4px;
        transition: transform .35s cubic-bezier(.68,-.4,.32,1.4), opacity .25s ease, background .25s ease, top .35s cubic-bezier(.68,-.4,.32,1.4);
      }
      .hamburger { position: relative; }
      .hamburger::before, .hamburger::after { content: ''; position: absolute; left: 0; }
      .hamburger::before { top: -7px; }
      .hamburger::after { top: 7px; }
      .nav-toggle.open .hamburger { background: transparent; }
      .nav-toggle.open .hamburger::before { top: 0; transform: rotate(45deg); background: var(--primary); }
      .nav-toggle.open .hamburger::after { top: 0; transform: rotate(-45deg); background: var(--primary); }
      @media (min-width: 768px) { .nav-toggle { display: none; } }

      .nav-panel {
        position: fixed; inset: 0; z-index: 101;
        background: linear-gradient(165deg, rgba(248,250,252,.97) 0%, rgba(255,255,255,.98) 40%, rgba(238,242,255,.96) 100%);
        backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
        opacity: 0; visibility: hidden; pointer-events: none;
        transition: opacity .4s cubic-bezier(.22,1,.36,1), visibility .4s;
      }
      .nav-panel.open { opacity: 1; visibility: visible; pointer-events: auto; }
      .nav-panel-inner {
        display: flex; flex-direction: column; gap: 1.25rem;
        padding: 5.5rem 1.75rem 2.5rem;
        height: 100%; overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        transform: translateY(18px) scale(.98); opacity: 0;
        transition: transform .45s cubic-bezier(.22,1,.36,1), opacity .4s ease;
      }
      .nav-panel.open .nav-panel-inner { transform: translateY(0) scale(1); opacity: 1; }

      .nav-panel .nav-links > li, .nav-panel .nav-cta, .nav-panel .nav-social-mobile {
        opacity: 0; transform: translateX(-16px);
        transition: opacity .4s cubic-bezier(.22,1,.36,1), transform .45s cubic-bezier(.22,1,.36,1);
        transition-delay: 0s;
      }
      .nav-panel.open .nav-links > li, .nav-panel.open .nav-cta, .nav-panel.open .nav-social-mobile {
        opacity: 1; transform: translateX(0);
        transition-delay: calc(0.08s + var(--i, 0) * 0.06s);
      }

      @media (min-width: 768px) {
        .nav-panel {
          position: static; inset: auto; opacity: 1; visibility: visible; pointer-events: auto;
          background: transparent; backdrop-filter: none; transition: none;
          display: flex; flex: 1; justify-content: flex-end;
        }
        .nav-panel-inner {
          flex-direction: row; align-items: center; gap: 1.25rem;
          padding: 0; height: auto; overflow: visible;
          transform: none; opacity: 1; transition: none;
        }
        .nav-panel .nav-links > li, .nav-panel .nav-cta, .nav-panel .nav-social-mobile { opacity: 1; transform: none; transition: none; }
      }

      .nav-links { list-style: none; display: flex; flex-direction: column; gap: .15rem; width: 100%; }
      @media (min-width: 768px) { .nav-links { flex-direction: row; align-items: center; gap: 1.25rem; width: auto; } }

      .nav-links > li > a, .nav-drop-btn {
        color: var(--text); font-size: 1.35rem; font-weight: 600; font-family: var(--font-h);
        transition: color .2s, background .2s, transform .2s;
        background: none; border: none; cursor: pointer;
        display: block; padding: .9rem 0; width: 100%; text-align: left; border-radius: 12px;
      }
      @media (min-width: 768px) {
        .nav-links > li > a, .nav-drop-btn {
          color: var(--text-2); font-size: .9rem; font-weight: 500; font-family: var(--font-b);
          padding: .25rem 0; width: auto; border-radius: 0;
        }
      }
      .nav-links a:hover, .nav-links a.active, .nav-drop-btn:hover, .nav-drop-btn.active { color: var(--primary); }

      .nav-cta { width: 100%; margin-top: 1rem; text-align: center; box-shadow: 0 8px 28px rgba(79,70,229,.35); }
      @media (min-width: 768px) { .nav-cta { width: auto; margin-top: 0; } }

      .nav-dropdown { position: relative; width: 100%; }
      @media (min-width: 768px) { .nav-dropdown { width: auto; } }
      .nav-drop-btn { display: inline-flex; align-items: center; gap: .4rem; }
      .nav-drop-btn .chevron { transition: transform .3s cubic-bezier(.22,1,.36,1); }
      .nav-drop-btn[aria-expanded="true"] .chevron { transform: rotate(180deg); }

      .nav-dropdown-menu {
        display: grid; grid-template-rows: 0fr;
        transition: grid-template-rows .35s cubic-bezier(.22,1,.36,1);
        padding: 0; margin: 0; border: none;
      }
      .nav-dropdown-menu > * { overflow: hidden; }
      .nav-dropdown-menu.open { grid-template-rows: 1fr; padding: .35rem 0 .35rem .5rem; margin: 0 0 .4rem; border-left: 2px solid rgba(79,70,229,.25); }
      .nav-dropdown-menu a {
        display: block; padding: .7rem .85rem; border-radius: 10px;
        font-size: 1rem; color: var(--text-2); font-weight: 500;
        opacity: 0; transform: translateY(-6px);
        transition: opacity .3s ease, transform .3s ease, background .2s, color .2s;
      }
      .nav-dropdown-menu.open a { opacity: 1; transform: translateY(0); }
      .nav-dropdown-menu.open a:nth-child(1) { transition-delay: .04s; }
      .nav-dropdown-menu.open a:nth-child(2) { transition-delay: .07s; }
      .nav-dropdown-menu.open a:nth-child(3) { transition-delay: .1s; }
      .nav-dropdown-menu.open a:nth-child(4) { transition-delay: .13s; }
      .nav-dropdown-menu.open a:nth-child(5) { transition-delay: .16s; }
      .nav-dropdown-menu.open a:nth-child(6) { transition-delay: .19s; }
      .nav-dropdown-menu.open a:nth-child(7) { transition-delay: .22s; }
      .nav-dropdown-menu.open a:nth-child(8) { transition-delay: .25s; }
      .nav-dropdown-menu.open a:nth-child(9) { transition-delay: .28s; }
      .nav-dropdown-menu a:hover { background: rgba(79,70,229,.08); color: var(--primary); }

      @media (min-width: 768px) {
        .nav-dropdown-menu {
          display: flex; flex-direction: column; gap: .15rem;
          position: absolute; top: calc(100% + 12px); left: 50%;
          min-width: 240px; padding: .6rem; margin: 0; border-left: none; border-radius: 16px;
          background: rgba(255,255,255,.98); backdrop-filter: blur(16px);
          border: 1px solid rgba(15,23,42,.08); box-shadow: 0 16px 48px rgba(15,23,42,.12);
          opacity: 0; visibility: hidden; pointer-events: none;
          transform: translateX(-50%) translateY(8px) scale(.96);
          transition: opacity .25s ease, transform .3s cubic-bezier(.22,1,.36,1), visibility .25s;
          grid-template-rows: none;
        }
        .nav-dropdown-menu > * { overflow: visible; }
        .nav-dropdown-menu.open {
          opacity: 1; visibility: visible; pointer-events: auto;
          transform: translateX(-50%) translateY(0) scale(1);
          padding: .6rem; margin: 0; border-left: none;
        }
        .nav-dropdown-menu a { font-size: .875rem; white-space: nowrap; opacity: 1; transform: none; transition: background .2s, color .2s; }
        .nav-dropdown-menu.open a { transition-delay: 0s; }
      }

      .btn { display: inline-flex; align-items: center; justify-content: center; padding: .8rem 1.65rem; border-radius: 9999px; font-family: var(--font-h); font-weight: 600; font-size: .9rem; border: none; cursor: pointer; transition: all .3s ease; }
      .btn-primary { background: linear-gradient(135deg, #4F46E5, #7C3AED); color: #fff; box-shadow: 0 6px 24px rgba(79,70,229,.3); }
      .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 32px rgba(79,70,229,.4); }
      .btn-outline { background: transparent; border: 1.5px solid rgba(15,23,42,.12); color: var(--text); }
      .btn-outline:hover { border-color: var(--primary); color: var(--primary); background: rgba(79,70,229,.04); }
      .flex-btns { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }

      .glass-card { background: rgba(255,255,255,.7); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,.8); border-radius: var(--radius); padding: 1.75rem 1.5rem; box-shadow: 0 8px 32px rgba(15,23,42,.06); transition: transform .4s ease, box-shadow .4s ease; position: relative; overflow: hidden; }
      .glass-card:hover { transform: translateY(-8px); box-shadow: 0 20px 48px rgba(15,23,42,.1); }

      .hero-premium { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 7rem 1.5rem 5rem; overflow: hidden; background: #F8FAFC; }
      .hero-bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; contain: strict; }
      .orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.5; animation: orb-float 18s ease-in-out infinite; will-change: transform; }
      .orb-1 { width: 420px; height: 420px; background: radial-gradient(circle, rgba(79,70,229,.4) 0%, transparent 70%); top: -10%; left: -8%; }
      .orb-2 { width: 380px; height: 380px; background: radial-gradient(circle, rgba(6,182,212,.35) 0%, transparent 70%); bottom: -5%; right: -5%; animation-delay: -6s; }
      .orb-3 { width: 280px; height: 280px; background: radial-gradient(circle, rgba(124,58,237,.32) 0%, transparent 70%); top: 40%; left: 50%; animation-delay: -12s; }
      @keyframes orb-float { 0%, 100% { transform: translate(0,0) scale(1); } 33% { transform: translate(30px,-40px) scale(1.08); } 66% { transform: translate(-20px,25px) scale(0.95); } }
      .grid-overlay { position: absolute; inset: 0; background-image: linear-gradient(rgba(79,70,229,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(79,70,229,.04) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 20%, transparent 70%); }
      .hero-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; position: relative; z-index: 2; max-width: 1140px; margin: 0 auto; width: 100%; }
      @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; } }
      .hero-content { max-width: 560px; }
      .hero-title { font-family: var(--font-h); font-size: clamp(2.1rem, 6vw, 3.6rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.03em; color: var(--text); margin: 0 0 1.5rem; }
      .hero-lead { font-size: 1.05rem; line-height: 1.7; color: var(--text-2); margin: 0 0 2rem; max-width: 480px; }
      .trust-row { display: flex; align-items: center; gap: 1.25rem; margin-top: 2.5rem; flex-wrap: wrap; }
      .trust-item { display: flex; flex-direction: column; gap: 0.15rem; }
      .trust-item strong { font-family: var(--font-h); font-size: 1.35rem; font-weight: 700; color: var(--text); }
      .trust-item span { font-size: 0.8rem; color: var(--text-3); }
      .trust-divider { width: 1px; height: 28px; background: rgba(15,23,42,.12); }
      .typing-cursor { display: inline-block; color: var(--primary); font-weight: 300; margin-left: 2px; animation: blink 0.8s step-end infinite; }
      @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
      .hero-visual { display: flex; justify-content: center; position: relative; }
      .visual-card { width: 100%; max-width: 380px; padding: 2.5rem 2rem !important; text-align: center; position: relative; }
      .visual-icon { font-size: 3.5rem; margin-bottom: 1rem; line-height: 1; }
      .visual-card h3 { font-family: var(--font-h); font-size: 1.35rem; font-weight: 700; margin: 0 0 0.5rem; color: var(--text); }
      .visual-tags { font-size: 0.9rem; color: var(--text-3); margin: 0 0 1.75rem; }
      .float-badge { position: absolute; font-size: 0.75rem; font-weight: 600; padding: 0.4rem 0.75rem; border-radius: 9999px; background: rgba(255,255,255,.92); backdrop-filter: blur(8px); box-shadow: 0 4px 16px rgba(15,23,42,.1); border: 1px solid rgba(255,255,255,.8); white-space: nowrap; animation: badge-float 5s ease-in-out infinite; }
      .badge-1 { top: 12%; left: -12%; } .badge-2 { top: 48%; right: -14%; animation-delay: -1.8s; } .badge-3 { bottom: 18%; left: -8%; animation-delay: -3.5s; }
      @keyframes badge-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
      .animate-float { animation: float 6.5s ease-in-out infinite; }
      @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
      .scroll-indicator { position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 0.5rem; color: var(--text-3); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; z-index: 5; }
      .scroll-line { width: 1.5px; height: 40px; background: linear-gradient(to bottom, var(--primary), transparent); border-radius: 2px; animation: scroll-pulse 2s ease-in-out infinite; }
      @keyframes scroll-pulse { 0%, 100% { opacity: 0.4; transform: scaleY(0.7); } 50% { opacity: 1; transform: scaleY(1); } }

      .section-soft { background: linear-gradient(180deg, #F8FAFC, #F1F5F9); padding: 4rem 1.25rem; }
      .section-violet { background: radial-gradient(ellipse 70% 50% at 80% 30%, rgba(124,58,237,.08), transparent 50%), #F8FAFC; padding: 4rem 1.25rem; }
      .section-warm { background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(245,158,11,.07), transparent 55%), #fff; padding: 4rem 1.25rem; }
      .container { max-width: 1140px; margin: 0 auto; width: 100%; }
      .grid-2 { display: grid; gap: 2rem; align-items: center; }
      @media (min-width: 1024px) { .grid-2 { grid-template-columns: 1fr 1fr; gap: 3rem; } }
      .grid-3 { display: grid; gap: 1.25rem; }
      @media (min-width: 640px) { .grid-3 { grid-template-columns: 1fr 1fr; } }
      @media (min-width: 1024px) { .grid-3 { grid-template-columns: 1fr 1fr 1fr; } }
      .text-center { text-align: center; }
      .mb-4 { margin-bottom: 1rem; } .mb-6 { margin-bottom: 1.5rem; } .mb-8 { margin-bottom: 2rem; }
      h1 { font-family: var(--font-h); font-weight: 800; font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.15; letter-spacing: -.02em; color: var(--text); }
      h2 { font-family: var(--font-h); font-weight: 700; font-size: clamp(1.5rem, 3.5vw, 2.25rem); letter-spacing: -.02em; color: var(--text); }
      h3 { font-family: var(--font-h); font-weight: 600; font-size: 1.1rem; color: var(--text); }
      p { color: var(--text-2); }
      .lead { font-size: 1.05rem; line-height: 1.7; max-width: 28rem; }
      .eyebrow { display: inline-flex; align-items: center; gap: .5rem; padding: .4rem 1rem; border-radius: 9999px; background: rgba(255,255,255,.85); border: 1px solid rgba(79,70,229,.15); color: var(--primary); font-size: .85rem; font-weight: 500; box-shadow: 0 1px 4px rgba(0,0,0,.04); margin-bottom: 1.5rem; }
      .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--emerald); animation: pulse 2s ease-in-out infinite; }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
      .icon-box { width: 48px; height: 48px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 1rem; }
      .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.5rem; }
      .stat-box { padding: .9rem; border-radius: 16px; background: rgba(255,255,255,.7); border: 1px solid rgba(226,232,240,.8); }
      .stat-box strong { display: block; font-size: 1.35rem; font-family: var(--font-h); }
      .stat-box span { font-size: .75rem; color: var(--text-3); }

      .site-footer { background: #0F172A; color: #94A3B8; padding: 3rem 1.25rem 1.5rem; }
      .footer-grid { max-width: 1140px; margin: 0 auto; display: grid; gap: 2rem; grid-template-columns: 1fr; }
      @media (min-width: 640px) { .footer-grid { grid-template-columns: 1.4fr 1fr 1fr; } }
      @media (min-width: 900px) { .footer-grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; } }
      .footer-brand .logo { color: #fff; margin-bottom: 1rem; }
      .footer-brand .logo span, .footer-brand .logo-text span { background: linear-gradient(135deg, #818CF8, #A78BFA); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
      .footer-desc { font-size: .9rem; line-height: 1.6; max-width: 280px; color: #94A3B8; }
      .footer-col h4 { font-family: var(--font-h); font-size: .85rem; font-weight: 600; color: #fff; margin-bottom: 1rem; letter-spacing: .02em; }
      .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: .55rem; }
      .footer-col a { font-size: .875rem; color: #94A3B8; transition: color .2s; }
      .footer-col a:hover { color: #fff; }
      .footer-bottom { max-width: 1140px; margin: 2.5rem auto 0; padding-top: 1.5rem; border-top: 1px solid rgba(148,163,184,.15); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; font-size: .8rem; }
      .footer-links { display: flex; gap: 1.25rem; }
      .footer-links a:hover { color: #fff; }

      .reveal { opacity: 0; transform: translateY(28px); transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1); }
      .reveal.visible { opacity: 1; transform: translateY(0); }
      @media (max-width: 899px) {
        .hero-premium { padding: 5.5rem 1.25rem 3.5rem; min-height: auto; }
        .float-badge { display: none; }
        .scroll-indicator { display: none; }
        .flex-btns .btn { flex: 1 1 auto; min-width: 140px; }
      }
    </style>
  </head>
  <body>
    <slot />
    <CookieBanner />
    <script is:inline>
      (function () {
        'use strict';
        try {
          var reveals = document.querySelectorAll('.reveal');
          if (reveals.length && 'IntersectionObserver' in window) {
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add('visible');
                  io.unobserve(e.target);
                }
              });
            }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
            reveals.forEach(function (el) { io.observe(el); });
          } else {
            reveals.forEach(function (el) { el.classList.add('visible'); });
          }

          var nav = document.getElementById('navbar');
          var ticking = false;
          function onScroll() {
            if (!nav) return;
            if (window.scrollY > 20) nav.classList.add('scrolled');
            else nav.classList.remove('scrolled');
            ticking = false;
          }
          window.addEventListener('scroll', function () {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(onScroll);
            }
          }, { passive: true });
          onScroll();

          function startTyping() {
            try {
              var typingEl = document.getElementById('typing-text');
              if (!typingEl) return;
              if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                typingEl.textContent = 'Grow Your Business';
                return;
              }
              var words = ['Grow Your Business', 'Rank & Convert', 'Scale Digitally', 'Build & Market'];
              var wordIndex = 0, charIndex = 0, isDeleting = false, typingSpeed = 90;
              var timer = null;
              function type() {
                var currentWord = words[wordIndex];
                if (isDeleting) {
                  typingEl.textContent = currentWord.substring(0, charIndex - 1);
                  charIndex--;
                  typingSpeed = 45;
                } else {
                  typingEl.textContent = currentWord.substring(0, charIndex + 1);
                  charIndex++;
                  typingSpeed = 90;
                }
                if (!isDeleting && charIndex === currentWord.length) {
                  typingSpeed = 1800;
                  isDeleting = true;
                } else if (isDeleting && charIndex === 0) {
                  isDeleting = false;
                  wordIndex = (wordIndex + 1) % words.length;
                  typingSpeed = 400;
                }
                timer = setTimeout(type, typingSpeed);
              }
              type();
              document.addEventListener('visibilitychange', function () {
                if (document.hidden && timer) {
                  clearTimeout(timer);
                  timer = null;
                } else if (!document.hidden && !timer) {
                  type();
                }
              });
            } catch (e) {}
          }
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', startTyping);
          else startTyping();
        } catch (err) {}
      })();
    </script>
  </body>
</html>
