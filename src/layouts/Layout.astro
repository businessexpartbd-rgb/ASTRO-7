---
import '../styles/global.css';
import { categories } from '../data/news';

interface Props { title?: string; description?: string; image?: string; type?: string; }
const { title = 'দৈনিক নিউজ — বাংলাদেশের জাতীয় সংবাদপত্র', description = 'বাংলাদেশের ৬৪ জেলা, গ্রামবাংলা ও জাতীয় গুরুত্বপূর্ণ খবরের নির্ভরযোগ্য ডিজিটাল ঠিকানা।', image, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="bn" data-lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f5132" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="bn_BD" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url.origin)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="icon" href="/logo.png" type="image/png" />
  </head>
  <body>
    <a class="skip-link" href="#main">মূল সংবাদে যান</a>
    <header class="site-header">
      <div class="utility-bar">
        <div class="container utility-inner">
          <div class="date-cluster" aria-label="আজকের তারিখ">
            <span id="date-bn">তারিখ লোড হচ্ছে…</span><span class="dot">•</span>
            <span id="date-en"></span><span class="dot">•</span><span id="date-hijri"></span>
          </div>
          <div class="utility-actions">
            <span id="weather-chip" class="weather-chip">ঢাকা · আবহাওয়া</span>
            <button class="lang-btn active" data-set-lang="bn" aria-label="বাংলা ভাষা">বাংলা</button>
            <button class="lang-btn" data-set-lang="en" aria-label="English language">English</button>
          </div>
        </div>
      </div>
      <div class="container brand-row">
        <a href="/" class="brand" aria-label="দৈনিক নিউজ হোমপেজ"><img src="/logo.png" alt="দৈনিক নিউজ" width="500" height="500" /></a>
        <div class="brand-note"><strong data-bn="জাতীয় সংবাদ · মানুষের কথা" data-en="National news · People's voice">জাতীয় সংবাদ · মানুষের কথা</strong><span data-bn="৬৪ জেলা ও গ্রামবাংলার খবর" data-en="News from 64 districts and rural Bangladesh">৬৪ জেলা ও গ্রামবাংলার খবর</span></div>
        <form class="header-search" action="/search/" role="search"><label class="sr-only" for="site-search">সংবাদ খুঁজুন</label><input id="site-search" name="q" placeholder="সংবাদ খুঁজুন…" autocomplete="off" /><button type="submit" aria-label="খুঁজুন">⌕</button></form>
        <button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav">মেনু</button>
      </div>
      <nav id="primary-nav" class="primary-nav" aria-label="প্রধান নেভিগেশন">
        <div class="container nav-scroll"><a href="/" class="home-link">প্রচ্ছদ</a>{categories.map((category) => <a href={`/archive/?category=${encodeURIComponent(category)}`}>{category}</a>)}<a href="/districts/">৬৪ জেলা</a><a href="/archive/">আর্কাইভ</a></div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid"><div><img src="/logo.png" alt="দৈনিক নিউজ" width="500" height="500" class="footer-logo" /><p>জাতীয় সংবাদ, ৬৪ জেলা ও গ্রামবাংলার মানুষের কথা তুলে ধরার স্বাধীন ডিজিটাল প্ল্যাটফর্ম।</p></div><div><h2>গুরুত্বপূর্ণ</h2><a href="/districts/">জেলা সংবাদ</a><a href="/archive/">নিউজ আর্কাইভ</a><a href="/search/">সংবাদ অনুসন্ধান</a></div><div><h2>সম্পাদকীয়</h2><a href="#">আমাদের সম্পর্কে</a><a href="#">যোগাযোগ</a><a href="#">গোপনীয়তা নীতি</a></div></div>
      <div class="copyright">© <span id="copyright-year"></span> দৈনিক নিউজ। সর্বস্বত্ব সংরক্ষিত।</div>
    </footer>
    <script is:inline>
      const bnDigits = n => String(n).replace(/\d/g, d => '০১২৩৪৫৬৭৮৯'[d]);
      const now = new Date();
      const opts = { timeZone:'Asia/Dhaka', year:'numeric', month:'long', day:'numeric', weekday:'long' };
      const bnEl = document.getElementById('date-bn');
      const enEl = document.getElementById('date-en');
      const hijriEl = document.getElementById('date-hijri');
      if (bnEl) bnEl.textContent = new Intl.DateTimeFormat('bn-BD', opts).format(now);
      if (enEl) enEl.textContent = new Intl.DateTimeFormat('en-GB', {timeZone:'Asia/Dhaka',day:'2-digit',month:'long',year:'numeric'}).format(now);
      if (hijriEl) { try { hijriEl.textContent = new Intl.DateTimeFormat('bn-BD-u-ca-islamic', {timeZone:'Asia/Dhaka',day:'numeric',month:'long',year:'numeric'}).format(now) + ' হিজরি'; } catch(e) { hijriEl.textContent='হিজরি তারিখ'; } }
      const year = document.getElementById('copyright-year'); if(year) year.textContent = bnDigits(now.getFullYear());
      const menu = document.querySelector('.menu-toggle'); const nav = document.getElementById('primary-nav');
      menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') === 'true'; menu.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('open', !open); });
      function setLanguage(lang) { document.documentElement.dataset.lang=lang; document.documentElement.lang=lang; localStorage.setItem('dainik-lang',lang); document.querySelectorAll('[data-bn][data-en]').forEach(el => { el.textContent = el.dataset[lang]; }); document.querySelectorAll('[data-set-lang]').forEach(b=>b.classList.toggle('active',b.dataset.setLang===lang)); }
      document.querySelectorAll('[data-set-lang]').forEach(b=>b.addEventListener('click',()=>setLanguage(b.dataset.setLang)));
      setLanguage(localStorage.getItem('dainik-lang') || 'bn');
      const weather = document.getElementById('weather-chip');
      fetch('https://api.open-meteo.com/v1/forecast?latitude=23.81&longitude=90.41&current=temperature_2m,weather_code&timezone=Asia%2FDhaka').then(r=>r.json()).then(d=>{ if(weather && d.current) weather.textContent=`ঢাকা · ${bnDigits(Math.round(d.current.temperature_2m))}°সে`; }).catch(()=>{});
    </script>
  </body>
</html>
