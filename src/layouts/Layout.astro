---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Creavix iT Solution — Creative Digital & AI Services',
  description = 'Premium video editing, AI video marketing, web & app development, authentication systems and Facebook marketing services.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://creavixit.com" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✨</text></svg>" />

    <!-- ALL CRITICAL STYLES INLINE — works even if external CSS fails -->
    <style is:global>
      :root {
        --primary: #4F46E5;
        --primary-light: #818CF8;
        --violet: #7C3AED;
        --accent: #06B6D4;
        --rose: #F43F5E;
        --amber: #F59E0B;
        --emerald: #10B981;
        --text: #0F172A;
        --text-2: #475569;
        --text-3: #64748B;
        --bg: #F8FAFC;
        --white: #FFFFFF;
        --radius: 24px;
        --font-h: "Outfit", system-ui, sans-serif;
        --font-b: "Inter", system-ui, sans-serif;
        --font-d: "Playfair Display", Georgia, serif;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: var(--font-b);
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }

      .font-heading { font-family: var(--font-h); }
      .font-display { font-family: var(--font-d); }
      .text-gradient {
        background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 50%, #06B6D4 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .text-primary { color: var(--primary); }
      .text-violet { color: var(--violet); }

      /* Navbar */
      .navbar {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        padding: 1rem 0;
        transition: background .3s, box-shadow .3s;
      }
      .navbar.scrolled {
        background: rgba(255,255,255,.88);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: 0 1px 0 rgba(15,23,42,.06);
      }
      .nav-inner {
        max-width: 1140px; margin: 0 auto; padding: 0 1.5rem;
        display: flex; align-items: center; justify-content: space-between;
      }
      .logo {
        font-family: var(--font-h); font-weight: 700; font-size: 1.2rem;
        color: var(--text);
      }
      .logo span {
        background: linear-gradient(135deg, #4F46E5, #7C3AED);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      }
      .nav-links {
        display: none; gap: 2rem; list-style: none;
      }
      @media (min-width: 768px) { .nav-links { display: flex; } }
      .nav-links a {
        color: var(--text-2); font-size: .9rem; font-weight: 500;
        transition: color .2s;
      }
      .nav-links a:hover, .nav-links a.active { color: var(--primary); }

      /* Buttons */
      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        padding: .8rem 1.65rem; border-radius: 9999px;
        font-family: var(--font-h); font-weight: 600; font-size: .9rem;
        border: none; cursor: pointer; transition: all .3s ease;
      }
      .btn-primary {
        background: linear-gradient(135deg, #4F46E5, #7C3AED);
        color: #fff;
        box-shadow: 0 6px 24px rgba(79,70,229,.3);
      }
      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 32px rgba(79,70,229,.4);
      }
      .btn-outline {
        background: transparent;
        border: 1.5px solid rgba(15,23,42,.12);
        color: var(--text);
      }
      .btn-outline:hover {
        border-color: var(--primary); color: var(--primary);
        background: rgba(79,70,229,.04);
      }
      .flex-btns { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }

      /* Glass Card */
      .glass-card {
        background: rgba(255,255,255,.7);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,.8);
        border-radius: var(--radius);
        padding: 1.75rem 1.5rem;
        box-shadow: 0 8px 32px rgba(15,23,42,.06);
        transition: transform .4s ease, box-shadow .4s ease;
        position: relative;
        overflow: hidden;
      }
      .glass-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 48px rgba(15,23,42,.1);
      }

      /* ========== PREMIUM HERO ========== */
      .hero-premium {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding: 7rem 1.5rem 5rem;
        overflow: hidden;
        background: #F8FAFC;
      }
      .hero-bg {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
      }
      .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.5;
        animation: orb-float 18s ease-in-out infinite;
      }
      .orb-1 {
        width: 420px; height: 420px;
        background: radial-gradient(circle, rgba(79,70,229,.4) 0%, transparent 70%);
        top: -10%; left: -8%;
      }
      .orb-2 {
        width: 380px; height: 380px;
        background: radial-gradient(circle, rgba(6,182,212,.35) 0%, transparent 70%);
        bottom: -5%; right: -5%;
        animation-delay: -6s;
      }
      .orb-3 {
        width: 280px; height: 280px;
        background: radial-gradient(circle, rgba(124,58,237,.32) 0%, transparent 70%);
        top: 40%; left: 50%;
        animation-delay: -12s;
      }
      @keyframes orb-float {
        0%, 100% { transform: translate(0,0) scale(1); }
        33% { transform: translate(30px,-40px) scale(1.08); }
        66% { transform: translate(-20px,25px) scale(0.95); }
      }
      .grid-overlay {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(79,70,229,.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(79,70,229,.04) 1px, transparent 1px);
        background-size: 60px 60px;
        mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 20%, transparent 70%);
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
        align-items: center;
        position: relative;
        z-index: 2;
        max-width: 1140px;
        margin: 0 auto;
        width: 100%;
      }
      @media (min-width: 900px) {
        .hero-grid {
          grid-template-columns: 1.1fr 0.9fr;
          gap: 4rem;
        }
      }
      .hero-content { max-width: 560px; }
      .hero-title {
        font-family: var(--font-h);
        font-size: clamp(2.4rem, 5vw, 3.6rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.03em;
        color: var(--text);
        margin: 0 0 1.5rem;
      }
      .hero-lead {
        font-size: 1.125rem;
        line-height: 1.7;
        color: var(--text-2);
        margin: 0 0 2rem;
        max-width: 480px;
      }
      .trust-row {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-top: 2.5rem;
        flex-wrap: wrap;
      }
      .trust-item {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }
      .trust-item strong {
        font-family: var(--font-h);
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--text);
      }
      .trust-item span {
        font-size: 0.8rem;
        color: var(--text-3);
      }
      .trust-divider {
        width: 1px;
        height: 28px;
        background: rgba(15,23,42,.12);
      }

      /* Typing */
      .typing-cursor {
        display: inline-block;
        color: var(--primary);
        font-weight: 300;
        margin-left: 2px;
        animation: blink 0.8s step-end infinite;
      }
      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
      }

      /* Hero Visual */
      .hero-visual {
        display: flex;
        justify-content: center;
        position: relative;
      }
      .visual-card {
        width: 100%;
        max-width: 380px;
        padding: 2.5rem 2rem !important;
        text-align: center;
        position: relative;
      }
      .visual-icon {
        font-size: 3.5rem;
        margin-bottom: 1rem;
        line-height: 1;
      }
      .visual-card h3 {
        font-family: var(--font-h);
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0 0 0.5rem;
        color: var(--text);
      }
      .visual-tags {
        font-size: 0.9rem;
        color: var(--text-3);
        margin: 0 0 1.75rem;
      }
      .float-badge {
        position: absolute;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.4rem 0.75rem;
        border-radius: 9999px;
        background: rgba(255,255,255,.92);
        backdrop-filter: blur(8px);
        box-shadow: 0 4px 16px rgba(15,23,42,.1);
        border: 1px solid rgba(255,255,255,.8);
        white-space: nowrap;
        animation: badge-float 5s ease-in-out infinite;
      }
      .badge-1 { top: 12%; left: -12%; }
      .badge-2 { top: 48%; right: -14%; animation-delay: -1.8s; }
      .badge-3 { bottom: 18%; left: -8%; animation-delay: -3.5s; }
      @keyframes badge-float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
      }
      .animate-float {
        animation: float 6.5s ease-in-out infinite;
      }
      @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-14px); }
      }

      /* Scroll Indicator */
      .scroll-indicator {
        position: absolute;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-3);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        z-index: 5;
      }
      .scroll-line {
        width: 1.5px;
        height: 40px;
        background: linear-gradient(to bottom, var(--primary), transparent);
        border-radius: 2px;
        animation: scroll-pulse 2s ease-in-out infinite;
      }
      @keyframes scroll-pulse {
        0%, 100% { opacity: 0.4; transform: scaleY(0.7); }
        50% { opacity: 1; transform: scaleY(1); }
      }

      /* Sections */
      .section-soft { background: linear-gradient(180deg, #F8FAFC, #F1F5F9); padding: 5rem 1.5rem; }
      .section-violet {
        background: radial-gradient(ellipse 70% 50% at 80% 30%, rgba(124,58,237,.08), transparent 50%), #F8FAFC;
        padding: 5rem 1.5rem;
      }
      .section-warm {
        background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(245,158,11,.07), transparent 55%), #fff;
        padding: 5rem 1.5rem;
      }

      /* Layout helpers */
      .container { max-width: 1140px; margin: 0 auto; width: 100%; }
      .grid-2 { display: grid; gap: 3rem; align-items: center; }
      @media (min-width: 1024px) { .grid-2 { grid-template-columns: 1fr 1fr; } }
      .grid-3 { display: grid; gap: 1.25rem; }
      @media (min-width: 640px) { .grid-3 { grid-template-columns: 1fr 1fr; } }
      @media (min-width: 1024px) { .grid-3 { grid-template-columns: 1fr 1fr 1fr; } }
      .text-center { text-align: center; }
      .mb-4 { margin-bottom: 1rem; }
      .mb-6 { margin-bottom: 1.5rem; }
      .mb-8 { margin-bottom: 2rem; }

      h1 {
        font-family: var(--font-h);
        font-weight: 800;
        font-size: clamp(2.2rem, 5vw, 3.25rem);
        line-height: 1.15;
        letter-spacing: -.02em;
        color: var(--text);
      }
      h2 {
        font-family: var(--font-h);
        font-weight: 700;
        font-size: clamp(1.75rem, 3.5vw, 2.25rem);
        letter-spacing: -.02em;
        color: var(--text);
      }
      h3 {
        font-family: var(--font-h);
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--text);
      }
      p { color: var(--text-2); }
      .lead { font-size: 1.125rem; line-height: 1.7; max-width: 28rem; }
      .eyebrow {
        display: inline-flex; align-items: center; gap: .5rem;
        padding: .4rem 1rem; border-radius: 9999px;
        background: rgba(255,255,255,.85);
        border: 1px solid rgba(79,70,229,.15);
        color: var(--primary);
        font-size: .85rem; font-weight: 500;
        box-shadow: 0 1px 4px rgba(0,0,0,.04);
        margin-bottom: 1.5rem;
      }
      .dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: var(--emerald);
        animation: pulse 2s ease-in-out infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: .5; }
      }
      .icon-box {
        width: 48px; height: 48px; border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; margin-bottom: 1rem;
      }
      .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.5rem; }
      .stat-box {
        padding: .9rem; border-radius: 16px;
        background: rgba(255,255,255,.7);
        border: 1px solid rgba(226,232,240,.8);
      }
      .stat-box strong { display: block; font-size: 1.35rem; font-family: var(--font-h); }
      .stat-box span { font-size: .75rem; color: var(--text-3); }

      footer {
        background: #0F172A;
        color: #94A3B8;
        padding: 2.5rem 1.5rem;
      }
      .footer-inner {
        max-width: 1140px; margin: 0 auto;
        display: flex; flex-wrap: wrap;
        justify-content: space-between; align-items: center; gap: 1rem;
      }
      footer .logo { color: #fff; }
      footer .logo span {
        background: linear-gradient(135deg, #818CF8, #A78BFA);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      }

      .reveal { opacity: 0; transform: translateY(28px); transition: all .8s cubic-bezier(.16,1,.3,1); }
      .reveal.visible { opacity: 1; transform: translateY(0); }

      /* Mobile */
      @media (max-width: 899px) {
        .hero-premium { padding: 6rem 1.5rem 4rem; min-height: auto; }
        .float-badge { display: none; }
        .scroll-indicator { display: none; }
      }
    </style>
  </head>
  <body>
    <slot />

    <script>
      // Reveal on scroll
      const reveals = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      reveals.forEach(el => io.observe(el));

      // Navbar scroll
      const nav = document.getElementById('navbar');
      const onScroll = () => {
        if (window.scrollY > 20) nav?.classList.add('scrolled');
        else nav?.classList.remove('scrolled');
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // ========== TYPING EFFECT ==========
      const typingEl = document.getElementById('typing-text');
      if (typingEl) {
        const words = ['Convert & Inspire', 'Scale Fast', 'Drive Results', 'Build Brands'];
        let wordIndex = 0;
        let charIndex = 0;
        let isDeleting = false;
        let typingSpeed = 90;

        function type() {
          const currentWord = words[wordIndex];

          if (isDeleting) {
            typingEl.textContent = currentWord.substring(0, charIndex - 1);
            charIndex--;
            typingSpeed = 45;
          } else {
            typingEl.textContent = currentWord.substring(0, charIndex + 1);
            charIndex++;
            typingSpeed = 90;
          }

          if (!isDeleting && charIndex === currentWord.length) {
            typingSpeed = 1800;
            isDeleting = true;
          } else if (isDeleting && charIndex === 0) {
            isDeleting = false;
            wordIndex = (wordIndex + 1) % words.length;
            typingSpeed = 400;
          }

          setTimeout(type, typingSpeed);
        }

        setTimeout(type, 600);
      }
    </script>
  </body>
</html>
