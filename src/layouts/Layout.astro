---
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/brand-system.css';
import '../styles/page-quality.css';
import { SITE } from '../data/site';
import { PAGE_SEO } from '../data/pageSeo';
import { getPageVisual } from '../data/pageVisuals';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  pageType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  articleTags?: string[];
}
const {
  title: suppliedTitle = SITE.seoTitle,
  description: suppliedDescription = SITE.seoDescription,
  image = '/og-creavix-share-v2.png',
  pageType = 'website',
  publishedTime,
  modifiedTime,
  articleSection,
  articleTags = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname || '/', SITE.url).href;
const socialImage = new URL(image, SITE.url).href;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const pageVisual = getPageVisual(pathname);
const pageVisualStyle = `--page-accent:${pageVisual.accent};--page-accent-2:${pageVisual.accent2};--page-wash:${pageVisual.wash};--page-ink:${pageVisual.ink}`;
const title = PAGE_SEO[pathname]?.title || suppliedTitle;
const description = PAGE_SEO[pathname]?.description || suppliedDescription;
const segments = pathname.split('/').filter(Boolean);
const pageId = `${canonical}#webpage`;
const perfV = '20260903speed1';

const compact = (value: string, limit: number) => {
  if (value.length <= limit) return value;
  const shortened = value.slice(0, limit + 1);
  const boundary = shortened.lastIndexOf(' ');
  return `${shortened.slice(0, boundary > limit * 0.72 ? boundary : limit).replace(/[\s,;:|—-]+$/, '')}…`;
};

const titleWithoutLongBrand = title
  .replace(/\s*[|—]\s*Creavix iT Solution Blog$/i, '')
  .replace(/\s*[|—]\s*Creavix iT Solution$/i, '')
  .replace(/\s*[|—]\s*Creavix iT$/i, '');
const searchTitle = compact(title.length > 68 ? titleWithoutLongBrand : title, 68);
const searchDescription = compact(description, 165);

const labelFor = (segment: string) => segment
  .replaceAll('-', ' ')
  .replace(/\b\w/g, (letter) => letter.toUpperCase());

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
  ...segments.map((segment, index) => ({
    '@type': 'ListItem',
    position: index + 2,
    name: index === segments.length - 1 ? searchTitle : labelFor(segment),
    item: new URL(`/${segments.slice(0, index + 1).join('/')}/`, SITE.url).href,
  })),
];

const webPageType = pathname === '/about'
  ? 'AboutPage'
  : pathname === '/contact'
    ? 'ContactPage'
    : pathname === '/portfolio' || pathname === '/blog' || pathname === '/services'
      ? 'CollectionPage'
      : pageType === 'article'
        ? 'BlogPosting'
        : 'WebPage';

const pageSchema: Record<string, unknown> = {
  '@type': webPageType,
  '@id': pageId,
  url: canonical,
  name: searchTitle,
  description: searchDescription,
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#organization` },
  primaryImageOfPage: { '@type': 'ImageObject', url: socialImage },
  inLanguage: 'en-BD',
  breadcrumb: { '@id': `${canonical}#breadcrumb` },
};

if (pageType === 'article') {
  Object.assign(pageSchema, {
    headline: title.split('|')[0].trim(),
    image: [socialImage],
    datePublished: publishedTime,
    dateModified: modifiedTime || publishedTime,
    articleSection,
    keywords: articleTags.join(', '),
    author: { '@id': `${SITE.url}/#organization` },
    publisher: { '@id': `${SITE.url}/#organization` },
    mainEntityOfPage: { '@id': pageId },
  });
}

const serviceSchema = pathname.startsWith('/services/') ? {
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: title.split('|')[0].trim(),
  description: searchDescription,
  url: canonical,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: [
    { '@type': 'Country', name: 'Bangladesh' },
    { '@type': 'Place', name: 'Worldwide' },
  ],
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: canonical,
    servicePhone: SITE.hotline,
  },
} : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': `${SITE.url}/#organization`,
      name: SITE.brand,
      url: SITE.url,
      logo: `${SITE.url}/favicon-512.png`,
      image: `${SITE.url}/og-creavix.png`,
      description: SITE.seoDescription,
      alternateName: ['Creavix IT', 'Creavix'],
      email: SITE.email1,
      telephone: SITE.hotline,
      areaServed: ['Bangladesh', 'Worldwide'],
      knowsAbout: ['Professional Video Editing', 'AI Video Marketing', 'Human-like Content', 'Web Development', 'Mobile and Web Application Development', 'Authentication Systems', 'Business Automation', 'Digital Marketing', 'Search Engine Optimization', 'Facebook Page Services', 'Facebook Boosting', 'Meta and YouTube Campaigns'],
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Hemayetpur',
        addressLocality: 'Savar',
        addressRegion: 'Dhaka',
        postalCode: '1340',
        addressCountry: 'BD',
      },
      sameAs: [
        'https://www.facebook.com/CreavixITSolution',
        'https://www.instagram.com/creavixitsolution',
        'https://www.youtube.com/@CreavixiTsolution',
        'https://www.tiktok.com/@creavixitsolution',
        'https://www.linkedin.com/in/creavix-it-solution',
        'https://x.com/creavixit',
      ],
      foundingDate: String(SITE.servingSince),
      founder: { '@type': 'Person', name: SITE.founder.name },
      contactPoint: [{
        '@type': 'ContactPoint',
        telephone: SITE.hotline,
        contactType: 'customer service',
        email: SITE.email1,
        availableLanguage: ['English', 'Bengali'],
        areaServed: ['BD', 'Worldwide'],
      }],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Creative, Technology and Growth Services',
        itemListElement: ['AI Video Marketing', 'Professional Video Editing', 'Web Development', 'Application Development', 'SEO', 'Digital Marketing', 'Business Automation'].map((name) => ({ '@type': 'OfferCatalog', name })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.brand,
      publisher: { '@id': `${SITE.url}/#organization` },
      inLanguage: 'en-BD',
    },
    pageSchema,
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems,
    },
    ...(serviceSchema ? [serviceSchema] : []),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      id="viewport-meta"
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="theme-color" content="#0A2540" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <title>{searchTitle}</title>
    <meta name="description" content={searchDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={SITE.brand} />
    <meta name="application-name" content={SITE.brand} />
    <meta name="generator" content="Astro 7.2.4" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="alternate" hreflang="en-BD" href={canonical} />

    <link rel="dns-prefetch" href="https://i.ytimg.com" />
    <link rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
    {pathname === '/' && <link rel="preload" as="image" href="/media/hero-studio-bangladesh-480.webp" fetchpriority="high" />}

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={searchTitle} />
    <meta property="og:description" content={searchDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_BD" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${SITE.brand} — Video Editing and Digital Solutions`} />
    {pageType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {pageType === 'article' && (modifiedTime || publishedTime) && <meta property="article:modified_time" content={modifiedTime || publishedTime} />}
    {pageType === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
    {pageType === 'article' && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={searchTitle} />
    <meta name="twitter:description" content={searchDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${SITE.brand} — Video Editing and Digital Solutions`} />
    <link rel="image_src" href={socialImage} />

    <link rel="stylesheet" href={`/perf.css?v=${perfV}`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script src={`/js/perf.js?v=${perfV}`} defer></script>

    <style is:global>
      :root {
        --primary: #2563EB;
        --primary-light: #3B82F6;
        --violet: #1D4ED8;
        --accent: #F59E0B;
        --rose: #F43F5E;
        --amber: #F59E0B;
        --emerald: #10B981;
        --black: #0B0F19;
        --text: var(--black);
        --text-2: #64748B;
        --text-3: #94A3B8;
        --bg: #FFFFFF;
        --white: #FFFFFF;
        --radius: 22px;
        --font-h: "Segoe UI Variable Display", "Segoe UI", ui-sans-serif, system-ui, sans-serif;
        --font-b: "Segoe UI Variable Text", "Segoe UI", Roboto, "Noto Sans Bengali", Arial, sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
        touch-action: manipulation;
      }
      body {
        font-family: var(--font-b);
        background: #FFFFFF;
        color: var(--text);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
        overflow-x: clip;
        touch-action: manipulation;
        overscroll-behavior-y: none;
      }
      a, button, input, textarea, select { touch-action: manipulation; }
      a { color: inherit; text-decoration: none; }
      :focus-visible { outline: 3px solid #F59E0B; outline-offset: 3px; }
      img { max-width: 100%; height: auto; display: block; }
      .creavix-translate-engine {
        position: fixed !important;
        width: 1px !important;
        height: 1px !important;
        left: -9999px !important;
        overflow: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
      }
      .goog-te-banner-frame.skiptranslate,
      .goog-te-gadget-icon,
      #goog-gt-tt,
      .goog-te-balloon-frame { display: none !important; }
      body { top: 0 !important; }
      html[data-site-language="bn"] body { font-family: "Hind Siliguri", sans-serif; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body
    class="creavix-brand"
    data-page-profile={pageVisual.profile}
    data-page-kind={pageVisual.kind}
    style={pageVisualStyle}
  >
    <a class="skip-to-content" href="#main-content">Skip to content</a>
    <slot />
    <div id="creavix-translate-engine" class="creavix-translate-engine notranslate" aria-hidden="true"></div>
    <CookieBanner />
    <script is:inline>
      (function () {
        'use strict';
        var STORAGE_KEY = 'creavix-language';
        var SCRIPT_ID = 'creavix-google-translate';
        var desiredLanguage = 'en';

        function readLanguage() {
          try { return localStorage.getItem(STORAGE_KEY) === 'bn' ? 'bn' : 'en'; }
          catch (error) { return 'en'; }
        }

        function rememberLanguage(language) {
          try { localStorage.setItem(STORAGE_KEY, language); } catch (error) {}
        }

        function translateCookieDomains() {
          var host = location.hostname;
          var parts = host.split('.');
          var root = parts.length > 2 ? parts.slice(-2).join('.') : host;
          return ['', host, '.' + host, root, '.' + root].filter(function (domain, index, values) {
            return values.indexOf(domain) === index;
          });
        }

        function setTranslateCookie(value, expires) {
          var suffix = ';path=/;SameSite=Lax' + (expires ? ';expires=' + expires : '');
          translateCookieDomains().forEach(function (domain) {
            document.cookie = 'googtrans=' + value + suffix + (domain ? ';domain=' + domain : '');
          });
        }

        function clearTranslateCookie() {
          var past = 'Thu, 01 Jan 1970 00:00:00 GMT';
          setTranslateCookie('', past);
        }

        function protectNonTranslatableContent() {
          document.querySelectorAll('.hero-premium, .logo, .support-brand, a[href^="tel:"], a[href^="mailto:"], [data-public-rating], .hero-counter').forEach(function (element) {
            element.classList.add('notranslate');
            element.setAttribute('translate', 'no');
          });
        }

        function paintControls(language) {
          document.documentElement.lang = language === 'bn' ? 'bn' : 'en';
          document.documentElement.dataset.siteLanguage = language;
          document.querySelectorAll('[data-language-toggle]').forEach(function (button) {
            button.dataset.activeLanguage = language;
            button.setAttribute('aria-pressed', language === 'bn' ? 'true' : 'false');
            button.setAttribute('aria-label', language === 'bn' ? 'Switch website to English' : 'ওয়েবসাইট বাংলায় পড়ুন');
          });
        }

        function applyBengali() {
          var combo = document.querySelector('.goog-te-combo');
          if (!combo) {
            window.setTimeout(applyBengali, 80);
            return;
          }
          if (combo.value !== 'bn') {
            combo.value = 'bn';
            combo.dispatchEvent(new Event('change'));
          }
        }

        window.creavixGoogleTranslateInit = function () {
          if (!window.google || !window.google.translate) return;
          new window.google.translate.TranslateElement({
            pageLanguage: 'en',
            includedLanguages: 'bn',
            autoDisplay: false,
            multilanguagePage: true
          }, 'creavix-translate-engine');
          if (desiredLanguage === 'bn') applyBengali();
        };

        function loadTranslator() {
          if (document.getElementById(SCRIPT_ID)) {
            if (window.google && window.google.translate) window.creavixGoogleTranslateInit();
            return;
          }
          var script = document.createElement('script');
          script.id = SCRIPT_ID;
          script.src = 'https://translate.google.com/translate_a/element.js?cb=creavixGoogleTranslateInit';
          script.async = true;
          script.defer = true;
          document.head.appendChild(script);
        }

        window.creavixSetLanguage = function (language) {
          desiredLanguage = language === 'bn' ? 'bn' : 'en';
          rememberLanguage(desiredLanguage);
          paintControls(desiredLanguage);
          protectNonTranslatableContent();
          if (desiredLanguage === 'bn') {
            setTranslateCookie('/en/bn');
            loadTranslator();
          } else {
            clearTranslateCookie();
            location.reload();
          }
        };

        desiredLanguage = readLanguage();
        protectNonTranslatableContent();
        paintControls(desiredLanguage);
        document.addEventListener('click', function (event) {
          var button = event.target.closest('[data-language-toggle]');
          if (!button) return;
          event.preventDefault();
          window.creavixSetLanguage(readLanguage() === 'bn' ? 'en' : 'bn');
        });
        if (desiredLanguage === 'bn') {
          setTranslateCookie('/en/bn');
          if ('requestIdleCallback' in window) requestIdleCallback(loadTranslator, { timeout: 1200 });
          else setTimeout(loadTranslator, 250);
        } else {
          /* Pre-warm after the critical render so the first Bangla tap feels immediate. */
          if ('requestIdleCallback' in window) requestIdleCallback(loadTranslator, { timeout: 3500 });
          else setTimeout(loadTranslator, 2200);
        }
      })();
    </script>
    <script is:inline>
      (function () {
        'use strict';
        try {
          var nav = document.getElementById('navbar');
          var ticking = false;
          function onScroll() {
            if (!nav) return;
            if (window.scrollY > 20) nav.classList.add('scrolled');
            else nav.classList.remove('scrolled');
            ticking = false;
          }
          window.addEventListener('scroll', function () {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(onScroll);
            }
          }, { passive: true });
          onScroll();
        } catch (err) {}
      })();
    </script>
  </body>
</html>
