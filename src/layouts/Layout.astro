---
import CookieBanner from '../components/CookieBanner.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = SITE.seoTitle,
  description = SITE.seoDescription,
} = Astro.props;

const canonical = Astro.url.href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.brand,
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  description: SITE.seoDescription,
  email: SITE.email1,
  telephone: SITE.hotline,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Hemayetpur',
    addressLocality: 'Savar',
    addressRegion: 'Dhaka',
    postalCode: '1340',
    addressCountry: 'BD',
  },
  sameAs: [
    'https://www.facebook.com/CreavixITSolution',
    'https://www.instagram.com/creavixitsolution',
    'https://www.youtube.com/@CreavixiTsolution',
    'https://www.tiktok.com/@creavixitsolution',
    'https://www.linkedin.com/in/creavix-it-solution',
    'https://x.com/creavixit',
  ],
  foundingDate: String(SITE.servingSince),
  founder: { '@type': 'Person', name: SITE.founder.name },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      id="viewport-meta"
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="theme-color" content="#2563EB" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE.seoKeywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={SITE.brand} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/logo.png`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    </noscript>
    <link rel="icon" type="image/png" href="/logo.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script src="/js/perf.js" defer></script>
    <style is:global>
      :root {
        --primary: #2563EB;
        --primary-light: #3B82F6;
        --violet: #1D4ED8;
        --accent: #F59E0B;
        --rose: #F43F5E;
        --amber: #F59E0B;
        --emerald: #10B981;
        --text: #0B0F19;
        --text-2: #64748B;
        --text-3: #94A3B8;
        --bg: #FFFFFF;
        --white: #FFFFFF;
        --radius: 20px;
        --font-h: "Outfit", system-ui, sans-serif;
        --font-b: "Inter", system-ui, sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
        touch-action: manipulation;
      }
      body {
        font-family: var(--font-b);
        background: #FFFFFF;
        color: var(--text);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
        overflow-x: hidden;
        touch-action: manipulation;
        overscroll-behavior-y: none;
      }
      a, button, input, textarea, select { touch-action: manipulation; }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; height: auto; display: block; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }

      .text-gradient { color: #0B0F19; }
      .text-primary { color: var(--primary); }

      .navbar {
        position: fixed;
        top: 36px;
        left: 0;
        right: 0;
        z-index: 100;
        padding: 0.75rem 0;
        background: #fff;
        border-bottom: 1px solid rgba(15, 23, 42, 0.06);
        transition: background .25s, box-shadow .25s;
      }
      .navbar.scrolled {
        background: rgba(255,255,255,.97);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 4px 24px rgba(15,23,42,.06);
      }
      .nav-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        position: relative;
      }
      .logo {
        font-family: var(--font-h);
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--text);
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        z-index: 102;
      }
      .logo-text span { color: #2563EB; }
      .logo-img { width: 36px; height: 36px; object-fit: contain; border-radius: 8px; flex-shrink: 0; }

      .nav-panel {
        position: fixed; inset: 0; z-index: 101;
        background: #fff;
        opacity: 0; visibility: hidden; pointer-events: none;
        transition: opacity .35s ease, visibility .35s;
      }
      .nav-panel.open { opacity: 1; visibility: visible; pointer-events: auto; }
      .nav-panel-inner {
        display: flex; flex-direction: column; gap: 1.25rem;
        padding: 5.5rem 1.75rem 2.5rem;
        height: 100%; overflow-y: auto;
        -webkit-overflow-scrolling: touch;
      }
      @media (min-width: 768px) {
        .nav-panel {
          position: static; inset: auto; opacity: 1; visibility: visible; pointer-events: auto;
          background: transparent; display: flex; flex: 1; justify-content: flex-end;
        }
        .nav-panel-inner {
          flex-direction: row; align-items: center; gap: 1.25rem;
          padding: 0; height: auto; overflow: visible;
        }
      }

      .nav-links { list-style: none; display: flex; flex-direction: column; gap: .15rem; width: 100%; }
      @media (min-width: 768px) {
        .nav-links { flex-direction: row; align-items: center; gap: 1.35rem; width: auto; }
      }

      .nav-links > li > a, .nav-drop-btn {
        color: var(--text); font-size: 1.3rem; font-weight: 600; font-family: var(--font-h);
        background: none; border: none; cursor: pointer;
        display: block; padding: .85rem 0; width: 100%; text-align: left;
      }
      @media (min-width: 768px) {
        .nav-links > li > a, .nav-drop-btn {
          color: #475569; font-size: .9rem; font-weight: 500; font-family: var(--font-b);
          padding: .25rem 0; width: auto;
        }
      }
      .nav-links a:hover, .nav-links a.active, .nav-drop-btn:hover, .nav-drop-btn.active {
        color: #2563EB;
      }

      .nav-cta { width: 100%; margin-top: 1rem; text-align: center; }
      @media (min-width: 768px) { .nav-cta { width: auto; margin-top: 0; } }

      .nav-dropdown { position: relative; width: 100%; }
      @media (min-width: 768px) { .nav-dropdown { width: auto; } }
      .nav-drop-btn { display: inline-flex; align-items: center; gap: .35rem; }
      .nav-drop-btn .chevron { transition: transform .3s ease; }
      .nav-drop-btn[aria-expanded="true"] .chevron { transform: rotate(180deg); }

      .nav-dropdown-menu {
        display: grid; grid-template-rows: 0fr;
        transition: grid-template-rows .3s ease;
        padding: 0; margin: 0; border: none;
      }
      .nav-dropdown-menu > * { overflow: hidden; }
      .nav-dropdown-menu.open {
        grid-template-rows: 1fr;
        padding: .35rem 0 .35rem .5rem;
        margin: 0 0 .4rem;
        border-left: 2px solid rgba(37, 99, 235, 0.25);
      }
      .nav-dropdown-menu a {
        display: block; padding: .65rem .85rem; border-radius: 10px;
        font-size: 0.95rem; color: var(--text-2); font-weight: 500;
      }
      .nav-dropdown-menu a:hover { background: rgba(37, 99, 235, 0.08); color: #2563EB; }

      @media (min-width: 768px) {
        .nav-dropdown-menu {
          display: flex; flex-direction: column; gap: .1rem;
          position: absolute; top: calc(100% + 12px); left: 50%;
          min-width: 240px; padding: .55rem; margin: 0; border-left: none; border-radius: 14px;
          background: #fff;
          border: 1px solid rgba(15,23,42,.08); box-shadow: 0 16px 48px rgba(15,23,42,.12);
          opacity: 0; visibility: hidden; pointer-events: none;
          transform: translateX(-50%) translateY(8px);
          transition: opacity .2s ease, transform .25s ease, visibility .2s;
          grid-template-rows: none;
        }
        .nav-dropdown-menu > * { overflow: visible; }
        .nav-dropdown-menu.open {
          opacity: 1; visibility: visible; pointer-events: auto;
          transform: translateX(-50%) translateY(0);
          padding: .55rem; margin: 0; border-left: none;
        }
        .nav-dropdown-menu a { font-size: .875rem; white-space: nowrap; }
      }

      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        padding: .8rem 1.65rem; border-radius: 9999px;
        font-family: var(--font-h); font-weight: 600; font-size: .9rem;
        border: none; cursor: pointer; transition: all .25s ease;
      }
      .btn-primary {
        background: #2563EB; color: #fff;
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.28);
      }
      .btn-primary:hover {
        background: #1D4ED8;
        transform: translateY(-1px);
        box-shadow: 0 10px 28px rgba(37, 99, 235, 0.35);
      }
      .btn-outline {
        background: #0B0F19; color: #fff;
      }
      .btn-outline:hover { background: #1e293b; color: #fff; }
      .flex-btns { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 1.75rem; }

      .glass-card {
        background: #fff;
        border: 1px solid rgba(15,23,42,.08);
        border-radius: var(--radius);
        padding: 1.75rem 1.5rem;
        box-shadow: 0 8px 30px rgba(15,23,42,.05);
        transition: transform .35s ease, box-shadow .35s ease;
      }
      .glass-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 40px rgba(15,23,42,.08);
      }

      .hero-premium {
        position: relative;
        display: flex;
        align-items: center;
        padding: 7.5rem 1.5rem 3.5rem;
        overflow: hidden;
        background: #fff;
      }
      .hero-bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; contain: strict; }
      .orb {
        position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.35;
        animation: orb-float 18s ease-in-out infinite;
      }
      .orb-1 {
        width: 420px; height: 420px;
        background: radial-gradient(circle, rgba(37,99,235,.25) 0%, transparent 70%);
        top: -10%; left: -8%;
      }
      .orb-2 {
        width: 380px; height: 380px;
        background: radial-gradient(circle, rgba(148,163,184,.25) 0%, transparent 70%);
        bottom: -5%; right: -5%; animation-delay: -6s;
      }
      .orb-3 { display: none; }
      @keyframes orb-float {
        0%, 100% { transform: translate(0,0) scale(1); }
        50% { transform: translate(20px,-24px) scale(1.05); }
      }
      .grid-overlay {
        position: absolute; inset: 0;
        background-image:
          linear-gradient(rgba(15,23,42,.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(15,23,42,.03) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(ellipse 75% 65% at 70% 40%, black 15%, transparent 72%);
      }
      .hero-grid {
        display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center;
        position: relative; z-index: 2; max-width: 1200px; margin: 0 auto; width: 100%;
      }
      @media (min-width: 900px) {
        .hero-grid { grid-template-columns: 1.15fr 0.85fr; gap: 2.5rem; }
      }
      .hero-title {
        font-family: var(--font-h);
        font-size: clamp(2.4rem, 6.5vw, 4rem);
        font-weight: 800;
        line-height: 1.02;
        letter-spacing: -0.045em;
        color: #0B0F19;
        margin: 0 0 1.25rem;
      }
      .hero-lead {
        font-size: 1.05rem;
        line-height: 1.7;
        color: #64748B;
        margin: 0 0 0.5rem;
        max-width: 480px;
      }
      .trust-row {
        display: flex; align-items: center; gap: 1.25rem;
        margin-top: 2rem; flex-wrap: wrap;
      }
      .trust-item { display: flex; flex-direction: column; gap: 0.1rem; }
      .trust-item strong {
        font-family: var(--font-h); font-size: 1.3rem; font-weight: 700; color: #0B0F19;
      }
      .trust-item span { font-size: 0.78rem; color: #94A3B8; }
      .trust-divider { width: 1px; height: 28px; background: rgba(15,23,42,.1); }

      .section-soft { background: #F8FAFC; padding: 4rem 1.25rem; }
      .section-violet { background: #fff; padding: 4rem 1.25rem; }
      .section-warm { background: linear-gradient(180deg, #F8FAFC, #fff); padding: 4rem 1.25rem; }
      .container { max-width: 1200px; margin: 0 auto; width: 100%; }
      .grid-2 { display: grid; gap: 2rem; align-items: center; }
      @media (min-width: 1024px) { .grid-2 { grid-template-columns: 1fr 1fr; gap: 3rem; } }
      .grid-3 { display: grid; gap: 1.25rem; }
      @media (min-width: 640px) { .grid-3 { grid-template-columns: 1fr 1fr; } }
      @media (min-width: 1024px) { .grid-3 { grid-template-columns: 1fr 1fr 1fr; } }
      .text-center { text-align: center; }
      .mb-4 { margin-bottom: 1rem; } .mb-6 { margin-bottom: 1.5rem; } .mb-8 { margin-bottom: 2rem; }
      h1 {
        font-family: var(--font-h); font-weight: 800;
        font-size: clamp(2rem, 5vw, 3.25rem);
        line-height: 1.08; letter-spacing: -.03em; color: #0B0F19;
      }
      h2 {
        font-family: var(--font-h); font-weight: 800;
        font-size: clamp(1.5rem, 3.5vw, 2.25rem);
        letter-spacing: -.03em; color: #0B0F19;
      }
      h3 { font-family: var(--font-h); font-weight: 600; font-size: 1.1rem; color: #0B0F19; }
      p { color: #64748B; }
      .lead { font-size: 1.05rem; line-height: 1.7; max-width: 28rem; }
      .eyebrow {
        display: inline-flex; align-items: center; gap: .5rem;
        padding: .4rem 1rem; border-radius: 9999px;
        background: #fff; border: 1px solid rgba(15,23,42,.08);
        color: #2563EB; font-size: .85rem; font-weight: 500;
        box-shadow: 0 1px 4px rgba(0,0,0,.04); margin-bottom: 1.25rem;
      }
      .dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: var(--emerald); animation: pulse 2s ease-in-out infinite;
      }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
      .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.5rem; }

      .site-footer { background: #0B0F19; color: #94A3B8; padding: 3rem 1.25rem 1.5rem; }
      .footer-grid {
        max-width: 1200px; margin: 0 auto;
        display: grid; gap: 2rem; grid-template-columns: 1fr;
      }
      @media (min-width: 640px) { .footer-grid { grid-template-columns: 1.4fr 1fr 1fr; } }
      @media (min-width: 900px) { .footer-grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; } }
      .footer-brand .logo { color: #fff; margin-bottom: 1rem; }
      .footer-brand .logo span, .footer-brand .logo-text span { color: #3B82F6; }
      .footer-desc { font-size: .9rem; line-height: 1.6; max-width: 280px; color: #94A3B8; }
      .footer-col h4 {
        font-family: var(--font-h); font-size: .85rem; font-weight: 600;
        color: #fff; margin-bottom: 1rem;
      }
      .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: .55rem; }
      .footer-col a { font-size: .875rem; color: #94A3B8; transition: color .2s; }
      .footer-col a:hover { color: #fff; }
      .footer-bottom {
        max-width: 1200px; margin: 2.5rem auto 0; padding-top: 1.5rem;
        border-top: 1px solid rgba(148,163,184,.15);
        display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; font-size: .8rem;
      }
      .footer-links { display: flex; gap: 1.25rem; }
      .footer-links a:hover { color: #fff; }

      .reveal {
        opacity: 0; transform: translateY(24px);
        transition: opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1);
      }
      .reveal.visible { opacity: 1; transform: translateY(0); }

      @media (max-width: 899px) {
        .hero-premium { padding: 6rem 1.25rem 3rem; }
        .flex-btns .btn { flex: 1 1 auto; min-width: 140px; }
      }
      @media (max-width: 767px) {
        .navbar { top: 32px; }
        .orb { filter: blur(28px); opacity: 0.18; animation: none; }
      }
    </style>
  </head>
  <body>
    <slot />
    <CookieBanner />
    <script is:inline>
      (function () {
        'use strict';
        try {
          var reveals = document.querySelectorAll('.reveal');
          if (reveals.length && 'IntersectionObserver' in window) {
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add('visible');
                  io.unobserve(e.target);
                }
              });
            }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
            reveals.forEach(function (el) { io.observe(el); });
          } else {
            reveals.forEach(function (el) { el.classList.add('visible'); });
          }
          var nav = document.getElementById('navbar');
          var ticking = false;
          function onScroll() {
            if (!nav) return;
            if (window.scrollY > 20) nav.classList.add('scrolled');
            else nav.classList.remove('scrolled');
            ticking = false;
          }
          window.addEventListener('scroll', function () {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(onScroll);
            }
          }, { passive: true });
          onScroll();
        } catch (err) {}
      })();
    </script>
  </body>
</html>
