---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { news } from '../../data/news';
export function getStaticPaths() { return news.map(item => ({params:{slug:item.slug},props:{item}})); }
const { item } = Astro.props;
const published = new Intl.DateTimeFormat('bn-BD',{dateStyle:'long',timeStyle:'short',timeZone:'Asia/Dhaka'}).format(new Date(item.publishedAt));
const updated = new Intl.DateTimeFormat('bn-BD',{dateStyle:'long',timeStyle:'short',timeZone:'Asia/Dhaka'}).format(new Date(item.updatedAt));
const related = news.filter(n => n.slug !== item.slug && (n.category === item.category || n.district === item.district)).slice(0,3);
const schema = {'@context':'https://schema.org','@type':'NewsArticle',headline:item.title,image:[new URL(item.image,Astro.url.origin).href],datePublished:item.publishedAt,dateModified:item.updatedAt,author:{'@type':'Person',name:item.author},publisher:{'@type':'NewsMediaOrganization',name:'দৈনিক নিউজ',logo:{'@type':'ImageObject',url:new URL('/logo.png',Astro.url.origin).href}}};
---
<Layout title={`${item.title} | দৈনিক নিউজ`} description={item.excerpt} image={item.image} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="container article-shell"><article class="article"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">প্রচ্ছদ</a><span>›</span><a href={`/archive/?category=${item.category}`}>{item.category}</a></nav><div class="article-category">{item.category} · {item.district}</div><h1 data-bn={item.title} data-en={item.titleEn}>{item.title}</h1><p class="standfirst" data-bn={item.excerpt} data-en={item.excerptEn}>{item.excerpt}</p><div class="byline"><strong>{item.author}</strong><span>প্রকাশ: {published}</span><span>আপডেট: {updated}</span></div><img class="article-image" src={item.image} alt="" width="1600" height="1067" /><div class="article-content">{item.content.map(p => <p>{p}</p>)}</div><div class="article-note">সম্পাদকীয় নোট: এটি প্রাথমিক ডেমো কনটেন্ট। বাস্তব সংবাদ প্রকাশের আগে তথ্য, উৎস ও ছবি যাচাই করা হবে।</div></article><aside class="article-aside"><h2>সম্পর্কিত সংবাদ</h2>{related.map(n => <NewsCard item={n} compact />)}</aside></div>
</Layout>
