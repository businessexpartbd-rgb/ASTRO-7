  .site-hero-mini { min-height: 70px; border-radius: 8px; padding: 10px; display: flex; flex-direction: column; align-items: flex-start; background: linear-gradient(135deg, #eff6ff, #dbeafe); overflow: hidden; }
  .site-hero-mini span { font-size: .38rem; color: #2563eb; font-weight: 800; text-transform: uppercase; }
  .site-hero-mini strong { margin-top: 3px; font-size: .68rem; line-height: 1.1; color: #0f172a; }
  .site-hero-mini i { width: 34px; height: 8px; margin-top: 7px; border-radius: 8px; background: #2563eb; }
  .site-proof { margin: 7px 0; padding: 6px; display: grid; grid-template-columns: auto 1fr auto 1fr; gap: 3px; align-items: center; border: 1px solid #e2e8f0; border-radius: 6px; }
