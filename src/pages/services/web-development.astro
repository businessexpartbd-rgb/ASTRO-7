  .browser-base {
    width: 92%;
    height: 10px;
    margin: 0 auto;
    border-radius: 0 0 9px 9px;
    background: linear-gradient(#94a3b8,#475569);
    box-shadow: 0 6px 12px rgba(15,23,42,.14);
