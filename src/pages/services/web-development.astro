  .preview-url { display: none; height: 17px; align-items: center; gap: 5px; margin-bottom: 5px; padding: 0 7px; border-radius: 5px; background: #111c30; color: #94a3b8; font-size: .48rem; white-space: nowrap; overflow: hidden; }
  .preview-url span { width: 5px; height: 5px; border-radius: 50%; background: #34d399; flex: none; }
