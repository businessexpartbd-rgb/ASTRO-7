  .code-head b { color: #4ade80; font-weight: 700; }
  .code-stream { height: 242px; overflow: hidden; mask-image: linear-gradient(#000 82%, transparent); }
  .code-stream pre { margin: 0; font: 500 .54rem/1.55 ui-monospace, SFMono-Regular, Menlo, monospace; white-space: pre-wrap; color: #dbeafe; animation: builderCode 6s ease-in-out infinite alternate; }
  .builder-code .k { color: #c084fc; }
