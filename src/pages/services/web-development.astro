  .preview-base { height: 0; overflow: hidden; margin: 0 auto; width: 92%; border-radius: 0 0 8px 8px; background: linear-gradient(#94a3b8, #475569); transition: height .3s; }
  .wd-builder[data-mode="laptop"] .preview-base { height: 10px; }
