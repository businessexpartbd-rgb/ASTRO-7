    display: flex; align-items: center; gap: 0.55rem;
  }
  .wd-ico {
    width: 28px; height: 28px; border-radius: 8px;
    display: grid; place-items: center; font-size: 0.85rem; font-weight: 800;
  }
  .wd-ico.ok { background: #DCFCE7; color: #16A34A; }
  .wd-ico.warn { background: #FEF3C7; color: #D97706; }
  .wd-ico.bad { background: #FEE2E2; color: #DC2626; }
  .wd-body { margin: 0; color: #475569; line-height: 1.7; font-size: 1rem; }
  .wd-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.65rem; }
  .wd-list li {
    position: relative; padding-left: 1.1rem; color: #475569; line-height: 1.55;
  }
  .wd-list li::before {
