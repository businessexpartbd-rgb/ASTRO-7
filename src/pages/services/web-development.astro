  .browser-base i { display: block; width: 25%; height: 3px; margin: auto; border-radius: 0 0 4px 4px; background: #334155; }

  .website-flow {
    min-height: 190%;
    padding: 8px;
    background: linear-gradient(#fff,#f8fbff);
    animation: websiteFlow 6s ease-in-out infinite;
  }
  .mini-nav { display: flex; align-items: center; gap: 5px; height: 16px; margin-bottom: 8px; }
  .mini-nav strong { display: grid; place-items: center; width: 15px; height: 15px; border-radius: 4px; color: #fff; background: linear-gradient(135deg,var(--sp-orange),var(--sp-blue)); font-size: .4rem; }
  .mini-nav span { width: 15px; height: 3px; border-radius: 4px; background: #cbd5e1; }
  .mini-nav span:first-of-type { margin-left: auto; }
  .mini-nav i { width: 22px; height: 7px; border-radius: 99px; background: #0f2b46; }

  .mini-hero {
    position: relative;
    min-height: 92px;
    overflow: hidden;
    padding: 12px;
    border-radius: 10px;
    background:
      radial-gradient(circle at 78% 30%,rgba(37,99,235,.2),transparent 34%),
      linear-gradient(135deg,#fff7ed,#eff6ff 52%,#f5f3ff);
  }
  .mini-hero small { color: var(--sp-orange); font-size: .34rem; font-weight: 900; letter-spacing: .12em; }
  .mini-hero h2 { position: relative; z-index: 2; margin: 4px 0 5px; color: #0f172a; font: 800 .82rem/1.02 var(--font-h),sans-serif; }
  .mini-hero p { width: 44%; height: 3px; margin: 3px 0; border-radius: 3px; background: #cbd5e1; }
  .mini-hero .mini-cta { display: inline-block; margin-top: 6px; padding: 4px 8px; border-radius: 99px; color: #fff; background: #0f2b46; font-size: .34rem; font-weight: 800; }
  .mini-art { position: absolute; right: 9px; top: 12px; width: 40%; height: 68px; }
  .mini-art i { position: absolute; border-radius: 50%; background: linear-gradient(135deg,var(--sp-blue),var(--sp-purple)); box-shadow: 0 7px 16px rgba(37,99,235,.2); }
  .mini-art i:nth-child(1) { width: 48px; height: 48px; right: 2px; top: 2px; }
  .mini-art i:nth-child(2) { width: 28px; height: 28px; left: 4px; bottom: 0; background: linear-gradient(135deg,var(--sp-orange),#fb7185); }
  .mini-art i:nth-child(3) { width: 13px; height: 13px; left: 25px; top: 2px; background: var(--sp-green); }

  .mini-proof { display: grid; grid-template-columns: repeat(3,1fr); gap: 4px; margin: 7px 0; }
  .mini-proof span { display: grid; padding: 5px; border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; }
  .mini-proof b { color: var(--sp-blue); font-size: .52rem; }
  .mini-proof small { color: #64748b; font-size: .29rem; }
  .mini-heading { margin: 8px 0 5px; }
  .mini-heading b,.mini-heading i { display: block; height: 4px; border-radius: 4px; background: #1e293b; }
  .mini-heading b { width: 36%; }
  .mini-heading i { width: 62%; height: 3px; margin-top: 4px; background: #cbd5e1; }
  .mini-cards,.mini-gallery { display: grid; grid-template-columns: repeat(3,1fr); gap: 5px; }
  .mini-cards article { height: 46px; border: 1px solid #dbeafe; border-radius: 7px; background: #fff; box-shadow: 0 4px 10px rgba(37,99,235,.08); }
  .mini-cards article:nth-child(2) { background: linear-gradient(145deg,#eff6ff,#fff); }
  .mini-banner { display: grid; place-items: center; height: 54px; margin-top: 8px; border-radius: 8px; background: linear-gradient(135deg,#1d4ed8,#06b6d4); }
  .mini-banner b { width: 44%; height: 4px; border-radius: 4px; background: #fff; }
  .mini-banner i { width: 28%; height: 8px; margin-top: 5px; border-radius: 8px; background: var(--sp-orange); }
  .mini-gallery { grid-template-columns: repeat(2,1fr); }
  .mini-gallery i { height: 42px; border-radius: 6px; background: linear-gradient(145deg,#dbeafe,#bfdbfe); }

  .spatial-footer {
    min-height: 58px;
    padding: 9px 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 7px 13px;
    border-top: 1px solid rgba(15,23,42,.07);
    background: rgba(255,255,255,.9);
  }
  .spatial-footer span { display: flex; align-items: center; gap: 5px; color: #64748b; font-size: .52rem; font-weight: 800; }
  .spatial-footer i { width: 6px; height: 6px; border-radius: 50%; }
  .dot-html { background: var(--sp-orange); }
  .dot-css { background: var(--sp-blue); }
  .dot-seo { background: var(--sp-green); }
  .dot-edge { background: var(--sp-purple); }

  .spatial-metric {
    position: absolute;
    z-index: 6;
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .5rem .66rem;
    border: 1px solid rgba(255,255,255,.78);
    border-radius: 17px 17px 17px 7px;
    background: linear-gradient(135deg,rgba(255,255,255,.84),rgba(255,255,255,.52));
    box-shadow: 0 16px 34px rgba(15,23,42,.12),inset 0 1px 0 #fff;
    backdrop-filter: blur(12px) saturate(1.18);
    -webkit-backdrop-filter: blur(12px) saturate(1.18);
    animation: metricFloat 4s ease-in-out infinite alternate;
  }
  .spatial-metric > span:last-child { display: grid; line-height: 1.05; }
  .spatial-metric small { color: #94a3b8; font-size: .39rem; font-weight: 900; letter-spacing: .1em; }
  .spatial-metric strong { margin-top: .18rem; color: #0f172a; font-size: .56rem; white-space: nowrap; }
  .metric-speed { left: -.5%; top: 20%; }
  .metric-responsive { right: -1%; bottom: 14%; animation-delay: -2s; }

  .metric-ring {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    border-radius: 50%;
    background: conic-gradient(var(--sp-green) 0 99%,#e2e8f0 99%);
    box-shadow: 0 7px 18px rgba(16,185,129,.2);
  }
  .metric-ring::before { content: ''; grid-area: 1/1; width: 25px; height: 25px; border-radius: 50%; background: #fff; }
  .metric-ring b { grid-area: 1/1; z-index: 1; color: #15803d; font-size: .58rem; }

  .device-stack { position: relative; width: 34px; height: 28px; flex: 0 0 34px; }
  .device-stack i { position: absolute; bottom: 1px; border: 2px solid var(--sp-blue); background: rgba(239,246,255,.9); }
  .device-stack i:nth-child(1) { left: 0; width: 12px; height: 21px; border-radius: 4px; }
  .device-stack i:nth-child(2) { left: 10px; width: 18px; height: 25px; border-radius: 4px; border-color: var(--sp-purple); }
  .device-stack i:nth-child(3) { right: 0; width: 21px; height: 15px; border-radius: 3px; border-color: var(--sp-orange); }

  .spatial-pulse {
    position: absolute;
    z-index: 1;
    inset: 4% 0 4%;
    border: 1px solid rgba(37,99,235,.14);
    border-radius: 50%;
    pointer-events: none;
    animation: pulseOrbit 7s linear infinite;
  }
  .spatial-pulse::after {
    content: '';
    position: absolute;
    left: 12%;
    top: 6%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sp-cyan);
    box-shadow: 0 0 0 6px rgba(6,182,212,.1),0 0 18px rgba(6,182,212,.7);
  }

  .spatial-paused * { animation-play-state: paused !important; }
  .spatial-ready .spatial-canvas,.spatial-ready .spatial-metric { opacity: 0; }
  .spatial-ready.spatial-visible .spatial-canvas { animation: spatialReveal .7s cubic-bezier(.16,1,.3,1) both, spatialFloat 5.5s .7s ease-in-out infinite alternate; }
  .spatial-ready.spatial-visible .spatial-metric { animation: metricReveal .55s cubic-bezier(.16,1,.3,1) both; }
  .spatial-ready.spatial-visible .metric-speed { animation-delay: .16s; }
  .spatial-ready.spatial-visible .metric-responsive { animation-delay: .27s; }

  @keyframes spatialAura { to { transform: translate3d(5%,-4%,0) scale(1.09); } }
  @keyframes spatialFloat { to { transform: translate3d(0,-7px,0) rotateY(1.5deg) rotateX(-.4deg); } }
  @keyframes buildPulse { 50% { opacity: .35; transform: scale(.72); } }
  @keyframes codeDrift { to { transform: translateY(-28px); } }
  @keyframes compileTravel { from { transform: translateX(-115%); } to { transform: translateX(390%); } }
  @keyframes browserHover { to { transform: translate3d(0,-6px,0); } }
  @keyframes websiteFlow { 0%,14% { transform: translateY(0); } 82%,100% { transform: translateY(calc(-47% + 12px)); } }
  @keyframes metricFloat { to { transform: translate3d(4px,-7px,0); } }
  @keyframes pulseOrbit { to { transform: rotate(360deg); } }
  @keyframes spatialReveal {
    from { opacity: 0; transform: translate3d(0,24px,0) scale(.96) rotateY(-3deg); }
    to { opacity: 1; transform: translate3d(0,0,0) scale(1) rotateY(-2deg) rotateX(.6deg); }
  }
  @keyframes metricReveal {
    from { opacity: 0; transform: translate3d(0,15px,0) scale(.86); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 640px) {
    .wd-spatial-engine { width: min(100%,420px); aspect-ratio: 1 / 1.02; }
    .spatial-canvas {
      inset: 8% 1% 9%;
      border-radius: 22px 44px 26px 50px / 30px 36px 40px 44px;
      transform: none;
      backdrop-filter: blur(7px) saturate(1.1);
      -webkit-backdrop-filter: blur(7px) saturate(1.1);
      animation: none;
    }
    .spatial-kicker { font-size: .45rem; letter-spacing: .08em; }
    .kicker-left { left: 3%; }
    .kicker-right { right: 2%; }
    .spatial-topbar { height: 37px; padding: 0 10px; }
    .spatial-topbar > strong { font-size: .52rem; }
    .build-state { font-size: .4rem; }
    .spatial-workspace {
      min-height: 300px;
      grid-template-columns: minmax(112px,.62fr) minmax(190px,1.38fr);
      background: linear-gradient(110deg,#08111f 0 34%,#f8fbff 34%);
    }
    .spatial-code { padding: 13px 8px 9px; }
    .spatial-code-head { font-size: .43rem; }
    .spatial-code pre { height: 194px; margin: 9px 0 6px; font-size: .43rem; line-height: 1.5; }
    .spatial-code small { font-size: .39rem; }
    .spatial-preview { padding: 18px 8px; }
    .browser-frame { width: min(98%,230px); animation: none; }
    .browser-screen { height: 205px; }
    .mini-hero { min-height: 78px; padding: 9px; }
    .mini-hero h2 { font-size: .7rem; }
    .mini-art i:nth-child(1) { width: 40px; height: 40px; }
    .spatial-footer { min-height: 48px; padding: 7px; gap: 5px 9px; }
    .spatial-footer span { font-size: .42rem; }
    .spatial-footer span:nth-child(n+4) { display: none; }

    .spatial-metric {
      padding: .36rem .46rem;
      gap: .34rem;
      border-radius: 13px 13px 13px 6px;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .spatial-metric small { font-size: .31rem; }
