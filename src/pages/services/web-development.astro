<script is:inline>
(function () {
  var root = document.querySelector('[data-device-cycle]');
  if (!root) return;
  var label = document.querySelector('[data-device-label]');
  var order = ['phone', 'tablet', 'laptop'];
  var names = { phone: 'Mobile', tablet: 'Tablet', laptop: 'Desktop' };
  var i = 0;
  var timer = 0;
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function render() {
    root.setAttribute('data-mode', order[i]);
    if (label) label.textContent = names[order[i]];
  }
  function next() {
    i = (i + 1) % order.length;
    render();
  }
  function start() {
    if (reduced || timer || document.hidden) return;
    timer = window.setInterval(next, 2000);
  }
  function stop() {
    if (!timer) return;
    window.clearInterval(timer);
    timer = 0;
  }

  render();
  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      if (entries[0] && entries[0].isIntersecting) start();
      else stop();
    }, { threshold: 0.12 });
    observer.observe(root);
  } else {
    start();
  }
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stop();
    else start();
  });
})();
</script>
