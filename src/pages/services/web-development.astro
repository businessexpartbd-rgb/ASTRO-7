<script is:inline>
(function () {
  var root = document.querySelector('[data-device-cycle]');
  if (!root) return;
  var frames = root.querySelectorAll('[data-frame]');
  var label = document.querySelector('[data-device-label]');
  var names = { laptop: 'Desktop', tablet: 'Tablet', phone: 'Mobile' };
  var order = ['laptop', 'tablet', 'phone'];
  var i = 0;
  setInterval(function () {
    frames.forEach(function (f) { f.classList.remove('is-active'); });
    i = (i + 1) % order.length;
    var next = root.querySelector('[data-frame="' + order[i] + '"]');
    if (next) next.classList.add('is-active');
    if (label) label.textContent = names[order[i]] || 'Preview';
  }, 2800);
})();
</script>
