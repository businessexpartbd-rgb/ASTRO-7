---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../data/site';

/** Official brand marks via Simple Icons CDN */
const platformsTop = [
  { name: 'WordPress', href: 'https://wordpress.org/', desc: 'CMS & business sites', icon: 'https://cdn.simpleicons.org/wordpress/21759B' },
  { name: 'Next.js', href: 'https://nextjs.org/', desc: 'React full-stack apps', icon: 'https://cdn.simpleicons.org/nextdotjs/000000' },
  { name: 'Astro', href: 'https://astro.build/', desc: 'Ultra-fast static sites', icon: 'https://cdn.simpleicons.org/astro/BC52EE' },
  { name: 'Cloudflare', href: 'https://www.cloudflare.com/', desc: 'Workers, Pages & CDN', icon: 'https://cdn.simpleicons.org/cloudflare/F38020' },
];

const platformsMore = [
  { name: 'React', href: 'https://react.dev/', desc: 'UI library', icon: 'https://cdn.simpleicons.org/react/61DAFB' },
  { name: 'Vue.js', href: 'https://vuejs.org/', desc: 'Progressive framework', icon: 'https://cdn.simpleicons.org/vuedotjs/4FC08D' },
  { name: 'Tailwind CSS', href: 'https://tailwindcss.com/', desc: 'Utility-first CSS', icon: 'https://cdn.simpleicons.org/tailwindcss/06B6D4' },
  { name: 'Node.js', href: 'https://nodejs.org/', desc: 'Server runtime', icon: 'https://cdn.simpleicons.org/nodedotjs/339933' },
  { name: 'Shopify', href: 'https://www.shopify.com/', desc: 'E-commerce', icon: 'https://cdn.simpleicons.org/shopify/7AB55C' },
  { name: 'Webflow', href: 'https://webflow.com/', desc: 'No-code design', icon: 'https://cdn.simpleicons.org/webflow/4353FF' },
];

const domains = [
  { name: 'Cloudflare Registrar', href: 'https://www.cloudflare.com/products/registrar/', desc: 'At-cost domains + DNS', icon: 'https://cdn.simpleicons.org/cloudflare/F38020' },
  { name: 'Namecheap', href: 'https://www.namecheap.com/', desc: 'Popular & affordable', letter: 'N', color: '#FF6C2C' },
  { name: 'GoDaddy', href: 'https://www.godaddy.com/', desc: 'Global domain leader', letter: 'G', color: '#1BDBDB' },
  { name: 'Porkbun', href: 'https://porkbun.com/', desc: 'Cheap + free WHOIS', letter: 'P', color: '#F7931A' },
  { name: 'Name.com', href: 'https://www.name.com/', desc: 'Easy management', letter: 'n', color: '#1A73E8' },
  { name: 'Squarespace Domains', href: 'https://domains.squarespace.com/', desc: 'Simple managed domains', letter: 'S', color: '#000000' },
];

const challenges = [
  'Building sites that stay fast under real traffic and Core Web Vitals pressure',
  'Keeping design premium while remaining fully mobile-responsive',
  'Structuring content and metadata for sustainable SEO growth',
  'Secure forms, auth flows and third-party integrations without bloat',
];

const problems = [
  'Slow shared hosting and unoptimized images killing conversions',
  'Template sites that look the same as every competitor',
  'No clear information architecture or conversion path',
  'Missing analytics, tracking and post-launch support',
];

const workflow = [
  { t: 'Discovery', d: 'Goals, audience, competitors, brand assets and technical constraints mapped in a short kickoff.' },
  { t: 'Architecture', d: 'Sitemap, wireframes, stack choice (Astro / Next / WordPress) and hosting plan locked.' },
  { t: 'Design & Build', d: 'UI system, responsive pages, CMS/content model, forms and performance budget applied.' },
  { t: 'QA & Launch', d: 'Cross-device tests, SEO checks, analytics, SSL, DNS and production deploy.' },
  { t: 'Optimize', d: 'Speed tuning, search console, conversion tweaks and optional ongoing care.' },
];

const solutions = [
  { t: 'Performance-first builds', d: 'Static where possible, edge delivery via Cloudflare, image optimization and clean code.' },
  { t: 'Conversion-focused UI', d: 'Clear hierarchy, trust signals, sticky CTAs and WhatsApp/contact paths that convert.' },
  { t: 'SEO foundations', d: 'Semantic HTML, meta, schema, sitemap, robots and Core Web Vitals friendly structure.' },
  { t: 'Maintainable stack', d: 'Documented components, easy content updates and scalable hosting choices.' },
];

const floatIcons = [
  { label: 'HTML5', color: '#E34F26' },
  { label: 'CSS3', color: '#1572B6' },
  { label: 'JS', color: '#F7DF1E' },
  { label: 'SEO', color: '#10B981' },
  { label: 'API', color: '#8B5CF6' },
  { label: 'SSL', color: '#3B82F6' },
];
---
<Layout
  title="Web Development Agency Bangladesh | Premium Sites — Creavix iT"
  description="Professional website development in Bangladesh by Creavix iT Solution — fast Astro, Next.js & WordPress builds, SEO-ready, mobile-first and conversion focused."
>
  <TopBar />
  <Nav active="services" />

  <!-- HERO -->
  <section class="wd-hero">
    <div class="container wd-hero-grid">
      <div class="wd-hero-copy">
        <div class="wd-badge">
          <span class="wd-badge-dot"></span>
          Web Development · Creavix iT
        </div>
        <h1 class="wd-title">
          High-Performance Websites Built to Rank, Load Fast &amp; Convert
        </h1>
        <p class="wd-lead">
          From brand sites and landing pages to business portals — we design and ship modern,
          SEO-ready websites with premium UI, mobile-first layouts and edge-speed delivery.
        </p>
        <div class="wd-meta">
          <div><span>Focus</span>Business &amp; Agency Sites</div>
          <div><span>Stack</span>Astro · Next · WordPress</div>
          <div><span>Delivery</span>Staging + Production</div>
        </div>
        <div class="wd-actions">
          <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Start on WhatsApp</a>
          <a class="btn btn-outline" href="/contact">Request a quote</a>
        </div>
      </div>

      <div class="wd-device-wrap" aria-hidden="true">
        <!-- floating web-dev icons -->
        <div class="float-ring">
          {floatIcons.map((f, i) => (
            <span class={`float-ico f${i}`} style={`--c:${f.color}`}>{f.label}</span>
          ))}
        </div>

        <div class="wd-device" data-device-cycle>
          <!-- LAPTOP -->
          <div class="frame frame-laptop is-active" data-frame="laptop">
            <div class="bezel">
              <div class="chrome">
                <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
                <div class="url">demo.creavixit.com</div>
              </div>
              <div class="screen dual">
                <div class="pane code-pane">
                  <div class="code-scroll">
                    <pre><code><span class="k">const</span> <span class="v">site</span> = <span class="s">"Creavix"</span>
<span class="k">export</span> <span class="k">default</span> <span class="f">build</span>() {'{'}
  <span class="k">return</span> <span class="s">&lt;Hero /&gt;</span>
{'}'}
<span class="c">// SEO + speed ready</span>
<span class="k">import</span> <span class="v">Layout</span>
<span class="v">performance</span>.<span class="f">score</span> = <span class="n">98</span>
<span class="k">async</span> <span class="k">function</span> <span class="f">deploy</span>() {'{'}
  <span class="k">await</span> <span class="f">edge</span>()
{'}'}
<span class="c">/* mobile first */</span>
<span class="v">css</span>.<span class="f">optimize</span>()
<span class="k">const</span> <span class="v">rank</span> = <span class="s">"page-1"</span></code></pre>
                    <pre aria-hidden="true"><code><span class="k">const</span> <span class="v">site</span> = <span class="s">"Creavix"</span>
<span class="k">export</span> <span class="k">default</span> <span class="f">build</span>() {'{'}
  <span class="k">return</span> <span class="s">&lt;Hero /&gt;</span>
{'}'}
<span class="c">// SEO + speed ready</span>
<span class="k">import</span> <span class="v">Layout</span>
<span class="v">performance</span>.<span class="f">score</span> = <span class="n">98</span>
<span class="k">async</span> <span class="k">function</span> <span class="f">deploy</span>() {'{'}
  <span class="k">await</span> <span class="f">edge</span>()
{'}'}
<span class="c">/* mobile first */</span>
<span class="v">css</span>.<span class="f">optimize</span>()
<span class="k">const</span> <span class="v">rank</span> = <span class="s">"page-1"</span></code></pre>
                  </div>
                </div>
                <div class="pane demo-pane">
                  <div class="demo-scroll">
                    <div class="demo-page">
                      <div class="d-nav"></div>
                      <div class="d-hero"></div>
                      <div class="d-line"></div>
                      <div class="d-cards"><i></i><i></i><i></i></div>
                      <div class="d-block"></div>
                      <div class="d-line short"></div>
                      <div class="d-cards"><i></i><i></i></div>
                      <div class="d-cta"></div>
                    </div>
                    <div class="demo-page" aria-hidden="true">
                      <div class="d-nav"></div>
                      <div class="d-hero"></div>
                      <div class="d-line"></div>
                      <div class="d-cards"><i></i><i></i><i></i></div>
                      <div class="d-block"></div>
                      <div class="d-line short"></div>
                      <div class="d-cards"><i></i><i></i></div>
                      <div class="d-cta"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="base"></div>
          </div>

          <!-- TABLET -->
          <div class="frame frame-tablet" data-frame="tablet">
            <div class="bezel">
              <div class="chrome">
                <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
                <div class="url">tablet · demo</div>
              </div>
              <div class="screen dual stacked">
                <div class="pane code-pane">
                  <div class="code-scroll">
                    <pre><code><span class="k">export</span> <span class="k">const</span> <span class="v">meta</span> = {'{'}
  <span class="v">title</span>: <span class="s">"Creavix"</span>,
  <span class="v">seo</span>: <span class="k">true</span>
{'}'}
<span class="c">// responsive grid</span>
<span class="v">layout</span> = <span class="s">"fluid"</span>
<span class="f">render</span>(<span class="v">page</span>)</code></pre>
                    <pre aria-hidden="true"><code><span class="k">export</span> <span class="k">const</span> <span class="v">meta</span> = {'{'}
  <span class="v">title</span>: <span class="s">"Creavix"</span>,
  <span class="v">seo</span>: <span class="k">true</span>
{'}'}
<span class="c">// responsive grid</span>
<span class="v">layout</span> = <span class="s">"fluid"</span>
<span class="f">render</span>(<span class="v">page</span>)</code></pre>
                  </div>
                </div>
                <div class="pane demo-pane">
                  <div class="demo-scroll">
                    <div class="demo-page">
                      <div class="d-nav"></div>
                      <div class="d-hero"></div>
                      <div class="d-cards tall"><i></i><i></i></div>
                      <div class="d-cta"></div>
                    </div>
                    <div class="demo-page" aria-hidden="true">
                      <div class="d-nav"></div>
                      <div class="d-hero"></div>
                      <div class="d-cards tall"><i></i><i></i></div>
                      <div class="d-cta"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- PHONE -->
          <div class="frame frame-phone" data-frame="phone">
            <div class="bezel">
              <div class="notch"></div>
              <div class="screen dual stacked">
                <div class="pane code-pane slim">
                  <div class="code-scroll">
                    <pre><code><span class="k">@media</span> <span class="s">mobile</span>
  <span class="v">grid</span>: <span class="n">1</span>
<span class="f">fast</span>()
<span class="c">// touch UI</span>
<span class="v">cta</span>.<span class="f">sticky</span>()</code></pre>
                    <pre aria-hidden="true"><code><span class="k">@media</span> <span class="s">mobile</span>
  <span class="v">grid</span>: <span class="n">1</span>
<span class="f">fast</span>()
<span class="c">// touch UI</span>
<span class="v">cta</span>.<span class="f">sticky</span>()</code></pre>
                  </div>
                </div>
                <div class="pane demo-pane">
                  <div class="demo-scroll">
                    <div class="demo-page">
                      <div class="d-nav"></div>
                      <div class="d-hero short"></div>
                      <div class="d-cards phone"><i></i><i></i><i></i></div>
                      <div class="d-cta"></div>
                    </div>
                    <div class="demo-page" aria-hidden="true">
                      <div class="d-nav"></div>
                      <div class="d-hero short"></div>
                      <div class="d-cards phone"><i></i><i></i><i></i></div>
                      <div class="d-cta"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <p class="wd-device-label"><span data-device-label>Desktop</span> · live code + demo scroll</p>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="wd-sec">
    <div class="container wd-split">
      <h2 class="wd-h"><span class="wd-ico ok">✓</span> Project Overview</h2>
      <p class="wd-body">
        Businesses need more than a pretty template. They need a site that represents the brand,
        loads in milliseconds, ranks for real search intent and guides visitors to contact or buy.
        Creavix iT builds production-ready websites — from simple brand pages to multi-page
        service portals — with clean code, strong SEO structure and conversion-minded design.
      </p>
    </div>
  </section>

  <!-- Challenges -->
  <section class="wd-sec alt">
    <div class="container wd-split">
      <h2 class="wd-h"><span class="wd-ico warn">!</span> The Challenges</h2>
      <ul class="wd-list">{challenges.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <!-- Problems + visual -->
  <section class="wd-sec">
    <div class="container">
      <div class="wd-split">
        <h2 class="wd-h"><span class="wd-ico bad">▲</span> The Problems We Solve</h2>
        <ul class="wd-list">{problems.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="viz-row">
        <div class="viz-card dark">
          <div class="viz-lock">
            <svg viewBox="0 0 64 64" width="72" height="72" aria-hidden="true">
              <rect x="14" y="28" width="36" height="28" rx="6" fill="#3B82F6"/>
              <path d="M22 28v-8a10 10 0 0 1 20 0v8" fill="none" stroke="#93C5FD" stroke-width="4"/>
              <circle cx="32" cy="42" r="4" fill="#EFF6FF"/>
            </svg>
          </div>
          <p>Secure · SSL · Forms</p>
        </div>
        <div class="viz-card light">
          <div class="viz-iso">
            <span class="iso a"></span><span class="iso b"></span><span class="iso c"></span>
          </div>
          <p>Modular architecture</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Platforms -->
  <section class="wd-sec alt">
    <div class="container">
      <div class="wd-center">
        <p class="wd-eyebrow">Technology stack</p>
        <h2 class="wd-h2">Platforms we build with</h2>
        <p class="wd-sub">Official logos · each card opens the real website</p>
      </div>
      <div class="plat-grid top">
        {platformsTop.map((p) => (
          <a class="plat-card top" href={p.href} target="_blank" rel="noopener noreferrer">
            <img class="plat-img" src={p.icon} alt="" width="36" height="36" loading="lazy" />
            <div>
              <strong>{p.name}</strong>
              <span>{p.desc}</span>
            </div>
            <span class="plat-go">↗</span>
          </a>
        ))}
      </div>
      <div class="plat-grid more">
        {platformsMore.map((p) => (
          <a class="plat-card" href={p.href} target="_blank" rel="noopener noreferrer">
            <img class="plat-img sm" src={p.icon} alt="" width="28" height="28" loading="lazy" />
            <div>
              <strong>{p.name}</strong>
              <span>{p.desc}</span>
            </div>
            <span class="plat-go">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Domains -->
  <section class="wd-sec">
    <div class="container">
      <div class="wd-center">
        <p class="wd-eyebrow">Domain &amp; DNS</p>
        <h2 class="wd-h2">Trusted places to buy domains</h2>
        <p class="wd-sub">Official links — register and connect with confidence</p>
      </div>
      <div class="plat-grid more">
        {domains.map((d) => (
          <a class="plat-card" href={d.href} target="_blank" rel="noopener noreferrer">
            {d.icon ? (
              <img class="plat-img sm" src={d.icon} alt="" width="28" height="28" loading="lazy" />
            ) : (
              <span class="plat-letter" style={`--c:${d.color}`}>{d.letter}</span>
            )}
            <div>
              <strong>{d.name}</strong>
              <span>{d.desc}</span>
            </div>
            <span class="plat-go">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Workflow -->
  <section class="wd-sec alt">
    <div class="container">
      <div class="wd-center">
        <p class="wd-eyebrow">How we work</p>
        <h2 class="wd-h2">Website delivery workflow</h2>
      </div>
      <ol class="flow">
        {workflow.map((w, i) => (
          <li class="flow-item">
            <span class="flow-n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{w.t}</h3>
              <p>{w.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Solutions -->
  <section class="wd-sec">
    <div class="container">
      <div class="wd-center">
        <p class="wd-eyebrow">Outcomes</p>
        <h2 class="wd-h2">What you get with Creavix</h2>
      </div>
      <div class="sol-grid">
        {solutions.map((s) => (
          <article class="sol-card">
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Conclusion -->
  <section class="wd-sec alt">
    <div class="container wd-split">
      <h2 class="wd-h"><span class="wd-ico ok">✓</span> Conclusion</h2>
      <p class="wd-body">
        A strong website is infrastructure — not decoration. With the right stack, structure and
        performance budget, your brand gains a durable digital asset that supports marketing,
        sales and trust. Creavix iT delivers that asset with clear process and agency-grade quality.
      </p>
    </div>
  </section>

  <section class="wd-cta">
    <div class="container wd-cta-inner">
      <div>
        <p class="wd-eyebrow light">Book a free consultation</p>
        <h2>Let’s build your next website</h2>
        <p>WhatsApp {SITE.whatsapp} · {SITE.email1}</p>
      </div>
      <div class="wd-actions">
        <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
        <a class="btn btn-light" href="/contact">Contact form</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .wd-hero {
    padding: 5.5rem 1.25rem 3.5rem;
    background:
      radial-gradient(ellipse 55% 45% at 85% 15%, rgba(37, 99, 235, 0.1), transparent 60%),
      linear-gradient(180deg, #ffffff, #F7F9FC);
    overflow: hidden;
  }
  .wd-hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .wd-hero-grid { grid-template-columns: 1.05fr 0.95fr; gap: 3rem; }
  }
  .wd-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.35rem 0.85rem; border-radius: 999px;
    background: #fff; border: 1px solid rgba(15,23,42,.08);
    font-size: 0.78rem; font-weight: 600; color: #334155;
    margin-bottom: 1rem; box-shadow: 0 4px 14px rgba(15,23,42,.04);
  }
  .wd-badge-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #22C55E; box-shadow: 0 0 0 3px rgba(34,197,94,.25);
  }
  .wd-title {
    margin: 0 0 1rem;
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.65rem);
    font-weight: 800; line-height: 1.12; letter-spacing: -0.03em; color: #0F172A;
  }
  .wd-lead {
    margin: 0 0 1.35rem; font-size: 1.05rem; line-height: 1.65;
    color: #475569; max-width: 36rem;
  }
  .wd-meta {
    display: grid; grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 0.75rem; margin-bottom: 1.5rem;
  }
  .wd-meta div {
    background: #fff; border: 1px solid rgba(15,23,42,.07);
    border-radius: 12px; padding: 0.7rem 0.85rem;
    font-size: 0.82rem; font-weight: 600; color: #0F172A;
  }
  .wd-meta span {
    display: block; font-size: 0.68rem; font-weight: 600;
    letter-spacing: .04em; text-transform: uppercase; color: #64748B; margin-bottom: .2rem;
  }
  .wd-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; }

  /* Device + floating icons */
  .wd-device-wrap {
    position: relative;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
  }
  @media (max-width: 959px) { .wd-device-wrap { order: -1; } }

  .float-ring {
    position: absolute; inset: -12px -8px;
    pointer-events: none; z-index: 0;
  }
  .float-ico {
    position: absolute;
    padding: 0.35rem 0.55rem;
    border-radius: 8px;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #fff;
    background: var(--c);
    box-shadow: 0 8px 20px rgba(15,23,42,.18);
    animation: floatY 4.5s ease-in-out infinite;
  }
  .f0 { top: 8%; left: 2%; animation-delay: 0s; }
  .f1 { top: 18%; right: 0%; animation-delay: .4s; }
  .f2 { top: 48%; left: -2%; animation-delay: .8s; color: #0F172A; }
  .f3 { bottom: 28%; right: 2%; animation-delay: 1.2s; }
  .f4 { bottom: 12%; left: 8%; animation-delay: 1.6s; }
  .f5 { top: 62%; right: 6%; animation-delay: 2s; }
  @keyframes floatY {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .wd-device {
    position: relative; z-index: 1;
    width: min(440px, 100%); height: 340px;
    display: grid; place-items: center;
  }
  .frame {
    position: absolute;
    opacity: 0;
    transform: scale(0.92) translateY(12px);
    transition: opacity .55s ease, transform .55s cubic-bezier(.16,1,.3,1);
    pointer-events: none;
  }
  .frame.is-active {
    opacity: 1; transform: scale(1) translateY(0); pointer-events: auto;
  }

  .frame-laptop { width: 380px; }
  .frame-laptop .bezel {
    background: #1E293B; border-radius: 14px 14px 6px 6px;
    padding: 10px 10px 6px;
