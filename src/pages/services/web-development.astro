  .wd-spatial-engine {
    --sp-blue: #2563eb;
    --sp-cyan: #06b6d4;
    --sp-orange: #f97316;
    --sp-purple: #7c3aed;
    --sp-green: #10b981;
    position: relative;
    isolation: isolate;
    width: min(100%, 590px);
    aspect-ratio: 1.12 / 1;
    container-type: inline-size;
    contain: layout paint;
    perspective: 1200px;
  }

  .spatial-grid {
    position: absolute;
    inset: 3% 1%;
    z-index: -3;
    border-radius: 42px;
    opacity: .48;
    background-image:
      linear-gradient(rgba(37,99,235,.065) 1px, transparent 1px),
      linear-gradient(90deg, rgba(37,99,235,.065) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 24%, transparent 78%);
    mask-image: radial-gradient(ellipse at center, #000 24%, transparent 78%);
  }

  .spatial-aura {
    position: absolute;
    z-index: -2;
    border-radius: 50%;
    filter: blur(34px);
    pointer-events: none;
  }
  .aura-blue {
    width: 48%;
    aspect-ratio: 1;
    right: 3%;
    top: 11%;
    background: rgba(37,99,235,.18);
    animation: spatialAura 7s ease-in-out infinite alternate;
  }
  .aura-orange {
    width: 34%;
    aspect-ratio: 1;
    left: 8%;
    bottom: 7%;
    background: rgba(249,115,22,.14);
    animation: spatialAura 8s -3s ease-in-out infinite alternate-reverse;
  }

  .spatial-kicker {
    position: absolute;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: .38rem;
    color: #64748b;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .12em;
  }
  .spatial-kicker i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sp-blue);
    box-shadow: 0 0 0 4px rgba(37,99,235,.1), 0 0 12px rgba(37,99,235,.45);
  }
  .kicker-left { left: 5%; top: 1%; }
  .kicker-right { right: 4%; top: 1%; }
  .kicker-right i { background: var(--sp-green); box-shadow: 0 0 0 4px rgba(16,185,129,.1), 0 0 12px rgba(16,185,129,.42); }

  .spatial-canvas {
    position: absolute;
    z-index: 2;
    inset: 7% 3% 8%;
    overflow: hidden;
    border: 1px solid rgba(37,99,235,.14);
    border-radius: 30px 64px 34px 72px / 36px 48px 52px 58px;
    background: rgba(255,255,255,.92);
    box-shadow:
      inset 4px 4px 12px rgba(255,255,255,.96),
      inset -5px -5px 16px rgba(15,23,42,.025),
      0 30px 72px rgba(15,23,42,.12),
      0 12px 28px rgba(37,99,235,.08);
    backdrop-filter: blur(14px) saturate(1.18);
    -webkit-backdrop-filter: blur(14px) saturate(1.18);
    transform: rotateY(-2deg) rotateX(.6deg);
    transform-origin: center;
    animation: spatialFloat 5.5s ease-in-out infinite alternate;
  }

  .spatial-topbar {
    height: 42px;
    padding: 0 14px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid rgba(15,23,42,.07);
    background: rgba(255,255,255,.84);
  }
  .window-dots { display: flex; gap: 5px; }
  .window-dots i { width: 7px; height: 7px; border-radius: 50%; background: #fb7185; }
  .window-dots i:nth-child(2) { background: #fbbf24; }
  .window-dots i:nth-child(3) { background: #34d399; }
  .spatial-topbar > strong { color: #334155; font-size: .62rem; letter-spacing: .04em; }
  .build-state {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 5px;
    color: #15803d;
    font-size: .5rem;
    font-weight: 900;
    letter-spacing: .07em;
  }
  .build-state i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgba(34,197,94,.12);
    animation: buildPulse 1.6s ease-in-out infinite;
  }

  .spatial-workspace {
    min-height: 338px;
    display: grid;
    grid-template-columns: minmax(170px,.76fr) minmax(250px,1.24fr);
    background: linear-gradient(115deg,#08111f 0 37%,#f8fbff 37% 100%);
  }

  .spatial-code {
    min-width: 0;
    padding: 18px 13px 12px;
    overflow: hidden;
    color: #dbeafe;
  }
  .spatial-code-head {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: #94a3b8;
    font: 600 .56rem/1.2 ui-monospace, monospace;
  }
  .spatial-code-head b { color: #4ade80; }
  .spatial-code pre {
    height: 225px;
    margin: 13px 0 8px;
    overflow: hidden;
    color: #dbeafe;
    font: 500 .56rem/1.58 ui-monospace, SFMono-Regular, Menlo, monospace;
    white-space: pre-wrap;
    -webkit-mask-image: linear-gradient(#000 84%,transparent);
    mask-image: linear-gradient(#000 84%,transparent);
  }
  .spatial-code code { display: block; animation: codeDrift 6s ease-in-out infinite alternate; }
  .sc-dim { color: #64748b; }
  .sc-purple { color: #c084fc; }
  .sc-cyan { color: #7dd3fc; }
  .sc-green { color: #86efac; }
  .sc-orange { color: #fb923c; }
  .compile-line { height: 3px; overflow: hidden; border-radius: 99px; background: rgba(148,163,184,.18); }
  .compile-line span {
    display: block;
    width: 34%;
    height: 100%;
