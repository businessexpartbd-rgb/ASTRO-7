  .build-progress { height: 3px; border-radius: 999px; background: rgba(148, 163, 184, .18); overflow: hidden; }
  .build-progress span { display: block; height: 100%; width: 45%; border-radius: inherit; background: linear-gradient(90deg, #22d3ee, #3b82f6); animation: buildLine 2s ease-in-out infinite; }
  @keyframes buildLine { 0% { transform: translateX(-110%); } 100% { transform: translateX(330%); } }
  .builder-code > p { margin: 9px 0 0; display: flex; align-items: center; gap: 6px; font-size: .56rem; color: #86efac; }
  .builder-code > p i { width: 6px; height: 6px; border-radius: 50%; background: #22c55e; }
  .builder-preview { min-width: 0; position: relative; display: grid; place-items: center; padding: 20px 14px; overflow: hidden; }
  .preview-glow { position: absolute; width: 230px; height: 230px; border-radius: 50%; background: rgba(59, 130, 246, .16); filter: blur(35px); }
  .preview-device { --dw: 142px; --dh: 250px; position: relative; z-index: 1; width: var(--dw); transition: width .45s cubic-bezier(.22,1,.36,1); }
  .wd-builder[data-mode="tablet"] .preview-device { --dw: 248px; --dh: 212px; }
