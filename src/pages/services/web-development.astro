  .preview-browser { padding: 7px; border-radius: 22px; background: linear-gradient(160deg, #182336, #07101e); box-shadow: 0 22px 38px rgba(15, 23, 42, .3); transition: border-radius .45s ease, padding .45s ease; }
  .wd-builder[data-mode="tablet"] .preview-browser { border-radius: 14px; padding: 9px; }
  .wd-builder[data-mode="laptop"] .preview-browser { border-radius: 10px 10px 4px 4px; padding: 7px 7px 5px; }
  .preview-camera { width: 34px; height: 7px; margin: 0 auto -12px; border-radius: 999px; background: #020617; position: relative; z-index: 3; top: 10px; transition: opacity .25s; }
