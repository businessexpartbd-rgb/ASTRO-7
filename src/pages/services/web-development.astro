  .builder-footer { min-height: 64px; padding: 9px 12px 10px; display: grid; gap: 8px; border-top: 1px solid rgba(15, 23, 42, .08); background: #fff; }
  .device-tabs { display: flex; justify-content: center; gap: 5px; }
