---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ServiceIcons from '../../components/icons/ServiceIcons.astro';
import { SITE } from '../../data/site';

const platformsTop = [
  { name: 'WordPress', href: 'https://wordpress.org/', desc: 'CMS & business sites', icon: 'https://cdn.simpleicons.org/wordpress/21759B' },
  { name: 'Next.js', href: 'https://nextjs.org/', desc: 'React full-stack apps', icon: 'https://cdn.simpleicons.org/nextdotjs/000000' },
  { name: 'Astro', href: 'https://astro.build/', desc: 'Ultra-fast static sites', icon: 'https://cdn.simpleicons.org/astro/BC52EE' },
  { name: 'Cloudflare', href: 'https://www.cloudflare.com/', desc: 'Workers, Pages & CDN', icon: 'https://cdn.simpleicons.org/cloudflare/F38020' },
];

const platformsMore = [
  { name: 'React', href: 'https://react.dev/', desc: 'UI library', icon: 'https://cdn.simpleicons.org/react/61DAFB' },
  { name: 'Vue.js', href: 'https://vuejs.org/', desc: 'Progressive framework', icon: 'https://cdn.simpleicons.org/vuedotjs/4FC08D' },
  { name: 'Tailwind CSS', href: 'https://tailwindcss.com/', desc: 'Utility-first CSS', icon: 'https://cdn.simpleicons.org/tailwindcss/06B6D4' },
  { name: 'Node.js', href: 'https://nodejs.org/', desc: 'Server runtime', icon: 'https://cdn.simpleicons.org/nodedotjs/339933' },
  { name: 'Shopify', href: 'https://www.shopify.com/', desc: 'E-commerce', icon: 'https://cdn.simpleicons.org/shopify/7AB55C' },
  { name: 'Webflow', href: 'https://webflow.com/', desc: 'No-code design', icon: 'https://cdn.simpleicons.org/webflow/4353FF' },
];

const aiBuilders = [
  { name: 'v0 by Vercel', desc: 'Next.js UI & full-stack apps', icon: '/logos/v0.svg', href: 'https://v0.dev/pricing', tone: '#0b0f19' },
  { name: 'Lovable', desc: 'AI websites & applications', icon: 'https://lovable.dev/favicon.ico', href: 'https://lovable.dev/pricing', tone: '#e11d48' },
  { name: 'Bolt', desc: 'Browser full-stack builder', icon: '/logos/bolt.svg', href: 'https://bolt.new/pricing', tone: '#2563eb' },
  { name: 'Replit Agent', desc: 'Build, test & deploy', icon: '/logos/replit.svg', href: 'https://replit.com/pricing', tone: '#f26207' },
  { name: 'Base44', desc: 'Apps, database & auth', icon: 'https://base44.com/favicon.ico', href: 'https://base44.com/pricing', tone: '#7c3aed' },
  { name: 'Firebase Studio', desc: 'AI prototyping & backend', icon: 'https://firebase.google.com/favicon.ico', href: 'https://firebase.google.com/docs/studio/pricing', tone: '#f59e0b' },
  { name: 'Cursor', desc: 'Agent-assisted coding', icon: '/logos/cursor.svg', href: 'https://cursor.com/pricing', tone: '#0f172a' },
  { name: 'GitHub Copilot', desc: 'Coding, review & agents', icon: 'https://github.com/favicon.ico', href: 'https://github.com/features/copilot/plans', tone: '#2563eb' },
];

const manualEngineering = [
  { icon: 'web', title: 'Architecture', desc: 'Next.js, Astro and clean component systems.' },
  { icon: 'auth', title: 'Security', desc: 'Authentication, roles, validation and safe integrations.' },
  { icon: 'automation', title: 'Backend & Data', desc: 'APIs, databases, business logic and automation.' },
  { icon: 'seo', title: 'SEO & Performance', desc: 'Core Web Vitals, metadata, caching and accessibility.' },
  { icon: 'check', title: 'Manual QA', desc: 'Mobile, tablet and desktop testing before delivery.' },
  { icon: 'rocket', title: 'Production Delivery', desc: 'GitHub workflow, Cloudflare deployment and monitoring.' },
];

const domains = [
  { name: 'Hostinger', href: 'https://www.hostinger.com/domain-name-search', desc: 'Domains + hosting · popular choice', icon: '/logos/hostinger.svg' },
  { name: 'Namecheap', href: 'https://www.namecheap.com/domains/', desc: 'Affordable domains · free WHOIS', icon: '/logos/namecheap.svg' },
  { name: 'Cloudflare', href: 'https://www.cloudflare.com/products/registrar/', desc: 'At-cost domains + free DNS', icon: '/logos/cloudflare.svg' },
  { name: 'GoDaddy', href: 'https://www.godaddy.com/domains', desc: 'Global domain marketplace', icon: '/logos/godaddy.svg' },
  { name: 'Porkbun', href: 'https://porkbun.com/', desc: 'Cheap domains · free privacy', icon: '/logos/porkbun.svg' },
  { name: 'Name.com', href: 'https://www.name.com/domain/search', desc: 'Simple domain management', icon: '/logos/namecom.svg' },
];

const challenges = [
  'Building sites that stay fast under real traffic and Core Web Vitals pressure',
  'Keeping design premium while remaining fully mobile-responsive',
  'Structuring content and metadata for sustainable SEO growth',
  'Secure forms, auth flows and third-party integrations without bloat',
];

const problems = [
  'Slow shared hosting and unoptimized images killing conversions',
  'Template sites that look the same as every competitor',
  'No clear information architecture or conversion path',
  'Missing analytics, tracking and post-launch support',
];

const workflow = [
  { t: 'Discovery', d: 'Goals, audience, competitors, brand assets and technical constraints mapped in a short kickoff.' },
  { t: 'Architecture', d: 'Sitemap, wireframes, stack choice (Astro / Next / WordPress) and hosting plan locked.' },
  { t: 'Design & Build', d: 'UI system, responsive pages, CMS/content model, forms and performance budget applied.' },
  { t: 'QA & Launch', d: 'Cross-device tests, SEO checks, analytics, SSL, DNS and production deploy.' },
  { t: 'Optimize', d: 'Speed tuning, search console, conversion tweaks and optional ongoing care.' },
];

const solutions = [
  { t: 'Performance-first builds', d: 'Static where possible, edge delivery via Cloudflare, image optimization and clean code.' },
  { t: 'Conversion-focused UI', d: 'Clear hierarchy, trust signals, sticky CTAs and WhatsApp/contact paths that convert.' },
  { t: 'SEO foundations', d: 'Semantic HTML, meta, schema, sitemap, robots and Core Web Vitals friendly structure.' },
  { t: 'Maintainable stack', d: 'Documented components, easy content updates and scalable hosting choices.' },
];

const floatIcons = [
  { label: 'HTML5', color: '#E34F26' },
  { label: 'CSS3', color: '#1572B6' },
  { label: 'JS', color: '#F7DF1E' },
  { label: 'SEO', color: '#10B981' },
  { label: 'API', color: '#8B5CF6' },
  { label: 'SSL', color: '#3B82F6' },
];
---
<Layout
  title="Web Development Agency Bangladesh | Premium Sites — Creavix iT"
  description="Professional website development in Bangladesh by Creavix iT Solution — fast Astro, Next.js & WordPress builds, SEO-ready, mobile-first and conversion focused."
>
  <TopBar />
  <Nav active="services" />

  <section class="wd-hero">
    <div class="container wd-hero-grid">
      <div class="wd-hero-copy">
        <div class="wd-badge">
          <span class="wd-badge-dot"></span>
          Web Development · Creavix iT
        </div>
        <h1 class="wd-title">
          High-Performance Websites Built to Rank, Load Fast &amp; Convert
        </h1>
        <p class="wd-lead">
          From brand sites and landing pages to business portals — we design and ship modern,
          SEO-ready websites with premium UI, mobile-first layouts and edge-speed delivery.
        </p>
        <div class="wd-meta">
          <div><span>Focus</span>Business &amp; Agency Sites</div>
          <div><span>Stack</span>Astro · Next · WordPress</div>
          <div><span>Delivery</span>Staging + Production</div>
        </div>
        <div class="wd-actions">
          <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Start on WhatsApp</a>
          <a class="btn btn-outline" href="/contact">Request a quote</a>
        </div>
      </div>

      <div class="wd-device-wrap" aria-hidden="true">
        <div class="wd-builder" data-device-cycle data-mode="phone">
          <div class="builder-bar">
            <span class="builder-dots"><i></i><i></i><i></i></span>
            <span class="builder-title">Creavix Live Builder</span>
            <span class="builder-live"><i></i> Building</span>
          </div>

          <div class="builder-workspace">
            <div class="builder-code">
              <div class="code-head"><span>src/pages/index.astro</span><b>● Live</b></div>
              <div class="code-stream">
                <pre><code><span class="c">// performance-first website</span>
<span class="k">import</span> <span class="v">Layout</span> <span class="k">from</span> <span class="s">'./Layout.astro'</span>

<span class="k">const</span> <span class="v">brand</span> = <span class="s">'Creavix'</span>
<span class="k">const</span> <span class="v">features</span> = [
  <span class="s">'Responsive UI'</span>, <span class="s">'SEO'</span>,
  <span class="s">'Edge Speed'</span>, <span class="s">'Analytics'</span>
]

<span class="k">export</span> <span class="k">default</span> <span class="f">Website</span>() {'{'}
  <span class="k">return</span> <span class="s">&lt;PremiumSite /&gt;</span>
{'}'}

<span class="v">performance</span>.<span class="f">optimize</span>()
<span class="k">await</span> <span class="f">deployToEdge</span>()</code></pre>
              </div>
              <div class="build-progress"><span></span></div>
              <p><i></i> Website generated successfully</p>
            </div>

            <div class="builder-preview">
              <div class="preview-glow"></div>
              <div class="preview-device">
                <div class="preview-camera"></div>
                <div class="preview-browser">
                  <div class="preview-url"><span></span> creavix-demo.pages.dev</div>
                  <div class="site-viewport">
                    <div class="site-scroll">
                      <div class="site-nav"><b>C</b><i></i><i></i><i></i></div>
                      <div class="site-hero-mini">
                        <span>Digital excellence</span><strong>Build faster.<br/>Grow smarter.</strong><i></i>
                      </div>
                      <div class="site-proof"><b>98</b><span>Performance</span><b>100</b><span>SEO Ready</span></div>
                      <div class="site-section-title"><i></i><i></i></div>
                      <div class="site-cards"><article></article><article></article><article></article></div>
                      <div class="site-banner"><i></i><b></b></div>
                      <div class="site-section-title"><i></i><i></i></div>
                      <div class="site-gallery"><i></i><i></i><i></i><i></i></div>
                      <div class="site-cta-mini"><i></i><b></b></div>
                      <div class="site-footer-mini"></div>
                    </div>
                  </div>
                </div>
                <div class="preview-base"><i></i></div>
              </div>
            </div>
          </div>

          <div class="builder-footer">
            <div class="device-tabs">
              <span data-tab="phone" class="active">Mobile</span>
              <span data-tab="tablet">Tablet</span>
              <span data-tab="laptop">Desktop</span>
            </div>
            <div class="builder-features">
              {floatIcons.map((f) => <span><i style={`--c:${f.color}`}></i>{f.label}</span>)}
            </div>
          </div>
        </div>
        <p class="wd-device-label"><strong data-device-label>Mobile</strong> preview · 2-second responsive cycle · live auto-scroll</p>
      </div>
    </div>
  </section>

  <section class="wd-sec">
    <div class="container wd-split">
      <h2 class="wd-h"><span class="wd-ico ok"><ServiceIcons name="web" size={26} /></span> Project Overview</h2>
      <p class="wd-body">
        Businesses need more than a pretty template. They need a site that represents the brand,
        loads in milliseconds, ranks for real search intent and guides visitors to contact or buy.
        Creavix iT builds production-ready websites — from simple brand pages to multi-page
        service portals — with clean code, strong SEO structure and conversion-minded design.
      </p>
    </div>
  </section>

  <section class="wd-sec alt">
    <div class="container wd-split">
      <h2 class="wd-h"><span class="wd-ico warn"><ServiceIcons name="strategy" size={26} /></span> The Challenges</h2>
      <ul class="wd-list">{challenges.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <section class="wd-sec ai-builders-sec" id="ai-builders">
    <div class="container">
      <div class="wd-center ai-builder-heading">
        <p class="wd-eyebrow">AI-assisted development</p>
        <h2 class="wd-h2">AI speed. Expert-led delivery.</h2>
        <p class="wd-sub">We use leading AI development platforms for rapid iteration, then finish every production decision with experienced engineering. Select a tool to view its official pricing.</p>
      </div>
      <div class="ai-builder-grid">
        {aiBuilders.map((tool, i) => (
          <a class="ai-builder-card" href={tool.href} target="_blank" rel="noopener noreferrer" aria-label={`View official ${tool.name} pricing`} style={`--builder-tone:${tool.tone};--builder-index:${i}`}>
            <span class="ai-builder-logo">
              <img src={tool.icon} alt={`${tool.name} logo`} width="48" height="48" loading="lazy" decoding="async" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
              <b class="ai-builder-fallback" style="display:none">{tool.name.charAt(0)}</b>
            </span>
            <span class="ai-builder-copy"><strong>{tool.name}</strong><small>{tool.desc}</small></span>
            <span class="ai-builder-price">View pricing <i aria-hidden="true">↗</i></span>
          </a>
        ))}
      </div>

      <div class="manual-engineering">
        <div class="manual-engineering-head">
          <p class="wd-eyebrow">Beyond AI</p>
          <h3>Engineering that makes it production-ready</h3>
          <p>AI accelerates the first build. Our manual work makes the final product dependable, secure, fast and maintainable.</p>
        </div>
        <div class="manual-engineering-grid">
          {manualEngineering.map((item) => (
            <article class="manual-engineering-card">
              <span><ServiceIcons name={item.icon} size={28} /></span>
              <div><h4>{item.title}</h4><p>{item.desc}</p></div>
            </article>
          ))}
        </div>
      </div>
      <p class="ai-pricing-note">Pricing and account availability are controlled by each provider and may change. All links open the provider’s official pricing page.</p>
    </div>
  </section>

  <section class="wd-sec">
    <div class="container">
      <div class="wd-split">
        <h2 class="wd-h"><span class="wd-ico bad"><ServiceIcons name="spark" size={26} /></span> The Problems We Solve</h2>
        <ul class="wd-list">{problems.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="viz-row">
        <div class="viz-card dark">
          <div class="viz-lock">
            <svg viewBox="0 0 64 64" width="72" height="72" aria-hidden="true">
              <rect x="14" y="28" width="36" height="28" rx="6" fill="#3B82F6"/>
              <path d="M22 28v-8a10 10 0 0 1 20 0v8" fill="none" stroke="#93C5FD" stroke-width="4"/>
              <circle cx="32" cy="42" r="4" fill="#EFF6FF"/>
            </svg>
          </div>
          <p>Secure · SSL · Forms</p>
        </div>
        <div class="viz-card light">
          <div class="viz-iso">
            <span class="iso a"></span><span class="iso b"></span><span class="iso c"></span>
          </div>
          <p>Modular architecture</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wd-sec alt">
    <div class="container">
      <div class="wd-center">
        <p class="wd-eyebrow">Technology stack</p>
        <h2 class="wd-h2">Platforms we build with</h2>
        <p class="wd-sub">Official logos · each card opens the real website</p>
      </div>
      <div class="plat-grid top">
        {platformsTop.map((p) => (
          <a class="plat-card top" href={p.href} target="_blank" rel="noopener noreferrer">
            <img class="plat-img" src={p.icon} alt="" width="36" height="36" loading="lazy" />
            <div>
              <strong>{p.name}</strong>
              <span>{p.desc}</span>
            </div>
            <span class="plat-go">↗</span>
          </a>
        ))}
      </div>
      <div class="plat-grid more">
        {platformsMore.map((p) => (
          <a class="plat-card" href={p.href} target="_blank" rel="noopener noreferrer">
            <img class="plat-img sm" src={p.icon} alt="" width="28" height="28" loading="lazy" />
            <div>
              <strong>{p.name}</strong>
              <span>{p.desc}</span>
            </div>
            <span class="plat-go">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wd-sec">
    <div class="container">
      <div class="wd-center">
        <p class="wd-eyebrow">Domain &amp; DNS</p>
        <h2 class="wd-h2">Trusted places to buy domains</h2>
        <p class="wd-sub">Hostinger first · official logos &amp; purchase links</p>
      </div>
      <div class="plat-grid more domain-grid">
        {domains.map((d) => (
          <a class="plat-card domain" href={d.href} target="_blank" rel="noopener noreferrer">
            <span class="plat-logo-wrap">
              <img
                class="plat-img"
                src={d.icon}
                alt={`${d.name} logo`}
                width="36"
                height="36"
                loading="lazy"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
              />
              <span class="plat-letter fallback" style="display:none">{d.name.charAt(0)}</span>
            </span>
            <div>
              <strong>{d.name}</strong>
              <span>{d.desc}</span>
            </div>
            <span class="plat-go">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wd-sec alt">
    <div class="container">
      <div class="wd-center">
        <p class="wd-eyebrow">How we work</p>
        <h2 class="wd-h2">Website delivery workflow</h2>
      </div>
      <ol class="flow">
        {workflow.map((w, i) => (
          <li class="flow-item">
            <span class="flow-n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{w.t}</h3>
              <p>{w.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wd-sec">
    <div class="container">
      <div class="wd-center">
        <p class="wd-eyebrow">Outcomes</p>
        <h2 class="wd-h2">What you get with Creavix</h2>
      </div>
      <div class="sol-grid">
        {solutions.map((s) => (
          <article class="sol-card">
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="wd-sec alt">
    <div class="container wd-split">
      <h2 class="wd-h"><span class="wd-ico ok"><ServiceIcons name="rocket" size={26} /></span> Conclusion</h2>
      <p class="wd-body">
        A strong website is infrastructure — not decoration. With the right stack, structure and
        performance budget, your brand gains a durable digital asset that supports marketing,
        sales and trust. Creavix iT delivers that asset with clear process and agency-grade quality.
      </p>
    </div>
  </section>

  <section class="wd-cta">
    <div class="container wd-cta-inner">
      <div>
        <p class="wd-eyebrow cta-eye">Book a free consultation</p>
        <h2 class="cta-title">Let’s build your next website</h2>
        <p class="cta-sub">WhatsApp {SITE.whatsapp} · {SITE.email1}</p>
      </div>
      <div class="wd-actions">
        <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
        <a class="btn btn-light" href="/contact">Contact form</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  html{scroll-behavior:smooth}.ai-builders-sec{background:linear-gradient(180deg,#fff 0%,#f5f8ff 100%)}.ai-builder-heading{max-width:760px;margin-inline:auto}.ai-builder-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin-top:1.55rem}.ai-builder-card{position:relative;display:flex;flex-direction:column;align-items:flex-start;min-width:0;min-height:178px;padding:1rem;border:1px solid rgba(15,23,42,.08);border-radius:20px;background:rgba(255,255,255,.94);box-shadow:0 11px 30px rgba(15,23,42,.055);color:#0b0f19;text-decoration:none;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s,border-color .3s}.ai-builder-card:before{content:'';position:absolute;right:-24px;top:-28px;width:82px;height:82px;border-radius:50%;background:color-mix(in srgb,var(--builder-tone) 13%,transparent);pointer-events:none}.ai-builder-card:hover,.ai-builder-card:focus-visible{transform:translateY(-5px);border-color:color-mix(in srgb,var(--builder-tone) 38%,transparent);box-shadow:0 20px 42px color-mix(in srgb,var(--builder-tone) 14%,transparent);outline:none}.ai-builder-logo{width:48px;height:48px;display:grid;place-items:center;overflow:hidden;border:1px solid rgba(15,23,42,.07);border-radius:14px;background:#fff;box-shadow:0 7px 18px rgba(15,23,42,.09)}.ai-builder-logo img{width:34px;height:34px;object-fit:contain}.ai-builder-fallback{width:100%;height:100%;place-items:center;background:var(--builder-tone);color:#fff}.ai-builder-copy{display:grid;gap:.25rem;min-width:0;margin-top:.75rem}.ai-builder-copy strong{font:800 .9rem/1.2 var(--font-h)}.ai-builder-copy small{color:#64748b;font-size:.7rem;line-height:1.4}.ai-builder-price{display:flex;align-items:center;gap:.3rem;margin-top:auto;padding-top:.75rem;color:#2563eb;font-size:.7rem;font-weight:800}.ai-builder-price i{font-style:normal}.manual-engineering{display:grid;gap:1.35rem;margin-top:2.4rem;padding:1.15rem;border-radius:24px;background:#0b1220;color:#e2e8f0;box-shadow:0 24px 55px rgba(15,23,42,.18)}.manual-engineering-head .wd-eyebrow{color:#60a5fa}.manual-engineering-head h3{margin:.35rem 0 .5rem;color:#fff;font-size:1.35rem}.manual-engineering-head p{margin:0;color:#94a3b8;font-size:.82rem;line-height:1.6}.manual-engineering-grid{display:grid;gap:.65rem}.manual-engineering-card{display:flex;align-items:flex-start;gap:.75rem;padding:.75rem;border:1px solid rgba(255,255,255,.09);border-radius:16px;background:rgba(255,255,255,.045)}.manual-engineering-card>span{width:42px;height:42px;display:grid;place-items:center;flex:0 0 42px;border-radius:12px;background:#fff}.manual-engineering-card h4{margin:0 0 .2rem;color:#fff;font-size:.82rem}.manual-engineering-card p{margin:0;color:#94a3b8;font-size:.7rem;line-height:1.45}.ai-pricing-note{margin:1rem 0 0;color:#94a3b8;font-size:.68rem;text-align:center}
  @media(min-width:680px){.ai-builder-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.manual-engineering-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(min-width:980px){.ai-builder-card{min-height:204px;padding:1.2rem}.ai-builder-logo{width:60px;height:60px;border-radius:17px}.ai-builder-logo img{width:42px;height:42px}.ai-builder-copy strong{font-size:1rem}.manual-engineering{grid-template-columns:.72fr 1.28fr;align-items:center;padding:1.65rem}.manual-engineering-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.ai-builder-card{transition:none}.ai-builder-card:hover{transform:none}}
  .wd-hero {
    padding: 8rem 1.25rem 3.5rem;
    background:
      radial-gradient(ellipse 55% 45% at 85% 15%, rgba(37, 99, 235, 0.1), transparent 60%),
      linear-gradient(180deg, #ffffff, #F7F9FC);
    overflow: hidden;
  }
  .wd-hero-grid {
    display: grid;
