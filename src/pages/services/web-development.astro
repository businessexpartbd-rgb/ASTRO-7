  .site-viewport { height: var(--dh); border-radius: 15px; background: #fff; overflow: hidden; transition: height .45s ease, border-radius .45s ease; }
  .wd-builder[data-mode="tablet"] .site-viewport { border-radius: 7px; }
  .wd-builder[data-mode="laptop"] .site-viewport { border-radius: 3px; }
  .site-scroll { min-height: 200%; padding: 8px; background: linear-gradient(#fff, #f8fbff); animation: websiteScroll 5.5s ease-in-out infinite; }
  @keyframes websiteScroll { 0%, 12% { transform: translateY(0); } 82%, 100% { transform: translateY(calc(-50% + 12px)); } }
  .site-nav { height: 15px; display: flex; align-items: center; gap: 5px; margin-bottom: 8px; }
  .site-nav b { width: 14px; height: 14px; display: grid; place-items: center; border-radius: 4px; background: #2563eb; color: #fff; font-size: .42rem; }
  .site-nav i { margin-left: auto; width: 16px; height: 3px; border-radius: 3px; background: #cbd5e1; }
