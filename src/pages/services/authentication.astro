---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
const title = "Authentication Systems | Creavix iT Solution";
const description = "Secure login, signup and role-based access. Authentication solutions by Creavix iT Solution.";
---
<Layout title={title} description={description}>
  <Nav active="services" />
  <section class="hero-premium service-hero">
    <div class="hero-bg"><div class="orb orb-1"></div><div class="orb orb-2"></div><div class="grid-overlay"></div></div>
    <div class="container hero-grid">
      <div class="hero-content reveal">
        <div class="eyebrow"><span class="dot"></span> Security</div>
        <h1 class="hero-title">Secure<br /><span class="text-gradient">Authentication Systems</span></h1>
        <p class="hero-lead">Login, signup, role-based access and secure session management for your apps.</p>
        <div class="flex-btns"><a href="/contact" class="btn btn-primary">Start Your Project</a><a href="/#services" class="btn btn-outline">All Services</a></div>
      </div>
      <div class="hero-visual reveal">
        <div class="visual-card glass-card animate-float"><div class="visual-icon">🔐</div><h3>Authentication</h3><p class="visual-tags">Login · Roles · SSO · Security</p></div>
      </div>
    </div>
  </section>
  <section class="section-warm"><div class="container text-center reveal" style="max-width:40rem">
    <h2 class="mb-4">Need Secure Auth?</h2>
    <a href="mailto:hello@creavixit.com" class="btn btn-primary">Contact Creavix iT</a>
  </div></section>
  <Footer />
</Layout>
