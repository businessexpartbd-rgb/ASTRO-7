---
import Layout from '../../layouts/Layout.astro';
const title = "Authentication Systems | Creavix iT Solution";
const description = "Secure login, signup, role-based access and authentication solutions. Enterprise-grade auth by Creavix iT Solution.";
---
<Layout title={title} description={description}>
  <nav class="navbar" id="navbar">
    <div class="nav-inner">
      <a href="/" class="logo"><img src="/logo.png" alt="Creavix iT Solution" class="logo-img" width="40" height="40" /> Creavix <span>iT</span> Solution</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/#services" class="active">Services</a></li>
        <li><a href="/#about">About</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
      <a href="/#contact" class="btn btn-primary nav-cta">Get Started</a>
    </div>
  </nav>
  <section class="hero-premium service-hero">
    <div class="hero-bg"><div class="orb orb-1"></div><div class="orb orb-2"></div><div class="grid-overlay"></div></div>
    <div class="container hero-grid">
      <div class="hero-content reveal">
        <div class="eyebrow"><span class="dot"></span> Security</div>
        <h1 class="hero-title">Secure<br /><span class="text-gradient">Authentication Systems</span></h1>
        <p class="hero-lead">Login, signup, role-based access and secure session management for your apps and platforms.</p>
        <div class="flex-btns">
          <a href="/#contact" class="btn btn-primary">Start Your Project</a>
          <a href="/#services" class="btn btn-outline">All Services</a>
        </div>
      </div>
      <div class="hero-visual reveal">
        <div class="visual-card glass-card animate-float">
          <div class="visual-icon">🔐</div>
          <h3>Authentication</h3>
          <p class="visual-tags">Login · Roles · SSO · Security</p>
          <div class="stat-grid">
            <div class="stat-box"><strong class="text-primary">Secure</strong><span>By Default</span></div>
            <div class="stat-box"><strong class="text-violet">RBAC</strong><span>Ready</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section-soft">
    <div class="container">
      <div class="text-center mb-8 reveal">
        <p class="eyebrow" style="margin:0 auto 1rem">What You Get</p>
        <h2 class="mb-4">Auth Done Right</h2>
      </div>
      <div class="grid-3">
        <div class="glass-card reveal"><div class="icon-box" style="background:rgba(16,185,129,.1)">🔑</div><h3 class="mb-4">Login & Signup</h3><p style="font-size:.9rem">Email, social and passwordless options.</p></div>
        <div class="glass-card reveal"><div class="icon-box" style="background:rgba(79,70,229,.1)">👥</div><h3 class="mb-4">Role-Based Access</h3><p style="font-size:.9rem">Admin, user and custom roles with permissions.</p></div>
        <div class="glass-card reveal"><div class="icon-box" style="background:rgba(244,63,94,.1)">🛡️</div><h3 class="mb-4">Session Security</h3><p style="font-size:.9rem">Secure tokens, expiry and protection against abuse.</p></div>
      </div>
    </div>
  </section>
  <section class="section-warm">
    <div class="container text-center reveal" style="max-width:40rem">
      <h2 class="mb-4">Need Secure Auth?</h2>
      <p class="mb-8" style="font-size:1.1rem">Tell us your app requirements. We implement production-ready authentication.</p>
      <a href="mailto:hello@creavixit.com" class="btn btn-primary" style="padding:.9rem 2rem; font-size:1rem">Contact Creavix iT</a>
    </div>
  </section>
  <footer class="site-footer">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo footer-logo"><img src="/logo.png" alt="Creavix iT Solution" class="logo-img" width="36" height="36" /> Creavix <span>iT</span> Solution</a>
        <p class="footer-desc">Premium digital agency delivering AI video marketing, web development and growth solutions.</p>
      </div>
      <div class="footer-col"><h4>Services</h4><ul>
        <li><a href="/services/authentication">Authentication</a></li>
        <li><a href="/services/application-build">Application Build</a></li>
        <li><a href="/services/web-development">Web Development</a></li>
        <li><a href="/services/video-editing">Video Editing</a></li>
      </ul></div>
      <div class="footer-col"><h4>Company</h4><ul>
        <li><a href="/#about">About Us</a></li>
        <li><a href="/#contact">Contact</a></li>
        <li><a href="mailto:hello@creavixit.com">Support</a></li>
      </ul></div>
      <div class="footer-col"><h4>Contact</h4><ul>
        <li><a href="mailto:hello@creavixit.com">hello@creavixit.com</a></li>
        <li><a href="https://creavixit.com">creavixit.com</a></li>
        <li>Bangladesh</li>
      </ul></div>
    </div>
    <div class="footer-bottom"><div>© 2026 Creavix iT Solution. All rights reserved.</div></div>
  </footer>
</Layout>
