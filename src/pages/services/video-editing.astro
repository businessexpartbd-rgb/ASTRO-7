---
import RelatedServices from '../../components/RelatedServices.astro';
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ServiceHeroVisual from '../../components/ServiceHeroVisual.astro';
import ServiceIcons from '../../components/icons/ServiceIcons.astro';
import { SITE } from '../../data/site';

const seoTitle = 'Professional Video Editing Bangladesh | Ads, Reels, YouTube — Creavix iT';
const seoDescription =
  'Cinematic video editing for ads, Reels, YouTube and brand films. Fast turnaround, platform-ready sizes — Creavix iT Solution Bangladesh.';

const offers = [
  { t: 'Ad & promo edits', d: 'Hook-first cuts for Meta, YouTube and TikTok that sell the offer in seconds.' },
  { t: 'YouTube long-form', d: 'Pacing, title cards, B-roll rhythm and retention-friendly structure.' },
  { t: 'Reels & Shorts', d: 'Vertical 9:16 edits with captions, beat sync and clear CTAs.' },
  { t: 'Product & service films', d: 'Clean product reveals, before/after and testimonial assemblies.' },
  { t: 'Color & sound', d: 'Grade, loudness balance and music beds that match brand mood.' },
  { t: 'Subtitles & versions', d: 'Bangla/English captions and multi-size exports from one master.' },
];

const steps = [
  { n: '01', t: 'Brief', d: 'Goal, platform, raw clips, brand refs and deadline.' },
  { n: '02', t: 'Edit', d: 'Structure, pacing, text, music and first cut.' },
  { n: '03', t: 'Revise', d: 'Focused feedback rounds until approved.' },
  { n: '04', t: 'Deliver', d: 'Final files in the sizes your channels need.' },
];
const offerIcons = ['campaign', 'production', 'video', 'marketing', 'spark', 'global'];
const stepIcons = ['strategy', 'video', 'check', 'rocket'];

const faqs = [
  { q: 'What kind of footage should I send?', a: 'Mobile or camera footage both work. Higher-quality source video and audio allow for a cleaner final result.' },
  { q: 'How long does editing take?', a: 'Short reels and ads are usually faster. Long-form YouTube edits and multi-format campaigns require more production time.' },
  { q: 'How is this different from AI video marketing?', a: 'Video editing primarily transforms your footage. AI video can also introduce generated or hybrid visuals.' },
  { q: 'How many revisions are included?', a: 'Revision rounds depend on the selected package. A major change in scope is quoted separately.' },
  { q: 'Can I order only one ad edit?', a: 'Yes. You can start with a single creative or commission a complete campaign set.' },
];
---

<Layout title={seoTitle} description={seoDescription}>
  <TopBar />
  <Nav active="services" />
  <main id="main-content" tabindex="-1">

  <section class="sv-hero">
    <div class="container sv-grid">
      <div class="reveal">
        <p class="sv-eye">Video Editing Agency</p>
        <h1>Video editing that <span class="brand-accent">holds attention.</span></h1>
        <p class="sv-sub">Ads, Reels, YouTube and brand films — paced for mobile feeds. Platform-ready delivery from Creavix iT.</p>
        <div class="sv-actions">
          <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Send my footage</a>
          <a class="btn btn-outline" href="/portfolio">See portfolio</a>
        </div>
      </div>
      <div class="reveal">
        <ServiceHeroVisual variant="video" />
      </div>
    </div>
  </section>

  <section class="sv-sec">
    <div class="container">
      <div class="sv-center reveal"><p class="sv-eye">What we edit</p><h2>Formats built for real channels</h2></div>
      <div class="sv-cards">{offers.map((o, i) => (<article class="sv-card reveal"><span class="sv-card-icon"><ServiceIcons name={offerIcons[i]} size={30} /></span><h3>{o.t}</h3><p>{o.d}</p></article>))}</div>
    </div>
  </section>

  <section class="sv-sec sv-muted">
    <div class="container">
      <div class="sv-center reveal"><p class="sv-eye">Process</p><h2>From raw to publish-ready</h2></div>
      <div class="sv-steps">{steps.map((s, i) => (<div class="sv-step reveal"><div class="sv-step-top"><span class="sv-card-icon"><ServiceIcons name={stepIcons[i]} size={28} /></span><span>{s.n}</span></div><h3>{s.t}</h3><p>{s.d}</p></div>))}</div>
    </div>
  </section>

  <section class="sv-sec">
    <div class="container sv-faq-wrap">
      <div class="sv-center reveal"><p class="sv-eye">FAQ</p><h2>Editing questions</h2></div>
      <div class="sv-faq reveal">{faqs.map((f) => (<details class="sv-faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
    </div>
  </section>

  <section class="sv-cta">
    <div class="container sv-cta-inner reveal">
      <div><h2>Ready to cut your next video?</h2><p>WhatsApp {SITE.whatsapp}</p></div>
      <a class="btn btn-light" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
  </section>
  <RelatedServices />
  </main>
  <Footer />
</Layout>

<style>
.sv-hero{padding:5.25rem 1.25rem 3.5rem;background:radial-gradient(ellipse 50% 40% at 90% 10%,rgba(37,99,235,.12),transparent 55%),linear-gradient(180deg,#fff,#F8FAFC)}
.sv-grid{display:grid;gap:2rem;align-items:center}@media(min-width:900px){.sv-grid{grid-template-columns:1.05fr .95fr;gap:2.5rem}}
.sv-eye{margin:0 0 .5rem;font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#2563EB}
.sv-hero h1,.sv-center h2,.sv-cta h2{font-family:Outfit,system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;color:#0B0F19;margin:0 0 .5rem}
.sv-hero h1{font-size:clamp(1.7rem,4vw,2.5rem);line-height:1.12}
.sv-sub{margin:0 0 1.25rem;color:#475569;line-height:1.65;max-width:34rem}
.sv-actions{display:flex;flex-wrap:wrap;gap:.65rem}
.sv-sec{padding:3.25rem 1.25rem;background:#fff}.sv-muted{background:#F8FAFC}
.sv-center{text-align:center;max-width:36rem;margin:0 auto 1.75rem}.sv-center h2{font-size:clamp(1.35rem,3vw,1.8rem)}
.sv-cards{display:grid;gap:1rem}@media(min-width:700px){.sv-cards{grid-template-columns:1fr 1fr 1fr}}
.sv-card{background:#F8FAFC;border:1px solid rgba(15,23,42,.07);border-radius:16px;padding:1.25rem}
.sv-muted .sv-step{background:#fff}.sv-card h3{margin:0 0 .35rem;font-size:1rem;font-weight:800}.sv-card p{margin:0;font-size:.9rem;color:#64748B;line-height:1.55}
.sv-steps{display:grid;gap:1rem}@media(min-width:700px){.sv-steps{grid-template-columns:repeat(4,1fr)}}
.sv-step{padding:1.15rem;border-radius:16px;border:1px solid rgba(15,23,42,.07);background:#F8FAFC}
.sv-step span{font-weight:800;font-size:.8rem;color:#2563EB}.sv-step h3{margin:.35rem 0;font-size:1rem}.sv-step p{margin:0;font-size:.88rem;color:#64748B}
.sv-faq-wrap{max-width:720px}.sv-faq{display:flex;flex-direction:column;gap:.65rem}
.sv-faq-item{border:1px solid rgba(15,23,42,.08);border-radius:14px;background:#F8FAFC;padding:.15rem 1rem}
.sv-faq-item summary{cursor:pointer;font-weight:700;padding:.9rem 0;list-style:none;display:flex;justify-content:space-between;gap:1rem}
.sv-faq-item summary::-webkit-details-marker{display:none}.sv-faq-item summary::after{content:'+';color:#2563EB;font-size:1.25rem}
.sv-faq-item[open] summary::after{content:'–'}.sv-faq-item p{margin:0 0 1rem;color:#64748B;font-size:.92rem;line-height:1.65}
.sv-cta{padding:2.75rem 1.25rem;background:linear-gradient(135deg,#1E3A8A,#2563EB);color:#fff}
.sv-cta-inner{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between}
.sv-cta h2{color:#fff;font-size:clamp(1.25rem,3vw,1.65rem)}.sv-cta p{margin:0;opacity:.95}
.btn-light{background:#fff;color:#1E40AF;border:none}
</style>
