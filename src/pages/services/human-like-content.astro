---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../data/site';

const seoTitle = 'Human-like Content & Product Videos Bangladesh — Creavix iT';
const seoDescription =
  'Authentic human-like product and people content for ads and social. Natural delivery, Bangla/English scripts — Creavix iT Solution.';

const types = [
  { t: 'Product demos', d: 'Hands, texture, use-cases — content that feels demonstrated, not dumped.' },
  { t: 'Spokesperson style', d: 'Talking-head energy with clear claims and soft CTAs.' },
  { t: 'Lifestyle inserts', d: 'Context shots that place the offer in real daily moments.' },
  { t: 'Testimonial assembly', d: 'Customer voice structured for trust without heavy production.' },
];

const why = [
  { t: 'Trust', d: 'Viewers buy from people they feel they understand.' },
  { t: 'Platform native', d: 'Looks closer to organic posts than glossy TV ads.' },
  { t: 'Flexible', d: 'Works for local sellers and international brands alike.' },
  { t: 'Pairs with ads', d: 'Ready for boosting and full campaigns.' },
];

const faqs = [
  { q: 'Human-like মানে কী?', a: 'দেখতে ও শুনতে যতটা সম্ভব প্রাকৃতিক — অতিরিক্ত কৃত্রিম টোন এড়িয়ে অফার পরিষ্কার রাখা।' },
  { q: 'আমার নিজের মুখ লাগবে?', a: 'পারেন; অথবা স্ক্রিপ্ট + ভিজুয়াল পদ্ধতিতে প্রোডাক্ট-ফোকাসড কনটেন্টও হয়।' },
  { q: 'ভাষা?', a: 'বাংলা, ইংরেজি বা মিশ্র — অডিয়েন্স অনুযায়ী।' },
  { q: 'AI Video-এর সাথে পার্থক্য?', a: 'এখানে জোর অথেন্টিক হিউম্যান প্রেজেন্স ও প্রোডাক্ট স্টোরি; AI টুলস সাপোর্ট হিসেবে ব্যবহার হতে পারে।' },
];
---

<Layout title={seoTitle} description={seoDescription}>
  <TopBar />
  <Nav active="services" />

  <section class="sv-hero">
    <div class="container sv-grid">
      <div class="reveal">
        <p class="sv-eye">Human-like Content</p>
        <h1>Content that feels real — and still sells</h1>
        <p class="sv-sub">Product and people-first videos for social and ads. Natural tone, clear offers, built for Bangladesh marketplace behaviour and global brands.</p>
        <div class="sv-actions">
          <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Discuss my product</a>
          <a class="btn btn-outline" href="/services/ai-video-marketing">AI video options</a>
        </div>
      </div>
      <div class="sv-visual reveal" aria-hidden="true">
        <div class="hl-card">
          <div class="hl-face"></div>
          <div class="hl-lines"><span></span><span></span><span></span></div>
          <div class="hl-tag">Authentic · On-brand</div>
        </div>
      </div>
    </div>
  </section>

  <section class="sv-sec">
    <div class="container">
      <div class="sv-center reveal"><p class="sv-eye">Formats</p><h2>What we produce</h2></div>
      <div class="sv-cards">{types.map(t => (<article class="sv-card reveal"><h3>{t.t}</h3><p>{t.d}</p></article>))}</div>
    </div>
  </section>

  <section class="sv-sec sv-muted">
    <div class="container">
      <div class="sv-center reveal"><p class="sv-eye">Why it works</p><h2>Built for attention and trust</h2></div>
      <div class="sv-cards">{why.map(w => (<article class="sv-card reveal"><h3>{w.t}</h3><p>{w.d}</p></article>))}</div>
    </div>
  </section>

  <section class="sv-sec">
    <div class="container sv-faq-wrap">
      <div class="sv-center reveal"><p class="sv-eye">FAQ</p><h2>Content questions</h2></div>
      <div class="sv-faq reveal">{faqs.map(f => (<details class="sv-faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
    </div>
  </section>

  <section class="sv-cta">
    <div class="container sv-cta-inner reveal">
      <div><h2>Plan human-like creatives</h2><p>WhatsApp {SITE.whatsapp}</p></div>
      <a class="btn btn-light" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
  </section>
  <Footer />
</Layout>

<style>
.sv-hero{padding:5.25rem 1.25rem 3.5rem;background:radial-gradient(ellipse 50% 40% at 90% 10%,rgba(14,165,233,.12),transparent 55%),linear-gradient(180deg,#fff,#F8FAFC)}
.sv-grid{display:grid;gap:2.5rem;align-items:center}@media(min-width:900px){.sv-grid{grid-template-columns:1.1fr .9fr}}
.sv-eye{margin:0 0 .5rem;font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#0284C7}
.sv-hero h1,.sv-center h2,.sv-cta h2{font-family:Outfit,system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;color:#0B0F19;margin:0 0 .5rem}
.sv-hero h1{font-size:clamp(1.7rem,4vw,2.5rem);line-height:1.12}
.sv-sub{margin:0 0 1.25rem;color:#475569;line-height:1.65;max-width:34rem}
.sv-actions{display:flex;flex-wrap:wrap;gap:.65rem}
.sv-visual{display:flex;justify-content:center}
.hl-card{width:min(100%,280px);padding:1.5rem;border-radius:20px;background:#fff;border:1px solid rgba(15,23,42,.08);box-shadow:0 24px 48px rgba(15,23,42,.1);text-align:center}
.hl-face{width:72px;height:72px;margin:0 auto 1rem;border-radius:50%;background:linear-gradient(145deg,#7DD3FC,#2563EB);animation:hl-glow 3s ease-in-out infinite}
.hl-lines{display:flex;flex-direction:column;gap:.4rem;margin-bottom:1rem}
.hl-lines span{height:8px;border-radius:4px;background:#E2E8F0;display:block}
.hl-lines span:nth-child(1){width:100%}.hl-lines span:nth-child(2){width:85%}.hl-lines span:nth-child(3){width:60%}
.hl-tag{font-size:.75rem;font-weight:700;color:#0284C7}
@keyframes hl-glow{0%,100%{box-shadow:0 0 0 0 rgba(37,99,235,.3)}50%{box-shadow:0 0 0 12px rgba(37,99,235,0)}}
.sv-sec{padding:3.25rem 1.25rem;background:#fff}.sv-muted{background:#F8FAFC}
.sv-center{text-align:center;max-width:36rem;margin:0 auto 1.75rem}.sv-center h2{font-size:clamp(1.35rem,3vw,1.8rem)}
.sv-cards{display:grid;gap:1rem}@media(min-width:700px){.sv-cards{grid-template-columns:1fr 1fr}}
.sv-card{background:#F8FAFC;border:1px solid rgba(15,23,42,.07);border-radius:16px;padding:1.25rem}
.sv-muted .sv-card{background:#fff}.sv-card h3{margin:0 0 .35rem;font-size:1rem;font-weight:800}.sv-card p{margin:0;font-size:.9rem;color:#64748B;line-height:1.55}
.sv-faq-wrap{max-width:720px}.sv-faq{display:flex;flex-direction:column;gap:.65rem}
.sv-faq-item{border:1px solid rgba(15,23,42,.08);border-radius:14px;background:#F8FAFC;padding:.15rem 1rem}
.sv-faq-item summary{cursor:pointer;font-weight:700;padding:.9rem 0;list-style:none;display:flex;justify-content:space-between;gap:1rem}
.sv-faq-item summary::-webkit-details-marker{display:none}.sv-faq-item summary::after{content:'+';color:#0284C7;font-size:1.25rem}
.sv-faq-item[open] summary::after{content:'–'}.sv-faq-item p{margin:0 0 1rem;color:#64748B;font-size:.92rem;line-height:1.65}
.sv-cta{padding:2.75rem 1.25rem;background:linear-gradient(135deg,#0369A1,#0EA5E9);color:#fff}
.sv-cta-inner{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between}
.sv-cta h2{color:#fff;font-size:clamp(1.25rem,3vw,1.65rem)}.sv-cta p{margin:0;opacity:.95}
.btn-light{background:#fff;color:#0369A1;border:none}
@media(prefers-reduced-motion:reduce){.hl-face{animation:none}}
</style>
