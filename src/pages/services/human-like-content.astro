---
import Layout from '../../layouts/Layout.astro';
const title = "Authentic Human-like AI Content | Creavix iT Solution";
const description = "Realistic AI human and product visuals that feel genuine and conversion-focused. Premium authentic content by Creavix iT Solution.";
---
<Layout title={title} description={description}>
  <nav class="navbar" id="navbar">
    <div class="nav-inner">
      <a href="/" class="logo"><img src="/logo.png" alt="Creavix iT Solution" class="logo-img" width="40" height="40" /> Creavix <span>iT</span> Solution</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/#services" class="active">Services</a></li>
        <li><a href="/#about">About</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
      <a href="/#contact" class="btn btn-primary nav-cta">Get Started</a>
    </div>
  </nav>
  <section class="hero-premium service-hero">
    <div class="hero-bg"><div class="orb orb-1"></div><div class="orb orb-2"></div><div class="grid-overlay"></div></div>
    <div class="container hero-grid">
      <div class="hero-content reveal">
        <div class="eyebrow"><span class="dot"></span> Authentic Visuals</div>
        <h1 class="hero-title">Authentic<br /><span class="text-gradient">Human-like Content</span></h1>
        <p class="hero-lead">Realistic AI human and product visuals that feel genuine — built for ads, product pages and brand storytelling that convert.</p>
        <div class="flex-btns">
          <a href="/#contact" class="btn btn-primary">Start Your Project</a>
          <a href="/#services" class="btn btn-outline">All Services</a>
        </div>
      </div>
      <div class="hero-visual reveal">
        <div class="visual-card glass-card animate-float">
          <div class="visual-icon">👤</div>
          <h3>Human-like Content</h3>
          <p class="visual-tags">AI Humans · Products · Brand</p>
          <div class="stat-grid">
            <div class="stat-box"><strong class="text-primary">Real</strong><span>Look & Feel</span></div>
            <div class="stat-box"><strong class="text-violet">High</strong><span>Conversion</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section-soft">
    <div class="container">
      <div class="text-center mb-8 reveal">
        <p class="eyebrow" style="margin:0 auto 1rem">What You Get</p>
        <h2 class="mb-4">Content That Feels Real</h2>
      </div>
      <div class="grid-3">
        <div class="glass-card reveal"><div class="icon-box" style="background:rgba(245,158,11,.1)">🧑</div><h3 class="mb-4">AI Humans</h3><p style="font-size:.9rem">Natural-looking presenters and models for ads and product videos.</p></div>
        <div class="glass-card reveal"><div class="icon-box" style="background:rgba(244,63,94,.1)">📦</div><h3 class="mb-4">Product Visuals</h3><p style="font-size:.9rem">Product shots and demos that look authentic and premium.</p></div>
        <div class="glass-card reveal"><div class="icon-box" style="background:rgba(79,70,229,.1)">🎬</div><h3 class="mb-4">Ad Creatives</h3><p style="font-size:.9rem">Conversion-focused visuals ready for Meta and YouTube.</p></div>
      </div>
    </div>
  </section>
  <section class="section-warm">
    <div class="container text-center reveal" style="max-width:40rem">
      <h2 class="mb-4">Need Authentic Content?</h2>
      <p class="mb-8" style="font-size:1.1rem">Tell us your product and style. We deliver realistic AI visuals fast.</p>
      <a href="mailto:hello@creavixit.com" class="btn btn-primary" style="padding:.9rem 2rem; font-size:1rem">Contact Creavix iT</a>
    </div>
  </section>
  <footer class="site-footer">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo footer-logo"><img src="/logo.png" alt="Creavix iT Solution" class="logo-img" width="36" height="36" /> Creavix <span>iT</span> Solution</a>
        <p class="footer-desc">Premium digital agency delivering AI video marketing, web development and growth solutions.</p>
      </div>
      <div class="footer-col"><h4>Services</h4><ul>
        <li><a href="/services/video-editing">Video Editing</a></li>
        <li><a href="/services/ai-video-marketing">AI Video Marketing</a></li>
        <li><a href="/services/human-like-content">Human-like Content</a></li>
        <li><a href="/services/web-development">Web Development</a></li>
      </ul></div>
      <div class="footer-col"><h4>Company</h4><ul>
        <li><a href="/#about">About Us</a></li>
        <li><a href="/#contact">Contact</a></li>
        <li><a href="mailto:hello@creavixit.com">Support</a></li>
      </ul></div>
      <div class="footer-col"><h4>Contact</h4><ul>
        <li><a href="mailto:hello@creavixit.com">hello@creavixit.com</a></li>
        <li><a href="https://creavixit.com">creavixit.com</a></li>
        <li>Bangladesh</li>
      </ul></div>
    </div>
    <div class="footer-bottom"><div>© 2026 Creavix iT Solution. All rights reserved.</div></div>
  </footer>
</Layout>
