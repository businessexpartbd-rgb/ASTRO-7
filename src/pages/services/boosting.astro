  }
  .bo-core-label {
    font-size: 0.65rem;
    opacity: 0.85;
  }
  .bo-core strong {
    font-size: 0.95rem;
    font-weight: 800;
  }
  .bo-orbit {
    position: absolute;
    z-index: 3;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.1);
    color: #1E40AF;
    animation: bo-bob 3.5s ease-in-out infinite;
  }
  .bo-o1 { top: 8%; left: 50%; transform: translateX(-50%); }
