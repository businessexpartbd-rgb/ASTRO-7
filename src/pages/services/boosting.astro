    margin: 0 0 0.9rem;
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(1.7rem, 4.2vw, 2.55rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #0B0F19;
  }
  .bo-sub {
    margin: 0 0 1.35rem;
    color: #475569;
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 36rem;
  }
  .bo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.15rem;
  }
  .bo-pills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .bo-pills li {
    font-size: 0.72rem;
    font-weight: 600;
    color: #1E40AF;
    background: #EFF6FF;
    border: 1px solid rgba(37, 99, 235, 0.15);
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
  }

  .bo-visual {
    display: flex;
    justify-content: center;
  }
  .bo-magnet {
    position: relative;
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
