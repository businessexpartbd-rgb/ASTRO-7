    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .bo-compare { grid-template-columns: 1fr 1fr; }
  }
  .bo-col {
    border-radius: 18px;
    padding: 1.5rem 1.35rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  .bo-boost {
    background: linear-gradient(180deg, #EFF6FF, #fff);
  }
  .bo-camp {
    background: linear-gradient(180deg, #FFFBEB, #fff);
  }
  .bo-col h3 {
    margin: 0 0 0.85rem;
    font-size: 1.2rem;
    font-weight: 800;
  }
  .bo-boost h3 { color: #1D4ED8; }
  .bo-camp h3 { color: #B45309; }
  .bo-col ul {
    margin: 0;
    padding: 0 0 0 1.1rem;
    color: #475569;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .bo-platforms {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .bo-platforms { grid-template-columns: 1fr 1fr; }
  }
  .bo-plat {
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.07);
