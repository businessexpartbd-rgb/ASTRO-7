  }
  .bo-o1 { animation-name: bo-bob; }
  .bo-o2, .bo-o3, .bo-o4 { animation-name: bo-bob; }

  .bo-sec { padding: 3.5rem 1.25rem; background: #fff; }
  .bo-muted { background: #F8FAFC; }
  .bo-center {
    text-align: center;
    max-width: 38rem;
    margin: 0 auto 2rem;
  }
  .bo-center h2,
  .bo-h2 {
    margin: 0 0 0.5rem;
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 800;
    color: #0B0F19;
    letter-spacing: -0.02em;
  }
  .bo-lead {
    margin: 0;
