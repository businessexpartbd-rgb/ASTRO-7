---
import MetaTargeting from '../../components/MetaTargeting.astro';
import RelatedServices from '../../components/RelatedServices.astro';
/**
 * Boosting & Campaign service page
 * Boost vs Campaign, Facebook + YouTube, live USD→BDT service rate
 * (market × 150/122), budget from $5, algorithm notes, FAQ
 */
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ServiceIcons from '../../components/icons/ServiceIcons.astro';
import { SITE } from '../../data/site';

const seoTitle =
  'Facebook Boosting & Ad Campaign Bangladesh | YouTube Ads · Dollar Rate — Creavix iT';
const seoDescription =
  'Facebook boosting vs full campaign, YouTube ads, budget from $5, transparent USD to BDT service rate with tax & bank fee explanation. Creavix iT Solution Bangladesh.';

const compare = [
  {
    side: 'Boosting',
    color: 'boost',
    points: [
      'Start from a post, Reel or existing creative',
      'Quick reach, messages, profile visits',
      'Simple goals — ideal for offers & page activity',
      'Faster to launch, smaller tests',
      'Best when creative already performs organically',
    ],
  },
  {
    side: 'Campaign',
    color: 'camp',
    points: [
      'Full funnel: awareness → traffic → leads/sales',
      'Audience research, placements, retargeting',
      'Facebook / Instagram + optional YouTube',
      'A/B creatives, weekly optimization',
      'Best for sustained growth & clear KPIs',
    ],
  },
];

const platforms = [
  {
    title: 'Facebook & Instagram',
    tag: 'Meta',
    desc: 'Feed, Stories, Reels, Messenger — boost a post or run structured campaigns for messages, calls and conversions.',
    items: ['Boost post / Reel', 'Traffic & engagement', 'Message / lead campaigns', 'Retargeting warm audiences'],
  },
  {
    title: 'YouTube Campaigns',
    tag: 'Google',
    desc: 'In-stream and discovery-style video ads that put your offer in front of viewers already watching related content.',
    items: ['Video views & awareness', 'Traffic to site / WhatsApp', 'Brand lift style goals', 'Creative length guidance'],
  },
];

const benefitsBoost = [
  { t: 'Speed', d: 'Go live the same day when the post and budget are ready.' },
  { t: 'Simple goals', d: 'More people seeing, reacting or messaging that specific post.' },
  { t: 'Low entry', d: 'Test from about $5 and learn what creative works.' },
  { t: 'Page heat', d: 'Useful before festivals, launches or limited offers.' },
];

const benefitsCamp = [
  { t: 'Structure', d: 'Objectives, audiences and placements planned together.' },
  { t: 'Scale', d: 'Move budget to winners; cut waste with weekly reviews.' },
  { t: 'Multi-platform', d: 'Meta plus YouTube under one growth plan when needed.' },
  { t: 'Reporting', d: 'Spend, results and cost-per-result in plain language.' },
];

const tiers = [
  { usd: 5, label: 'Test', note: 'Single boost test · one creative' },
  { usd: 15, label: 'Starter', note: 'Short boost window · offer push' },
  { usd: 50, label: 'Growth', note: 'Campaign-style · audience + creative' },
  { usd: 100, label: 'Scale', note: 'Multi-ad · retargeting ready' },
  { usd: 250, label: 'Pro', note: 'Full week optimization · FB / YT mix' },
];

const algo = [
  {
    t: 'Facebook delivery today',
    d: 'Meta rewards relevance and meaningful interactions. Clear creative, honest claims and message/call goals usually beat random “boost for likes only”.',
  },
  {
    t: 'Android & mobile feed',
    d: 'Most BD traffic is mobile. Vertical video, readable text on small screens and fast first seconds matter more than desktop-only designs.',
  },
  {
    t: 'Quality & limits',
    d: 'Sudden spammy boosts, misleading ads or weak Page quality can reduce delivery. Healthy Page + gradual spend is safer.',
  },
  {
    t: 'YouTube attention',
    d: 'Hooks in the first seconds, readable branding and a single clear action (visit, message, search) improve campaign efficiency.',
  },
];

const faqs = [
  {
    q: 'What is the difference between boosting and campaign management?',
    a: 'Boosting quickly distributes a post or reel to a selected audience. Campaign management coordinates objectives, audiences, placements, creative testing and optimization across Meta and, when required, YouTube.',
  },
  {
    q: 'What is the minimum budget?',
    a: 'A small boost test can begin around $5. Managed campaigns need enough budget to generate meaningful learning data for the chosen objective.',
  },
  {
    q: 'Why can the billed exchange rate exceed the market rate?',
    a: 'The service rate includes applicable taxes and payment or banking costs. The final BDT rate is shown transparently before confirmation and may therefore differ from the market spot rate.',
  },
  {
    q: 'Can the rate change daily?',
    a: 'Yes. The calculator uses a current USD/BDT reference and applies the displayed service-rate formula. A fallback value is used if the external reference is unavailable.',
  },
  {
    q: 'Is a YouTube campaign separate?',
    a: 'Yes. YouTube video advertising runs through the Google advertising ecosystem and can complement Meta promotion for awareness and traffic.',
  },
  {
    q: 'How quickly will I see results?',
    a: 'A boost can begin generating reach or enquiries within hours or days. Managed campaigns need several days of data for learning and scaling; we do not promise guaranteed sales.',
  },
  {
    q: 'Can I advertise from a restricted page?',
    a: 'Restrictions can reduce or stop delivery. The page and ad account should be reviewed and corrected before budget is committed.',
  },
  {
    q: 'Should I start with a boost or a campaign?',
    a: 'Use a boost to validate one offer quickly. Choose campaign management for repeatable leads, structured testing and scalable budgets.',
  },
];
---

<Layout title={seoTitle} description={seoDescription}>
  <TopBar />
  <Nav active="services" />
  <main id="main-content" tabindex="-1">

  <!-- HERO -->
  <section class="bo-hero">
    <div class="container bo-hero-grid">
      <div class="bo-copy reveal">
        <p class="bo-eye">Boosting &amp; Campaigns</p>
        <h1>Facebook &amp; YouTube ads.<br /><span class="brand-accent">Make every test count.</span></h1>
        <p class="bo-sub">
          Know the difference. Start from about $5. See a transparent USD → BDT service rate
          (market-linked, tax &amp; bank costs included). Magnetic growth creative — not random spend.
        </p>
        <div class="bo-actions">
          <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Plan my boost</a>
          <a class="btn btn-outline" href="#rate">Today’s dollar rate</a>
        </div>
        <ul class="bo-pills">
          <li>From $5</li>
          <li>Meta Boost</li>
          <li>Campaigns</li>
          <li>YouTube</li>
          <li>Live BDT rate</li>
        </ul>
      </div>

      <MetaTargeting compact />
    </div>
  </section>

  <!-- COMPARE -->
  <section class="bo-sec" id="compare">
    <div class="container">
      <div class="bo-center reveal">
        <p class="bo-eye">Boost vs Campaign</p>
        <h2>Same platform — different jobs</h2>
        <p class="bo-lead">Choose boost for speed tests. Choose campaign when you need a system.</p>
      </div>
      <div class="bo-compare">
        {compare.map((c) => (
          <article class={`bo-col bo-${c.color} reveal`}>
            <h3>{c.side}</h3>
            <ul>
              {c.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PLATFORMS -->
  <section class="bo-sec bo-muted" id="platforms">
    <div class="container">
      <div class="bo-center reveal">
        <p class="bo-eye">Platforms</p>
        <h2>Facebook, Instagram &amp; YouTube</h2>
      </div>
      <div class="bo-platforms">
        {platforms.map((p, i) => (
          <article class="bo-plat reveal">
            <span class="sv-card-icon"><ServiceIcons name={['facebook','video'][i]} size={30} /></span>
            <span class="bo-tag">{p.tag}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
            <ul>
              {p.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="bo-sec" id="benefits">
    <div class="container">
      <div class="bo-two">
        <div class="reveal">
          <p class="bo-eye">Boosting benefits</p>
          <h2 class="bo-h2">When boosting helps</h2>
          <div class="bo-bgrid">
            {benefitsBoost.map((b, i) => (
              <div class="bo-bcard">
                <span class="sv-card-icon"><ServiceIcons name={['rocket','strategy','boosting','spark'][i]} size={28} /></span>
                <h3>{b.t}</h3>
                <p>{b.d}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="reveal">
          <p class="bo-eye">Campaign benefits</p>
          <h2 class="bo-h2">When a campaign is better</h2>
          <div class="bo-bgrid">
            {benefitsCamp.map((b, i) => (
              <div class="bo-bcard">
                <span class="sv-card-icon"><ServiceIcons name={['campaign','global','marketing','check'][i]} size={28} /></span>
                <h3>{b.t}</h3>
                <p>{b.d}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BUDGET TIERS -->
  <section class="bo-sec bo-muted" id="budget">
    <div class="container">
      <div class="bo-center reveal">
        <p class="bo-eye">Budget friendly</p>
        <h2>From $5 — pick a starting band</h2>
        <p class="bo-lead">Final BDT = your USD band × today’s service rate (see calculator below).</p>
      </div>
      <div class="bo-tiers">
        {tiers.map((t) => (
          <article class="bo-tier reveal" data-usd={t.usd}>
            <div class="bo-tier-usd">${t.usd}</div>
            <div class="bo-tier-label">{t.label}</div>
            <p>{t.note}</p>
            <div class="bo-tier-bdt">≈ <span class="js-tier-bdt">—</span> BDT</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DOLLAR RATE -->
  <section class="bo-sec" id="rate">
    <div class="container bo-rate-wrap">
      <div class="bo-center reveal">
        <p class="bo-eye">Service dollar rate</p>
        <h2>Live USD → BDT calculation</h2>
        <p class="bo-lead">
          When market USD is <strong>122</strong> BDT, our service rate is <strong>150</strong> BDT.
          Formula: <code>service = market × (150 ÷ 122)</code>. Updates when you open the page (market feed + daily cache).
        </p>
      </div>

      <div class="bo-rate-card reveal" id="bo-rate-card">
        <div class="bo-rate-status" id="bo-rate-status">Loading market rate…</div>
        <div class="bo-rate-grid">
          <div class="bo-rate-box">
            <span class="bo-rate-k">Market USD (ref)</span>
            <span class="bo-rate-v" id="bo-market">—</span>
            <span class="bo-rate-u">BDT</span>
          </div>
          <div class="bo-rate-arrow" aria-hidden="true">→</div>
          <div class="bo-rate-box hi">
            <span class="bo-rate-k">Creavix service rate</span>
            <span class="bo-rate-v" id="bo-service">—</span>
            <span class="bo-rate-u">BDT / USD</span>
          </div>
        </div>
        <div class="bo-calc">
          <label for="bo-usd-input">Estimate budget</label>
          <div class="bo-calc-row">
            <input id="bo-usd-input" type="number" min="5" step="1" value="50" />
            <span class="bo-calc-usd">USD</span>
            <span class="bo-calc-eq">≈</span>
            <strong id="bo-bdt-out">—</strong>
            <span>BDT</span>
          </div>
        </div>
        <div class="bo-why">
          <h3>Why is the service rate above the market rate?</h3>
          <ul>
            <li><strong>Tax:</strong> Applicable service and payment taxes are included in the final rate.</li>
            <li><strong>Bank and gateway costs:</strong> Provider charges and settlement differences can increase the effective conversion cost.</li>
            <li><strong>Transparent service rate:</strong> The current calculation is shown before confirmation and updates with the reference market rate.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ALGORITHM -->
  <section class="bo-sec bo-muted" id="algorithm">
    <div class="container">
      <div class="bo-center reveal">
        <p class="bo-eye">Algorithm &amp; mobile</p>
        <h2>How delivery works in practice</h2>
      </div>
      <div class="bo-algo">
        {algo.map((a, i) => (
          <article class="bo-acard reveal">
            <span class="sv-card-icon"><ServiceIcons name={['facebook','phone','auth','video'][i]} size={30} /></span>
            <h3>{a.t}</h3>
            <p>{a.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bo-sec" id="faq">
    <div class="container bo-faq-wrap">
      <div class="bo-center reveal">
        <p class="bo-eye">FAQ</p>
        <h2>Boosting &amp; rate questions</h2>
      </div>
      <div class="bo-faq reveal">
        {faqs.map((f) => (
          <details class="bo-faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bo-cta">
    <div class="container bo-cta-inner reveal">
      <div>
        <p class="bo-eye light">Next step</p>
        <h2>Send your post link or goal — we suggest boost or campaign</h2>
        <p>WhatsApp {SITE.whatsapp} · {SITE.email1}</p>
      </div>
      <div class="bo-cta-btns">
        <a class="btn btn-light" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a class="btn btn-ghost" href="/services/campaign">Campaign page</a>
        <a class="btn btn-ghost" href="/contact">Contact</a>
      </div>
    </div>
  </section>

  <RelatedServices />
  </main>
  <Footer />
</Layout>

<script is:inline>
(function () {
  var REF_MARKET = 122;
  var REF_SERVICE = 150;
  var FACTOR = REF_SERVICE / REF_MARKET;
  var CACHE_KEY = 'creavix_usd_bdt_v1';
  var DAY_MS = 24 * 60 * 60 * 1000;

  var elMarket = document.getElementById('bo-market');
  var elService = document.getElementById('bo-service');
  var elStatus = document.getElementById('bo-rate-status');
  var elInput = document.getElementById('bo-usd-input');
  var elOut = document.getElementById('bo-bdt-out');

  function apply(market, source) {
    var service = Math.round(market * FACTOR * 100) / 100;
    if (elMarket) elMarket.textContent = market.toFixed(2);
    if (elService) elService.textContent = service.toFixed(2);
    if (elStatus) {
      elStatus.textContent =
        source === 'live'
          ? 'Updated from market feed · formula × (150/122)'
          : source === 'cache'
            ? 'Today’s cached rate · formula × (150/122)'
            : 'Fallback rate (API offline) · 122 → 150 baseline';
    }
    window.__creavixServiceRate = service;
    updateCalc();
    document.querySelectorAll('.bo-tier').forEach(function (node) {
      var usd = parseFloat(node.getAttribute('data-usd') || '0');
      var span = node.querySelector('.js-tier-bdt');
      if (span) span.textContent = Math.round(usd * service).toLocaleString('en-BD');
    });
  }

  function updateCalc() {
    var rate = window.__creavixServiceRate || REF_SERVICE;
    var usd = parseFloat((elInput && elInput.value) || '0');
    if (!isFinite(usd) || usd < 0) usd = 0;
    if (elOut) elOut.textContent = Math.round(usd * rate).toLocaleString('en-BD');
  }

  if (elInput) elInput.addEventListener('input', updateCalc);

  function readCache() {
    try {
      var raw = localStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      var o = JSON.parse(raw);
      if (!o || !o.market || !o.ts) return null;
      if (Date.now() - o.ts > DAY_MS) return null;
      return o.market;
    } catch (e) {
      return null;
    }
  }

  function writeCache(market) {
    try {
      localStorage.setItem(CACHE_KEY, JSON.stringify({ market: market, ts: Date.now() }));
    } catch (e) {}
  }

  var cached = readCache();
  if (cached) apply(cached, 'cache');
  else apply(REF_MARKET, 'fallback');

  fetch('https://open.er-api.com/v6/latest/USD')
    .then(function (r) {
      return r.json();
    })
    .then(function (data) {
      var m = data && data.rates && data.rates.BDT;
      if (typeof m === 'number' && m > 0) {
        writeCache(m);
        apply(m, 'live');
      }
    })
    .catch(function () {
      /* keep cache or fallback */
    });
})();
</script>

<style>
  .bo-hero {
    padding: 5.25rem 1.25rem 3.5rem;
    background:
      radial-gradient(ellipse 55% 45% at 85% 15%, rgba(37, 99, 235, 0.14), transparent 55%),
      radial-gradient(ellipse 40% 30% at 10% 90%, rgba(245, 158, 11, 0.08), transparent 50%),
      linear-gradient(180deg, #fff, #F8FAFC);
  }
  .bo-hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .bo-hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
  .bo-eye {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
