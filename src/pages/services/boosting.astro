    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: 0 0 0 12px rgba(37, 99, 235, 0.15), 0 20px 40px rgba(37, 99, 235, 0.35);
