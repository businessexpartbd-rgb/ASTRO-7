    position: absolute;
    inset: 18px;
    border-radius: 50%;
    border: 2px dashed rgba(37, 99, 235, 0.25);
    animation: bo-spin 18s linear infinite;
  }
  .bo-core {
    position: relative;
    z-index: 2;
    width: 120px;
    height: 120px;
    border-radius: 50%;
