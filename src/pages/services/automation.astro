---
/**
 * Automation Service — Facebook / Instagram Messenger AI
 * Human-like replies · multi-service bots · call conversion
 * Bangladesh + international marketplace focus
 */
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ServiceIcons from '../../components/icons/ServiceIcons.astro';
import { SITE } from '../../data/site';

const seoTitle =
  'Facebook Messenger Automation Bangladesh | AI Chatbot & Human-like Replies — Creavix iT';
const seoDescription =
  'Automate Facebook & Instagram Messenger with human-like AI replies. 24/7 inbox, multi-service bots, lead capture and call conversion for Bangladesh and global businesses. Creavix iT Solution.';

const channels = [
  {
    title: 'WhatsApp Business',
    desc: 'Instant FAQ, order updates, lead qualification and human handoff in one trusted conversation.',
    logo: '/automation/whatsapp.svg',
  },
  {
    title: 'Messenger',
    desc: 'Page inbox, comment-to-DM, story replies and campaign conversations — always on.',
    logo: '/automation/messenger.svg',
  },
  {
    title: 'Instagram DM',
    desc: 'Automated DMs, story mentions and comment replies tuned for product and service questions.',
    logo: '/automation/instagram.svg',
  },
  {
    title: 'Email Automation',
    desc: 'Welcome, follow-up, reminders and personalized lead nurturing triggered at the right moment.',
    logo: '/automation/gmail.svg',
  },
  {
    title: 'CRM & Lead Routing',
    desc: 'Capture, score and route every lead to the right team with a clean customer history.',
    logo: '/automation/hubspot.svg',
  },
  {
    title: 'Sheets & Reporting',
    desc: 'Sync enquiries, orders and campaign results into live dashboards without manual copying.',
    logo: '/automation/googlesheets.svg',
  },
];
const stepIcons = ['strategy', 'human', 'auth', 'rocket'];
const benefitIcons = ['automation', 'boosting', 'phone', 'marketing', 'strategy', 'global'];
const useCaseIcons = ['app', 'campaign', 'production', 'global'];

const benefits = [
  {
    t: '24/7 authentic replies',
    d: 'Customers get instant answers in Bangla or English — sounds human, not robotic.',
  },
  {
    t: 'Zero missed leads',
    d: 'Night-time and peak-hour messages are captured, qualified and tagged automatically.',
  },
  {
    t: 'Call conversion',
    d: 'Hot leads can be guided to a phone call or WhatsApp voice — bot hands off cleanly.',
  },
  {
    t: 'Lower support cost',
    d: 'Routine FAQs handled by automation; your team focuses only on high-value chats.',
  },
  {
    t: 'Service-aware flows',
    d: 'Video, web, boosting, apps — each service gets its own script and offer path.',
  },
  {
    t: 'BD + global ready',
    d: 'Built for local marketplaces and international clients who expect fast inbox response.',
  },
];

const steps = [
  {
    n: '01',
    t: 'Audit & map',
    d: 'We review your Page, services, FAQs and peak message types.',
  },
  {
    n: '02',
    t: 'Script & train',
    d: 'Human-like reply scripts in Bangla/English + intent routing for every service.',
  },
  {
    n: '03',
    t: 'Connect & test',
    d: 'Messenger / Instagram connected, flows tested with real scenarios.',
  },
  {
    n: '04',
    t: 'Go live & optimize',
    d: 'Launch, monitor conversions, refine answers weekly from real chats.',
  },
];

const useCases = [
  {
    tag: 'E-commerce',
    title: 'Price, stock & order',
    points: ['Product price & size', 'Delivery area check', 'Order status links', 'Upsell related items'],
  },
  {
    tag: 'Agency / Service',
    title: 'Quote & booking',
    points: ['Service menu routing', 'Budget qualification', 'Appointment slots', 'WhatsApp handoff'],
  },
  {
    tag: 'Education / Clinic',
    title: 'Info & appointment',
    points: ['Course or package info', 'Location & hours', 'Book a call', 'Reminder follow-ups'],
  },
  {
    tag: 'International',
    title: 'Lead capture 24/7',
    points: ['Timezone-safe replies', 'English + local language', 'CRM tag & export', 'Sales call trigger'],
  },
];

const future = [
  {
    t: 'Smarter intent AI',
    d: 'Continuous learning from your real inbox so replies stay natural and on-brand.',
  },
  {
    t: 'Voice & call bots',
    d: 'Beyond chat — guided call booking and simple voice FAQ for power users.',
  },
  {
    t: 'Omnichannel inbox',
    d: 'Messenger, Instagram, WhatsApp and web chat under one automation brain.',
  },
  {
    t: 'Revenue analytics',
    d: 'See which flows create orders, calls and closed deals — not just “messages answered”.',
  },
];

const faqs = [
  {
    q: 'What is automation — will people stop replying?',
    a: 'Automation answers routine questions such as price, opening hours, services and location instantly. Complex or sensitive conversations are handed over to your team. People stay in control while repetitive work is reduced.',
  },
  {
    q: 'Will the replies sound robotic?',
    a: 'No. Creavix creates human-like scripts with natural sentences, personalized greetings and your brand tone. The system can communicate in English, Bangla or a controlled mix when required.',
  },
  {
    q: 'Which platforms can be connected?',
    a: 'We can connect WhatsApp Business, Facebook Messenger, Instagram DM, email, web chat, CRM platforms and reporting tools according to your workflow and approved API access.',
  },
  {
    q: 'How can one inbox handle multiple services?',
    a: 'Intent routing identifies what a customer needs. A message about video, websites or marketing starts the correct flow with its own pricing, package, booking and follow-up path.',
  },
  {
    q: 'Can automation create calls and sales?',
    a: 'Yes. When a high-intent lead is detected, the workflow can collect a phone number, offer a callback slot, share a WhatsApp call option and notify your sales team immediately.',
  },
  {
    q: 'Why is this important for growing businesses?',
    a: 'Customers message outside office hours and expect a fast response. A 24/7 workflow prevents missed leads, improves support consistency and moves qualified buyers toward the next action.',
  },
  {
    q: 'How long does setup take?',
    a: 'A focused FAQ and lead-capture workflow can usually be prepared within a few working days. Multi-service systems require additional mapping, API configuration and testing. The timeline is confirmed before work begins.',
  },
  {
    q: 'How are data and privacy handled?',
    a: 'We use official platform tools and approved integrations whenever available. Access is limited to the required workflow, and customer data remains under your business control with privacy-aware configuration.',
  },
];

const integrations = [
  { name: 'WhatsApp', logo: '/automation/whatsapp.svg' },
  { name: 'Messenger', logo: '/automation/messenger.svg' },
  { name: 'Instagram', logo: '/automation/instagram.svg' },
  { name: 'Gmail', logo: '/automation/gmail.svg' },
  { name: 'HubSpot', logo: '/automation/hubspot.svg' },
  { name: 'Sheets', logo: '/automation/googlesheets.svg' },
];
---

<Layout title={seoTitle} description={seoDescription}>
  <TopBar />
  <Nav active="services" />

  <!-- HERO -->
  <section class="au-hero">
    <div class="container au-hero-grid">
      <div class="au-hero-copy reveal">
        <p class="au-eye">Intelligent Business Automation</p>
        <h1>Every Message. Every Lead. <span>One Smart System.</span></h1>
        <p class="au-sub">
          Connect WhatsApp, Messenger, Instagram, email, CRM and AI into one responsive workflow.
          We design human-like automation that replies, qualifies, follows up and grows your business 24/7.
        </p>
        <div class="au-actions">
          <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Get automation quote</a>
          <a class="btn btn-outline" href="#how-it-works">How it works</a>
        </div>
        <ul class="au-trust">
          <li>24/7 response</li>
          <li>Bangla + English</li>
          <li>Official APIs</li>
          <li>Human handoff</li>
        </ul>
      </div>

      <div class="au-command reveal" aria-label="Animated automation workflow illustration">
        <div class="au-command-top">
          <span class="au-window-dots"><i></i><i></i><i></i></span>
          <span>CREAVIX · AUTOMATION OS</span>
          <span class="au-status"><i></i> LIVE</span>
        </div>
        <div class="au-command-stage">
          <div class="au-orbit au-orbit-one"></div>
          <div class="au-orbit au-orbit-two"></div>
          <div class="au-brain">
            <span class="au-brain-pulse"></span>
            <ServiceIcons name="automation" size={48} />
            <strong>AI FLOW</strong>
            <small>6 systems connected</small>
          </div>
          {integrations.map((item, i) => (
            <div class={`au-brand au-brand-${i + 1}`}>
              <img src={item.logo} width="28" height="28" alt="" loading="eager" decoding="async" />
              <span>{item.name}</span>
            </div>
          ))}
          <svg class="au-connectors" viewBox="0 0 600 420" preserveAspectRatio="none" aria-hidden="true">
            <path d="M300 210 C220 150 170 105 92 72" />
            <path d="M300 210 C380 150 430 105 508 72" />
            <path d="M300 210 C190 215 135 210 68 210" />
            <path d="M300 210 C410 215 465 210 532 210" />
            <path d="M300 210 C220 280 170 330 92 350" />
            <path d="M300 210 C380 280 430 330 508 350" />
          </svg>
          <div class="au-event au-event-one"><span>01</span><b>New lead captured</b></div>
          <div class="au-event au-event-two"><span>02</span><b>Reply + CRM synced</b></div>
        </div>
        <div class="au-command-foot">
          <span><i></i> Response &lt; 3 sec</span><span>99.9% workflow uptime</span><span>Human handoff ready</span>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT IS -->
  <section class="au-sec" id="what-is">
    <div class="container au-split">
      <div class="reveal">
        <p class="au-eye">What is Automation?</p>
        <h2>Your inbox works while your team sleeps</h2>
        <p class="au-body">
          <strong>Chat automation</strong> connects your Facebook Page and Instagram to smart flows.
          When a customer messages about price, services, location or booking, the system replies
          instantly — in natural language — then collects details or offers a call.
        </p>
        <p class="au-body">
          It is not a cold keyword bot. Creavix designs <strong>service-aware scripts</strong> so
          video editing, web development, boosting and other offers each get the right path.
          Humans still handle complex deals; automation clears the queue.
        </p>
      </div>
      <div class="au-stat-grid reveal">
        <div class="au-stat"><strong>24/7</strong><span>Reply window</span></div>
        <div class="au-stat"><strong>&lt;3s</strong><span>Typical first reply</span></div>
        <div class="au-stat"><strong>BN + EN</strong><span>Language ready</span></div>
        <div class="au-stat"><strong>Call</strong><span>Hot-lead handoff</span></div>
      </div>
    </div>
  </section>

  <!-- CHANNELS -->
  <section class="au-sec au-muted">
    <div class="container">
      <div class="au-center reveal">
        <p class="au-eye">Channels</p>
        <h2>Where automation runs</h2>
        <p class="au-lead">Messenger-first for Bangladesh marketplaces — expandable worldwide.</p>
      </div>
      <div class="au-cards3 au-channel-grid">
        {channels.map((c) => (
          <article class="au-card au-channel-card reveal">
            <img class="au-brand-logo" src={c.logo} width="42" height="42" alt={`${c.title} official logo`} loading="lazy" decoding="async" />
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="au-sec" id="how-it-works">
    <div class="container">
      <div class="au-center reveal">
        <p class="au-eye">Process</p>
        <h2>How Creavix sets up automation</h2>
      </div>
      <div class="au-steps">
        {steps.map((s, i) => (
          <div class="au-step reveal">
            <div class="au-icon-row"><span class="au-svg-icon"><ServiceIcons name={stepIcons[i]} size={32} /></span><span class="au-step-n">{s.n}</span></div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="au-sec au-muted">
    <div class="container">
      <div class="au-center reveal">
        <p class="au-eye">Benefits</p>
        <h2>Why businesses automate Messenger</h2>
      </div>
      <div class="au-cards3">
        {benefits.map((b, i) => (
          <article class="au-card reveal">
            <span class="au-svg-icon" aria-hidden="true"><ServiceIcons name={benefitIcons[i]} size={34} /></span>
            <h3>{b.t}</h3>
            <p>{b.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- USE CASES -->
  <section class="au-sec">
    <div class="container">
      <div class="au-center reveal">
        <p class="au-eye">Use cases</p>
        <h2>Built for real marketplaces</h2>
        <p class="au-lead">From local Facebook shops to global lead gen — same engine, tailored scripts.</p>
      </div>
      <div class="au-cards2">
        {useCases.map((u, i) => (
          <article class="au-usecase reveal">
            <span class="au-svg-icon" aria-hidden="true"><ServiceIcons name={useCaseIcons[i]} size={34} /></span>
            <span class="au-tag">{u.tag}</span>
            <h3>{u.title}</h3>
            <ul>
              {u.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- API ORCHESTRATION VISUAL -->
  <section class="au-sec au-flow-sec">
    <div class="container">
      <div class="au-center reveal">
        <p class="au-eye">API Orchestration</p>
        <h2>Six tools. One automated growth engine.</h2>
        <p class="au-lead">Official APIs pass secure data between conversations, AI, CRM and your team—without repetitive manual work.</p>
      </div>
      <div class="au-api-board reveal">
        <div class="au-api-inputs">
          {integrations.slice(0, 3).map((item) => (
            <div class="au-api-pill"><img src={item.logo} width="26" height="26" alt="" /><span>{item.name}</span></div>
          ))}
        </div>
        <div class="au-api-arrow"><span></span></div>
        <div class="au-api-core"><ServiceIcons name="ai" size={42} /><strong>Creavix AI Router</strong><small>Intent · Language · Priority</small></div>
        <div class="au-api-arrow"><span></span></div>
        <div class="au-api-outputs">
          {integrations.slice(3).map((item) => (
            <div class="au-api-pill"><img src={item.logo} width="26" height="26" alt="" /><span>{item.name}</span></div>
          ))}
        </div>
      </div>
      <div class="au-api-results reveal"><span>Instant reply</span><span>Lead scored</span><span>Team notified</span><span>Follow-up scheduled</span></div>
    </div>
  </section>

  <!-- FUTURE -->
  <section class="au-sec au-muted">
    <div class="container">
      <div class="au-center reveal">
        <p class="au-eye">Roadmap</p>
        <h2>Where automation is going</h2>
        <p class="au-lead">We design flows that can grow with AI — without rebuilding everything later.</p>
      </div>
      <div class="au-cards2">
        {future.map((f) => (
          <article class="au-card reveal">
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="au-sec" id="faq">
    <div class="container au-faq-wrap">
      <div class="au-center reveal">
        <p class="au-eye">FAQ</p>
        <h2>Questions clients ask before ordering</h2>
      </div>
      <div class="au-faq reveal">
        {faqs.map((item) => (
          <details class="au-faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="au-cta">
    <div class="container au-cta-inner reveal">
      <div>
        <p class="au-eye light">Start automation</p>
        <h2>Turn every conversation into a growth opportunity</h2>
        <p>WhatsApp {SITE.whatsapp} · {SITE.email1} · {SITE.hotline}</p>
      </div>
      <div class="au-cta-btns">
        <a class="btn btn-light" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">WhatsApp us</a>
        <a class="btn btn-ghost" href="/contact">Contact form</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .au-svg-icon { width:54px; height:54px; display:grid; place-items:center; margin-bottom:.8rem; border-radius:16px; background:linear-gradient(145deg,#fff,#edf4ff); border:1px solid rgba(37,99,235,.12); box-shadow:0 10px 24px rgba(37,99,235,.12); }
  .au-icon-row { display:flex; align-items:flex-start; justify-content:space-between; gap:.75rem; }
  .au-hero {
    padding: 5.25rem 1.25rem 3.5rem;
    background:
      radial-gradient(ellipse 55% 45% at 85% 15%, rgba(37, 99, 235, 0.14), transparent 60%),
      radial-gradient(ellipse 40% 35% at 10% 80%, rgba(14, 165, 233, 0.08), transparent 55%),
      linear-gradient(180deg, #fff 0%, #F8FAFC 100%);
  }
  .au-hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .au-hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
    }
  }
  .au-eye {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2563EB;
  }
  .au-eye.light { color: #DBEAFE !important; opacity: 1 !important; }
  .au-hero h1 {
    margin: 0 0 0.9rem;
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(1.75rem, 4.2vw, 2.65rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #0B0F19;
  }
  .au-sub {
    margin: 0 0 1.35rem;
    color: #475569;
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 34rem;
  }
  .au-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }
  .au-trust {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .au-trust li {
    font-size: 0.75rem;
    font-weight: 600;
    color: #1E40AF;
    background: #EFF6FF;
    border: 1px solid rgba(37, 99, 235, 0.15);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
  }

  /* Phone mock */
  .au-visual {
    position: relative;
    display: flex;
    justify-content: center;
    min-height: 320px;
  }
  .au-phone {
    width: min(100%, 320px);
    border-radius: 24px;
    background: #0B1220;
    box-shadow:
      0 28px 60px rgba(15, 23, 42, 0.22),
      0 0 0 1px rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  .au-phone-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: #111827;
    color: #E2E8F0;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .au-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2563EB;
  }
  .au-live {
    margin-left: auto;
    color: #34D399;
    font-size: 0.65rem;
  }
  .au-chat {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-height: 260px;
    background: linear-gradient(180deg, #0F172A, #1E293B);
  }
  .au-bubble {
    max-width: 92%;
    padding: 0.55rem 0.75rem;
    border-radius: 14px;
    font-size: 0.78rem;
    line-height: 1.45;
  }
  .au-bubble.them {
    align-self: flex-start;
    background: #334155;
    color: #F1F5F9;
    border-bottom-left-radius: 4px;
  }
  .au-bubble.us {
    align-self: flex-end;
    background: linear-gradient(135deg, #2563EB, #1D4ED8);
    color: #fff;
    border-bottom-right-radius: 4px;
  }
  .au-cta-chip {
    display: inline-block;
    margin-top: 0.35rem;
    padding: 0.2rem 0.5rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.2);
    font-weight: 700;
    font-size: 0.72rem;
  }
  .au-phone-foot {
    text-align: center;
    padding: 0.55rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #94A3B8;
    background: #0B1220;
  }
  .au-float {
    position: absolute;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.1);
    color: #1E40AF;
    animation: au-bob 4s ease-in-out infinite;
  }
  .au-float-1 { top: 8%; left: 0; animation-delay: 0s; }
  .au-float-2 { top: 42%; right: 0; animation-delay: 0.6s; }
  .au-float-3 { bottom: 12%; left: 4%; animation-delay: 1.2s; }
  @keyframes au-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .au-sec { padding: 3.5rem 1.25rem; background: #fff; }
  .au-muted { background: #F8FAFC; }
  .au-center {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto 2rem;
  }
  .au-center h2,
  .au-split h2 {
    margin: 0 0 0.5rem;
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-weight: 800;
    color: #0B0F19;
    letter-spacing: -0.02em;
  }
  .au-lead,
  .au-body {
    margin: 0;
    color: #64748B;
    line-height: 1.65;
    font-size: 0.98rem;
  }
  .au-body + .au-body { margin-top: 0.85rem; }
  .au-body strong { color: #0F172A; }

  .au-split {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 800px) {
    .au-split { grid-template-columns: 1.2fr 0.8fr; gap: 3rem; }
  }
  .au-stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .au-stat {
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 16px;
    padding: 1.15rem 1rem;
    text-align: center;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  }
  .au-stat strong {
    display: block;
    font-family: Outfit, system-ui, sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    color: #2563EB;
    margin-bottom: 0.2rem;
  }
  .au-stat span { font-size: 0.8rem; color: #64748B; }

  .au-cards4,
  .au-cards3,
  .au-cards2 {
    display: grid;
