---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../data/site';

/** SEO service cards — layout & copy structure matched to agency SEO hub */
const services = [
  {
    id: 'seo-service',
    title: 'SEO Service',
    desc: 'Boost your online visibility with our top-notch SEO services. Enhance your website rankings, drive traffic, and increase website authority with us. So, maximize your digital presence and reach your target audience right now!',
    href: '#seo-overview',
    layout: 'full' as const,
    tone: 'purple' as const,
    art: 'seo',
  },
  {
    id: 'ecommerce-seo',
    title: 'E-Commerce SEO',
    desc: 'Creavix iT specializes in E-commerce SEO, optimizing online stores for higher visibility, increased traffic, and improved sales conversions. Elevate your e-commerce business today!',
    href: '#ecommerce',
    layout: 'half' as const,
    tone: 'pink' as const,
    art: 'ecommerce',
  },
  {
    id: 'local-seo',
    title: 'Local SEO',
    desc: 'Creavix iT offers custom-fit Local SEO solutions to boost your business visibility. Dominate local searches, attract nearby customers, and effectively grow your brand’s presence in your community.',
    href: '#local',
    layout: 'half' as const,
    tone: 'blue' as const,
    art: 'local',
  },
  {
    id: 'guest-post',
    title: 'Guest Post Service',
    desc: 'Expand your brand’s horizons with our strategic Guest Post Service. Unlock high-traffic platforms, boost authority, and amplify your online presence.',
    href: '#guest-post',
    layout: 'full' as const,
    tone: 'purple' as const,
    art: 'guest',
  },
  {
    id: 'seo-audit',
    title: 'SEO Audit Service',
    desc: 'Creavix iT conducts comprehensive SEO Audit Services to enhance your website’s performance. Unlock potential, optimize strategies, and dominate search rankings.',
    href: '#audit',
    layout: 'half' as const,
    tone: 'pink' as const,
    art: 'audit',
  },
  {
    id: 'gbp',
    title: 'Google Business Profile Optimization',
    desc: 'Creavix iT specializes in Google Business Profile Optimization, maximizing your online visibility. Elevate your local presence, attract customers, and stand out among competitors with our tailored optimization strategies for your business profile.',
    href: '#gbp',
    layout: 'half' as const,
    tone: 'blue' as const,
    art: 'gbp',
  },
  {
    id: 'aso',
    title: 'App Store Optimization',
    desc: 'Creavix iT offers expert App Store Optimization services. Enhance app visibility, increase downloads, and boost user engagement for your mobile application’s success.',
    href: '#aso',
    layout: 'full' as const,
    tone: 'purple' as const,
    art: 'aso',
  },
];
---
<Layout
  title="SEO Services Bangladesh | Digital Marketing — Creavix iT"
  description="Professional SEO services by Creavix iT Solution — on-page SEO, local SEO, e-commerce SEO, SEO audit, Google Business Profile optimization, guest posting and app store optimization."
>
  <TopBar />
  <Nav active="services" />

  <section class="seo-page">
    <div class="container seo-wrap">
      <header class="seo-head">
        <p class="seo-eyebrow">Digital Marketing · SEO</p>
        <h1 class="seo-h1">SEO That Builds Visibility, Authority &amp; Revenue</h1>
        <p class="seo-lead">
          Build qualified organic traffic with technical SEO, search-led content and measurable
          authority growth for businesses in Bangladesh and competitive global markets.
        </p>
      </header>

      <div class="seo-grid">
        {services.map((s) => (
          <article
            class={`seo-card seo-card--${s.layout} seo-card--${s.tone}`}
            id={s.id}
          >
            <div class="seo-card-art" aria-hidden="true" data-art={s.art}>
              {s.art === 'seo' && (
                <svg viewBox="0 0 320 220" class="art-svg" role="img">
                  <circle cx="140" cy="110" r="58" fill="none" stroke="#1E3A8A" stroke-width="10"/>
                  <line x1="182" y1="152" x2="240" y2="200" stroke="#1E3A8A" stroke-width="12" stroke-linecap="round"/>
                  <text x="140" y="118" text-anchor="middle" font-size="28" font-weight="800" fill="#1E3A8A" font-family="system-ui">SEO</text>
                  <circle cx="70" cy="48" r="14" fill="#3B82F6" opacity=".85"/>
                  <rect x="250" y="40" width="36" height="28" rx="6" fill="#60A5FA"/>
                  <rect x="40" y="160" width="40" height="28" rx="6" fill="#F59E0B"/>
                  <circle cx="260" cy="160" r="16" fill="#EF4444" opacity=".9"/>
                  <rect x="90" y="30" width="32" height="22" rx="4" fill="#22C55E"/>
                </svg>
              )}
              {s.art === 'ecommerce' && (
                <svg viewBox="0 0 280 200" class="art-svg" role="img">
                  <rect x="70" y="70" width="120" height="80" rx="10" fill="#DBEAFE" stroke="#3B82F6" stroke-width="3"/>
                  <text x="130" y="118" text-anchor="middle" font-size="22" font-weight="800" fill="#1D4ED8">SEO</text>
                  <path d="M160 50 L175 20 L190 50" fill="#6366F1"/>
                  <circle cx="210" cy="90" r="22" fill="#F472B6" opacity=".9"/>
                  <rect x="50" y="40" width="36" height="28" rx="6" fill="#FBBF24"/>
                  <path d="M40 160 h60 l12-40 h80" fill="none" stroke="#94A3B8" stroke-width="4"/>
                </svg>
              )}
              {s.art === 'local' && (
                <svg viewBox="0 0 280 200" class="art-svg" role="img">
                  <rect x="150" y="60" width="90" height="90" rx="12" fill="#BFDBFE" stroke="#2563EB" stroke-width="3"/>
                  <path d="M175 110 L195 70 L215 110 Z" fill="#1D4ED8"/>
                  <rect x="40" y="80" width="90" height="70" rx="10" fill="#EFF6FF" stroke="#3B82F6" stroke-width="3"/>
                  <text x="85" y="122" text-anchor="middle" font-size="16" font-weight="800" fill="#1E40AF">LOCAL</text>
                  <g fill="#FBBF24">
                    <path d="M50 55l3 8h9l-7 5 3 8-8-5-8 5 3-8-7-5h9z"/>
                    <path d="M70 55l3 8h9l-7 5 3 8-8-5-8 5 3-8-7-5h9z"/>
                    <path d="M90 55l3 8h9l-7 5 3 8-8-5-8 5 3-8-7-5h9z"/>
                  </g>
                </svg>
              )}
              {s.art === 'guest' && (
                <svg viewBox="0 0 320 180" class="art-svg" role="img">
                  <rect x="40" y="50" width="100" height="80" rx="10" fill="#E0E7FF" stroke="#6366F1" stroke-width="3"/>
                  <circle cx="70" cy="80" r="14" fill="#818CF8"/>
                  <rect x="95" y="72" width="30" height="8" rx="2" fill="#A5B4FC"/>
                  <rect x="95" y="88" width="22" height="6" rx="2" fill="#C7D2FE"/>
                  <path d="M160 90 H220" stroke="#94A3B8" stroke-width="3" stroke-dasharray="6 4"/>
                  <circle cx="240" cy="90" r="28" fill="#DBEAFE" stroke="#3B82F6" stroke-width="3"/>
                  <text x="240" y="96" text-anchor="middle" font-size="11" font-weight="700" fill="#1D4ED8">POST</text>
                </svg>
              )}
              {s.art === 'audit' && (
                <svg viewBox="0 0 280 200" class="art-svg" role="img">
                  <rect x="60" y="40" width="140" height="110" rx="12" fill="#EFF6FF" stroke="#3B82F6" stroke-width="3"/>
                  <circle cx="160" cy="120" r="36" fill="none" stroke="#1D4ED8" stroke-width="8"/>
                  <line x1="186" y1="146" x2="220" y2="176" stroke="#1D4ED8" stroke-width="10" stroke-linecap="round"/>
                  <rect x="80" y="60" width="70" height="10" rx="3" fill="#93C5FD"/>
                  <rect x="80" y="80" width="50" height="8" rx="3" fill="#BFDBFE"/>
                  <text x="100" y="150" font-size="14" font-weight="800" fill="#1E40AF">Audit</text>
                </svg>
              )}
              {s.art === 'gbp' && (
                <svg viewBox="0 0 280 200" class="art-svg" role="img">
                  <rect x="50" y="50" width="100" height="100" rx="12" fill="#DBEAFE" stroke="#2563EB" stroke-width="3"/>
                  <circle cx="100" cy="90" r="20" fill="#fff" stroke="#4285F4" stroke-width="4"/>
                  <text x="100" y="96" text-anchor="middle" font-size="14" font-weight="800" fill="#4285F4">G</text>
                  <rect x="170" y="60" width="70" height="80" rx="8" fill="#EFF6FF" stroke="#94A3B8" stroke-width="2"/>
                  <rect x="180" y="75" width="50" height="8" rx="2" fill="#CBD5E1"/>
                  <rect x="180" y="92" width="40" height="6" rx="2" fill="#E2E8F0"/>
                  <g fill="#FBBF24" transform="translate(175 115) scale(.7)">
                    <path d="M12 2l2.5 7h7l-5.5 4 2 7-6-4.5L6 20l2-7-5.5-4h7z"/>
                  </g>
                </svg>
              )}
              {s.art === 'aso' && (
                <svg viewBox="0 0 320 180" class="art-svg" role="img">
                  <rect x="120" y="20" width="80" height="140" rx="14" fill="#1E293B"/>
                  <rect x="128" y="36" width="64" height="100" rx="4" fill="#EFF6FF"/>
                  <circle cx="160" cy="148" r="6" fill="#64748B"/>
                  <rect x="40" y="50" width="50" height="50" rx="10" fill="#DBEAFE" stroke="#3B82F6" stroke-width="2"/>
                  <text x="65" y="80" text-anchor="middle" font-size="12" font-weight="800" fill="#1D4ED8">ASO</text>
                  <rect x="230" y="50" width="50" height="50" rx="10" fill="#E0E7FF" stroke="#6366F1" stroke-width="2"/>
                </svg>
              )}
            </div>
            <div class="seo-card-body">
              <h2 class="seo-card-title">{s.title}</h2>
              <p class="seo-card-desc">{s.desc}</p>
              <a class="seo-see" href={s.href}>
                See Details
                <span class="seo-see-ico" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Detail anchors (expanded copy for See Details) -->
  <section class="seo-details" id="seo-overview">
    <div class="container">
      <h2>Full-funnel SEO with Creavix iT</h2>
      <p>
        From technical foundations and on-page structure to content, links and local signals —
        we build SEO systems that support real business goals: traffic, leads and sales.
        Every engagement starts with measurement and ends with clear reporting.
      </p>
    </div>
  </section>

  <section class="seo-details alt" id="ecommerce">
    <div class="container">
      <h2>E-Commerce SEO</h2>
      <p>
        Product schema, category architecture, site speed, crawl budget and conversion-minded
        content — so your store ranks for buying intent and turns visits into orders.
      </p>
    </div>
  </section>

  <section class="seo-details" id="local">
    <div class="container">
      <h2>Local SEO</h2>
      <p>
        Maps pack visibility, NAP consistency, local landing pages and review strategy so
        nearby customers find and choose your business first.
      </p>
    </div>
  </section>

  <section class="seo-details alt" id="guest-post">
    <div class="container">
      <h2>Guest Post Service</h2>
      <p>
        Strategic placements on relevant, high-quality publications to earn authority links
        and brand exposure — not random spam blogs.
      </p>
    </div>
  </section>

  <section class="seo-details" id="audit">
    <div class="container">
      <h2>SEO Audit Service</h2>
      <p>
        Technical, content and competitive audit with prioritized fixes — so you know what
        blocks rankings and what to ship next.
      </p>
    </div>
  </section>

  <section class="seo-details alt" id="gbp">
    <div class="container">
      <h2>Google Business Profile Optimization</h2>
      <p>
        Complete profile setup, categories, photos, posts and review workflows that improve
        local pack performance and click-through.
      </p>
    </div>
  </section>

  <section class="seo-details" id="aso">
    <div class="container">
      <h2>App Store Optimization</h2>
      <p>
        Keyword-rich titles and descriptions, creative assets and conversion testing to grow
        organic installs on major app stores.
      </p>
    </div>
  </section>

  <section class="seo-cta">
    <div class="container seo-cta-grid">
      <div class="seo-cta-copy">
        <p class="seo-cta-eye">Book a Free Consultation</p>
        <h2 class="seo-cta-title">Let’s Talk</h2>
        <p class="seo-cta-sub">Tell us your goals — rankings, local leads or store growth. We’ll map a clear SEO path.</p>
        <div class="seo-cta-actions">
          <a class="btn btn-light" href="/contact">Contact Us</a>
          <a class="btn btn-outline-light" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
      </div>
      <div class="seo-cta-visual" aria-hidden="true">
        <div class="seo-cta-photo">
          <div class="seo-cta-photo-inner">
            <span class="dot"></span>
            <span class="line"></span>
            <span class="line short"></span>
            <span class="badge">SEO Strategy</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .seo-page {
    padding: 4.5rem 1.25rem 3rem;
    background: #ffffff;
  }
  .seo-wrap { max-width: 1100px; }
  .seo-head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
  }
  .seo-eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2563EB;
  }
  .seo-h1 {
    margin: 0 0 0.75rem;
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: clamp(1.85rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.03em;
  }
  .seo-lead {
    margin: 0;
    color: #64748B;
    line-height: 1.65;
    font-size: 1.05rem;
  }

  .seo-grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 800px) {
    .seo-grid {
      grid-template-columns: 1fr 1fr;
    }
    .seo-card--full {
      grid-column: 1 / -1;
    }
  }

  .seo-card {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    border-radius: 24px;
    padding: 1.5rem 1.5rem 1.65rem;
    overflow: hidden;
  }
  @media (min-width: 800px) {
    .seo-card--full {
      grid-template-columns: 1fr 1.1fr;
      padding: 2rem 2.25rem;
      gap: 2rem;
    }
  }
  .seo-card--purple { background: #E8E7FF; }
  .seo-card--pink { background: #FFE8EF; }
  .seo-card--blue { background: #D6EEFF; }

  .seo-card-art {
    display: grid;
    place-items: center;
    min-height: 160px;
  }
  .art-svg {
    width: min(100%, 320px);
    height: auto;
  }

  .seo-card-title {
    margin: 0 0 0.65rem;
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    color: #0F172A;
  }
  .seo-card-desc {
    margin: 0 0 1.15rem;
    color: #475569;
    line-height: 1.65;
    font-size: 0.98rem;
  }
  .seo-see {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: #1E3A8A;
    text-decoration: none;
  }
  .seo-see:hover { color: #2563EB; }
  .seo-see-ico {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    font-size: 0.85rem;
  }

  .seo-details {
    padding: 2.75rem 1.25rem;
    background: #fff;
  }
  .seo-details.alt { background: #F8FAFC; }
  .seo-details h2 {
    margin: 0 0 0.65rem;
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    color: #0F172A;
  }
  .seo-details p {
    margin: 0;
    max-width: 42rem;
    color: #475569;
    line-height: 1.7;
  }

  .seo-cta {
    padding: 3.5rem 1.25rem;
    background: linear-gradient(135deg, #EEF2FF, #DBEAFE 40%, #EFF6FF);
  }
  .seo-cta-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .seo-cta-grid { grid-template-columns: 1fr 1fr; gap: 3rem; }
  }
  .seo-cta-eye {
    margin: 0 0 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #334155;
  }
  .seo-cta-title {
    margin: 0 0 0.65rem;
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.03em;
  }
  .seo-cta-sub {
    margin: 0 0 1.35rem;
    color: #475569;
    line-height: 1.6;
    max-width: 28rem;
  }
  .seo-cta-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; }
  .btn-outline-light {
    background: transparent;
    border: 1.5px solid #1E40AF;
    color: #1E40AF;
  }
  .btn-outline-light:hover { background: rgba(30,64,175,.06); }

  .seo-cta-photo {
    border-radius: 24px;
    overflow: hidden;
    min-height: 240px;
    background:
      linear-gradient(135deg, rgba(37,99,235,.15), rgba(99,102,241,.2)),
      linear-gradient(160deg, #1E3A8A, #0F172A);
    display: grid;
    place-items: center;
    box-shadow: 0 24px 50px rgba(15,23,42,.18);
  }
  .seo-cta-photo-inner {
    width: min(280px, 80%);
    background: rgba(255,255,255,.95);
    border-radius: 16px;
    padding: 1.25rem;
    display: grid;
    gap: 0.65rem;
  }
  .seo-cta-photo-inner .dot {
    width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(135deg, #3B82F6, #6366F1);
  }
  .seo-cta-photo-inner .line {
    height: 10px; border-radius: 6px; background: #E2E8F0; width: 100%;
  }
  .seo-cta-photo-inner .line.short { width: 60%; }
  .seo-cta-photo-inner .badge {
    display: inline-block;
    margin-top: 0.25rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: #EFF6FF;
    color: #1D4ED8;
    font-size: 0.75rem;
    font-weight: 700;
    width: fit-content;
  }

  @media (max-width: 640px) {
    .seo-card { padding: 1.25rem; }
    .seo-card-title { font-size: 1.2rem; }
  }
</style>
