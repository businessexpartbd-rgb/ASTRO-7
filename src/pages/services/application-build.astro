---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../data/site';

const tech = [
  { name: 'WordPress', icon: 'https://cdn.simpleicons.org/wordpress/21759B' },
  { name: 'Shopify', icon: 'https://cdn.simpleicons.org/shopify/7AB55C' },
  { name: 'PHP', icon: 'https://cdn.simpleicons.org/php/777BB4' },
  { name: 'Laravel', icon: 'https://cdn.simpleicons.org/laravel/FF2D20' },
  { name: 'JavaScript', icon: 'https://cdn.simpleicons.org/javascript/F7DF1E' },
  { name: 'React', icon: 'https://cdn.simpleicons.org/react/61DAFB' },
  { name: 'Next.js', icon: 'https://cdn.simpleicons.org/nextdotjs/000000' },
  { name: 'Vue', icon: 'https://cdn.simpleicons.org/vuedotjs/4FC08D' },
  { name: 'Python', icon: 'https://cdn.simpleicons.org/python/3776AB' },
  { name: 'Firebase', icon: 'https://cdn.simpleicons.org/firebase/FFCA28' },
  { name: 'AWS', icon: 'https://cdn.simpleicons.org/amazonaws/232F3E' },
  { name: 'Docker', icon: 'https://cdn.simpleicons.org/docker/2496ED' },
  { name: 'Flutter', icon: 'https://cdn.simpleicons.org/flutter/02569B' },
  { name: 'Node.js', icon: 'https://cdn.simpleicons.org/nodedotjs/339933' },
  { name: 'MySQL', icon: 'https://cdn.simpleicons.org/mysql/4479A1' },
  { name: 'PostgreSQL', icon: 'https://cdn.simpleicons.org/postgresql/4169E1' },
];

const solutions = [
  {
    title: 'Business Dashboard',
    desc: 'Role-based admin panels with analytics, orders and team workflows.',
    tone: 'violet',
  },
  {
    title: 'Booking & CRM Apps',
    desc: 'Appointment, lead and customer pipelines built for real teams.',
    tone: 'pink',
  },
  {
    title: 'E-commerce Apps',
    desc: 'Catalog, cart, payments and order tracking for mobile-first shops.',
    tone: 'blue',
  },
];

const featured = [
  {
    title: 'CRM Apps',
    desc: 'Build and nurture customer relationships with pipelines, notes and follow-ups designed for your sales process.',
    tone: 'violet',
  },
  {
    title: 'HR & Team Tools',
    desc: 'Attendance, leave, payroll-ready modules and internal tools that streamline operations.',
    tone: 'pink',
  },
  {
    title: 'Accounting & Finance',
    desc: 'Invoicing, expense tracking and reporting interfaces that keep financial ops clear and fast.',
    tone: 'blue',
  },
];

const faqs = [
  {
    q: 'What is a mobile app, and how does it differ from a website?',
    a: 'A mobile app is installed on a phone or tablet and can use device features (camera, notifications, offline mode). A website runs in the browser. Many products need both — a responsive web presence plus a dedicated app for heavier use.',
  },
  {
    q: 'How are mobile apps developed, and which stacks do you use?',
    a: 'We scope requirements, design UI/UX, then build with React Native, Flutter, or native Android/iOS when needed. Backends often use Node, Laravel or Firebase depending on scale and budget.',
  },
  {
    q: 'What is the difference between native and hybrid (cross-platform) apps?',
    a: 'Native apps are built separately for iOS and Android for maximum performance. Cross-platform (React Native / Flutter) shares one codebase for faster delivery and lower cost while still feeling native.',
  },
  {
    q: 'How do users download and install apps?',
    a: 'Through the Apple App Store and Google Play Store after review, or via internal enterprise distribution for private company apps.',
  },
  {
    q: 'Are apps compatible with all devices?',
    a: 'We target modern Android and iOS versions used by your audience. During discovery we define device and OS support so testing stays focused.',
  },
  {
    q: 'Are mobile apps safe, and how is data protected?',
    a: 'We follow secure auth, encrypted transport (HTTPS), least-privilege APIs and store guidelines. Sensitive data handling is designed with your compliance needs in mind.',
  },
  {
    q: 'Can apps work offline?',
    a: 'Yes — when scoped. We can add offline caching and sync so core flows work without a constant connection.',
  },
  {
    q: 'How often should apps be updated?',
    a: 'Regular updates fix bugs, support new OS versions and ship improvements. We recommend a maintenance plan after launch.',
  },
];
---
<Layout
  title="Mobile & Application Development Bangladesh — Creavix iT"
  description="Custom mobile and web application development by Creavix iT Solution — Android, iOS, cross-platform apps, dashboards and business software."
>
  <TopBar />
  <Nav active="services" />

  <!-- HERO -->
  <section class="app-hero">
    <div class="app-hero-atmosphere" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="container app-hero-grid">
      <div class="app-hero-copy">
        <div class="app-hero-kicker"><span></span>Application Engineering Studio</div>
        <h1>We Build Apps That Feel <em>Effortless.</em></h1>
        <p>
          From the first product idea to a secure, production-ready launch—we design
          fast mobile and web applications that users understand instantly and
          businesses can scale confidently.
        </p>
        <div class="app-hero-proof" aria-label="Application development capabilities">
          <span><i>✓</i> Android &amp; iOS</span>
          <span><i>✓</i> Web Applications</span>
          <span><i>✓</i> Secure Cloud</span>
        </div>
        <div class="app-hero-actions">
          <a class="btn btn-assess" href="/contact">Plan Your Application <span>→</span></a>
          <a class="btn btn-wa" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
        <p class="app-hero-micro"><span></span>Strategy · UI/UX · Development · Deployment</p>
      </div>
      <div class="app-hero-visual" aria-label="Animated application design and development preview" role="img">
        <div class="app-studio">
          <div class="studio-topbar">
            <span class="studio-dots"><i></i><i></i><i></i></span>
            <span class="studio-title">CREAVIX · APP STUDIO</span>
            <span class="studio-live"><i></i> Live build</span>
          </div>
          <div class="studio-canvas">
            <div class="code-panel">
              <div class="code-head"><span>app.tsx</span><i>●</i></div>
              <div class="code-lines">
                <b style="--w:74%"></b><b style="--w:88%"></b><b style="--w:60%"></b>
                <b style="--w:78%"></b><b style="--w:48%"></b><b style="--w:68%"></b>
              </div>
              <div class="build-status"><i>✓</i><span><b>Production ready</b><small>Performance · Security · SEO</small></span></div>
            </div>
            <div class="device-stage">
              <div class="device-glow"></div>
              <div class="app-phone">
                <div class="app-phone-speaker"></div>
                <div class="app-phone-screen">
                  <div class="mobile-head"><span>9:41</span><i>● ● ●</i></div>
                  <div class="mobile-welcome"><small>Good morning</small><strong>Your business</strong></div>
                  <div class="mobile-balance"><span>Performance</span><strong>+38.6%</strong><div><i></i></div></div>
                  <div class="mobile-grid"><i></i><i></i><i></i><i></i></div>
                  <div class="mobile-nav"><i></i><i></i><i></i><i></i></div>
                </div>
              </div>
              <div class="orbit orbit-flutter"><span>F</span><b>Flutter</b></div>
              <div class="orbit orbit-react"><span>⚛</span><b>React</b></div>
              <div class="orbit orbit-cloud"><span>☁</span><b>Cloud</b></div>
              <div class="orbit orbit-secure"><span>✓</span><b>Secure</b></div>
            </div>
          </div>
          <div class="studio-progress"><span class="active"><i>1</i>Idea</span><b></b><span class="active"><i>2</i>Design</span><b></b><span class="active"><i>3</i>Build</span><b></b><span><i>4</i>Launch</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Maximum Reach -->
  <section class="app-sec">
    <div class="container app-split">
      <div>
        <h2>Maximum Reach with Mobile App</h2>
        <p>
          Get your app in front of as many people as possible with the help of our
          professional app designers. A mobile app can reach a huge audience
          because of the widespread use of smartphones. Harness the vast potential
          of app stores to connect with customers all around the globe. Our
          customized solutions optimize accessibility for varied demographics by
          ensuring broad compatibility, whether it’s iOS or Android.
        </p>
        <p>
          Incorporate social media, use push notifications, and make the interface
          easy to use to increase involvement. Raise awareness of your brand, make
          your services easy to use, and lead your industry. Take advantage of the
          widespread availability and ease of use of purpose-built mobile apps to
          expand your influence and accomplish more.
        </p>
        <a class="link-arrow" href="/contact">Contact Us <span>→</span></a>
      </div>
      <div class="reach-visual" aria-hidden="true">
        <div class="reach-card">
          <div class="reach-phone">
            <div class="rp-top">Transaction</div>
            <div class="rp-amt">$853.48</div>
            <div class="rp-row"></div>
            <div class="rp-row short"></div>
          </div>
          <div class="reach-phone alt">
            <div class="rp-top">Wallet</div>
            <div class="rp-amt">Balance</div>
            <div class="rp-row"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Showcase band -->
  <section class="app-showcase">
    <div class="container">
      <div class="showcase-frame" aria-hidden="true">
        <div class="sc-phone">
          <div class="sc-label">Manage Your Finances</div>
          <div class="sc-bars"><i></i><i></i><i></i></div>
        </div>
        <div class="sc-phone mid">
          <div class="sc-amt">$ 10,315.51</div>
          <div class="sc-grid"><i></i><i></i><i></i><i></i></div>
        </div>
        <div class="sc-phone">
          <div class="sc-label">Insights</div>
          <div class="sc-chart"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technologies -->
  <section class="app-sec alt">
    <div class="container">
      <div class="sec-head">
        <h2>Technologies We Use</h2>
        <div class="sec-line"></div>
      </div>
      <div class="tech-grid">
        {tech.map((t) => (
          <div class="tech-item">
            <img src={t.icon} alt="" width="36" height="36" loading="lazy" />
            <span>{t.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Android -->
  <section class="app-sec">
    <div class="container app-split platform">
      <div class="plat-art android" aria-hidden="true">
        <div class="android-bot">
          <div class="ab-head"></div>
          <div class="ab-body"></div>
          <div class="ab-arm l"></div>
          <div class="ab-arm r"></div>
          <div class="ab-leg l"></div>
          <div class="ab-leg r"></div>
        </div>
      </div>
      <div>
        <h2>Android</h2>
        <p>
          Creavix iT provides animated technology solutions by utilizing Android.
          Our business develops innovative mobile apps and hardware that re-imagine
          the user experience by capitalizing on the extensive capabilities of the
          Android platform. The innovative solutions produced by Creavix iT are designed
          to satisfy the unique needs of our clients through seamless integration and
          customization.
        </p>
        <p>
          Thanks to our dedication to quality, Android can support strong, easy-to-use,
          and prepared products for the future. Android opens the door to
          revolutionary solutions, breaking down barriers and opening up new
          dimensions of digital advancement. Embrace the boundless potential of
          technology with Creavix iT.
        </p>
        <a class="link-arrow" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Craft Your App <span>→</span></a>
      </div>
    </div>
  </section>

  <!-- iOS -->
  <section class="app-sec alt">
    <div class="container app-split platform reverse">
      <div>
        <h2>iOS</h2>
        <p>
          Creavix iT, at the forefront of innovation, harnesses the power of iOS to
          redefine digital experiences. Our company crafts exquisite, high-performance
          applications and devices, leveraging the seamless integration capabilities of
          the iOS ecosystem. With a focus on user-centric design and cutting-edge
          technology, Creavix iT creates bespoke solutions that resonate with Apple’s
          commitment to excellence.
        </p>
        <p>
          The iOS platform serves as the canvas for our groundbreaking products,
          ensuring a harmonious blend of functionality and aesthetics. Join us in
          exploring the pinnacle of digital sophistication, where Creavix iT transforms
          iOS into a gateway for unparalleled technological excellence and user
          delight.
        </p>
        <a class="link-arrow" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Grab Your App <span>→</span></a>
      </div>
      <div class="plat-art ios" aria-hidden="true">
        <div class="ios-badge">iOS</div>
      </div>
    </div>
  </section>

  <!-- Cross Platform -->
  <section class="app-sec">
    <div class="container app-split platform">
      <div class="plat-art cross" aria-hidden="true">
        <div class="cross-icons">
          <span class="ci android-c">A</span>
          <span class="ci ios-c">iOS</span>
        </div>
      </div>
      <div>
        <h2>Cross Platform</h2>
        <p>
          Creavix iT pioneers cross-platform solutions, unifying technology to deliver
          versatile and efficient products. Our expertise lies in seamlessly bridging
          platforms, ensuring our clients’ applications perform optimally across
          diverse ecosystems. Leveraging frameworks like React Native and Flutter,
          Creavix iT streamlines code reuse, reducing development time and costs.
        </p>
        <p>
          Our cross-platform approach guarantees a consistent and delightful user
          experience, whether on iOS or Android. Creavix iT thrives on innovation,
          utilizing the best of both worlds to create applications that transcend
          boundaries and provide unparalleled accessibility. Elevate your digital
          presence with Creavix iT, where cross-platform development becomes a
          cornerstone for unparalleled technological synergy.
        </p>
        <a class="link-arrow" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Grab Your App <span>→</span></a>
      </div>
    </div>
  </section>

  <!-- Solutions we build -->
  <section class="app-sec alt">
    <div class="container">
      <div class="sec-head">
        <h2>Solutions We Build</h2>
        <div class="sec-line"></div>
      </div>
      <div class="sol-grid">
        {solutions.map((s) => (
          <article class={`sol-card tone-${s.tone}`}>
            <div class="sol-illu" aria-hidden="true"></div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <a href="/contact">Explore More →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured -->
  <section class="app-sec">
    <div class="container">
      <div class="sec-head">
        <h2>Featured Service</h2>
        <div class="sec-line"></div>
      </div>
      <div class="feat-grid">
        {featured.map((f) => (
          <article class={`feat-card tone-${f.tone}`}>
            <div class="feat-illu" aria-hidden="true"></div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
            <a href="/contact">See Details →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="app-faq">
    <div class="container">
      <div class="sec-head light">
        <h2>Frequently Asked Questions</h2>
        <div class="sec-line light"></div>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="app-cta">
    <div class="container app-cta-grid">
      <div>
        <p class="cta-eye">Book a Free Consultation</p>
        <h2>Let’s Talk</h2>
        <p>Tell us about your app idea — Android, iOS or cross-platform. We’ll map scope, timeline and stack.</p>
        <a class="btn btn-assess" href="/contact">Contact Us</a>
      </div>
      <div class="cta-visual" aria-hidden="true">
        <div class="cta-box">
          <span class="cta-dot"></span>
          <span class="cta-line"></span>
          <span class="cta-line short"></span>
          <span class="cta-pill">App Strategy</span>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .app-hero {
    position:relative;isolation:isolate;overflow:hidden;padding:clamp(3.5rem,7vw,6.8rem) 1.25rem clamp(4rem,7vw,6rem);
    background:radial-gradient(circle at 82% 15%,rgba(99,102,241,.14),transparent 29%),radial-gradient(circle at 8% 82%,rgba(14,165,233,.1),transparent 28%),linear-gradient(135deg,#fbfdff 0%,#f6f8ff 52%,#fff 100%);
  }
  .app-hero:before{content:'';position:absolute;z-index:-2;inset:0;background-image:linear-gradient(rgba(37,99,235,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.035) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,#000,transparent 88%)}
  .app-hero-atmosphere i{position:absolute;z-index:-1;border-radius:50%;filter:blur(1px);pointer-events:none}.app-hero-atmosphere i:nth-child(1){width:360px;height:360px;right:-120px;top:-110px;background:rgba(79,70,229,.08)}.app-hero-atmosphere i:nth-child(2){width:240px;height:240px;left:-100px;bottom:-90px;background:rgba(6,182,212,.08)}.app-hero-atmosphere i:nth-child(3){width:8px;height:8px;left:48%;top:15%;background:#6366f1;box-shadow:90px 80px 0 #22c55e,-80px 180px 0 #38bdf8,230px 310px 0 #f59e0b}
  .app-hero-grid {
    display:grid;gap:clamp(2.5rem,6vw,5rem);align-items:center;min-width:0;
  }
  @media (min-width: 900px) {
    .app-hero-grid {grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr)}
  }
  .app-hero-copy{position:relative;z-index:2;min-width:0}.app-hero-kicker{display:inline-flex;align-items:center;gap:.5rem;margin-bottom:1rem;padding:.42rem .72rem;border:1px solid rgba(37,99,235,.13);border-radius:999px;background:rgba(255,255,255,.76);color:#2563eb;font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 8px 30px rgba(37,99,235,.07)}.app-hero-kicker span{width:7px;height:7px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 5px rgba(34,197,94,.12)}
  .app-hero-copy h1 {
    max-width:700px;margin:0 0 1.15rem;font-family:var(--font-h),system-ui,sans-serif;font-size:clamp(2.35rem,5.8vw,4.8rem);font-weight:800;line-height:.98;letter-spacing:-.055em;color:#0b0f19;text-wrap:balance;
  }
  .app-hero-copy h1 em{position:relative;color:#2563eb;font-style:normal;white-space:nowrap}.app-hero-copy h1 em:after{content:'';position:absolute;left:2%;right:2%;bottom:-.08em;height:.09em;border-radius:999px;background:linear-gradient(90deg,#2563eb,#8b5cf6,#22c55e);transform-origin:left;animation:app-line 1.1s .3s both cubic-bezier(.16,1,.3,1)}
  .app-hero-copy p {
    margin:0 0 1.4rem;color:#526178;line-height:1.75;font-size:clamp(.96rem,1.5vw,1.08rem);max-width:38rem;
  }
  .app-hero-proof{display:flex;flex-wrap:wrap;gap:.45rem;margin-bottom:1.35rem}.app-hero-proof span{display:inline-flex;align-items:center;gap:.38rem;padding:.4rem .62rem;border:1px solid rgba(15,23,42,.08);border-radius:999px;background:rgba(255,255,255,.75);color:#334155;font-size:.68rem;font-weight:750}.app-hero-proof i{display:grid;place-items:center;width:15px;height:15px;border-radius:50%;background:#dcfce7;color:#15803d;font-size:.55rem;font-style:normal}
  .app-hero-actions{display:flex;flex-wrap:wrap;gap:.65rem}.app-hero-actions .btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;min-height:48px;box-shadow:0 12px 28px rgba(15,23,42,.09)}
  .btn-wa {
    background:#fff;color:#0f766e;border:1px solid rgba(15,118,110,.18);border-radius:14px;padding:.78rem 1.25rem;font-weight:800;text-decoration:none;
  }
  .btn-wa:hover{background:#ecfdf5;color:#115e59;transform:translateY(-2px)}
  .btn-assess {
    background:linear-gradient(135deg,#2563eb,#4f46e5);color:#fff;border:none;border-radius:14px;padding:.78rem 1.25rem;font-weight:800;text-decoration:none;
  }
  .btn-assess:hover{background:linear-gradient(135deg,#1d4ed8,#4338ca);color:#fff;transform:translateY(-2px)}.app-hero-micro{display:flex;align-items:center;gap:.45rem;margin:.9rem 0 0!important;color:#94a3b8!important;font-size:.68rem!important;font-weight:700}.app-hero-micro span{width:26px;height:1px;background:#cbd5e1}

