---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
const title = "Application Build Services | Creavix iT Solution";
const description = "Custom web and mobile applications for performance and scalability. Creavix iT Solution.";
---
<Layout title={title} description={description}>
  <Nav active="services" />
  <section class="hero-premium service-hero">
    <div class="hero-bg"><div class="orb orb-1"></div><div class="orb orb-2"></div><div class="grid-overlay"></div></div>
    <div class="container hero-grid">
      <div class="hero-content reveal">
        <div class="eyebrow"><span class="dot"></span> App Development</div>
        <h1 class="hero-title">Custom<br /><span class="text-gradient">Application Build</span></h1>
        <p class="hero-lead">Web and mobile applications designed for performance, scalability and real business workflows.</p>
        <div class="flex-btns"><a href="/contact" class="btn btn-primary">Start Your Project</a><a href="/#services" class="btn btn-outline">All Services</a></div>
      </div>
      <div class="hero-visual reveal">
        <div class="visual-card glass-card animate-float">
          <div class="visual-icon">📱</div><h3>Application Build</h3><p class="visual-tags">Web App · Mobile · API</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section-warm"><div class="container text-center reveal" style="max-width:40rem">
    <h2 class="mb-4">Have an App Idea?</h2>
    <a href="mailto:hello@creavixit.com" class="btn btn-primary">Contact Creavix iT</a>
  </div></section>
  <Footer />
</Layout>
