---
import MetaTargeting from '../../components/MetaTargeting.astro';
import RelatedServices from '../../components/RelatedServices.astro';
/**
 * Digital Marketing — complete service page
 * SEO, paid ads, social, content, video, email, analytics
 * Bangladesh + international focus · FAQ · easy for non-marketers
 */
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ServiceIcons from '../../components/icons/ServiceIcons.astro';
import { SITE } from '../../data/site';

const seoTitle =
  'Digital Marketing Agency Bangladesh | SEO, Ads, Social & Growth — Creavix iT';
const seoDescription =
  'Full digital marketing by Creavix iT Solution — SEO, Google & Meta ads, social media, content, video marketing, email and analytics. Clear strategy for Bangladesh and global brands.';

const channels = [
  {
    title: 'Search Engine Optimization',
    tag: 'Organic',
    desc: 'Rank on Google for the keywords your customers actually type — local, national and product search.',
    href: '/services/seo',
    points: ['On-page & technical SEO', 'Local SEO / Google Business', 'Content for rankings', 'Monthly reporting'],
    icon: 'seo',
  },
  {
    title: 'Paid Ads (Meta & Google)',
    tag: 'Paid',
    desc: 'Facebook, Instagram and Google campaigns with clear audience, creative tests and budget control.',
    href: '/services/boosting',
    points: ['Audience research', 'Creative A/B testing', 'Retargeting', 'Cost per lead focus'],
    icon: 'boosting',
  },
  {
    title: 'Social Media Marketing',
    tag: 'Social',
    desc: 'Page presence, posting rhythm and community replies that keep your brand active and trusted.',
    href: '/services/facebook-page',
    points: ['Page setup & branding', 'Content calendar', 'Engagement playbook', 'Story & Reels guidance'],
    icon: 'facebook',
  },
  {
    title: 'Campaign Management',
    tag: 'Growth',
    desc: 'End-to-end campaigns — message, creative, media and weekly optimization under one plan.',
    href: '/services/campaign',
    points: ['Strategy & funnel', 'Launch roadmap', 'KPI tracking', 'Transparent reports'],
    icon: 'campaign',
  },
  {
    title: 'AI Video Marketing',
    tag: 'Creative',
    desc: 'Human-like AI and cinematic video ads built for Meta, YouTube and TikTok conversion.',
    href: '/services/ai-video-marketing',
    points: ['Ad-ready edits', 'Hook-first scripts', 'Platform sizes', 'Fast turnaround'],
    icon: 'ai',
  },
  {
    title: 'Content & Email',
    tag: 'Nurture',
    desc: 'Website copy, offers and simple email/SMS sequences that turn visitors into repeat buyers.',
    href: '/contact',
    points: ['Landing page copy', 'Offer structure', 'Basic email flows', 'CTA optimization'],
    icon: 'email',
  },
];

const pillars = [
  {
    t: 'Be found',
    d: 'SEO + local search so people discover you when they need your product or service.',
  },
  {
    t: 'Be chosen',
    d: 'Clear offers, social proof and creative that make clicking you the easy decision.',
  },
  {
    t: 'Be converted',
    d: 'Ads, landing pages and follow-ups designed for leads, calls and orders — not vanity likes.',
  },
  {
    t: 'Be measured',
    d: 'Simple dashboards: spend, reach, leads, cost per result — so you know what works.',
  },
];
const pillarIcons = ['seo','strategy','marketing','boosting'];

const steps = [
  { n: '01', t: 'Discover', d: 'Business goals, offer, audience and current channels reviewed in a short brief.' },
  { n: '02', t: 'Plan', d: 'Channel mix, budget suggestion, creative needs and 30–90 day roadmap.' },
  { n: '03', t: 'Launch', d: 'SEO tasks, ads, posts or video go live with tracking in place.' },
  { n: '04', t: 'Optimize', d: 'Weekly checks — pause waste, scale winners, report in plain language.' },
];
const stepIcons = ['search','strategy','rocket','automation'];

const who = [
  {
    title: 'Local shops & services',
    desc: 'Clinics, coaching, restaurants, home services — get calls and messages from nearby customers.',
  },
  {
    title: 'E-commerce & Facebook shops',
    desc: 'Product visibility, retargeting and catalog-style creatives that push add-to-cart and inbox orders.',
  },
  {
    title: 'Agencies & B2B',
    desc: 'Lead forms, LinkedIn-style positioning and landing pages for higher-ticket services.',
  },
  {
    title: 'International brands',
    desc: 'English creative, global ad accounts and reporting standards for remote teams.',
  },
];
const whoIcons = ['phone','app','auth','global'];

const faqs = [
  {
    q: 'What does digital marketing include?',
    a: 'It combines the channels that help customers discover, trust and choose your business: SEO, paid advertising, social media, content, video, email and conversion-focused landing experiences.',
  },
  {
    q: 'Should I start with SEO or paid ads?',
    a: 'Paid ads generate faster market data, while SEO builds durable organic discovery. Many businesses benefit from a measured combination based on budget and growth targets.',
  },
  {
    q: 'What budget is required?',
    a: 'Media spend is separate from our service fee. The recommended range depends on your market, objective and whether you need SEO, boosting or full campaign management.',
  },
  {
    q: 'How quickly will I see results?',
    a: 'Paid campaigns can produce useful data within days. Sustainable SEO growth often takes weeks or months. We report realistic timelines instead of promising guaranteed rankings or sales.',
  },
  {
    q: 'What will the reports show?',
    a: 'Clear business metrics: spend, reach, clicks, leads or messages, cost per result, key insights and recommended next actions.',
  },
  {
    q: 'Is running a Facebook page enough?',
    a: 'Page activity is one channel. A complete growth system also considers search, ads, landing pages, tracking and offer clarity so the outcome is customers, not only likes.',
  },
  {
    q: 'Can Creavix manage all channels together?',
    a: 'Yes. One team can coordinate SEO, Meta advertising, campaign creative, AI video and landing-page support, or begin with one focused channel.',
  },
  {
    q: 'Do you support international clients?',
    a: 'Yes. We provide English creative, reporting and remote communication for international engagements as well as Bangladesh-focused campaigns.',
  },
];
---

<Layout title={seoTitle} description={seoDescription}>
  <TopBar />
  <Nav active="services" />
  <main id="main-content" tabindex="-1">

  <!-- HERO -->
  <section class="dm-hero">
    <div class="container dm-hero-grid">
      <div class="dm-copy reveal">
        <p class="dm-eye">Digital Marketing</p>
        <h1>Get found. Get chosen.<br /><span class="brand-accent">Connect with customers.</span></h1>
        <p class="dm-sub">
          SEO, ads, social, content and video — one clear growth system for Bangladesh businesses
          and international brands. No jargon walls. Just channels that move leads and sales.
        </p>
        <div class="dm-actions">
          <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Plan my channels</a>
          <a class="btn btn-outline" href="#channels">See all services</a>
        </div>
        <ul class="dm-pills">
          <li>SEO</li>
          <li>Meta &amp; Google Ads</li>
          <li>Social</li>
          <li>Video</li>
          <li>Analytics</li>
        </ul>
      </div>

      <MetaTargeting compact />
    </div>
  </section>

  <!-- WHAT IS -->
  <section class="dm-sec" id="what-is">
    <div class="container dm-split">
      <div class="reveal">
        <p class="dm-eye">What is digital marketing?</p>
        <h2>Online marketing that your customer can actually follow</h2>
        <p class="dm-body">
          Digital marketing is how people <strong>discover</strong> your business on Google or social,
          <strong>trust</strong> your content and offers, then <strong>message, call or buy</strong>.
          It is not only “boosting a post”. It is a mix of search, ads, creative and follow-up.
        </p>
        <p class="dm-body">
          Creavix builds that mix for real marketplaces — Facebook-heavy local sellers,
          service businesses that need calls, and brands that need measurable growth.
        </p>
      </div>
      <div class="dm-pillar-grid reveal">
        {pillars.map((p, i) => (
          <div class="dm-pillar">
            <span class="dm-icon"><ServiceIcons name={pillarIcons[i]} size={28} /></span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CHANNELS -->
  <section class="dm-sec dm-muted" id="channels">
    <div class="container">
      <div class="dm-center reveal">
        <p class="dm-eye">Full stack</p>
        <h2>Every digital function you may need</h2>
        <p class="dm-lead">Pick one channel or combine — each card links to deeper service pages where available.</p>
      </div>
      <div class="dm-channels">
        {channels.map((c) => (
          <article class="dm-channel reveal">
            <div class="dm-channel-head">
              <div class="dm-card-top"><span class="dm-icon lg"><ServiceIcons name={c.icon} size={34} /></span><span class="dm-tag">{c.tag}</span></div>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </div>
            <ul>
              {c.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
            <a class="dm-link" href={c.href}>Explore →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="dm-sec" id="process">
    <div class="container">
      <div class="dm-center reveal">
        <p class="dm-eye">Process</p>
        <h2>How we run digital marketing</h2>
      </div>
      <div class="dm-steps">
        {steps.map((s, i) => (
          <div class="dm-step reveal">
            <div class="dm-step-top"><span class="dm-icon"><ServiceIcons name={stepIcons[i]} size={26} /></span><span class="dm-step-n">{s.n}</span></div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO -->
  <section class="dm-sec dm-muted">
    <div class="container">
      <div class="dm-center reveal">
        <p class="dm-eye">Who it is for</p>
        <h2>Built for local and global marketplaces</h2>
      </div>
      <div class="dm-who">
        {who.map((w, i) => (
          <article class="dm-who-card reveal">
            <span class="dm-icon"><ServiceIcons name={whoIcons[i]} size={28} /></span>
            <h3>{w.title}</h3>
            <p>{w.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FUNNEL VISUAL -->
  <section class="dm-funnel-sec">
    <div class="container">
      <div class="dm-center reveal">
        <p class="dm-eye light">Simple funnel</p>
        <h2>From stranger to customer</h2>
      </div>
      <div class="dm-funnel reveal" aria-hidden="true">
        <div class="dm-fn">Awareness<br /><small>SEO · Ads · Social</small></div>
        <span>→</span>
        <div class="dm-fn">Interest<br /><small>Content · Video</small></div>
        <span>→</span>
        <div class="dm-fn">Action<br /><small>Form · Inbox · Call</small></div>
        <span>→</span>
        <div class="dm-fn hi">Customer<br /><small>Order · Retain</small></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="dm-sec" id="faq">
    <div class="container dm-faq-wrap">
      <div class="dm-center reveal">
        <p class="dm-eye">FAQ</p>
        <h2>Common questions before you start</h2>
      </div>
      <div class="dm-faq reveal">
        {faqs.map((f) => (
          <details class="dm-faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="dm-cta">
    <div class="container dm-cta-inner reveal">
      <div>
        <p class="dm-eye light">Next step</p>
        <h2>Tell us your goal — we map the channels</h2>
        <p>WhatsApp {SITE.whatsapp} · {SITE.email1} · {SITE.hotline}</p>
      </div>
      <div class="dm-cta-btns">
        <a class="btn btn-light" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a class="btn btn-ghost" href="/contact">Contact</a>
        <a class="btn btn-ghost" href="/services/seo">SEO details</a>
      </div>
    </div>
  </section>

  <RelatedServices />
  </main>
  <Footer />
</Layout>

<style>
  .dm-hero {
    padding: 5.25rem 1.25rem 3.5rem;
    background:
      radial-gradient(ellipse 55% 45% at 88% 12%, rgba(37, 99, 235, 0.14), transparent 60%),
      radial-gradient(ellipse 40% 30% at 5% 90%, rgba(14, 165, 233, 0.07), transparent 50%),
      linear-gradient(180deg, #fff, #F8FAFC);
  }
  .dm-hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .dm-hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
    }
  }
  .dm-eye {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2563EB;
  }
  .dm-eye.light { color: #93C5FD; }
  .dm-hero h1 {
    margin: 0 0 0.9rem;
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(1.75rem, 4.2vw, 2.65rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #0B0F19;
  }
  .dm-sub {
    margin: 0 0 1.35rem;
    color: #475569;
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 34rem;
  }
  .dm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.15rem;
  }
  .dm-pills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .dm-pills li {
    font-size: 0.72rem;
    font-weight: 600;
    color: #1E40AF;
    background: #EFF6FF;
    border: 1px solid rgba(37, 99, 235, 0.15);
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
  }

  .dm-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .dm-board {
    width: min(100%, 340px);
    border-radius: 20px;
    background: #0B1220;
    color: #E2E8F0;
    box-shadow: 0 28px 56px rgba(15, 23, 42, 0.2);
    overflow: hidden;
  }
  .dm-board-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    background: #111827;
  }
  .dm-live {
    color: #34D399;
    font-size: 0.7rem;
  }
  .dm-bars {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.45rem;
    height: 160px;
    padding: 1rem 1rem 0.5rem;
  }
  .dm-bar {
    flex: 1;
    height: var(--h, 50%);
    border-radius: 8px 8px 4px 4px;
    background: rgba(148, 163, 184, 0.25);
    position: relative;
    animation: dm-rise 1.2s ease-out both;
  }
  .dm-bar.on {
    background: linear-gradient(180deg, #60A5FA, #2563EB);
  }
  .dm-bar span {
    position: absolute;
    bottom: -1.35rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.58rem;
    font-weight: 600;
    color: #94A3B8;
    white-space: nowrap;
  }
  .dm-board-foot {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
    padding: 2rem 0.85rem 1rem;
    text-align: center;
  }
  .dm-board-foot strong {
    display: block;
    font-size: 0.85rem;
    font-weight: 800;
    color: #fff;
  }
  .dm-board-foot small {
    font-size: 0.65rem;
    color: #94A3B8;
  }
  @keyframes dm-rise {
    from { transform: scaleY(0.3); opacity: 0.4; transform-origin: bottom; }
    to { transform: scaleY(1); opacity: 1; transform-origin: bottom; }
  }
  .dm-chip {
    position: absolute;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.1);
    color: #1E40AF;
    animation: dm-bob 4s ease-in-out infinite;
  }
  .dm-chip-1 { top: 6%; left: 0; }
  .dm-chip-2 { top: 48%; right: 0; animation-delay: 0.5s; }
  .dm-chip-3 { bottom: 8%; left: 6%; animation-delay: 1s; }
  @keyframes dm-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .dm-sec { padding: 3.5rem 1.25rem; background: #fff; }
  .dm-muted { background: #F8FAFC; }
  .dm-center {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto 2rem;
  }
  .dm-center h2,
  .dm-split h2 {
    margin: 0 0 0.5rem;
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-weight: 800;
    color: #0B0F19;
    letter-spacing: -0.02em;
  }
  .dm-lead,
  .dm-body {
    margin: 0;
    color: #64748B;
    line-height: 1.65;
    font-size: 0.98rem;
  }
  .dm-body + .dm-body { margin-top: 0.85rem; }
  .dm-body strong { color: #0F172A; }

  .dm-split {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 800px) {
    .dm-split { grid-template-columns: 1.15fr 0.85fr; gap: 2.5rem; }
  }
  .dm-pillar-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .dm-pillar {
    background: #F8FAFC;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 16px;
    padding: 1.1rem 1rem;
  }
  .dm-icon { width:48px; height:48px; display:grid; place-items:center; flex:0 0 auto; margin-bottom:.75rem; border-radius:15px; background:linear-gradient(145deg,#fff,#edf4ff); border:1px solid rgba(37,99,235,.12); box-shadow:0 9px 22px rgba(37,99,235,.12); }
  .dm-icon.lg { width:58px; height:58px; }
  .dm-card-top,.dm-step-top { display:flex; align-items:flex-start; justify-content:space-between; gap:.75rem; }
  .dm-pillar h3 {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    font-weight: 800;
    color: #2563EB;
  }
  .dm-pillar p {
    margin: 0;
    font-size: 0.85rem;
    color: #64748B;
    line-height: 1.5;
  }

  .dm-channels {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .dm-channels { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1000px) {
    .dm-channels { grid-template-columns: 1fr 1fr 1fr; }
  }
  .dm-channel {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 18px;
    padding: 1.35rem 1.25rem;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.03);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .dm-channel:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(37, 99, 235, 0.1);
  }
  .dm-tag {
    display: inline-block;
    margin-bottom: 0.5rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    background: #EFF6FF;
    color: #1D4ED8;
  }
  .dm-channel h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    font-weight: 800;
    color: #0B0F19;
  }
  .dm-channel-head p {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: #64748B;
    line-height: 1.55;
  }
  .dm-channel ul {
    margin: 0 0 1rem;
    padding: 0 0 0 1.05rem;
    color: #475569;
    font-size: 0.88rem;
    line-height: 1.65;
    flex: 1;
  }
  .dm-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: #2563EB;
    text-decoration: none;
  }
  .dm-link:hover { text-decoration: underline; }

  .dm-steps {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .dm-steps { grid-template-columns: repeat(4, 1fr); }
  }
  .dm-step {
    padding: 1.25rem 1.1rem;
    border-radius: 16px;
    border: 1px solid rgba(15, 23, 42, 0.07);
    background: #F8FAFC;
  }
  .dm-step-n {
    display: block;
    font-family: Outfit, system-ui, sans-serif;
    font-weight: 800;
    font-size: 0.8rem;
    color: #2563EB;
    letter-spacing: 0.06em;
    margin-bottom: 0.45rem;
  }
  .dm-step h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 800;
  }
  .dm-step p {
    margin: 0;
    font-size: 0.88rem;
    color: #64748B;
    line-height: 1.5;
  }

  .dm-who {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .dm-who { grid-template-columns: 1fr 1fr; }
  }
  .dm-who-card {
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 16px;
    padding: 1.3rem 1.2rem;
  }
  .dm-who-card h3 {
    margin: 0 0 0.4rem;
    font-size: 1.02rem;
    font-weight: 800;
  }
  .dm-who-card p {
    margin: 0;
    font-size: 0.9rem;
    color: #64748B;
    line-height: 1.55;
  }

  .dm-funnel-sec {
    padding: 3rem 1.25rem;
    background: #0B1220;
    color: #E2E8F0;
  }
  .dm-funnel-sec h2 { color: #fff; }
  .dm-funnel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }
  .dm-fn {
    padding: 0.75rem 1rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.88rem;
    font-weight: 700;
    text-align: center;
    min-width: 7.5rem;
  }
  .dm-fn small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.68rem;
    font-weight: 500;
    color: #94A3B8;
  }
  .dm-fn.hi {
    background: linear-gradient(135deg, #2563EB, #1D4ED8);
