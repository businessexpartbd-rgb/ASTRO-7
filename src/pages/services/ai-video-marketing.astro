---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
const title = "AI Video Marketing Services | Creavix iT Solution";
const description = "AI-powered video content and marketing campaigns that scale fast. Creavix iT Solution.";
---
<Layout title={title} description={description}>
  <Nav active="services" />
  <section class="hero-premium service-hero">
    <div class="hero-bg"><div class="orb orb-1"></div><div class="orb orb-2"></div><div class="grid-overlay"></div></div>
    <div class="container hero-grid">
      <div class="hero-content reveal">
        <div class="eyebrow"><span class="dot"></span> AI-Powered Marketing</div>
        <h1 class="hero-title">AI Video Marketing<br />That <span class="text-gradient">Scales Fast</span></h1>
        <p class="hero-lead">AI-led video content and campaigns for Meta, YouTube and TikTok — faster production and conversion-focused storytelling.</p>
        <div class="flex-btns"><a href="/contact" class="btn btn-primary">Start Your Campaign</a><a href="/#services" class="btn btn-outline">All Services</a></div>
      </div>
      <div class="hero-visual reveal">
        <div class="visual-card glass-card animate-float">
          <div class="visual-icon">🤖</div><h3>AI Video Marketing</h3><p class="visual-tags">Meta · YouTube · TikTok · Scale</p>
          <div class="stat-grid"><div class="stat-box"><strong class="text-primary">Fast</strong><span>Production</span></div><div class="stat-box"><strong class="text-violet">High</strong><span>Conversion</span></div></div>
        </div>
      </div>
    </div>
  </section>
  <section class="section-soft"><div class="container">
    <div class="text-center mb-8 reveal"><p class="eyebrow" style="margin:0 auto 1rem">What You Get</p><h2 class="mb-4">AI Video Built for Growth</h2></div>
    <div class="grid-3">
      <div class="glass-card reveal"><div class="icon-box" style="background:rgba(124,58,237,.1)">🎬</div><h3 class="mb-4">AI Ad Creatives</h3><p style="font-size:.9rem">High-performing short ads for paid social.</p></div>
      <div class="glass-card reveal"><div class="icon-box" style="background:rgba(244,63,94,.1)">📦</div><h3 class="mb-4">Product Videos</h3><p style="font-size:.9rem">Product showcases that look real and convert.</p></div>
      <div class="glass-card reveal"><div class="icon-box" style="background:rgba(6,182,212,.1)">📈</div><h3 class="mb-4">Campaign Creatives</h3><p style="font-size:.9rem">Batch creatives for testing and scaling.</p></div>
    </div>
  </div></section>
  <section class="section-warm"><div class="container text-center reveal" style="max-width:40rem">
    <h2 class="mb-4">Ready to Scale with AI Video?</h2>
    <a href="mailto:hello@creavixit.com" class="btn btn-primary">Contact Creavix iT</a>
  </div></section>
  <Footer />
</Layout>
