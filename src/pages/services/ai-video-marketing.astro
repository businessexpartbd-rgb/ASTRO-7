---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ServiceHeroVisual from '../../components/ServiceHeroVisual.astro';
import { SITE } from '../../data/site';

const seoTitle = 'AI Video Marketing Agency Bangladesh | Human-like Ads — Creavix iT';
const seoDescription =
  'AI-powered video marketing with human-like results for Meta, YouTube and TikTok. Creavix iT Solution Bangladesh.';

const uses = [
  { t: 'Performance ads', d: 'Short AI-assisted creatives tested for clicks, messages and conversions.' },
  { t: 'Product stories', d: 'Lifestyle contexts without a full studio day every time.' },
  { t: 'UGC-style clips', d: 'Natural energy closer to real recommendations.' },
  { t: 'Multi-size packs', d: 'One concept → feed, story and landscape for campaigns.' },
];

const stack = [
  { t: 'Concept & hook', d: 'Offer angle and first-3-second attention plan.' },
  { t: 'AI + human polish', d: 'Generation where it helps; edit for brand safety.' },
  { t: 'Platform fit', d: 'Captions, safe zones and ratios for Meta / YouTube / Shorts.' },
  { t: 'Iterate', d: 'Swap hooks and CTAs from early ad data.' },
];

const faqs = [
  { q: 'AI ভিডিও কি আসল মনে হবে?', a: 'লক্ষ্য human-like ফিনিশ — এডিট ও ব্র্যান্ড গাইডলাইন মিলিয়ে দেওয়া হয়।' },
  { q: 'শুধু AI নাকি মিশ্র?', a: 'প্রয়োজনমতো মিশ্র: AI অ্যাসেট + আপনার ফুটেজ/লোগো + প্রফেশনাল এডিট।' },
  { q: 'অ্যাড অ্যাকাউন্টে চলবে?', a: 'পলিসি-সেফ ক্লেইম মেনে তৈরি; চূড়ান্ত অ্যাপ্রুভাল প্ল্যাটফর্মের।' },
  { q: 'Video Editing-এর সাথে সম্পর্ক?', a: 'AI Video কনসেপ্ট+জেনারেশন; ক্লাসিক এডিটিং আলাদা পেজে।' },
  { q: 'কত দ্রুত ডেলিভারি?', a: 'স্কোপ অনুযায়ী — অনেক অ্যাড ক্রিয়েটিভ দ্রুত টার্নঅ্যারাউন্ডের জন্য।' },
];
---

<Layout title={seoTitle} description={seoDescription}>
  <TopBar />
  <Nav active="services" />

  <section class="sv-hero">
    <div class="container sv-grid">
      <div class="reveal">
        <p class="sv-eye">AI Video Marketing</p>
        <h1>Human-like AI video built for ads that convert</h1>
        <p class="sv-sub">Hooks, scripts and motion for feeds — AI speed with editor judgment for Bangladesh and global brands.</p>
        <div class="sv-actions">
          <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Brief my campaign</a>
          <a class="btn btn-outline" href="/services/video-editing">Classic editing</a>
        </div>
      </div>
      <div class="reveal">
        <ServiceHeroVisual variant="ai" />
      </div>
    </div>
  </section>

  <section class="sv-sec">
    <div class="container">
      <div class="sv-center reveal"><p class="sv-eye">Use cases</p><h2>Where AI video pays off</h2></div>
      <div class="sv-cards">{uses.map((u) => (<article class="sv-card reveal"><h3>{u.t}</h3><p>{u.d}</p></article>))}</div>
    </div>
  </section>

  <section class="sv-sec sv-muted">
    <div class="container">
      <div class="sv-center reveal"><p class="sv-eye">How we work</p><h2>Speed without losing brand control</h2></div>
      <div class="sv-cards">{stack.map((s) => (<article class="sv-card reveal"><h3>{s.t}</h3><p>{s.d}</p></article>))}</div>
    </div>
  </section>

  <section class="sv-sec">
    <div class="container sv-faq-wrap">
      <div class="sv-center reveal"><p class="sv-eye">FAQ</p><h2>AI video questions</h2></div>
      <div class="sv-faq reveal">{faqs.map((f) => (<details class="sv-faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
    </div>
  </section>

  <section class="sv-cta">
    <div class="container sv-cta-inner reveal">
      <div><h2>Start an AI video test set</h2><p>WhatsApp {SITE.whatsapp}</p></div>
      <a class="btn btn-light" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
  </section>
  <Footer />
</Layout>

<style>
.sv-hero{padding:5.25rem 1.25rem 3.5rem;background:radial-gradient(ellipse 50% 40% at 90% 10%,rgba(124,58,237,.12),transparent 55%),linear-gradient(180deg,#fff,#F8FAFC)}
.sv-grid{display:grid;gap:2rem;align-items:center}@media(min-width:900px){.sv-grid{grid-template-columns:1.05fr .95fr}}
.sv-eye{margin:0 0 .5rem;font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#7C3AED}
.sv-hero h1,.sv-center h2,.sv-cta h2{font-family:Outfit,system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;color:#0B0F19;margin:0 0 .5rem}
.sv-hero h1{font-size:clamp(1.7rem,4vw,2.5rem);line-height:1.12}
.sv-sub{margin:0 0 1.25rem;color:#475569;line-height:1.65;max-width:34rem}
.sv-actions{display:flex;flex-wrap:wrap;gap:.65rem}
.sv-sec{padding:3.25rem 1.25rem;background:#fff}.sv-muted{background:#F8FAFC}
.sv-center{text-align:center;max-width:36rem;margin:0 auto 1.75rem}.sv-center h2{font-size:clamp(1.35rem,3vw,1.8rem)}
.sv-cards{display:grid;gap:1rem}@media(min-width:700px){.sv-cards{grid-template-columns:1fr 1fr}}
.sv-card{background:#F8FAFC;border:1px solid rgba(15,23,42,.07);border-radius:16px;padding:1.25rem}
.sv-muted .sv-card{background:#fff}.sv-card h3{margin:0 0 .35rem;font-size:1rem;font-weight:800}.sv-card p{margin:0;font-size:.9rem;color:#64748B;line-height:1.55}
.sv-faq-wrap{max-width:720px}.sv-faq{display:flex;flex-direction:column;gap:.65rem}
.sv-faq-item{border:1px solid rgba(15,23,42,.08);border-radius:14px;background:#F8FAFC;padding:.15rem 1rem}
.sv-faq-item summary{cursor:pointer;font-weight:700;padding:.9rem 0;list-style:none;display:flex;justify-content:space-between;gap:1rem}
.sv-faq-item summary::-webkit-details-marker{display:none}.sv-faq-item summary::after{content:'+';color:#7C3AED;font-size:1.25rem}
.sv-faq-item[open] summary::after{content:'–'}.sv-faq-item p{margin:0 0 1rem;color:#64748B;font-size:.92rem;line-height:1.65}
.sv-cta{padding:2.75rem 1.25rem;background:linear-gradient(135deg,#5B21B6,#7C3AED 40%,#2563EB);color:#fff}
.sv-cta-inner{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between}
.sv-cta h2{color:#fff;font-size:clamp(1.25rem,3vw,1.65rem)}.sv-cta p{margin:0;opacity:.95}
.btn-light{background:#fff;color:#5B21B6;border:none}
</style>
