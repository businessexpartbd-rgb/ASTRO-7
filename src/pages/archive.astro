---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import { news, categories } from '../data/news';
---
<Layout title="নিউজ আর্কাইভ | দৈনিক নিউজ" description="ক্যাটাগরি, জেলা, তারিখ বা শব্দ দিয়ে দৈনিক নিউজের প্রতিবেদন খুঁজুন।">
  <div class="container listing-page"><div class="page-intro"><span class="kicker">সংরক্ষিত প্রতিবেদন</span><h1>নিউজ আর্কাইভ</h1><p>ক্যাটাগরি, জেলা অথবা শিরোনামের শব্দ দিয়ে দ্রুত সংবাদ খুঁজুন।</p></div><div class="filter-bar"><input id="archive-search" type="search" placeholder="শিরোনাম বা জেলার নাম লিখুন" /><select id="category-filter"><option value="">সব ক্যাটাগরি</option>{categories.map(c => <option value={c}>{c}</option>)}</select></div><div id="archive-grid" class="card-grid">{news.map(item => <NewsCard item={item} />)}</div><div id="empty-state" class="empty-state" hidden>এই অনুসন্ধানে কোনো সংবাদ পাওয়া যায়নি।</div></div>
  <script is:inline>
    const params = new URLSearchParams(location.search); const search = document.getElementById('archive-search'); const filter = document.getElementById('category-filter');
    if(params.get('category')) filter.value=params.get('category'); if(params.get('q')) search.value=params.get('q');
    function run(){ const q=search.value.trim().toLowerCase(); const cat=filter.value; let shown=0; document.querySelectorAll('#archive-grid .news-card').forEach(card=>{const ok=(!q||card.dataset.search.includes(q))&&(!cat||card.dataset.category===cat); card.hidden=!ok;if(ok)shown++;}); document.getElementById('empty-state').hidden=shown>0; }
    search.addEventListener('input',run); filter.addEventListener('change',run); run();
  </script>
</Layout>
