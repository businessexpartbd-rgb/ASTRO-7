---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Reviews from '../components/Reviews.astro';
import VideoGallery from '../components/VideoGallery.astro';
import { SITE, STATS } from '../data/site';
---
<Layout title={SITE.seoTitle} description={SITE.seoDescription}>
  <Nav active="home" />
  <section id="home" class="hero-premium">
    <div class="hero-bg"><div class="orb orb-1"></div><div class="orb orb-2"></div><div class="orb orb-3"></div><div class="grid-overlay"></div></div>
    <div class="container hero-grid">
      <div class="hero-content reveal">
        <div class="eyebrow"><span class="dot"></span> {SITE.tagline}</div>
        <h1 class="hero-title">Full-Service IT &amp;<br />Digital Solutions That<br /><span class="text-gradient" id="typing-text">Grow Your Business</span><span class="typing-cursor">|</span></h1>
        <p class="hero-lead">{SITE.shortDesc}</p>
        <div class="flex-btns">
          <a href="#services" class="btn btn-primary">Explore Services</a>
          <a href={SITE.whatsappLink} class="btn btn-outline" target="_blank" rel="noopener noreferrer">WhatsApp Us</a>
        </div>
        <div class="trust-row">
          <div class="trust-item"><strong class="count-up" data-count="10+">0</strong><span>Years</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong class="count-up" data-count="4300+">0</strong><span>Projects</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong class="count-up" data-count="4.8">0</strong><span>Avg rating</span></div>
        </div>
      </div>
      <div class="hero-visual reveal">
        <div class="visual-card glass-card animate-float">
          <div class="visual-icon">💼</div>
          <h3>{SITE.brand}</h3>
          <p class="visual-tags">Web · App · AI Video · Auth · Marketing</p>
          <div class="stat-grid">
            <div class="stat-box"><strong class="text-primary count-up" data-count="4300+">0</strong><span>Projects</span></div>
            <div class="stat-box"><strong class="text-violet count-up" data-count="24h">0</strong><span>Fast delivery</span></div>
          </div>
          <div class="float-badge badge-1">💻 Web</div>
          <div class="float-badge badge-2">🤖 AI</div>
          <div class="float-badge badge-3">📱 App</div>
        </div>
      </div>
    </div>
    <div class="scroll-indicator"><span>Scroll</span><div class="scroll-line"></div></div>
  </section>

  <section id="services" class="section-soft">
    <div class="container">
      <div class="text-center mb-8 reveal">
        <p class="eyebrow" style="margin:0 auto 1rem">IT & Digital Services</p>
        <h2 class="mb-4">Everything Your Business Needs Online</h2>
        <p style="max-width:40rem;margin:0 auto">Website development, applications, authentication, AI video production, Facebook growth and full campaign management — one agency.</p>
      </div>
      <div class="grid-3">
        <a href="/services/web-development" class="glass-card reveal" style="text-decoration:none;color:inherit;display:block"><div class="icon-box" style="background:rgba(13,148,136,.12)">💻</div><h3 class="mb-4">Web Development</h3><p style="font-size:.9rem">Fast, SEO-friendly websites and landing pages built for ranking and conversion.</p></a>
        <a href="/services/application-build" class="glass-card reveal" style="text-decoration:none;color:inherit;display:block"><div class="icon-box" style="background:rgba(245,158,11,.12)">📱</div><h3 class="mb-4">Application Build</h3><p style="font-size:.9rem">Custom web & mobile applications designed for performance and scale.</p></a>
        <a href="/services/authentication" class="glass-card reveal" style="text-decoration:none;color:inherit;display:block"><div class="icon-box" style="background:rgba(5,150,105,.12)">🔐</div><h3 class="mb-4">Authentication Systems</h3><p style="font-size:.9rem">Secure login, signup, roles and access control for your products.</p></a>
        <a href="/services/ai-video-marketing" class="glass-card reveal" style="text-decoration:none;color:inherit;display:block"><div class="icon-box" style="background:rgba(234,88,12,.12)">🤖</div><h3 class="mb-4">AI Video Marketing</h3><p style="font-size:.9rem">AI-powered video ads for Meta, YouTube and TikTok that convert.</p></a>
        <a href="/services/video-editing" class="glass-card reveal" style="text-decoration:none;color:inherit;display:block"><div class="icon-box" style="background:rgba(225,29,72,.1)">🎬</div><h3 class="mb-4">Video Editing</h3><p style="font-size:.9rem">Professional editing for ads, social, YouTube and brand films.</p></a>
        <a href="/services/human-like-content" class="glass-card reveal" style="text-decoration:none;color:inherit;display:block"><div class="icon-box" style="background:rgba(217,119,6,.12)">👤</div><h3 class="mb-4">Human-like Content</h3><p style="font-size:.9rem">Authentic AI human & product visuals for campaigns.</p></a>
        <a href="/services/facebook-page" class="glass-card reveal" style="text-decoration:none;color:inherit;display:block"><div class="icon-box" style="background:rgba(13,148,136,.12)">📘</div><h3 class="mb-4">Facebook Page Services</h3><p style="font-size:.9rem">Business page setup and verification support.</p></a>
        <a href="/services/boosting" class="glass-card reveal" style="text-decoration:none;color:inherit;display:block"><div class="icon-box" style="background:rgba(225,29,72,.1)">📈</div><h3 class="mb-4">Boosting Service</h3><p style="font-size:.9rem">Targeted Meta boosting to reach the right audience.</p></a>
        <a href="/services/campaign" class="glass-card reveal" style="text-decoration:none;color:inherit;display:block"><div class="icon-box" style="background:rgba(234,88,12,.12)">🎯</div><h3 class="mb-4">Campaign Service</h3><p style="font-size:.9rem">End-to-end campaign planning and performance management.</p></a>
      </div>
    </div>
  </section>

  <VideoGallery />

  <section id="about" class="section-violet">
    <div class="container grid-2">
      <div class="reveal">
        <p class="eyebrow">Why {SITE.name}</p>
        <h2 class="mb-6">IT Solution Agency · Since {SITE.servingSince}</h2>
        <p class="lead mb-8">{SITE.shortDesc}</p>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:.85rem;color:var(--text-2)">
          <li>✓ Web, app & authentication engineering</li>
          <li>✓ AI video + classic video production</li>
          <li>✓ Facebook page, boost & campaigns</li>
          <li>✓ Studio: {SITE.addressBn} · Founder {SITE.founder.name}</li>
        </ul>
      </div>
      <div class="reveal">
        <div class="glass-card" style="padding:2.2rem">
          <h3 class="mb-6">At a glance</h3>
          <div class="stat-grid">
            {
              STATS.map((s) => (
                <div>
                  <strong class="count-up" data-count={s.value} style="font-size:1.5rem;color:var(--primary);font-family:var(--font-h)">0</strong>
                  <br />
                  <span style="font-size:.8rem;color:var(--text-3)">{s.label}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <Reviews />

  <section id="contact" class="section-warm">
    <div class="container text-center reveal" style="max-width:40rem">
      <h2 class="mb-4">Ready to Grow With a Full IT Partner?</h2>
      <p class="mb-8" style="font-size:1.1rem">WhatsApp {SITE.whatsapp} · {SITE.email1} · {SITE.hotline}</p>
      <div style="display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center">
        <a href={SITE.whatsappLink} class="btn btn-primary" style="padding:.9rem 2rem;font-size:1rem" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a href="/contact" class="btn btn-outline" style="padding:.9rem 2rem;font-size:1rem">Contact page</a>
      </div>
    </div>
  </section>
  <Footer />
</Layout>
