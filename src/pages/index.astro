---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Reviews from '../components/Reviews.astro';
import FeaturedVideoStack from '../components/FeaturedVideoStack.astro';
import BrandStrip from '../components/BrandStrip.astro';
import FAQ from '../components/FAQ.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import IconBox from '../components/IconBox.astro';
import ServiceIcons from '../components/icons/ServiceIcons.astro';
import HeroBookReel from '../components/HeroBookReel.astro';
import { SITE } from '../data/site';

const services = [
  { href: '/services/video-editing', name: 'video', title: 'Video Editing', desc: 'Ads, Reels, YouTube and brand films — cinematic grade.', tone: 'rgba(139,92,246,.11)' },
  { href: '/services/ai-video-marketing', name: 'ai', title: 'AI Video Marketing', desc: 'Human-like AI ads for Meta, YouTube and TikTok.', tone: 'rgba(37,99,235,.1)' },
  { href: '/services/human-like-content', name: 'human', title: 'Human-like Content', desc: 'Authentic product & people content that converts.', tone: 'rgba(244,63,94,.09)' },
  { href: '/services/web-development', name: 'web', title: 'Web Development', desc: 'Fast, SEO-ready websites and landing pages.', tone: 'rgba(6,182,212,.1)' },
  { href: '/services/application-build', name: 'app', title: 'Application Build', desc: 'Custom web & mobile apps for performance and scale.', tone: 'rgba(59,130,246,.1)' },
  { href: '/services/authentication', name: 'auth', title: 'Authentication', desc: 'Secure login, roles and access control.', tone: 'rgba(16,185,129,.1)' },
  { href: '/services/automation', name: 'automation', title: 'Automation', desc: 'Messenger & channel automation with human-like replies.', tone: 'rgba(20,184,166,.1)' },
  { href: '/services/digital-marketing', name: 'marketing', title: 'Digital Marketing', desc: 'SEO, ads, social and growth under one plan.', tone: 'rgba(249,115,22,.1)' },
  { href: '/services/seo', name: 'seo', title: 'SEO Services', desc: 'Rank for the searches your customers type.', tone: 'rgba(99,102,241,.1)' },
  { href: '/services/facebook-page', name: 'facebook', title: 'Facebook Page', desc: 'Setup, blue verify path, growth and checkup.', tone: 'rgba(24,119,242,.1)' },
  { href: '/services/boosting', name: 'boosting', title: 'Boosting', desc: 'Meta boosting from $5 with clear BDT rates.', tone: 'rgba(234,179,8,.11)' },
  { href: '/services/campaign', name: 'campaign', title: 'Campaign', desc: 'Full Meta & YouTube campaign management.', tone: 'rgba(236,72,153,.09)' },
];
const primaryServices = services.filter((_, index) => index < 3);
const supportingServices = services.filter((_, index) => index >= 3);
const aiTools = [
  { name: 'Kling AI', role: 'Cinematic video', icon: '/ai-tools/kling-transparent.png', href: 'https://kling.ai/' },
  { name: 'Hunyuan', role: 'AI video model', icon: '/ai-tools/hunyuan-transparent.png', href: 'https://aivideo.hunyuan.tencent.com/' },
  { name: 'ElevenLabs', role: 'Voice & dubbing', icon: '/ai-tools/elevenlabs.svg', href: 'https://elevenlabs.io/' },
  { name: 'Gemini', role: 'Ideas & visuals', icon: '/ai-tools/gemini.svg', href: 'https://gemini.google.com/' },
  { name: 'ChatGPT', role: 'Creative direction', icon: '/ai-tools/openai.svg', href: 'https://chatgpt.com/' },
  { name: 'Claude', role: 'Scripts & research', icon: '/ai-tools/claude.svg', href: 'https://claude.ai/' },
  { name: 'Higgsfield', role: 'AI video effects', icon: '/ai-tools/higgsfield-transparent.png', href: 'https://higgsfield.ai/' },
  { name: 'Grok', role: 'Image & video ideas', icon: '/ai-tools/grok-transparent.png', href: 'https://grok.com/' },
  { name: 'HeyGen', role: 'Avatar video', icon: '/ai-tools/heygen-transparent.png', href: 'https://www.heygen.com/' },
];
const devToolTeaser = [
  { name: 'v0', icon: '/logos/v0.svg' },
  { name: 'Lovable', icon: 'https://lovable.dev/favicon.ico' },
  { name: 'Bolt', icon: '/logos/bolt.svg' },
  { name: 'Replit', icon: '/logos/replit.svg' },
  { name: 'Base44', icon: 'https://base44.com/favicon.ico' },
  { name: 'Cursor', icon: '/logos/cursor.svg' },
];
---
<Layout title={SITE.seoTitle} description={SITE.seoDescription}>
  <TopBar />
  <Nav active="home" />

  <section id="home" class="hero-premium">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="grid-overlay"></div>
    </div>
    <div class="container hero-grid hero-grid-orbit">
      <div class="hero-content reveal">
        <div class="rating-pill">
          <span class="rating-score">4.8</span>
          <span class="rating-stars" aria-hidden="true">★★★★★</span>
          <span class="rating-label">Client Rated · BD &amp; Global</span>
        </div>

        <h1 class="hero-title">
          AI Video Marketing &amp;<br />Professional Video Editing
        </h1>

        <p class="hero-lead">
          Human creative direction, cinematic AI generation and professional post-production—built for brands that refuse to look ordinary. |
          <strong class="hero-delivery">24–48 Hours Delivery</strong>
        </p>

        <div class="hero-capabilities" aria-label="Video production capabilities">
          <span><i></i>Human-like AI</span>
          <span><i></i>Camera Footage</span>
          <span><i></i>Pro Post-Production</span>
        </div>

        <div class="flex-btns">
          <a href="#featured-videos" class="btn btn-primary hero-cta hero-cta-watch">Watch Videos</a>
          <a href={SITE.whatsappLink} class="btn hero-cta hero-cta-wa" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a href="/portfolio" class="btn hero-cta hero-cta-work">Portfolio</a>
        </div>

        <div class="trust-row">
          <div class="trust-item"><strong class="count-up" data-count="10+">10+</strong><span>Years</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong class="count-up" data-count="4300+">4,300+</strong><span>Projects</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong>24–48h</strong><span>Delivery</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong class="count-up" data-count="4.8">4.8</strong><span>Rating</span></div>
        </div>
      </div>

      <div class="hero-visual reveal">
        <div class="hero-visual-frame">
          <HeroBookReel />
        </div>
      </div>
    </div>
  </section>

  <BrandStrip />

  <FeaturedVideoStack />

  <section class="ai-stack" aria-labelledby="ai-stack-title">
    <div class="container">
      <div class="ai-stack-head reveal">
        <div>
          <p class="eyebrow">Our AI Production Stack</p>
          <h2 id="ai-stack-title">Professional Tools. Human Creative Direction.</h2>
        </div>
        <p>We combine leading AI platforms with professional editing to produce human-like videos, voices and campaign-ready visuals.</p>
      </div>
      <div class="ai-tools-grid" aria-label="AI platforms used by Creavix iT Solution">
        {aiTools.map((tool, i) => (
          <a class="ai-tool-card reveal" href={tool.href} target="_blank" rel="noopener noreferrer" aria-label={`Open the official ${tool.name} website`} style={`--tool-index:${i}`}>
            <span class="ai-tool-logo"><img src={tool.icon} alt={`${tool.name} logo`} width="192" height="192" loading="lazy" decoding="async" /></span>
            <span class="ai-tool-copy"><strong>{tool.name}</strong><small>{tool.role}</small></span>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
      <p class="ai-stack-note">Official platform links · Account availability and plans are managed by each provider.</p>
    </div>
  </section>

  <section id="services" class="section-soft">
    <div class="container">
      <div class="text-center mb-8 reveal">
        <p class="eyebrow" style="margin:0 auto 1rem">Our Services</p>
        <h2 class="mb-4">Everything Your Brand Needs to Grow</h2>
        <p style="max-width:40rem;margin:0 auto">Video, AI, web, apps, SEO, automation and Meta growth — one professional partner for Bangladesh and global brands.</p>
        <div class="section-signals" aria-label="Service standards"><span>12 capabilities</span><span>One accountable team</span><span>Global-ready delivery</span></div>
      </div>
      <div class="primary-services grid-3" aria-label="Primary services">
        {primaryServices.map((s, i) => (
          <a href={s.href} class="service-card service-card-primary reveal" data-magnetic style={`--card-index:${i}`}>
            <div class="service-card-top"><span class="service-priority">Core expertise</span><span class="service-index">0{i + 1}</span></div>
            <IconBox name={s.name} tone={s.tone} size={44} />
            <div class="service-copy"><h3>{s.title}</h3><p>{s.desc}</p></div>
            <span class="svc-more"><span>Explore service</span><i aria-hidden="true">↗</i></span>
          </a>
        ))}
      </div>
      <div class="supporting-heading reveal">
        <p class="eyebrow">Complete IT Solutions</p>
        <h3>Development, SEO, Automation &amp; Growth</h3>
      </div>
      <div class="grid-3 supporting-services" aria-label="Supporting digital services">
        {supportingServices.map((s, i) => (
          <a href={s.href} class="service-card service-card-support reveal" style={`--card-index:${i + 3}`}>
            <div class="service-card-top"><IconBox name={s.name} tone={s.tone} size={38} /><span class="service-index">{String(i + 4).padStart(2, '0')}</span></div>
            <div class="service-copy"><h3>{s.title}</h3><p>{s.desc}</p></div>
            <span class="svc-more"><span>Discover</span><i aria-hidden="true">→</i></span>
          </a>
        ))}
      </div>
      <aside class="dev-stack-teaser reveal" aria-labelledby="dev-stack-teaser-title">
        <div class="dev-stack-copy">
          <p class="eyebrow">AI-Assisted Development</p>
          <h3 id="dev-stack-teaser-title">AI speed. Expert engineering.</h3>
          <p>We use leading builders for faster iteration, then complete the code, security, performance and deployment manually.</p>
        </div>
        <div class="dev-stack-logos" aria-label="Selected AI development platforms">
          {devToolTeaser.map((tool) => (
            <span class="dev-stack-chip"><span><img src={tool.icon} alt={`${tool.name} official logo`} width="30" height="30" loading="lazy" decoding="async" /></span><b>{tool.name}</b></span>
          ))}
        </div>
        <a class="dev-stack-link" href="/services/web-development#ai-builders">Explore our development stack <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <ProcessFlow />

  <section id="about" class="section-violet">
    <div class="container about-premium-grid">
      <div class="about-story reveal">
        <p class="eyebrow">Why Creavix</p>
        <h2 class="mb-6">IT &amp; Video Agency · Since {SITE.servingSince}</h2>
        <p class="lead mb-8">{SITE.shortDesc}</p>
        <ul class="about-checks">
          <li><ServiceIcons name="check" size={22} /><span>Cinematic &amp; AI video production</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Web, app, SEO &amp; automation</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Facebook page, boost &amp; campaigns</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Studio: {SITE.addressBn} · {SITE.founder.name}</span></li>
        </ul>
        <div class="about-actions">
          <a href="/about" class="btn btn-outline">About us</a>
          <a href="/contact" class="btn btn-primary">Contact</a>
        </div>
      </div>
      <div class="about-dashboard reveal">
        <div class="about-dashboard-head"><span>Creavix performance</span><i>Live</i></div>
        <div class="about-stat-card">
          <h3>At a glance</h3>
          <div class="stat-grid">
            <div><strong class="count-up" data-count="10+">10+</strong><span>Years</span></div>
            <div><strong class="count-up" data-count="4300+">4,300+</strong><span>Projects</span></div>
            <div><strong class="count-up" data-count="4.8">4.8</strong><span>Avg rating</span></div>
            <div><strong>24–48h</strong><span>Delivery</span></div>
          </div>
        </div>
        <div class="about-mini-row"><span><b>BD</b> Local insight</span><span><b>∞</b> Global scale</span></div>
      </div>
    </div>
  </section>

  <Reviews />
  <FAQ />

  <section id="contact" class="section-warm premium-contact">
    <div class="container reveal">
      <div class="contact-panel">
        <div class="contact-copy"><span class="contact-kicker"><i></i>Accepting selected projects</span><h2>Ready to Grow With Creavix?</h2><p>Tell us what you want to build. We’ll turn the idea into a clear, high-performance production plan.</p></div>
        <div class="contact-action"><a href={SITE.whatsappLink} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Start on WhatsApp <span>↗</span></a><a href="/contact" class="btn btn-outline">Contact page</a><small>{SITE.whatsapp} · {SITE.email1}</small></div>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .ai-stack{padding:4.25rem 1.25rem;background:linear-gradient(180deg,#fff 0%,#f6f9ff 100%);border-block:1px solid rgba(15,23,42,.06)}
  .ai-stack-head{display:grid;gap:1rem;margin-bottom:1.65rem}.ai-stack-head .eyebrow{margin:0 0 .75rem}.ai-stack-head h2{margin:0;max-width:660px;font-size:clamp(1.7rem,3.5vw,2.7rem);line-height:1.08}.ai-stack-head>p{margin:0;max-width:600px;color:#64748b;line-height:1.7}
  .ai-tools-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}
  .ai-tool-card{position:relative;display:flex;align-items:center;gap:.7rem;min-width:0;padding:.72rem;border:1px solid rgba(15,23,42,.08);border-radius:18px;background:rgba(255,255,255,.92);box-shadow:0 10px 28px rgba(15,23,42,.055);color:#0b0f19;text-decoration:none;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s,border-color .3s}
  .ai-tool-card:hover,.ai-tool-card:focus-visible{transform:translateY(-4px);border-color:rgba(37,99,235,.24);box-shadow:0 18px 38px rgba(37,99,235,.12);outline:none}
  .ai-tool-logo{width:52px;height:52px;display:grid;place-items:center;flex:0 0 52px;overflow:visible;background:none;border:0;border-radius:0;box-shadow:none}
  .ai-tool-logo img{display:block;width:52px;height:52px;max-width:100%;max-height:100%;object-fit:contain;background:transparent;border:0;border-radius:0;box-shadow:none}.ai-tool-copy{display:grid;min-width:0;gap:.16rem}.ai-tool-copy strong{overflow:hidden;text-overflow:ellipsis;font:800 .82rem/1.2 var(--font-h);white-space:nowrap}.ai-tool-copy small{overflow:hidden;text-overflow:ellipsis;color:#64748b;font-size:.64rem;white-space:nowrap}.ai-tool-card>i{display:none;margin-left:auto;color:#2563eb;font-style:normal;font-weight:800}.ai-stack-note{margin:1rem 0 0;color:#94a3b8;font-size:.68rem;text-align:center}
  @media(min-width:640px){.ai-tools-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.ai-tool-card>i{display:block}}
  @media(min-width:900px){.ai-stack{padding-block:5.5rem}.ai-stack-head{grid-template-columns:1.1fr .9fr;align-items:end}.ai-tools-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:.85rem}.ai-tool-card{display:grid;justify-items:center;gap:.65rem;padding:1rem .7rem;text-align:center}.ai-tool-logo{width:58px;height:58px;flex-basis:58px}.ai-tool-logo img{width:58px;height:58px}.ai-tool-copy strong{font-size:.9rem}.ai-tool-copy small{font-size:.68rem}.ai-tool-card>i{position:absolute;right:.65rem;top:.55rem}}
  @media(prefers-reduced-motion:reduce){.ai-tool-card{transition:none}.ai-tool-card:hover{transform:none}}
  .section-signals{display:flex;justify-content:center;flex-wrap:wrap;gap:.45rem;margin-top:1.25rem}.section-signals span{padding:.38rem .68rem;border:1px solid rgba(37,99,235,.12);border-radius:999px;background:rgba(255,255,255,.7);color:#475569;font-size:.7rem;font-weight:700}
  .dev-stack-teaser{display:grid;gap:1.15rem;margin-top:3.3rem;padding:1.2rem;border:1px solid rgba(37,99,235,.14);border-radius:24px;background:linear-gradient(135deg,#fff 0%,#f4f8ff 62%,#eefbf8 100%);box-shadow:0 18px 45px rgba(15,23,42,.06)}.dev-stack-copy .eyebrow{margin:0 0 .55rem}.dev-stack-copy h3{margin:0 0 .4rem;font-size:1.18rem}.dev-stack-copy p{margin:0;color:#64748b;font-size:.82rem;line-height:1.55}.dev-stack-logos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.48rem}.dev-stack-chip{display:flex;align-items:center;gap:.42rem;min-width:0;padding:.45rem;border:1px solid rgba(15,23,42,.07);border-radius:13px;background:rgba(255,255,255,.88)}.dev-stack-chip>span{width:30px;height:30px;display:grid;place-items:center;flex:0 0 30px;overflow:hidden;border-radius:9px;background:#fff}.dev-stack-chip img{display:block;width:24px;height:24px;object-fit:contain}.dev-stack-chip b{overflow:hidden;text-overflow:ellipsis;font-size:.67rem;white-space:nowrap}.dev-stack-link{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;padding:.75rem 1rem;border-radius:14px;background:#0b1220;color:#fff;text-decoration:none;font-size:.78rem;font-weight:800}.dev-stack-link:hover{background:#1d4ed8;color:#fff}
  @media(min-width:900px){.dev-stack-teaser{grid-template-columns:1.15fr 1fr auto;align-items:center;padding:1.35rem 1.5rem}.dev-stack-link{white-space:nowrap}.dev-stack-logos{grid-template-columns:repeat(3,minmax(0,1fr))}}
  .primary-services { margin-bottom: 3.25rem; }
  .service-card{position:relative;display:flex;flex-direction:column;min-height:100%;padding:1.45rem;text-decoration:none;color:inherit;overflow:hidden;border:1px solid rgba(15,23,42,.08);border-radius:24px;background:rgba(255,255,255,.88);box-shadow:0 12px 35px rgba(15,23,42,.055),inset 0 1px 0 #fff;isolation:isolate;transition:transform .45s cubic-bezier(.16,1,.3,1),box-shadow .45s,border-color .45s}.service-card:before{content:'';position:absolute;z-index:-1;width:170px;height:170px;right:-75px;top:-80px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.14),transparent 68%);transition:transform .55s ease}.service-card:hover{transform:translateY(-8px);border-color:rgba(37,99,235,.24);box-shadow:0 26px 60px rgba(37,99,235,.12),inset 0 1px 0 #fff}.service-card:hover:before{transform:scale(1.35)}
  .service-card-primary {
    min-height:330px;
    padding:1.65rem;
    border-color: rgba(37, 99, 235, 0.2);
    background: linear-gradient(145deg, #fff 0%, #f8fbff 100%);
  }
  .service-card-primary:nth-child(2){background:linear-gradient(145deg,#fff,#faf8ff)}.service-card-primary:nth-child(3){background:linear-gradient(145deg,#fff,#f4fbff)}
  .service-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}.service-index{font:800 .7rem/1 var(--font-h);letter-spacing:.12em;color:#94a3b8}.service-copy{margin-top:auto}.service-copy h3{margin:0 0 .65rem;font-size:clamp(1.1rem,2vw,1.35rem);letter-spacing:-.025em}.service-copy p{margin:0;color:#64748b;font-size:.88rem;line-height:1.65}
  .service-priority {
    display: inline-flex;
    margin-bottom: 1rem;
    padding: .3rem .7rem;
    border-radius: 999px;
    color: #1d4ed8;
    background: rgba(37, 99, 235, .08);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .supporting-heading { max-width: 42rem; margin: 0 auto 1.5rem; text-align: center; }
  .supporting-heading .eyebrow { margin: 0 auto .65rem; }
  .supporting-heading h3 { font-size: clamp(1.35rem, 2.4vw, 1.9rem); }
  .supporting-services{gap:1rem}.service-card-support{min-height:245px}.service-card-support .service-card-top :global(.live-icon-box){margin:0}.service-card-support:nth-child(3n+2){transform:translateY(14px)}.service-card-support:nth-child(3n+2):hover{transform:translateY(6px)}
  .hero-grid-orbit {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: center;
    min-width: 0;
  }
  .hero-visual {
    order: -1;
    display: flex;
    justify-content: center;
    width: 100%;
    min-width: 0;
  }
  .hero-content {
    order: 1;
    max-width: 580px;
    min-width: 0;
  }
  .hero-visual-frame {
    position: relative;
    width: 100%;
    max-width: 460px;
    min-width: 0;
  }

  @media (min-width: 900px) {
    .hero-grid-orbit {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 2.75rem;
      align-items: center;
      min-height: 540px;
    }
    .hero-content { order: 1; }
    .hero-visual { order: 2; }
    .hero-visual-frame { max-width: 480px; }
  }

  .rating-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    margin-bottom: 1.35rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .rating-score { color: #0B0F19; }
  .rating-stars { color: #F59E0B; letter-spacing: 1px; font-size: 0.75rem; }
  .rating-label { color: #64748B; font-weight: 500; }
  .hero-delivery { color: #2563EB; font-weight: 700; }
  .hero-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
    margin: 1rem 0 1.15rem;
  }
  .hero-capabilities span {
    display: inline-flex;
    align-items: center;
    gap: .38rem;
    padding: .36rem .58rem;
    border: 1px solid rgba(37, 99, 235, .12);
    border-radius: 999px;
    background: rgba(255, 255, 255, .78);
    color: #334155;
    font-size: .68rem;
    font-weight: 700;
  }
  .hero-capabilities i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563EB, #8B5CF6);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, .08);
  }

  .trust-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.85rem;
    margin-top: 1.5rem;
  }
  .trust-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .trust-item strong {
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: #0B0F19;
    line-height: 1.1;
  }
