---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Reviews from '../components/Reviews.astro';
import FeaturedVideoStack from '../components/FeaturedVideoStack.astro';
import BrandStrip from '../components/BrandStrip.astro';
import FAQ from '../components/FAQ.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import IconBox from '../components/IconBox.astro';
import ServiceIcons from '../components/icons/ServiceIcons.astro';
import HeroBookReel from '../components/HeroBookReel.astro';
import { SITE } from '../data/site';

const services = [
  { href: '/services/video-editing', name: 'video', title: 'Video Editing', desc: 'Ads, Reels, YouTube and brand films — cinematic grade.', tone: 'rgba(37,99,235,.08)' },
  { href: '/services/ai-video-marketing', name: 'ai', title: 'AI Video Marketing', desc: 'Human-like AI ads for Meta, YouTube and TikTok.', tone: 'rgba(15,23,42,.05)' },
  { href: '/services/human-like-content', name: 'human', title: 'Human-like Content', desc: 'Authentic product & people content that converts.', tone: 'rgba(37,99,235,.08)' },
  { href: '/services/web-development', name: 'web', title: 'Web Development', desc: 'Fast, SEO-ready websites and landing pages.', tone: 'rgba(15,23,42,.05)' },
  { href: '/services/application-build', name: 'app', title: 'Application Build', desc: 'Custom web & mobile apps for performance and scale.', tone: 'rgba(37,99,235,.08)' },
  { href: '/services/authentication', name: 'auth', title: 'Authentication', desc: 'Secure login, roles and access control.', tone: 'rgba(15,23,42,.05)' },
  { href: '/services/automation', name: 'campaign', title: 'Automation', desc: 'Messenger & channel automation with human-like replies.', tone: 'rgba(37,99,235,.08)' },
  { href: '/services/digital-marketing', name: 'boost', title: 'Digital Marketing', desc: 'SEO, ads, social and growth under one plan.', tone: 'rgba(15,23,42,.05)' },
  { href: '/services/seo', name: 'web', title: 'SEO Services', desc: 'Rank for the searches your customers type.', tone: 'rgba(37,99,235,.08)' },
  { href: '/services/facebook-page', name: 'facebook', title: 'Facebook Page', desc: 'Setup, blue verify path, growth and checkup.', tone: 'rgba(15,23,42,.05)' },
  { href: '/services/boosting', name: 'boost', title: 'Boosting', desc: 'Meta boosting from $5 with clear BDT rates.', tone: 'rgba(37,99,235,.08)' },
  { href: '/services/campaign', name: 'campaign', title: 'Campaign', desc: 'Full Meta & YouTube campaign management.', tone: 'rgba(15,23,42,.05)' },
];
---
<Layout title={SITE.seoTitle} description={SITE.seoDescription}>
  <TopBar />
  <Nav active="home" />

  <section id="home" class="hero-premium">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="grid-overlay"></div>
    </div>
    <div class="container hero-grid hero-grid-orbit">
      <div class="hero-content reveal">
        <div class="rating-pill">
          <span class="rating-score">4.8</span>
          <span class="rating-stars" aria-hidden="true">★★★★★</span>
          <span class="rating-label">Client Rated · BD &amp; Global</span>
        </div>

        <h1 class="hero-title">
          Video Editing Agency<br />in Bangladesh
        </h1>

        <p class="hero-lead">
          Cinematic Human-like AI Videos, Professional Video Editing &amp; Full Digital Solutions |
          <strong class="hero-delivery">24–48 Hours Delivery</strong>
        </p>

        <div class="flex-btns">
          <a href="#featured-videos" class="btn btn-primary">Watch Videos</a>
          <a href={SITE.whatsappLink} class="btn btn-outline" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a href="/portfolio" class="btn btn-outline">Portfolio</a>
        </div>

        <div class="trust-row">
          <div class="trust-item"><strong class="count-up" data-count="10+">0</strong><span>Years</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong class="count-up" data-count="4300+">0</strong><span>Projects</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong>24–48h</strong><span>Delivery</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong class="count-up" data-count="4.8">0</strong><span>Rating</span></div>
        </div>
      </div>

      <div class="hero-visual reveal">
        <div class="hero-visual-frame">
          <HeroBookReel />
        </div>
      </div>
    </div>
  </section>

  <BrandStrip />

  <FeaturedVideoStack />

  <section id="services" class="section-soft">
    <div class="container">
      <div class="text-center mb-8 reveal">
        <p class="eyebrow" style="margin:0 auto 1rem">Our Services</p>
        <h2 class="mb-4">Everything Your Brand Needs to Grow</h2>
        <p style="max-width:40rem;margin:0 auto">Video, AI, web, apps, SEO, automation and Meta growth — one professional partner for Bangladesh and global brands.</p>
      </div>
      <div class="grid-3">
        {services.map((s) => (
          <a href={s.href} class="glass-card reveal" style="text-decoration:none;color:inherit;display:block">
            <IconBox name={s.name} tone={s.tone} size={44} />
            <h3 class="mb-4">{s.title}</h3>
            <p style="font-size:.9rem">{s.desc}</p>
            <span class="svc-more">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ProcessFlow />

  <section id="about" class="section-violet">
    <div class="container grid-2">
      <div class="reveal">
        <p class="eyebrow">Why Creavix</p>
        <h2 class="mb-6">IT &amp; Video Agency · Since {SITE.servingSince}</h2>
        <p class="lead mb-8">{SITE.shortDesc}</p>
        <ul class="about-checks">
          <li><ServiceIcons name="check" size={22} /><span>Cinematic &amp; AI video production</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Web, app, SEO &amp; automation</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Facebook page, boost &amp; campaigns</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Studio: {SITE.addressBn} · {SITE.founder.name}</span></li>
        </ul>
        <div style="margin-top:1.25rem;display:flex;flex-wrap:wrap;gap:.65rem">
          <a href="/about" class="btn btn-outline">About us</a>
          <a href="/contact" class="btn btn-primary">Contact</a>
        </div>
      </div>
      <div class="reveal">
        <div class="glass-card" style="padding:2.2rem">
          <h3 class="mb-6">At a glance</h3>
          <div class="stat-grid">
            <div><strong class="count-up" data-count="10+" style="font-size:1.5rem;color:var(--primary);font-family:var(--font-h)">0</strong><br /><span style="font-size:.8rem;color:var(--text-3)">Years</span></div>
            <div><strong class="count-up" data-count="4300+" style="font-size:1.5rem;color:var(--primary);font-family:var(--font-h)">0</strong><br /><span style="font-size:.8rem;color:var(--text-3)">Projects</span></div>
            <div><strong class="count-up" data-count="4.8" style="font-size:1.5rem;color:var(--primary);font-family:var(--font-h)">0</strong><br /><span style="font-size:.8rem;color:var(--text-3)">Avg rating</span></div>
            <div><strong style="font-size:1.5rem;color:var(--primary);font-family:var(--font-h)">24–48h</strong><br /><span style="font-size:.8rem;color:var(--text-3)">Delivery</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Reviews />
  <FAQ />

  <section id="contact" class="section-warm">
    <div class="container text-center reveal" style="max-width:40rem">
      <h2 class="mb-4">Ready to Grow With Creavix?</h2>
      <p class="mb-8" style="font-size:1.1rem">WhatsApp {SITE.whatsapp} · {SITE.email1} · {SITE.hotline}</p>
      <div style="display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center">
        <a href={SITE.whatsappLink} class="btn btn-primary" style="padding:.9rem 2rem;font-size:1rem" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a href="/contact" class="btn btn-outline" style="padding:.9rem 2rem;font-size:1rem">Contact page</a>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .hero-grid-orbit {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: center;
  }
  .hero-visual {
    order: -1;
    display: flex;
    justify-content: center;
    width: 100%;
  }
  .hero-content {
    order: 1;
    max-width: 580px;
  }
  .hero-visual-frame {
    position: relative;
    width: 100%;
    max-width: 460px;
  }

  @media (min-width: 900px) {
    .hero-grid-orbit {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 2.75rem;
      align-items: center;
      min-height: 540px;
    }
    .hero-content { order: 1; }
    .hero-visual { order: 2; }
    .hero-visual-frame { max-width: 480px; }
  }

  .rating-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    margin-bottom: 1.35rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .rating-score { color: #0B0F19; }
  .rating-stars { color: #F59E0B; letter-spacing: 1px; font-size: 0.75rem; }
  .rating-label { color: #64748B; font-weight: 500; }
  .hero-delivery { color: #2563EB; font-weight: 700; }

  .trust-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.85rem;
    margin-top: 1.5rem;
  }
  .trust-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .trust-item strong {
    font-family: var(--font-h), system-ui, sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: #0B0F19;
    line-height: 1.1;
  }
  .trust-item span {
    font-size: 0.72rem;
    font-weight: 600;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .trust-divider {
    width: 1px;
    height: 2rem;
    background: rgba(15, 23, 42, 0.12);
    flex-shrink: 0;
  }

  .svc-more {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #2563EB;
  }

  .about-checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    color: var(--text-2);
    padding: 0;
    margin: 0;
  }
  .about-checks li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  @media (max-width: 639px) {
    .hero-content { max-width: 100%; }
    .flex-btns { width: 100%; }
    .flex-btns .btn { flex: 1 1 calc(50% - 0.4rem); min-width: 0; text-align: center; }
    .trust-row { gap: 0.5rem 0.55rem; }
    .trust-item strong { font-size: 1.05rem; }
    .trust-divider { height: 1.75rem; }
  }
</style>
