---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import { news } from '../data/news';
const lead = news.find(n => n.featured) ?? news[0];
const latest = news.filter(n => n.slug !== lead.slug).slice(0,4);
const rural = news.filter(n => n.rural).slice(0,4);
const top = news.slice(0,5);
const jsonLd = { '@context':'https://schema.org','@type':'NewsMediaOrganization',name:'দৈনিক নিউজ',url:Astro.url.origin,logo:new URL('/logo.png',Astro.url.origin).href };
---
<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="breaking" aria-label="ব্রেকিং নিউজ"><div class="container breaking-inner"><strong>ব্রেকিং</strong><div class="ticker-window"><div class="ticker-track">{top.map(item => <a href={`/news/${item.slug}/`}>{item.title}</a>)}</div></div></div></section>
  <div class="container homepage">
    <section class="lead-grid" aria-label="প্রধান সংবাদ">
      <article class="lead-story"><a href={`/news/${lead.slug}/`} class="lead-image"><img src={lead.image} alt="" width="1600" height="1067" decoding="async" fetchpriority="high" /></a><div class="lead-body"><div class="eyebrow">প্রধান সংবাদ · {lead.district}</div><h1><a href={`/news/${lead.slug}/`} data-bn={lead.title} data-en={lead.titleEn}>{lead.title}</a></h1><p data-bn={lead.excerpt} data-en={lead.excerptEn}>{lead.excerpt}</p><a class="read-more" href={`/news/${lead.slug}/`}>বিস্তারিত পড়ুন →</a></div></article>
      <div class="latest-stack"><div class="section-heading"><h2>সর্বশেষ</h2><a href="/archive/">সব খবর</a></div>{latest.map(item => <NewsCard item={item} compact />)}</div>
    </section>
    <section class="content-section"><div class="section-heading"><div><span class="kicker">বাংলাদেশের শিকড়</span><h2>গ্রামবাংলার খবর</h2></div><a href="/archive/?category=গ্রামবাংলা">আরও দেখুন</a></div><div class="card-grid">{rural.map(item => <NewsCard item={item} />)}</div></section>
    <section class="district-promo"><div><span class="kicker">দেশজুড়ে প্রতিনিধি</span><h2>৬৪ জেলার সংবাদ</h2><p>বিভাগ, জেলা ও প্রকাশের তারিখ ধরে স্থানীয় সংবাদ খুঁজুন। গ্রামের সমস্যা, সম্ভাবনা ও মানুষের না-বলা কথাই এখানে বিশেষ গুরুত্ব পাবে।</p><a class="button" href="/districts/">জেলা নির্বাচন করুন</a></div><div class="district-stat"><strong>৬৪</strong><span>জেলা</span><strong>৮</strong><span>বিভাগ</span></div></section>
    <section class="content-section"><div class="section-heading"><h2>আরও সংবাদ</h2><a href="/archive/">নিউজ আর্কাইভ</a></div><div class="card-grid">{news.slice(4,8).map(item => <NewsCard item={item} />)}</div></section>
    <section class="weather-panel"><div><span class="kicker">আবহাওয়া</span><h2>আপনার জেলার আবহাওয়া ও সতর্কতা</h2><p>দৈনিক পূর্বাভাসের সঙ্গে নদী, বৃষ্টি ও স্থানীয় ঝুঁকির গুরুত্বপূর্ণ তথ্য আলাদা বিভাগে পাওয়া যাবে।</p></div><a class="button light" href="/weather/">আবহাওয়া দেখুন</a></section>
  </div>
</Layout>
