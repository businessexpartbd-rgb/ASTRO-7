---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Reviews from '../components/Reviews.astro';
import FeaturedVideoStack from '../components/FeaturedVideoStack.astro';
import BrandStrip from '../components/BrandStrip.astro';
import FAQ from '../components/FAQ.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import IconBox from '../components/IconBox.astro';
import ServiceIcons from '../components/icons/ServiceIcons.astro';
import HeroBookReel from '../components/HeroBookReel.astro';
import { SITE } from '../data/site';

const services = [
  { href: '/services/video-editing', name: 'video', title: 'Video Editing', desc: 'Ads, Reels, YouTube and brand films — cinematic grade.', tone: 'rgba(139,92,246,.11)' },
  { href: '/services/ai-video-marketing', name: 'ai', title: 'AI Video Marketing', desc: 'Human-like AI ads for Meta, YouTube and TikTok.', tone: 'rgba(37,99,235,.1)' },
  { href: '/services/human-like-content', name: 'human', title: 'Human-like Content', desc: 'Authentic product & people content that converts.', tone: 'rgba(244,63,94,.09)' },
  { href: '/services/web-development', name: 'web', title: 'Web Development', desc: 'Fast, SEO-ready websites and landing pages.', tone: 'rgba(6,182,212,.1)' },
  { href: '/services/application-build', name: 'app', title: 'Application Build', desc: 'Custom web & mobile apps for performance and scale.', tone: 'rgba(59,130,246,.1)' },
  { href: '/services/authentication', name: 'auth', title: 'Authentication', desc: 'Secure login, roles and access control.', tone: 'rgba(16,185,129,.1)' },
  { href: '/services/automation', name: 'automation', title: 'Automation', desc: 'Messenger & channel automation with human-like replies.', tone: 'rgba(20,184,166,.1)' },
  { href: '/services/digital-marketing', name: 'marketing', title: 'Digital Marketing', desc: 'SEO, ads, social and growth under one plan.', tone: 'rgba(249,115,22,.1)' },
  { href: '/services/seo', name: 'seo', title: 'SEO Services', desc: 'Rank for the searches your customers type.', tone: 'rgba(99,102,241,.1)' },
  { href: '/services/facebook-page', name: 'facebook', title: 'Facebook Page', desc: 'Setup, blue verify path, growth and checkup.', tone: 'rgba(24,119,242,.1)' },
  { href: '/services/boosting', name: 'boosting', title: 'Boosting', desc: 'Meta boosting from $5 with clear BDT rates.', tone: 'rgba(234,179,8,.11)' },
  { href: '/services/campaign', name: 'campaign', title: 'Campaign', desc: 'Full Meta & YouTube campaign management.', tone: 'rgba(236,72,153,.09)' },
];
const primaryServices = services.filter((_, index) => index < 3);
const supportingServices = services.filter((_, index) => index >= 3);
const aiTools = [
  { name: 'Kling AI', role: 'Cinematic video', icon: '/ai-tools/kling-transparent.png', href: 'https://kling.ai/' },
  { name: 'Hunyuan', role: 'AI video model', icon: '/ai-tools/hunyuan-transparent.png', href: 'https://aivideo.hunyuan.tencent.com/' },
  { name: 'ElevenLabs', role: 'Voice & dubbing', icon: '/ai-tools/elevenlabs.svg', href: 'https://elevenlabs.io/' },
  { name: 'Gemini', role: 'Ideas & visuals', icon: '/ai-tools/gemini.svg', href: 'https://gemini.google.com/' },
  { name: 'ChatGPT', role: 'Creative direction', icon: '/ai-tools/openai.svg', href: 'https://chatgpt.com/' },
  { name: 'Claude', role: 'Scripts & research', icon: '/ai-tools/claude.svg', href: 'https://claude.ai/' },
  { name: 'Higgsfield', role: 'AI video effects', icon: '/ai-tools/higgsfield-transparent.png', href: 'https://higgsfield.ai/' },
  { name: 'Grok', role: 'Image & video ideas', icon: '/ai-tools/grok-transparent.png', href: 'https://grok.com/' },
  { name: 'HeyGen', role: 'Avatar video', icon: '/ai-tools/heygen-transparent.png', href: 'https://www.heygen.com/' },
];
const devToolTeaser = [
  { name: 'v0', icon: '/logos/v0.svg' },
  { name: 'Lovable', icon: 'https://lovable.dev/favicon.ico' },
  { name: 'Bolt', icon: '/logos/bolt.svg' },
  { name: 'Replit', icon: '/logos/replit.svg' },
  { name: 'Base44', icon: 'https://base44.com/favicon.ico' },
  { name: 'Cursor', icon: '/logos/cursor.svg' },
];
---
<Layout title={SITE.seoTitle} description={SITE.seoDescription}>
  <TopBar />
  <Nav active="home" />

  <section id="home" class="hero-premium">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="grid-overlay"></div>
    </div>
    <div class="container hero-grid hero-grid-orbit">
      <div class="hero-content reveal">
        <div class="rating-pill">
          <span class="rating-score">4.8</span>
          <span class="rating-stars" aria-hidden="true">★★★★★</span>
          <span class="rating-label">Client Rated · BD &amp; Global</span>
        </div>

        <h1 class="hero-title">
          AI Video Marketing &amp;<br />Professional Video Editing
        </h1>

        <p class="hero-lead">
          Human creative direction, cinematic AI generation and professional post-production—built for brands that refuse to look ordinary. |
          <strong class="hero-delivery">24–48 Hours Delivery</strong>
        </p>

        <div class="hero-capabilities" aria-label="Video production capabilities">
          <span><i></i>Human-like AI</span>
          <span><i></i>Camera Footage</span>
          <span><i></i>Pro Post-Production</span>
        </div>

        <div class="flex-btns">
          <a href="#featured-videos" class="btn btn-primary hero-cta hero-cta-watch">Watch Videos</a>
          <a href={SITE.whatsappLink} class="btn hero-cta hero-cta-wa" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a href="/portfolio" class="btn hero-cta hero-cta-work">Portfolio</a>
        </div>

        <div class="trust-row">
          <div class="trust-item"><strong class="count-up" data-count="10+">10+</strong><span>Years</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong class="count-up" data-count="4300+">4,300+</strong><span>Projects</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong>24–48h</strong><span>Delivery</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong class="count-up" data-count="4.8">4.8</strong><span>Rating</span></div>
        </div>
      </div>

      <div class="hero-visual reveal">
        <div class="hero-visual-frame">
          <HeroBookReel />
        </div>
      </div>
    </div>
  </section>

  <BrandStrip />

  <FeaturedVideoStack />

  <section class="ai-stack" aria-labelledby="ai-stack-title">
    <div class="container">
      <div class="ai-stack-head reveal">
        <div>
          <p class="eyebrow">Our AI Production Stack</p>
          <h2 id="ai-stack-title">Professional Tools. Human Creative Direction.</h2>
        </div>
        <p>We combine leading AI platforms with professional editing to produce human-like videos, voices and campaign-ready visuals.</p>
      </div>
      <div class="ai-tools-grid" aria-label="AI platforms used by Creavix iT Solution">
        {aiTools.map((tool, i) => (
          <a class="ai-tool-card reveal" href={tool.href} target="_blank" rel="noopener noreferrer" aria-label={`Open the official ${tool.name} website`} style={`--tool-index:${i}`}>
            <span class="ai-tool-logo"><img src={tool.icon} alt={`${tool.name} logo`} width="192" height="192" loading="lazy" decoding="async" /></span>
            <span class="ai-tool-copy"><strong>{tool.name}</strong><small>{tool.role}</small></span>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
      <p class="ai-stack-note">Official platform links · Account availability and plans are managed by each provider.</p>
    </div>
  </section>

  <section class="brand-intelligence" aria-labelledby="brand-intelligence-title">
    <div class="brand-orb brand-orb-one" aria-hidden="true"></div>
    <div class="brand-orb brand-orb-two" aria-hidden="true"></div>
    <div class="container">
      <header class="brand-intelligence-head reveal">
        <p class="brand-kicker"><span></span>Branding, Explained Simply</p>
        <h2 id="brand-intelligence-title">Turn Everything You Create<br /><em>Into One Recognizable Brand.</em></h2>
        <p>A logo alone is not a brand. Branding connects your identity, niche, message and customer experience—so every video, website, application and campaign is instantly recognized as yours.</p>
      </header>

      <div class="brand-blueprint reveal">
        <div class="brand-blueprint-top"><span>BRAND APPLICATION STORY</span><i><b></b>24-SECOND · 8-SCENE VISUAL</i></div>
        <div class="brand-story" aria-label="Eight-scene animated portfolio showing six complete branding projects">
          <figure class="brand-story-frame story-overview" style="--delay:0s;--zoom:1;--origin:50% 50%">
            <div class="brand-overview-grid">
              <img src="/media/branding/datara.webp" alt="Datara brand identity preview" width="760" height="1350" loading="lazy" decoding="async" />
              <img src="/media/branding/addiba.webp" alt="Addiba brand identity preview" width="900" height="1350" loading="lazy" decoding="async" />
              <img src="/media/branding/primetalent.webp" alt="PrimeTalent brand identity preview" width="900" height="1350" loading="lazy" decoding="async" />
              <img src="/media/branding/pirate.webp" alt="Pirate brand identity preview" width="759" height="1350" loading="lazy" decoding="async" />
            </div>
            <figcaption><b>01</b><span>Four Brand Worlds<small>Identity across real touchpoints</small></span></figcaption>
          </figure>
          <figure class="brand-story-frame story-datara" style="--delay:3s;--zoom:1.18;--origin:50% 24%"><img src="/media/branding/datara.webp" alt="Datara complete brand identity across digital products and merchandise" width="760" height="1350" loading="lazy" decoding="async" /><figcaption><b>02</b><span>Datara<small>Data-led brand ecosystem</small></span></figcaption></figure>
          <figure class="brand-story-frame story-addiba" style="--delay:6s;--zoom:1.16;--origin:50% 36%"><img src="/media/branding/addiba.webp" alt="Addiba complete technology brand identity" width="900" height="1350" loading="lazy" decoding="async" /><figcaption><b>03</b><span>Addiba<small>Digital product identity</small></span></figcaption></figure>
          <figure class="brand-story-frame story-prime" style="--delay:9s;--zoom:1.17;--origin:50% 42%"><img src="/media/branding/primetalent.webp" alt="PrimeTalent complete consulting brand identity" width="900" height="1350" loading="lazy" decoding="async" /><figcaption><b>04</b><span>PrimeTalent<small>People-first visual system</small></span></figcaption></figure>
          <figure class="brand-story-frame story-pirate" style="--delay:12s;--zoom:1.2;--origin:50% 62%"><img src="/media/branding/pirate.webp" alt="Pirate lifestyle brand identity applied across products" width="759" height="1350" loading="lazy" decoding="async" /><figcaption><b>05</b><span>Pirate<small>Lifestyle applications</small></span></figcaption></figure>
          <figure class="brand-story-frame story-aurora" style="--delay:15s;--zoom:1.15;--origin:50% 54%"><img src="/media/branding/aurora.webp" alt="Aurora complete green brand identity system" width="760" height="1350" loading="lazy" decoding="async" /><figcaption><b>06</b><span>Aurora<small>Complete identity direction</small></span></figcaption></figure>
          <figure class="brand-story-frame story-valor" style="--delay:18s;--zoom:1.16;--origin:50% 50%"><img src="/media/branding/valor-city.webp" alt="Valor City complete multi-product brand identity" width="900" height="1349" loading="lazy" decoding="async" /><figcaption><b>07</b><span>Valor City<small>Multi-product brand world</small></span></figcaption></figure>
          <figure class="brand-story-frame story-complete" style="--delay:21s;--zoom:1;--origin:50% 50%">
            <div class="brand-final-grid">
              <img src="/media/branding/datara.webp" alt="" width="760" height="1350" loading="lazy" decoding="async" />
              <img src="/media/branding/addiba.webp" alt="" width="900" height="1350" loading="lazy" decoding="async" />
              <img src="/media/branding/primetalent.webp" alt="" width="900" height="1350" loading="lazy" decoding="async" />
              <img src="/media/branding/pirate.webp" alt="" width="759" height="1350" loading="lazy" decoding="async" />
              <img src="/media/branding/aurora.webp" alt="" width="760" height="1350" loading="lazy" decoding="async" />
              <img src="/media/branding/valor-city.webp" alt="" width="900" height="1349" loading="lazy" decoding="async" />
            </div>
            <figcaption><b>08</b><span>One Complete Portfolio<small>Six brands · Every touchpoint</small></span></figcaption>
            <div class="brand-story-glass"><span>BRANDING</span><small>Six identities · Built to be remembered</small></div>
          </figure>
          <div class="brand-story-progress" aria-hidden="true"><i></i></div>
        </div>
        <div class="brand-result"><span><i></i>Recognition</span><span>Trust</span><span>Consistency</span><span>Higher perceived value</span></div>
      </div>

      <div class="brand-learning-head reveal"><p>Tap each part to understand how a real brand is built.</p><span>6 essential building blocks</span></div>
      <div class="brand-learning-grid" aria-label="Interactive branding topics">
        <button class="brand-topic reveal" type="button" data-brand-dialog="brand-logo"><span class="brand-topic-icon"><ServiceIcons name="design" size={27}/></span><span><b>Logo System</b><small>More than one logo file</small></span><i>+</i></button>
        <button class="brand-topic reveal" type="button" data-brand-dialog="brand-social"><span class="brand-topic-icon"><ServiceIcons name="facebook" size={27}/></span><span><b>Social Consistency</b><small>Look familiar everywhere</small></span><i>+</i></button>
        <button class="brand-topic reveal" type="button" data-brand-dialog="brand-niche"><span class="brand-topic-icon"><ServiceIcons name="strategy" size={27}/></span><span><b>Brand Niche</b><small>Own one clear position</small></span><i>+</i></button>
        <button class="brand-topic reveal" type="button" data-brand-dialog="brand-voice"><span class="brand-topic-icon"><ServiceIcons name="human" size={27}/></span><span><b>Brand Voice</b><small>Sound unmistakably you</small></span><i>+</i></button>
        <button class="brand-topic reveal" type="button" data-brand-dialog="brand-marketing"><span class="brand-topic-icon"><ServiceIcons name="marketing" size={27}/></span><span><b>Marketing System</b><small>Connect every campaign</small></span><i>+</i></button>
        <button class="brand-topic reveal" type="button" data-brand-dialog="brand-value"><span class="brand-topic-icon"><ServiceIcons name="boosting" size={27}/></span><span><b>Brand Value</b><small>Why customers choose you</small></span><i>+</i></button>
      </div>
    </div>

    <dialog class="brand-dialog" id="brand-logo"><button class="brand-dialog-close" type="button" aria-label="Close">×</button><span class="brand-dialog-step">01 · IDENTITY</span><h3>A logo becomes powerful when it becomes a system.</h3><p>Use the same recognizable mark, colors, typography and spacing across your website, app, videos, packaging and profiles. This helps customers identify you before they even read your name.</p><ul><li>Primary, compact and icon versions</li><li>Consistent color and typography rules</li><li>Clear usage for every screen size</li></ul></dialog>
    <dialog class="brand-dialog" id="brand-social"><button class="brand-dialog-close" type="button" aria-label="Close">×</button><span class="brand-dialog-step">02 · CONSISTENCY</span><h3>Every social platform should feel like the same business.</h3><p>Your Facebook, Instagram, YouTube, LinkedIn and WhatsApp presence should share one profile identity, visual language and message. Consistency creates familiarity—and familiarity creates trust.</p><ul><li>Matching profile and cover identity</li><li>Repeatable post and thumbnail style</li><li>One clear message across platforms</li></ul></dialog>
    <dialog class="brand-dialog" id="brand-niche"><button class="brand-dialog-close" type="button" aria-label="Close">×</button><span class="brand-dialog-step">03 · POSITION</span><h3>A clear niche tells customers why you are the right choice.</h3><p>Strong brands do not try to mean everything to everyone. They choose a focused audience, a specific problem and a distinct promise—then reinforce that position in every customer touchpoint.</p><ul><li>Defined ideal customer</li><li>Clear problem and outcome</li><li>Memorable market position</li></ul></dialog>
    <dialog class="brand-dialog" id="brand-voice"><button class="brand-dialog-close" type="button" aria-label="Close">×</button><span class="brand-dialog-step">04 · MESSAGE</span><h3>Your brand should sound consistent, not only look consistent.</h3><p>Brand voice controls the words, tone and personality customers experience in captions, advertisements, website copy, support messages and videos. It turns communication into recognition.</p><ul><li>Consistent tone and vocabulary</li><li>Clear value proposition</li><li>Human, audience-appropriate messaging</li></ul></dialog>
    <dialog class="brand-dialog" id="brand-marketing"><button class="brand-dialog-close" type="button" aria-label="Close">×</button><span class="brand-dialog-step">05 · MARKETING</span><h3>Marketing performs better when every campaign strengthens the brand.</h3><p>Instead of producing disconnected ads, a brand system makes every video, landing page, application and campaign repeat the same promise and visual cues. Each campaign then builds long-term memory—not only short-term clicks.</p><ul><li>Campaigns connected by one idea</li><li>Reusable creative system</li><li>Recognition that grows over time</li></ul></dialog>
    <dialog class="brand-dialog" id="brand-value"><button class="brand-dialog-close" type="button" aria-label="Close">×</button><span class="brand-dialog-step">06 · BUSINESS VALUE</span><h3>Branding reduces doubt and increases perceived value.</h3><p>People often choose the business they recognize and trust—even when alternatives are cheaper. Professional branding signals reliability, makes your offer easier to remember and supports stronger customer loyalty.</p><ul><li>Faster customer trust</li><li>Greater pricing confidence</li><li>Long-term loyalty and referrals</li></ul></dialog>
  </section>

  <section id="services" class="section-soft">
    <div class="container">
      <div class="text-center mb-8 reveal">
        <p class="eyebrow" style="margin:0 auto 1rem">Our Services</p>
        <h2 class="mb-4">Everything Your Brand Needs to Grow</h2>
        <p style="max-width:40rem;margin:0 auto">Video, AI, web, apps, SEO, automation and Meta growth — one professional partner for Bangladesh and global brands.</p>
        <div class="section-signals" aria-label="Service standards"><span>12 capabilities</span><span>One accountable team</span><span>Global-ready delivery</span></div>
      </div>
      <div class="primary-services grid-3" aria-label="Primary services">
        {primaryServices.map((s, i) => (
          <a href={s.href} class="service-card service-card-primary reveal" data-magnetic style={`--card-index:${i}`}>
            <div class="service-card-top"><span class="service-priority">Core expertise</span><span class="service-index">0{i + 1}</span></div>
            <IconBox name={s.name} tone={s.tone} size={44} />
            <div class="service-copy"><h3>{s.title}</h3><p>{s.desc}</p></div>
            <span class="svc-more"><span>Explore service</span><i aria-hidden="true">↗</i></span>
          </a>
        ))}
      </div>
      <div class="supporting-heading reveal">
        <p class="eyebrow">Complete IT Solutions</p>
        <h3>Development, SEO, Automation &amp; Growth</h3>
      </div>
      <div class="grid-3 supporting-services" aria-label="Supporting digital services">
        {supportingServices.map((s, i) => (
          <a href={s.href} class="service-card service-card-support reveal" style={`--card-index:${i + 3}`}>
            <div class="service-card-top"><IconBox name={s.name} tone={s.tone} size={38} /><span class="service-index">{String(i + 4).padStart(2, '0')}</span></div>
            <div class="service-copy"><h3>{s.title}</h3><p>{s.desc}</p></div>
            <span class="svc-more"><span>Discover</span><i aria-hidden="true">→</i></span>
          </a>
        ))}
      </div>
      <aside class="dev-stack-teaser reveal" aria-labelledby="dev-stack-teaser-title">
        <div class="dev-stack-copy">
          <p class="eyebrow">AI-Assisted Development</p>
          <h3 id="dev-stack-teaser-title">AI speed. Expert engineering.</h3>
          <p>We use leading builders for faster iteration, then complete the code, security, performance and deployment manually.</p>
        </div>
        <div class="dev-stack-logos" aria-label="Selected AI development platforms">
          {devToolTeaser.map((tool) => (
            <span class="dev-stack-chip"><span><img src={tool.icon} alt={`${tool.name} official logo`} width="30" height="30" loading="lazy" decoding="async" /></span><b>{tool.name}</b></span>
          ))}
        </div>
        <a class="dev-stack-link" href="/services/web-development#ai-builders">Explore our development stack <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <ProcessFlow />

  <section id="about" class="section-violet">
    <div class="container about-premium-grid">
      <div class="about-story reveal">
        <p class="eyebrow">Why Creavix</p>
        <h2 class="mb-6">IT &amp; Video Agency · Since {SITE.servingSince}</h2>
        <p class="lead mb-8">{SITE.shortDesc}</p>
        <ul class="about-checks">
          <li><ServiceIcons name="check" size={22} /><span>Cinematic &amp; AI video production</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Web, app, SEO &amp; automation</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Facebook page, boost &amp; campaigns</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Studio: {SITE.addressBn} · {SITE.founder.name}</span></li>
        </ul>
        <div class="about-actions">
          <a href="/about" class="btn btn-outline">About us</a>
          <a href="/contact" class="btn btn-primary">Contact</a>
        </div>
      </div>
      <div class="about-dashboard reveal">
        <div class="about-dashboard-head"><span>Creavix performance</span><i>Live</i></div>
        <div class="about-stat-card">
          <h3>At a glance</h3>
          <div class="stat-grid">
            <div><strong class="count-up" data-count="10+">10+</strong><span>Years</span></div>
            <div><strong class="count-up" data-count="4300+">4,300+</strong><span>Projects</span></div>
            <div><strong class="count-up" data-count="4.8">4.8</strong><span>Avg rating</span></div>
            <div><strong>24–48h</strong><span>Delivery</span></div>
          </div>
        </div>
        <div class="about-mini-row"><span><b>BD</b> Local insight</span><span><b>∞</b> Global scale</span></div>
      </div>
    </div>
  </section>

  <Reviews />
  <FAQ />

  <section id="contact" class="section-warm premium-contact">
    <div class="container reveal">
      <div class="contact-panel">
        <div class="contact-copy"><span class="contact-kicker"><i></i>Accepting selected projects</span><h2>Ready to Grow With Creavix?</h2><p>Tell us what you want to build. We’ll turn the idea into a clear, high-performance production plan.</p></div>
        <div class="contact-action"><a href={SITE.whatsappLink} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Start on WhatsApp <span>↗</span></a><a href="/contact" class="btn btn-outline">Contact page</a><small>{SITE.whatsapp} · {SITE.email1}</small></div>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .brand-intelligence{position:relative;isolation:isolate;overflow:hidden;padding:5rem 1.25rem;background:linear-gradient(145deg,#f1f4f9 0%,#e7edf7 48%,#dce9ff 100%);color:#0f172a;border-block:1px solid rgba(37,99,235,.09)}
  .brand-intelligence:before{content:'';position:absolute;inset:0;z-index:-2;background-image:linear-gradient(rgba(37,99,235,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.045) 1px,transparent 1px);background-size:44px 44px;mask-image:linear-gradient(to bottom,transparent,#000 18%,#000 82%,transparent)}
  .brand-orb{position:absolute;z-index:-1;border-radius:50%;filter:blur(100px);pointer-events:none}.brand-orb-one{width:380px;height:380px;left:-170px;top:-110px;background:#60a5fa;opacity:.24}.brand-orb-two{width:330px;height:330px;right:-120px;bottom:-130px;background:#2563eb;opacity:.17}
  .brand-intelligence-head{max-width:860px;margin:0 auto 2rem;text-align:center}.brand-kicker{display:flex;align-items:center;justify-content:center;gap:.55rem;margin:0 0 1rem;color:#1d4ed8;font-size:.7rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.brand-kicker span{width:25px;height:2px;background:linear-gradient(90deg,#2563eb,#60a5fa)}
