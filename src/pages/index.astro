---
import MarketingSpotlight from '../components/MarketingSpotlight.astro';
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Reviews from '../components/Reviews.astro';
import FeaturedVideoStack from '../components/FeaturedVideoStack.astro';
import BrandStrip from '../components/BrandStrip.astro';
import FAQ from '../components/FAQ.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import IconBox from '../components/IconBox.astro';
import ServiceCardArt from '../components/ServiceCardArt.astro';
import { serviceArtwork } from '../data/serviceArtwork';
import ServiceIcons from '../components/icons/ServiceIcons.astro';
import ServiceCompass from '../components/ServiceCompass.astro';
import HeroVideoShowcase from '../components/HeroVideoShowcase.astro';
import BrandingCinema from '../components/BrandingCinema.astro';
import EngagementModels from '../components/EngagementModels.astro';
import ProjectBrief from '../components/ProjectBrief.astro';
import PromoPopup from '../components/PromoPopup.astro';
import AIToolExplorer from '../components/AIToolExplorer.astro';
import { SITE } from '../data/site';

const services = [
  { href: '/services/video-editing', name: 'video', title: 'Video Editing', desc: 'Ads, Reels, YouTube and brand films — cinematic grade.', tone: 'rgba(139,92,246,.11)' },
  { href: '/services/ai-video-marketing', name: 'ai', title: 'AI Video Marketing', desc: 'Human-like AI ads for Meta, YouTube and TikTok.', tone: 'rgba(37,99,235,.1)' },
  { href: '/services/human-like-content', name: 'human', title: 'Human-like Content', desc: 'Authentic product & people content that converts.', tone: 'rgba(244,63,94,.09)' },
  { href: '/services/web-development', name: 'web', title: 'Web Development', desc: 'Fast, SEO-ready websites and landing pages.', tone: 'rgba(6,182,212,.1)' },
  { href: '/services/application-build', name: 'app', title: 'Application Build', desc: 'Custom web & mobile apps for performance and scale.', tone: 'rgba(59,130,246,.1)' },
  { href: '/services/authentication', name: 'auth', title: 'Authentication', desc: 'Secure login, roles and access control.', tone: 'rgba(16,185,129,.1)' },
  { href: '/services/automation', name: 'automation', title: 'Automation', desc: 'Messenger & channel automation with human-like replies.', tone: 'rgba(20,184,166,.1)' },
  { href: '/services/digital-marketing', name: 'marketing', title: 'Digital Marketing', desc: 'SEO, ads, social and growth under one plan.', tone: 'rgba(249,115,22,.1)' },
  { href: '/services/seo', name: 'seo', title: 'SEO Services', desc: 'Rank for the searches your customers type.', tone: 'rgba(99,102,241,.1)' },
  { href: '/services/facebook-page', name: 'facebook', title: 'Facebook Page', desc: 'Setup, blue verify path, growth and checkup.', tone: 'rgba(24,119,242,.1)' },
  { href: '/services/boosting', name: 'boosting', title: 'Boosting', desc: 'Meta boosting from $5 with clear BDT rates.', tone: 'rgba(234,179,8,.11)' },
  { href: '/services/campaign', name: 'campaign', title: 'Campaign', desc: 'Full Meta & YouTube campaign management.', tone: 'rgba(236,72,153,.09)' },
];
const primaryServices = services.filter((_, index) => index < 3);
const supportingServices = services.filter((_, index) => index >= 3);
const homeServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Creavix iT Solution services',
  numberOfItems: services.length,
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: service.title,
    url: new URL(service.href, SITE.url).href,
  })),
};
const devToolTeaser = [
  { name: 'v0', icon: '/logos/v0.svg' },
  { name: 'Lovable', icon: 'https://lovable.dev/favicon.ico' },
  { name: 'Bolt', icon: '/logos/bolt.svg' },
  { name: 'Replit', icon: '/logos/replit.svg' },
  { name: 'Base44', icon: 'https://base44.com/favicon.ico' },
  { name: 'Cursor', icon: '/logos/cursor.svg' },
];
---
<Layout title={SITE.seoTitle} description={SITE.seoDescription}>
  <TopBar />
  <Nav active="home" />
  <main id="main-content" tabindex="-1">

  <section id="home" class="hero-premium">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="grid-overlay"></div>
    </div>
    <div class="container hero-grid hero-grid-orbit">
      <div class="hero-content">
        <div class="rating-pill">
          <span class="rating-score" data-public-rating>4.8</span>
          <span class="rating-stars" aria-hidden="true">★★★★★</span>
          <span class="rating-label">Client Rated · BD &amp; Global</span>
        </div>

        <h1 class="hero-title" aria-label="AI Video Marketing Agency & Data-Driven SEO Services">
          <span class="hero-title-line">
            <span class="hero-title-piece hero-title-video">AI Video</span>{' '}
            <span class="hero-title-piece hero-title-marketing">Marketing Agency</span>
          </span>{' '}
          <span class="hero-title-line">
            <span class="hero-title-piece hero-title-data">&amp; Data-Driven</span>{' '}
            <span class="hero-title-piece hero-title-seo">SEO Services</span>
          </span>
        </h1>

        <p class="hero-lead hero-subtitle">
          Grow your brand with cinematic AI video production, conversion-focused video marketing, technical SEO, local SEO, and AI search optimization—engineered to increase visibility across Google and AI-powered search.
        </p>

        <div class="hero-capabilities" aria-label="Creavix core capabilities">
          <span><i></i>Video &amp; AI</span>
          <span><i></i>Web &amp; Apps</span>
          <span><i></i>SEO &amp; Growth</span>
        </div>

        <div class="flex-btns">
          <a href="/services" class="btn btn-primary hero-cta hero-cta-watch">Explore Services</a>
          <a href="/portfolio" class="btn hero-cta hero-cta-work">View Portfolio</a>
          <a href={SITE.whatsappLink} class="btn hero-cta hero-cta-wa" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>

        <div class="trust-row" data-trust-counters role="list" aria-label="Creavix experience, projects, delivery and public rating">
          <div class="trust-item trust-years" role="listitem">
            <strong class="hero-counter" data-target="10" data-suffix="+">0</strong>
            <span>Years Experience</span>
          </div>
          <div class="trust-item trust-projects" role="listitem">
            <strong class="hero-counter" data-target="4300" data-suffix="+">0</strong>
            <span>Projects Delivered</span>
          </div>
          <div class="trust-item trust-delivery" role="listitem">
            <strong class="hero-counter" data-target="24" data-final="24–48h">0</strong>
            <span>Fast Delivery</span>
          </div>
          <div class="trust-item trust-rating" role="listitem" aria-label="Public rating out of 5">
            <strong class="hero-counter" data-target="4.8" data-decimals="1" data-public-rating-counter>0.0</strong>
            <span class="trust-stars" aria-hidden="true">★★★★★</span>
            <span>Public Rating</span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-visual-frame">
          <HeroVideoShowcase />
        </div>
      </div>
    </div>
  </section>

  <BrandStrip />
  <ServiceCompass />
  <MarketingSpotlight />

  <FeaturedVideoStack />

  <AIToolExplorer />

  <BrandingCinema />

  <section id="services" class="section-soft">
    <div class="container">
      <div class="text-center mb-8 reveal">
        <p class="eyebrow" style="margin:0 auto 1rem">Our Services</p>
        <h2 class="mb-4">Complete IT Services, <span class="brand-accent">Built Around Your Business</span></h2>
        <p style="max-width:43rem;margin:0 auto">Explore every Creavix capability in detail—from creative production and software engineering to search, automation and paid growth.</p>
        <div class="section-signals" aria-label="Service standards"><span>12 capabilities</span><span>One accountable team</span><span>Global-ready delivery</span></div>
      </div>
      <div class="primary-services grid-3" aria-label="Primary services">
        {primaryServices.map((s, i) => (
          <a href={s.href} class="service-card service-card-primary reveal" data-magnetic style={`--card-index:${i}`}>
            <div class="service-card-top"><span class="service-priority">Core expertise</span><span class="service-index">0{i + 1}</span></div>
            {serviceArtwork[s.name] ? (
              <ServiceCardArt src={serviceArtwork[s.name]} />
            ) : (
              <IconBox name={s.name} tone={s.tone} size={44} />
            )}
            <div class="service-copy"><h3>{s.title}</h3><p>{s.desc}</p></div>
            <span class="svc-more"><span>Explore service</span><i aria-hidden="true">↗</i></span>
          </a>
        ))}
      </div>
      <div class="supporting-heading reveal">
        <p class="eyebrow">Complete IT Solutions</p>
        <h3>Development, SEO, Automation &amp; <span class="brand-green">Growth</span></h3>
      </div>
      <div class="grid-3 supporting-services" aria-label="Supporting digital services">
        {supportingServices.map((s, i) => (
          <a href={s.href} class="service-card service-card-support reveal" style={`--card-index:${i + 3}`}>
            <div class="service-card-top">{serviceArtwork[s.name] ? <ServiceCardArt src={serviceArtwork[s.name]} /> : <IconBox name={s.name} tone={s.tone} size={38} />}<span class="service-index">{String(i + 4).padStart(2, '0')}</span></div>
            <div class="service-copy"><h3>{s.title}</h3><p>{s.desc}</p></div>
            <span class="svc-more"><span>Discover</span><i aria-hidden="true">→</i></span>
          </a>
        ))}
      </div>
      <aside class="dev-stack-teaser reveal" aria-labelledby="dev-stack-teaser-title">
        <div class="dev-stack-copy">
          <p class="eyebrow">AI-Assisted Development</p>
          <h3 id="dev-stack-teaser-title">AI speed. <span class="brand-blue">Expert engineering.</span></h3>
          <p>We use leading builders for faster iteration, then complete the code, security, performance and deployment manually.</p>
        </div>
        <div class="dev-stack-logos" aria-label="Selected AI development platforms">
          {devToolTeaser.map((tool) => (
            <span class="dev-stack-chip"><span><img src={tool.icon} alt={`${tool.name} official logo`} width="30" height="30" loading="lazy" decoding="async" fetchpriority="low" /></span><b>{tool.name}</b></span>
          ))}
        </div>
        <a class="dev-stack-link" href="/services/web-development#ai-builders">Explore our development stack <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <ProcessFlow />

  <section id="about" class="section-violet">
    <div class="container about-premium-grid">
      <div class="about-story reveal">
        <p class="eyebrow">Why Creavix</p>
        <h2 class="mb-6">Video Marketing &amp; IT Company · <span class="brand-accent">Since {SITE.servingSince}</span></h2>
        <p class="lead mb-8">{SITE.shortDesc}</p>
        <ul class="about-checks">
          <li><ServiceIcons name="check" size={22} /><span>Cinematic &amp; AI video production</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Web, app, SEO &amp; automation</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Facebook page, boost &amp; campaigns</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Studio: {SITE.addressBn} · {SITE.founder.name}</span></li>
        </ul>
        <div class="about-actions">
          <a href="/about" class="btn btn-outline">About us</a>
          <a href="/contact" class="btn btn-primary">Contact</a>
        </div>
      </div>
      <div class="about-dashboard reveal">
        <div class="about-dashboard-head"><span>Creavix at a glance</span><i>Since 2014</i></div>
        <div class="about-stat-card">
          <h3>At a glance</h3>
          <div class="stat-grid">
            <div><strong class="count-up" data-count="10+">10+</strong><span>Years</span></div>
            <div><strong class="count-up" data-count="4300+">4,300+</strong><span>Projects</span></div>
            <div><strong class="count-up" data-count="4.8">4.8</strong><span>Avg rating</span></div>
            <div><strong>24–48h</strong><span>Delivery</span></div>
          </div>
        </div>
        <div class="about-mini-row"><span><b>BD</b> Local insight</span><span><b>∞</b> Global scale</span></div>
      </div>
    </div>
  </section>

  <Reviews />
  <FAQ />
  <EngagementModels />
  <ProjectBrief />
  <PromoPopup />
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(homeServiceSchema)} />
</Layout>

<script>
  const hero = document.getElementById('home');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero) {
    if (reduceMotion || !('IntersectionObserver' in window)) {
      hero.classList.add('hero-motion-active');
    } else {
      hero.classList.add('hero-motion-ready');

      const replayHeroEntrance = () => {
        hero.classList.remove('hero-motion-active');
        void hero.offsetWidth;
        hero.classList.add('hero-motion-active');
      };

      const heroObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) replayHeroEntrance();
          else hero.classList.remove('hero-motion-active');
        },
        { threshold: 0.28, rootMargin: '-4% 0px -12% 0px' },
      );

      heroObserver.observe(hero);
    }
  }

  const trustCounters = document.querySelector('[data-trust-counters]');
  let counterRun = 0;
  let counterTimers = [];

  const finalCounterValue = (counter) => {
    if (counter.dataset.final) return counter.dataset.final;
    const target = Number(counter.dataset.target || 0);
    const decimals = Number(counter.dataset.decimals || 0);
    const formatted = target.toLocaleString('en-US', {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    });
    return `${formatted}${counter.dataset.suffix || ''}`;
  };

  const resetCounters = () => {
    counterTimers.forEach(window.clearTimeout);
    counterTimers = [];
    trustCounters?.querySelectorAll('.hero-counter').forEach((counter) => {
      counter.textContent = Number(counter.dataset.decimals || 0) ? '0.0' : '0';
    });
  };

  const animateCounter = (counter, run) => {
    const target = Number(counter.dataset.target || 0);
    const decimals = Number(counter.dataset.decimals || 0);
    const duration = target >= 1000 ? 820 : 650;
    const started = performance.now();

    const tick = (time) => {
      if (run !== counterRun) return;
      const progress = Math.min((time - started) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 4);
      const value = target * eased;
      counter.textContent = value.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      }) + (progress === 1 ? (counter.dataset.suffix || '') : '');

      if (progress < 1) requestAnimationFrame(tick);
      else counter.textContent = finalCounterValue(counter);
    };

    requestAnimationFrame(tick);
  };

  const revealCounters = () => {
    if (!trustCounters) return;
    const run = ++counterRun;
    trustCounters.classList.remove('trust-motion-active');
    resetCounters();
    void trustCounters.offsetWidth;
    trustCounters.classList.add('trust-motion-active');

    trustCounters.querySelectorAll('.hero-counter').forEach((counter, index) => {
      const timer = window.setTimeout(() => animateCounter(counter, run), 80 + index * 75);
      counterTimers.push(timer);
    });
  };

  if (trustCounters) {
    if (reduceMotion || !('IntersectionObserver' in window)) {
      trustCounters.classList.add('trust-motion-active');
      trustCounters.querySelectorAll('.hero-counter').forEach((counter) => {
        counter.textContent = finalCounterValue(counter);
      });
    } else {
      trustCounters.classList.add('trust-motion-ready');
      const trustObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) revealCounters();
          else {
            counterRun++;
            trustCounters.classList.remove('trust-motion-active');
            resetCounters();
          }
        },
        { threshold: 0.45, rootMargin: '0px 0px -5% 0px' },
      );
      trustObserver.observe(trustCounters);
    }
  }

  window.addEventListener('creavix:rating-update', (event) => {
    const average = Number(event.detail?.average);
    const total = Number(event.detail?.total);
    if (!Number.isFinite(average) || average <= 0) return;

    document.querySelectorAll('[data-public-rating]').forEach((element) => {
      element.textContent = average.toFixed(1);
    });

    const ratingCounter = document.querySelector('[data-public-rating-counter]');
    if (ratingCounter) ratingCounter.dataset.target = average.toFixed(1);

    const ratingLabel = document.querySelector('.rating-label');
    if (ratingLabel && Number.isFinite(total) && total > 0) {
      ratingLabel.textContent = `${total} Published Ratings · BD & Global`;
    }

    if (trustCounters?.classList.contains('trust-motion-active')) revealCounters();
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');
  @import url('https://fonts.cdnfonts.com/css/li-ador-noirrit');

  .hero-title {
    font-family: 'Li Ador Noirrit' !important;
    font-size: clamp(2.35rem, 5.15vw, 4.65rem) !important;
    font-weight: 800 !important;
    line-height: 1.01 !important;
    letter-spacing: -0.05em !important;
    text-wrap: balance;
  }
  .hero-title-line {
    display: block;
    overflow: hidden;
    padding: 0.025em 0 0.085em;
  }
  .hero-title-piece {
    display: inline-block;
    margin-right: 0.1em;
    transform-origin: 50% 100%;
  }
  :global(.creavix-brand) .hero-title .hero-title-video {
    color: var(--brand-orange) !important;
    font-size: 1.06em;
    font-weight: 800;
    background: var(--brand-orange-gradient) !important;
    background-size: 260% 260% !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }
  :global(.creavix-brand) .hero-title .hero-title-marketing {
    color: #1d4ed8 !important;
    font-size: 1.06em;
    font-weight: 800;
    background: linear-gradient(110deg, #1d4ed8 0%, #2563eb 28%, #06b6d4 54%, #7c3aed 78%, #1d4ed8 100%) !important;
    background-size: 260% 260% !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }
  :global(.creavix-brand) .hero-title .hero-title-data {
    color: #4338ca !important;
    -webkit-text-fill-color: #4338ca !important;
    font-size: 0.7em;
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  :global(.creavix-brand) .hero-title .hero-title-seo {
    color: #15803d !important;
    font-size: 1.03em;
    font-weight: 800;
    background: linear-gradient(110deg, #15803d 0%, #10b981 42%, #0891b2 72%, #15803d 100%) !important;
    background-size: 240% 240% !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }
  :global(.creavix-brand) .hero-subtitle {
    position: relative;
    max-width: 58ch;
    padding-top: 1.05rem;
    color: #526075 !important;
    font-family: 'Hind Siliguri' !important;
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    font-weight: 500;
    line-height: 1.72;
    letter-spacing: -0.006em;
    text-wrap: pretty;
  }
  :global(.creavix-brand) .hero-subtitle::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3.25rem;
    height: 3px;
    border-radius: 999px;
    background: var(--brand-orange-gradient);
    background-size: 220% 220%;
    box-shadow: 0 4px 14px rgba(249, 115, 22, 0.24);
    animation: hero-gradient-flow 7s ease-in-out infinite;
  }
  .hero-motion-ready .hero-title-piece,
  .hero-motion-ready .hero-subtitle {
    opacity: 0;
    transform: translate3d(0, 1.15rem, 0);
    filter: blur(5px);
    will-change: opacity, transform, filter;
  }
  .hero-motion-ready.hero-motion-active .hero-title-piece {
    animation: hero-word-reveal 680ms cubic-bezier(.16, 1, .3, 1) both;
  }
  .hero-motion-ready.hero-motion-active :is(.hero-title-video, .hero-title-marketing, .hero-title-seo) {
    animation:
      hero-word-reveal 680ms cubic-bezier(.16, 1, .3, 1) both,
      hero-gradient-flow 7s ease-in-out infinite;
  }
  .hero-motion-ready.hero-motion-active .hero-title-line:first-child .hero-title-piece:nth-child(1) {
    animation-delay: 40ms, 0ms;
  }
  .hero-motion-ready.hero-motion-active .hero-title-line:first-child .hero-title-piece:nth-child(2) {
    animation-delay: 120ms, 0ms;
  }
  .hero-motion-ready.hero-motion-active .hero-title-line:nth-child(2) .hero-title-piece:nth-child(1) {
    animation-delay: 200ms;
  }
  .hero-motion-ready.hero-motion-active .hero-title-line:nth-child(2) .hero-title-piece:nth-child(2) {
    animation-delay: 280ms, 0ms;
  }
  .hero-motion-ready.hero-motion-active .hero-subtitle {
    animation: hero-subtitle-reveal 720ms 390ms cubic-bezier(.16, 1, .3, 1) both;
  }
  @keyframes hero-word-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 1.15rem, 0) scale(.985);
      filter: blur(5px);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
      filter: blur(0);
    }
  }
  @keyframes hero-subtitle-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, .9rem, 0);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      filter: blur(0);
    }
  }
  @keyframes hero-gradient-flow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  @media (max-width: 639px) {
    .hero-title {
      font-size: clamp(2rem, 10.2vw, 2.75rem) !important;
      line-height: 1.02 !important;
      letter-spacing: -0.04em !important;
    }
    .hero-title-line {
      overflow: visible;
      padding-bottom: 0.06em;
    }
    .hero-title-piece {
      margin-right: 0.06em;
    }
    :global(.creavix-brand) .hero-title :is(.hero-title-video, .hero-title-marketing, .hero-title-seo) {
      font-size: 1em;
    }
    :global(.creavix-brand) .hero-title .hero-title-data {
      display: block;
      margin: 0.15em 0 0.08em;
      font-size: 0.68em;
    }
    :global(.creavix-brand) .hero-subtitle {
      max-width: 100%;
      padding-top: 0.95rem;
      font-size: 1rem;
      line-height: 1.68;
    }
    :global(.creavix-brand) .hero-subtitle::before {
      width: 2.75rem;
    }
  }
  @media (min-width: 640px) and (max-width: 899px) {
    .hero-title {
      font-size: clamp(3rem, 7.2vw, 4rem) !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-motion-ready .hero-title-piece,
    .hero-motion-ready .hero-subtitle,
    .hero-motion-ready.hero-motion-active .hero-title-piece,
    .hero-motion-ready.hero-motion-active .hero-subtitle {
      opacity: 1;
      transform: none;
      filter: none;
      animation: none;
    }
  }
