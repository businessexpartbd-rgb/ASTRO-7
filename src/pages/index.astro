---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Reviews from '../components/Reviews.astro';
import VideoGallery from '../components/VideoGallery.astro';
import IconBox from '../components/IconBox.astro';
import ServiceIcons from '../components/icons/ServiceIcons.astro';
import HeroOrbit from '../components/HeroOrbit.astro';
import { SITE } from '../data/site';

const services = [
  { href: '/services/web-development', name: 'web', title: 'Web Development', desc: 'Fast, SEO-friendly websites and landing pages built for ranking and conversion.', tone: 'rgba(13,148,136,.12)' },
  { href: '/services/application-build', name: 'app', title: 'Application Build', desc: 'Custom web & mobile applications designed for performance and scale.', tone: 'rgba(245,158,11,.12)' },
  { href: '/services/authentication', name: 'auth', title: 'Authentication Systems', desc: 'Secure login, signup, roles and access control for your products.', tone: 'rgba(5,150,105,.12)' },
  { href: '/services/ai-video-marketing', name: 'ai', title: 'AI Video Marketing', desc: 'AI-powered video ads for Meta, YouTube and TikTok that convert.', tone: 'rgba(234,88,12,.12)' },
  { href: '/services/video-editing', name: 'video', title: 'Video Editing', desc: 'Professional editing for ads, social, YouTube and brand films.', tone: 'rgba(225,29,72,.1)' },
  { href: '/services/human-like-content', name: 'human', title: 'Human-like Content', desc: 'Authentic AI human & product visuals for campaigns.', tone: 'rgba(217,119,6,.12)' },
  { href: '/services/facebook-page', name: 'facebook', title: 'Facebook Page Services', desc: 'Business page setup and verification support.', tone: 'rgba(13,148,136,.12)' },
  { href: '/services/boosting', name: 'boost', title: 'Boosting Service', desc: 'Targeted Meta boosting to reach the right audience.', tone: 'rgba(225,29,72,.1)' },
  { href: '/services/campaign', name: 'campaign', title: 'Campaign Service', desc: 'End-to-end campaign planning and performance management.', tone: 'rgba(234,88,12,.12)' },
];
---
<Layout title={SITE.seoTitle} description={SITE.seoDescription}>
  <Nav active="home" />
  <section id="home" class="hero-premium">
    <div class="hero-bg"><div class="orb orb-1"></div><div class="orb orb-2"></div><div class="orb orb-3"></div><div class="grid-overlay"></div></div>
    <div class="container hero-grid hero-grid-orbit">
      <div class="hero-content reveal">
        <div class="eyebrow"><span class="dot"></span> {SITE.tagline}</div>
        <h1 class="hero-title">Full-Service IT &amp;<br />Digital Solutions That<br /><span class="text-gradient" id="typing-text">Grow Your Business</span><span class="typing-cursor">|</span></h1>
        <p class="hero-lead">{SITE.shortDesc}</p>
        <div class="flex-btns">
          <a href="#services" class="btn btn-primary">Explore Services</a>
          <a href={SITE.whatsappLink} class="btn btn-outline" target="_blank" rel="noopener noreferrer">WhatsApp Us</a>
        </div>
        <div class="trust-row">
          <div class="trust-item"><strong class="count-up" data-count="10+">0</strong><span>Years</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong class="count-up" data-count="4300+">0</strong><span>Projects</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><strong class="count-up" data-count="4.8">0</strong><span>Avg rating</span></div>
        </div>
      </div>
      <div class="hero-visual reveal">
        <HeroOrbit />
      </div>
    </div>
    <div class="scroll-indicator"><span>Scroll</span><div class="scroll-line"></div></div>
  </section>

  <section id="services" class="section-soft">
    <div class="container">
      <div class="text-center mb-8 reveal">
        <p class="eyebrow" style="margin:0 auto 1rem">IT &amp; Digital Services</p>
        <h2 class="mb-4">Everything Your Business Needs Online</h2>
        <p style="max-width:40rem;margin:0 auto">Website development, applications, authentication, AI video production, Facebook growth and full campaign management — one agency.</p>
      </div>
      <div class="grid-3">
        {services.map((s) => (
          <a href={s.href} class="glass-card reveal" style="text-decoration:none;color:inherit;display:block">
            <IconBox name={s.name} tone={s.tone} size={44} />
            <h3 class="mb-4">{s.title}</h3>
            <p style="font-size:.9rem">{s.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <VideoGallery />

  <section id="about" class="section-violet">
    <div class="container grid-2">
      <div class="reveal">
        <p class="eyebrow">Why {SITE.name}</p>
        <h2 class="mb-6">IT Solution Agency · Since {SITE.servingSince}</h2>
        <p class="lead mb-8">{SITE.shortDesc}</p>
        <ul class="about-checks">
          <li><ServiceIcons name="check" size={22} /><span>Web, app &amp; authentication engineering</span></li>
          <li><ServiceIcons name="check" size={22} /><span>AI video + classic video production</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Facebook page, boost &amp; campaigns</span></li>
          <li><ServiceIcons name="check" size={22} /><span>Studio: {SITE.addressBn} · Founder {SITE.founder.name}</span></li>
        </ul>
      </div>
      <div class="reveal">
        <div class="glass-card" style="padding:2.2rem">
          <h3 class="mb-6">At a glance</h3>
          <div class="stat-grid">
            <div><strong class="count-up" data-count="10+" style="font-size:1.5rem;color:var(--primary);font-family:var(--font-h)">0</strong><br /><span style="font-size:.8rem;color:var(--text-3)">Years</span></div>
            <div><strong class="count-up" data-count="4300+" style="font-size:1.5rem;color:var(--primary);font-family:var(--font-h)">0</strong><br /><span style="font-size:.8rem;color:var(--text-3)">Projects</span></div>
            <div><strong class="count-up" data-count="4.8" style="font-size:1.5rem;color:var(--primary);font-family:var(--font-h)">0</strong><br /><span style="font-size:.8rem;color:var(--text-3)">Avg rating</span></div>
            <div><strong class="count-up" data-count="24h" style="font-size:1.5rem;color:var(--primary);font-family:var(--font-h)">0</strong><br /><span style="font-size:.8rem;color:var(--text-3)">Delivery</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Reviews />

  <section id="contact" class="section-warm">
    <div class="container text-center reveal" style="max-width:40rem">
      <h2 class="mb-4">Ready to Grow With a Full IT Partner?</h2>
      <p class="mb-8" style="font-size:1.1rem">WhatsApp {SITE.whatsapp} · {SITE.email1} · {SITE.hotline}</p>
      <div style="display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center">
        <a href={SITE.whatsappLink} class="btn btn-primary" style="padding:.9rem 2rem;font-size:1rem" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a href="/contact" class="btn btn-outline" style="padding:.9rem 2rem;font-size:1rem">Contact page</a>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .hero-grid-orbit {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: center;
  }
  .hero-visual {
    order: -1;
    display: flex;
    justify-content: center;
  }
  .hero-content { order: 1; }
  @media (min-width: 900px) {
    .hero-grid-orbit {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 2.5rem;
    }
    .hero-content { order: 1; }
    .hero-visual { order: 2; }
  }
  .about-checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    color: var(--text-2);
    padding: 0;
    margin: 0;
  }
  .about-checks li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
</style>
