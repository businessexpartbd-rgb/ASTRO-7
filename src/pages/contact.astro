---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ServiceIcons from '../components/icons/ServiceIcons.astro';
import { SITE, SOCIAL_LINKS } from '../data/site';

const linkedIn =
  SOCIAL_LINKS.find((s) => s.key === 'linkedin')?.url ||
  'https://www.linkedin.com/in/creavix-it-solution';
/** Photos: replace files in /public/team/ when ready */
const leaders = [
  {
    role: 'Founder & Chairman',
    name: 'Hannan Khan',
    size: 'lg',
    photo: '/team/hannan-executive.webp',
    initial: 'H',
    experience: 'Since 2014',
    bio: 'Founder and strategic leader of Creavix iT Solution, shaping the company’s creative vision, client standards and long-term direction through more than a decade of hands-on digital experience.',
    social: true,
    facebook: 'https://www.facebook.com/HannanKhanDesigner',
    linkedin: linkedIn,
    whatsapp: true,
  },
  {
    role: 'Chief Executive Officer',
    name: 'Sabbir Khan',
    size: 'md',
    photo: '/team/sabbir-executive.webp',
    initial: 'S',
    experience: '3+ years leadership',
    bio: 'Leads executive operations, project coordination and delivery quality—keeping the team, timelines and client commitments aligned as Creavix grows.',
    social: true,
    facebook: 'https://www.facebook.com/sabbirkhanmotivation',
    linkedin: linkedIn,
    whatsapp: false,
  },
  {
    role: 'Director, Operations',
    name: 'Tanni Aktar',
    size: 'sm',
    photo: null,
    initial: 'T',
    experience: '5 years as Director',
    bio: 'Supports operational governance, internal coordination and consistent project execution across the company’s creative and technology services.',
    social: false,
    facebook: '',
    linkedin: '',
    whatsapp: false,
  },
];

const channels = [
  {
    title: 'WhatsApp',
    value: SITE.whatsapp,
    href: SITE.whatsappLink,
    hint: 'Fastest reply · Owner line',
    icon: 'whatsapp',
  },
  {
    title: 'Hotline',
    value: SITE.hotline,
    href: `tel:${SITE.hotline.replace(/\s/g, '')}`,
    hint: 'Call during business hours',
    icon: 'phone',
  },
  {
    title: 'Email',
    value: SITE.email1,
    href: `mailto:${SITE.email1}`,
    hint: SITE.email2,
    icon: 'email',
  },
];

const topics = [
  { t: 'Video / AI edit', d: 'Send footage or product links + deadline.' },
  { t: 'Website / app', d: 'Share references and must-have features.' },
  { t: 'Boost / campaign', d: 'Page link, budget band and goal.' },
  { t: 'Facebook page', d: 'Page URL + what needs fixing.' },
];

const faqs = [
  { q: 'How quickly will I receive a reply?', a: 'We usually respond on WhatsApp within a few hours during business hours.' },
  { q: 'Do you work with international clients?', a: 'Yes. We support English briefs, remote collaboration and clear progress reporting for clients worldwide.' },
  { q: 'Can I visit the office?', a: `Yes. Our office is at ${SITE.address}. Please message first to schedule an appointment.` },
];
---

<Layout
  title={`Contact ${SITE.brand} | Leadership & Quote`}
  description={`Contact ${SITE.brand} — meet Founder & Chairman Hannan Khan, CEO Sabbir Khan and Operations Director Tanni Aktar. WhatsApp ${SITE.whatsapp}, ${SITE.address}.`}
>
  <TopBar />
  <Nav active="contact" />
  <main id="main-content" tabindex="-1">

  <section class="ct-hero">
    <div class="container ct-hero-inner reveal">
      <p class="ct-eye">Contact</p>
      <h1>Let’s make your<br /><span class="brand-accent">next move matter.</span></h1>
      <p class="ct-sub">
        Video, AI, web and growth — Bangladesh studio with global-ready communication.
        Meet the leadership below, then reach us on WhatsApp.
      </p>
      <div class="ct-actions">
        <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
        <a class="btn btn-outline" href="/blog">Read the blog</a>
      </div>
    </div>
  </section>

  <!-- LEADERSHIP -->
  <section class="lead-sec" id="leadership">
    <div class="container">
      <div class="ct-center reveal">
        <p class="ct-eye">Leadership</p>
        <h2>Meet the <span class="brand-accent">Management Team</span></h2>
        <p class="ct-lead">Meet the management team responsible for vision, executive operations and dependable delivery.</p>
      </div>

      <div class="lead-row">
        {leaders.map((p) => (
          <article class={`lead-card lead-${p.size} reveal`}>
            <div class="lead-photo-wrap">
              <div class="lead-photo" data-initial={p.initial}>
                {p.photo && <img
                  src={p.photo}
                  alt={p.name}
                  width="640"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                  onerror="this.style.display='none'"
                />}
                <span class="lead-fallback" aria-hidden="true">{p.initial}</span>
              </div>
              <span class="lead-badge">{p.role}</span>
            </div>
            <h3>{p.name}</h3>
            <p class="lead-exp">{p.experience}</p>
            <p class="lead-bio">{p.bio}</p>
            {p.social && (
              <div class="lead-social">
                {p.facebook && (
                  <a href={p.facebook} target="_blank" rel="noopener noreferrer" class="lead-soc" title={`${p.name} on Facebook`} aria-label={`Open ${p.name}'s Facebook profile`}>Facebook profile</a>
                )}
                {p.linkedin && (
                  <a href={p.linkedin} target="_blank" rel="noopener noreferrer" class="lead-soc" title="LinkedIn">LinkedIn</a>
                )}
                {p.whatsapp && (
                  <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer" class="lead-soc lead-wa" title="WhatsApp">WhatsApp</a>
                )}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ct-sec">
    <div class="container">
      <div class="ct-channels">
        {channels.map((c) => (
          <a class="ct-card reveal" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <div class="ct-ico"><ServiceIcons name={c.icon} size={28} /></div>
            <h3>{c.title}</h3>
            <p class="ct-val">{c.value}</p>
            <p class="ct-hint">{c.hint}</p>
          </a>
        ))}
      </div>

      <div class="ct-studio reveal">
        <div>
          <h3>Studio</h3>
          <p>{SITE.address}</p>
          <p class="ct-hint">{SITE.addressBn}</p>
        </div>
        <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Message Owner</a>
      </div>

      <div class="ct-topics">
        <div class="ct-center reveal">
          <p class="ct-eye">Before you message</p>
          <h2>What to send for a faster quote</h2>
        </div>
        <div class="ct-topic-grid">
          {topics.map((t) => (
            <article class="ct-topic reveal">
              <h3>{t.t}</h3>
              <p>{t.d}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="ct-faq-wrap reveal">
        <h2>FAQ</h2>
        {faqs.map((f) => (
          <details class="ct-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <div class="ct-social reveal">
        <h3>Social</h3>
        <div class="ct-socials">
          {SOCIAL_LINKS.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-outline">{s.name}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
  </main>
  <Footer />
</Layout>

<style>
  .ct-hero {
    padding: 5rem 1.25rem 2rem;
    background:
      radial-gradient(ellipse 50% 40% at 50% 0%, rgba(37, 99, 235, 0.1), transparent 55%),
      linear-gradient(180deg, #fff, #F8FAFC);
    text-align: center;
  }
  .ct-hero-inner { max-width: 640px; margin: 0 auto; }
  .ct-eye {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2563EB;
  }
  .ct-hero h1 {
    margin: 0 0 0.75rem;
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.45rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0B0F19;
  }
  .ct-sub { margin: 0 0 1.25rem; color: #475569; line-height: 1.65; }
  .ct-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; justify-content: center; }
  .ct-center { text-align: center; margin-bottom: 1.75rem; }
  .ct-center h2 {
    margin: 0 0 0.4rem;
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(1.3rem, 3vw, 1.65rem);
    font-weight: 800;
  }
  .ct-lead { margin: 0; color: #64748B; font-size: 0.9rem; }
  .ct-lead code {
    font-size: 0.8rem;
    background: #EFF6FF;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    color: #1D4ED8;
  }

  /* Leadership */
  .lead-sec {
    padding: 2.5rem 1.25rem 3rem;
    background: #fff;
  }
  .lead-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .lead-row {
      flex-direction: row;
      align-items: stretch;
      justify-content: center;
      gap: 1.25rem;
    }
  }
  .lead-card {
    position:relative;
    overflow:hidden;
    background: linear-gradient(145deg,#fff,#F8FAFC);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 26px;
    padding: .75rem .75rem 1.5rem;
    text-align: center;
    width: 100%;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow:0 18px 48px rgba(15,23,42,.075);
    transition:transform .45s cubic-bezier(.16,1,.3,1),box-shadow .45s,border-color .45s;
  }
  .lead-card:hover{transform:translateY(-7px);border-color:rgba(37,99,235,.22);box-shadow:0 28px 65px rgba(37,99,235,.13)}
  @media (min-width: 900px) {
    .lead-lg { max-width: 330px; flex: 1.12; }
    .lead-md { max-width: 310px; flex: 1.05; }
    .lead-sm { max-width: 280px; flex: .95; }
  }
  .lead-photo-wrap { position: relative; width:100%; margin-bottom: 1rem; }
  .lead-photo {
    position: relative;
    width:100%;
    aspect-ratio:4/5;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(145deg, #dbeafe, #1E40AF);
    margin: 0 auto;
    box-shadow: 0 16px 36px rgba(37, 99, 235, 0.16);
  }
  .lead-lg .lead-photo,.lead-md .lead-photo,.lead-sm .lead-photo{width:100%;height:auto}
  @media (max-width: 899px) {
    .lead-card{max-width:380px}.lead-photo{max-height:470px}
    .lead-card:nth-child(1){order:1}.lead-card:nth-child(2){order:2}.lead-card:nth-child(3){order:3}
  }
  .lead-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position:center top;
    display: block;
    position: relative;
    z-index: 1;
  }
  .lead-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: Outfit, system-ui, sans-serif;
    font-weight: 800;
    font-size: 2.5rem;
    color: #fff;
    z-index: 0;
  }
  .lead-badge {
    position:absolute;
    left:50%;
    bottom:-.65rem;
    transform:translateX(-50%);
    display: inline-block;
    margin-top: 0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #1D4ED8;
    background: rgba(255,255,255,.94);
    border:1px solid rgba(37,99,235,.14);
    box-shadow:0 8px 22px rgba(15,23,42,.12);
    padding: 0.38rem 0.72rem;
    border-radius: 999px;
    white-space:nowrap;
  }
  .lead-card h3 {
    margin: 0.35rem 0 0.2rem;
    font-size: 1.15rem;
    font-weight: 800;
    color: #0B0F19;
  }
  .lead-lg h3 { font-size: 1.3rem; }
  .lead-exp {
    margin: 0 0 0.65rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #2563EB;
  }
  .lead-bio {
    margin: 0;
    font-size: 0.88rem;
    color: #64748B;
    line-height: 1.55;
    flex: 1;
  }
  .lead-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
    margin-top: 1rem;
  }
  .lead-soc {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    text-decoration: none;
    color: #1E40AF;
    background: #fff;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }
  .lead-soc:hover { background: #EFF6FF; }
  .lead-wa {
    background: #25D366;
    border-color: #25D366;
    color: #fff;
  }
  .lead-wa:hover { background: #1ebe57; color: #fff; }

  .ct-sec { padding: 2rem 1.25rem 3.5rem; background: #F8FAFC; }
  .ct-channels {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) { .ct-channels { grid-template-columns: 1fr 1fr 1fr; } }
  .ct-card {
    display: block;
    text-decoration: none;
    color: inherit;
    text-align: center;
    padding: 1.5rem 1.15rem;
    border-radius: 18px;
    border: 1px solid rgba(15, 23, 42, 0.07);
    background: #fff;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .ct-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(37, 99, 235, 0.1);
  }
  .ct-ico {
    width: 52px;
    height: 52px;
    margin: 0 auto 0.85rem;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.12);
  }
  .ct-card h3 { margin: 0 0 0.35rem; font-weight: 800; }
  .ct-val { margin: 0; font-size: 0.95rem; font-weight: 600; color: #2563EB; }
  .ct-hint { margin: 0.35rem 0 0; font-size: 0.8rem; color: #94A3B8; }
  .ct-studio {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border-radius: 18px;
    border: 1px solid rgba(15, 23, 42, 0.07);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    background: #fff;
  }
  .ct-studio h3 { margin: 0 0 0.35rem; font-weight: 800; }
  .ct-studio p { margin: 0; color: #475569; }
  .ct-topics { margin-top: 2.75rem; }
  .ct-topic-grid {
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 700px) { .ct-topic-grid { grid-template-columns: 1fr 1fr; } }
  .ct-topic {
    padding: 1.15rem;
    border-radius: 14px;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.06);
  }
  .ct-topic h3 { margin: 0 0 0.3rem; font-size: 0.95rem; font-weight: 800; color: #2563EB; }
  .ct-topic p { margin: 0; font-size: 0.88rem; color: #64748B; line-height: 1.5; }
  .ct-faq-wrap { max-width: 560px; margin: 2.75rem auto 0; }
  .ct-faq-wrap h2 {
    font-family: Outfit, system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }
  .ct-faq {
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 12px;
    padding: 0.15rem 1rem;
    margin-bottom: 0.5rem;
    background: #fff;
  }
  .ct-faq summary {
    cursor: pointer;
    font-weight: 700;
    padding: 0.85rem 0;
    list-style: none;
  }
  .ct-faq summary::-webkit-details-marker { display: none; }
  .ct-faq p { margin: 0 0 0.85rem; color: #64748B; font-size: 0.92rem; line-height: 1.55; }
  .ct-social { margin-top: 2.5rem; text-align: center; }
  .ct-social h3 { margin: 0 0 0.85rem; font-weight: 800; }
  .ct-socials { display: flex; flex-wrap: wrap; gap: 0.55rem; justify-content: center; }
</style>
