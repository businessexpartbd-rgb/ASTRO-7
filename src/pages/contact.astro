---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Contact Creavix iT Solution | Get a Quote" description="Contact Creavix iT Solution for video editing, AI marketing, web development and campaign services. Email hello@creavixit.com.">
  <Nav active="contact" />
  <section class="hero-premium" style="min-height:auto;padding-top:8rem;padding-bottom:4rem">
    <div class="hero-bg"><div class="orb orb-1"></div><div class="orb orb-2"></div><div class="grid-overlay"></div></div>
    <div class="container" style="position:relative;z-index:2;max-width:640px;text-align:center">
      <div class="reveal">
        <div class="eyebrow" style="margin-left:auto;margin-right:auto"><span class="dot"></span> Contact</div>
        <h1 class="hero-title">Let’s Build Something<br /><span class="text-gradient">That Converts</span></h1>
        <p class="hero-lead" style="margin-left:auto;margin-right:auto">Tell us about your project. We reply quickly with a clear plan and next steps.</p>
      </div>
    </div>
  </section>
  <section class="section-soft">
    <div class="container">
      <div class="grid-3">
        <div class="glass-card reveal text-center">
          <div class="icon-box" style="background:rgba(79,70,229,.1);margin:0 auto 1rem">✉️</div>
          <h3 class="mb-4">Email</h3>
          <p style="font-size:.9rem"><a href="mailto:hello@creavixit.com" style="color:var(--primary)">hello@creavixit.com</a></p>
        </div>
        <div class="glass-card reveal text-center">
          <div class="icon-box" style="background:rgba(6,182,212,.1);margin:0 auto 1rem">🌐</div>
          <h3 class="mb-4">Website</h3>
          <p style="font-size:.9rem"><a href="https://creavixit.com">creavixit.com</a></p>
        </div>
        <div class="glass-card reveal text-center">
          <div class="icon-box" style="background:rgba(16,185,129,.1);margin:0 auto 1rem">📍</div>
          <h3 class="mb-4">Location</h3>
          <p style="font-size:.9rem">Bangladesh</p>
        </div>
      </div>
      <div class="text-center mt-8 reveal" style="margin-top:3rem">
        <a href="mailto:hello@creavixit.com" class="btn btn-primary" style="padding:.9rem 2rem;font-size:1rem">Email Creavix iT</a>
      </div>
    </div>
  </section>
  <Footer />
</Layout>
