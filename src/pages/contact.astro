---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ServiceIcons from '../components/icons/ServiceIcons.astro';
import { SITE, SOCIAL_LINKS } from '../data/site';

const linkedIn =
  SOCIAL_LINKS.find((s) => s.key === 'linkedin')?.url ||
  'https://www.linkedin.com/in/creavix-it-solution';
const facebookCompany =
  SOCIAL_LINKS.find((s) => s.key === 'facebook')?.url ||
  'https://www.facebook.com/CreavixITSolution';

/** Photos: replace files in /public/team/ when ready */
const leaders = [
  {
    role: 'Chairman & Owner',
    name: 'Hannan Khan',
    size: 'lg',
    photo: '/team/hannan.jpg',
    initial: 'H',
    experience: 'Since 2014',
    bio: 'Online activist, freelancer and content creator since 2014. Built Creavix iT Solution through hands-on creative work, client delivery and long-term digital craft — the story of turning freelance discipline into a full video & IT agency. Main oversight of company direction stays with Hannan.',
    social: true,
    facebook: facebookCompany,
    linkedin: linkedIn,
    whatsapp: true,
  },
  {
    role: 'Chief Executive Officer',
    name: 'Sabbir Khan',
    size: 'md',
    photo: '/team/sabbir.jpg',
    initial: 'S',
    experience: '3+ years leadership',
    bio: 'Leads day-to-day executive coordination so projects, people and client promises stay aligned. Focused on operations quality and growth execution under the Creavix brand.',
    social: true,
    facebook: facebookCompany,
    linkedin: linkedIn,
    whatsapp: false,
  },
  {
    role: 'Director',
    name: 'Tanni Aktar',
    size: 'sm',
    photo: '/team/tanni.jpg',
    initial: 'T',
    experience: '5 years as Director',
    bio: 'Experienced director guiding company operations on the ground. Much of daily direction runs through this role, with strategic supervision from the Owner — a steady hand for delivery and team coordination.',
    social: false,
    facebook: '',
    linkedin: '',
    whatsapp: false,
  },
];

const channels = [
  {
    title: 'WhatsApp',
    value: SITE.whatsapp,
    href: SITE.whatsappLink,
    hint: 'Fastest reply · Owner line',
    icon: 'boost',
  },
  {
    title: 'Hotline',
    value: SITE.hotline,
    href: `tel:${SITE.hotline.replace(/\s/g, '')}`,
    hint: 'Call during business hours',
    icon: 'campaign',
  },
  {
    title: 'Email',
    value: SITE.email1,
    href: `mailto:${SITE.email1}`,
    hint: SITE.email2,
    icon: 'web',
  },
];

const topics = [
  { t: 'Video / AI edit', d: 'Send footage or product links + deadline.' },
  { t: 'Website / app', d: 'Share references and must-have features.' },
  { t: 'Boost / campaign', d: 'Page link, budget band and goal.' },
  { t: 'Facebook page', d: 'Page URL + what needs fixing.' },
];

const faqs = [
  { q: 'কতক্ষণে উত্তর পাব?', a: 'সাধারণত কয়েক ঘণ্টার মধ্যে WhatsApp-এ উত্তর দেওয়ার চেষ্টা করা হয়।' },
  { q: 'আন্তর্জাতিক ক্লায়েন্ট?', a: 'হ্যাঁ — ইংরেজিতে ব্রিফ ও রিপোর্ট করা যায়।' },
  { q: 'অফিস ভিজিট?', a: `${SITE.addressBn} — আগে মেসেজ করে অ্যাপয়েন্টমেন্ট নিন।` },
];
---

<Layout
  title={`Contact ${SITE.brand} | Leadership & Quote`}
  description={`Contact ${SITE.brand} — meet Chairman Hannan Khan, CEO Sabbir Khan and Director Tanni Aktar. WhatsApp ${SITE.whatsapp}, ${SITE.address}.`}
>
  <TopBar />
  <Nav active="contact" />

  <section class="ct-hero">
    <div class="container ct-hero-inner reveal">
      <p class="ct-eye">Contact</p>
      <h1>Talk to a partner that delivers</h1>
      <p class="ct-sub">
        Video, AI, web and growth — Bangladesh studio with global-ready communication.
        Meet the leadership below, then reach us on WhatsApp.
      </p>
      <div class="ct-actions">
        <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
        <a class="btn btn-outline" href="/blog">Read the blog</a>
      </div>
    </div>
  </section>

  <!-- LEADERSHIP -->
  <section class="lead-sec" id="leadership">
    <div class="container">
      <div class="ct-center reveal">
        <p class="ct-eye">Leadership</p>
        <h2>Chairman, CEO &amp; Director</h2>
        <p class="ct-lead">Photos can be replaced anytime in <code>/public/team/</code> — layout stays premium on mobile and desktop.</p>
      </div>

      <div class="lead-row">
        {leaders.map((p) => (
          <article class={`lead-card lead-${p.size} reveal`}>
            <div class="lead-photo-wrap">
              <div class="lead-photo" data-initial={p.initial}>
                <img
                  src={p.photo}
                  alt={p.name}
                  width="320"
                  height="320"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
                <span class="lead-fallback" aria-hidden="true">{p.initial}</span>
              </div>
              <span class="lead-badge">{p.role}</span>
            </div>
            <h3>{p.name}</h3>
            <p class="lead-exp">{p.experience}</p>
            <p class="lead-bio">{p.bio}</p>
            {p.social && (
              <div class="lead-social">
                {p.facebook && (
                  <a href={p.facebook} target="_blank" rel="noopener noreferrer" class="lead-soc" title="Facebook">Facebook</a>
                )}
                {p.linkedin && (
                  <a href={p.linkedin} target="_blank" rel="noopener noreferrer" class="lead-soc" title="LinkedIn">LinkedIn</a>
                )}
                {p.whatsapp && (
                  <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer" class="lead-soc lead-wa" title="WhatsApp">WhatsApp</a>
                )}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ct-sec">
    <div class="container">
      <div class="ct-channels">
        {channels.map((c) => (
          <a class="ct-card reveal" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <div class="ct-ico"><ServiceIcons name={c.icon} size={28} /></div>
            <h3>{c.title}</h3>
            <p class="ct-val">{c.value}</p>
            <p class="ct-hint">{c.hint}</p>
          </a>
        ))}
      </div>

      <div class="ct-studio reveal">
        <div>
          <h3>Studio</h3>
          <p>{SITE.address}</p>
          <p class="ct-hint">{SITE.addressBn}</p>
        </div>
        <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Message Owner</a>
      </div>

      <div class="ct-topics">
        <div class="ct-center reveal">
          <p class="ct-eye">Before you message</p>
          <h2>What to send for a faster quote</h2>
        </div>
        <div class="ct-topic-grid">
          {topics.map((t) => (
            <article class="ct-topic reveal">
              <h3>{t.t}</h3>
              <p>{t.d}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="ct-faq-wrap reveal">
        <h2>FAQ</h2>
        {faqs.map((f) => (
          <details class="ct-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <div class="ct-social reveal">
        <h3>Social</h3>
        <div class="ct-socials">
          {SOCIAL_LINKS.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-outline">{s.name}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .ct-hero {
    padding: 5rem 1.25rem 2rem;
    background:
      radial-gradient(ellipse 50% 40% at 50% 0%, rgba(37, 99, 235, 0.1), transparent 55%),
      linear-gradient(180deg, #fff, #F8FAFC);
    text-align: center;
  }
  .ct-hero-inner { max-width: 640px; margin: 0 auto; }
  .ct-eye {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2563EB;
  }
  .ct-hero h1 {
    margin: 0 0 0.75rem;
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.45rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0B0F19;
  }
  .ct-sub { margin: 0 0 1.25rem; color: #475569; line-height: 1.65; }
  .ct-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; justify-content: center; }
  .ct-center { text-align: center; margin-bottom: 1.75rem; }
  .ct-center h2 {
    margin: 0 0 0.4rem;
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(1.3rem, 3vw, 1.65rem);
    font-weight: 800;
  }
  .ct-lead { margin: 0; color: #64748B; font-size: 0.9rem; }
  .ct-lead code {
    font-size: 0.8rem;
    background: #EFF6FF;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    color: #1D4ED8;
  }

  /* Leadership */
  .lead-sec {
    padding: 2.5rem 1.25rem 3rem;
    background: #fff;
  }
  .lead-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .lead-row {
      flex-direction: row;
      align-items: stretch;
      justify-content: center;
      gap: 1.25rem;
    }
  }
  .lead-card {
    background: #F8FAFC;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 20px;
    padding: 1.35rem 1.15rem 1.5rem;
    text-align: center;
    width: 100%;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  @media (min-width: 900px) {
    .lead-lg { max-width: 300px; flex: 1.15; }
    .lead-md { max-width: 260px; flex: 1; }
    .lead-sm { max-width: 230px; flex: 0.9; }
  }
  .lead-photo-wrap { position: relative; margin-bottom: 1rem; }
  .lead-photo {
    position: relative;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(145deg, #2563EB, #1E40AF);
    margin: 0 auto;
    box-shadow: 0 16px 36px rgba(37, 99, 235, 0.25);
  }
  .lead-lg .lead-photo { width: 168px; height: 168px; }
  .lead-md .lead-photo { width: 132px; height: 132px; }
  .lead-sm .lead-photo { width: 108px; height: 108px; }
  @media (max-width: 899px) {
    .lead-lg .lead-photo { width: 160px; height: 160px; }
    .lead-md .lead-photo { width: 136px; height: 136px; }
    .lead-sm .lead-photo { width: 112px; height: 112px; }
  }
  .lead-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 1;
  }
  .lead-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: Outfit, system-ui, sans-serif;
    font-weight: 800;
    font-size: 2.5rem;
    color: #fff;
    z-index: 0;
  }
  .lead-badge {
    display: inline-block;
    margin-top: 0.65rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #1D4ED8;
    background: #EFF6FF;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }
  .lead-card h3 {
    margin: 0.35rem 0 0.2rem;
    font-size: 1.15rem;
    font-weight: 800;
    color: #0B0F19;
  }
  .lead-lg h3 { font-size: 1.3rem; }
  .lead-exp {
    margin: 0 0 0.65rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #2563EB;
  }
  .lead-bio {
    margin: 0;
    font-size: 0.88rem;
    color: #64748B;
    line-height: 1.55;
    flex: 1;
  }
  .lead-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
    margin-top: 1rem;
  }
  .lead-soc {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    text-decoration: none;
    color: #1E40AF;
    background: #fff;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }
  .lead-soc:hover { background: #EFF6FF; }
  .lead-wa {
    background: #25D366;
    border-color: #25D366;
    color: #fff;
  }
  .lead-wa:hover { background: #1ebe57; color: #fff; }

  .ct-sec { padding: 2rem 1.25rem 3.5rem; background: #F8FAFC; }
  .ct-channels {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) { .ct-channels { grid-template-columns: 1fr 1fr 1fr; } }
  .ct-card {
    display: block;
    text-decoration: none;
    color: inherit;
    text-align: center;
    padding: 1.5rem 1.15rem;
    border-radius: 18px;
    border: 1px solid rgba(15, 23, 42, 0.07);
    background: #fff;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .ct-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(37, 99, 235, 0.1);
  }
  .ct-ico {
    width: 52px;
    height: 52px;
    margin: 0 auto 0.85rem;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.12);
  }
  .ct-card h3 { margin: 0 0 0.35rem; font-weight: 800; }
  .ct-val { margin: 0; font-size: 0.95rem; font-weight: 600; color: #2563EB; }
  .ct-hint { margin: 0.35rem 0 0; font-size: 0.8rem; color: #94A3B8; }
  .ct-studio {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border-radius: 18px;
    border: 1px solid rgba(15, 23, 42, 0.07);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    background: #fff;
  }
  .ct-studio h3 { margin: 0 0 0.35rem; font-weight: 800; }
  .ct-studio p { margin: 0; color: #475569; }
  .ct-topics { margin-top: 2.75rem; }
  .ct-topic-grid {
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 700px) { .ct-topic-grid { grid-template-columns: 1fr 1fr; } }
  .ct-topic {
    padding: 1.15rem;
    border-radius: 14px;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.06);
  }
  .ct-topic h3 { margin: 0 0 0.3rem; font-size: 0.95rem; font-weight: 800; color: #2563EB; }
  .ct-topic p { margin: 0; font-size: 0.88rem; color: #64748B; line-height: 1.5; }
  .ct-faq-wrap { max-width: 560px; margin: 2.75rem auto 0; }
  .ct-faq-wrap h2 {
    font-family: Outfit, system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }
  .ct-faq {
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 12px;
    padding: 0.15rem 1rem;
    margin-bottom: 0.5rem;
    background: #fff;
  }
  .ct-faq summary {
    cursor: pointer;
    font-weight: 700;
    padding: 0.85rem 0;
    list-style: none;
  }
  .ct-faq summary::-webkit-details-marker { display: none; }
  .ct-faq p { margin: 0 0 0.85rem; color: #64748B; font-size: 0.92rem; line-height: 1.55; }
  .ct-social { margin-top: 2.5rem; text-align: center; }
  .ct-social h3 { margin: 0 0 0.85rem; font-weight: 800; }
  .ct-socials { display: flex; flex-wrap: wrap; gap: 0.55rem; justify-content: center; }
</style>
