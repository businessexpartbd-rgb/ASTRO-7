---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ServiceIcons from '../components/icons/ServiceIcons.astro';
import { SITE, SOCIAL_LINKS } from '../data/site';

const channels = [
  {
    title: 'WhatsApp',
    value: SITE.whatsapp,
    href: SITE.whatsappLink,
    hint: 'Fastest reply · BD & international',
    icon: 'boost',
  },
  {
    title: 'Hotline',
    value: SITE.hotline,
    href: `tel:${SITE.hotline.replace(/\s/g, '')}`,
    hint: 'Call during business hours',
    icon: 'campaign',
  },
  {
    title: 'Email',
    value: SITE.email1,
    href: `mailto:${SITE.email1}`,
    hint: SITE.email2,
    icon: 'web',
  },
];

const topics = [
  { t: 'Video / AI edit', d: 'Send footage or product links + deadline.' },
  { t: 'Website / app', d: 'Share references and must-have features.' },
  { t: 'Boost / campaign', d: 'Page link, budget band and goal (messages, sales).' },
  { t: 'Facebook page', d: 'Page URL + what is broken (setup, verify, restriction).' },
];

const faqs = [
  { q: 'কতক্ষণে উত্তর পাব?', a: 'সাধারণত কয়েক ঘণ্টার মধ্যে WhatsApp-এ উত্তর দেওয়ার চেষ্টা করা হয়।' },
  { q: 'আন্তর্জাতিক ক্লায়েন্ট?', a: 'হ্যাঁ — ইংরেজিতে ব্রিফ ও রিপোর্ট করা যায়।' },
  { q: 'অফিস ভিজিট?', a: `${SITE.addressBn} — আগে মেসেজ করে অ্যাপয়েন্টমেন্ট নিন।` },
];
---

<Layout
  title={`Contact ${SITE.brand} | Video, AI & Digital Quote`}
  description={`Contact ${SITE.brand} — WhatsApp ${SITE.whatsapp}, hotline ${SITE.hotline}, ${SITE.email1}. ${SITE.address}.`}
>
  <TopBar />
  <Nav active="contact" />

  <section class="ct-hero">
    <div class="container ct-hero-inner reveal">
      <p class="ct-eye">Contact</p>
      <h1>Talk to a partner that delivers</h1>
      <p class="ct-sub">
        Video, AI creatives, websites, apps or growth campaigns — Bangladesh studio with global-ready communication.
      </p>
      <div class="ct-actions">
        <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
        <a class="btn btn-outline" href="/portfolio">See portfolio</a>
      </div>
    </div>
  </section>

  <section class="ct-sec">
    <div class="container">
      <div class="ct-channels">
        {channels.map((c) => (
          <a class="ct-card reveal" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <div class="ct-ico"><ServiceIcons name={c.icon} size={28} /></div>
            <h3>{c.title}</h3>
            <p class="ct-val">{c.value}</p>
            <p class="ct-hint">{c.hint}</p>
          </a>
        ))}
      </div>

      <div class="ct-studio reveal">
        <div>
          <h3>Studio</h3>
          <p>{SITE.address}</p>
          <p class="ct-hint">{SITE.addressBn}</p>
          <p class="ct-founder">Founder: <strong>{SITE.founder.name}</strong> — {SITE.founder.role}</p>
        </div>
        <a class="btn btn-primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">Message first</a>
      </div>

      <div class="ct-topics">
        <div class="ct-center reveal">
          <p class="ct-eye">Before you message</p>
          <h2>What to send for a faster quote</h2>
        </div>
        <div class="ct-topic-grid">
          {topics.map((t) => (
            <article class="ct-topic reveal">
              <h3>{t.t}</h3>
              <p>{t.d}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="ct-faq-wrap reveal">
        <h2>FAQ</h2>
        {faqs.map((f) => (
          <details class="ct-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <div class="ct-social reveal">
        <h3>Social</h3>
        <div class="ct-socials">
          {SOCIAL_LINKS.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn-outline">{s.name}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .ct-hero {
    padding: 5rem 1.25rem 2.5rem;
    background:
      radial-gradient(ellipse 50% 40% at 50% 0%, rgba(37, 99, 235, 0.1), transparent 55%),
      linear-gradient(180deg, #fff, #F8FAFC);
    text-align: center;
  }
  .ct-hero-inner { max-width: 640px; margin: 0 auto; }
  .ct-eye {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2563EB;
  }
  .ct-hero h1 {
    margin: 0 0 0.75rem;
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.45rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0B0F19;
  }
  .ct-sub { margin: 0 0 1.25rem; color: #475569; line-height: 1.65; }
  .ct-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; justify-content: center; }
  .ct-sec { padding: 2rem 1.25rem 3.5rem; background: #fff; }
  .ct-channels {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) { .ct-channels { grid-template-columns: 1fr 1fr 1fr; } }
  .ct-card {
    display: block;
    text-decoration: none;
    color: inherit;
    text-align: center;
    padding: 1.5rem 1.15rem;
    border-radius: 18px;
    border: 1px solid rgba(15, 23, 42, 0.07);
    background: #F8FAFC;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .ct-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(37, 99, 235, 0.1);
  }
  .ct-ico {
    width: 52px;
    height: 52px;
    margin: 0 auto 0.85rem;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.12);
  }
  .ct-card h3 { margin: 0 0 0.35rem; font-weight: 800; }
  .ct-val { margin: 0; font-size: 0.95rem; font-weight: 600; color: #2563EB; }
  .ct-hint { margin: 0.35rem 0 0; font-size: 0.8rem; color: #94A3B8; }
  .ct-studio {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border-radius: 18px;
    border: 1px solid rgba(15, 23, 42, 0.07);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    background: #fff;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  }
  .ct-studio h3 { margin: 0 0 0.35rem; font-weight: 800; }
  .ct-studio p { margin: 0; color: #475569; }
  .ct-founder { margin-top: 0.65rem !important; font-size: 0.9rem; }
  .ct-topics { margin-top: 2.75rem; }
  .ct-center { text-align: center; margin-bottom: 1.25rem; }
  .ct-center h2 {
    margin: 0;
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(1.25rem, 3vw, 1.55rem);
    font-weight: 800;
  }
  .ct-topic-grid {
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 700px) { .ct-topic-grid { grid-template-columns: 1fr 1fr; } }
  .ct-topic {
    padding: 1.15rem;
    border-radius: 14px;
    background: #F8FAFC;
    border: 1px solid rgba(15, 23, 42, 0.06);
  }
  .ct-topic h3 { margin: 0 0 0.3rem; font-size: 0.95rem; font-weight: 800; color: #2563EB; }
  .ct-topic p { margin: 0; font-size: 0.88rem; color: #64748B; line-height: 1.5; }
  .ct-faq-wrap { max-width: 560px; margin: 2.75rem auto 0; }
  .ct-faq-wrap h2 {
    font-family: Outfit, system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }
  .ct-faq {
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 12px;
    padding: 0.15rem 1rem;
    margin-bottom: 0.5rem;
    background: #F8FAFC;
  }
  .ct-faq summary {
    cursor: pointer;
    font-weight: 700;
    padding: 0.85rem 0;
    list-style: none;
  }
  .ct-faq summary::-webkit-details-marker { display: none; }
  .ct-faq p { margin: 0 0 0.85rem; color: #64748B; font-size: 0.92rem; line-height: 1.55; }
  .ct-social { margin-top: 2.5rem; text-align: center; }
  .ct-social h3 { margin: 0 0 0.85rem; font-weight: 800; }
  .ct-socials { display: flex; flex-wrap: wrap; gap: 0.55rem; justify-content: center; }
</style>
