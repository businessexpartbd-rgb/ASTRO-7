---
import Layout from '../layouts/Layout.astro';
---
<Layout title="আবহাওয়া | দৈনিক নিউজ" description="বাংলাদেশের আবহাওয়া, বৃষ্টি, নদী ও স্থানীয় সতর্কতার তথ্য।"><div class="container listing-page"><div class="page-intro"><span class="kicker">আজকের পূর্বাভাস</span><h1>আবহাওয়া ও সতর্কতা</h1><p>স্থানীয় সময় অনুযায়ী বর্তমান আবহাওয়া। জরুরি সিদ্ধান্তের জন্য বাংলাদেশ আবহাওয়া অধিদপ্তরের সরকারি সতর্কতা অনুসরণ করুন।</p></div><section class="weather-dashboard"><div><span>ঢাকা</span><strong id="weather-temp">লোড হচ্ছে…</strong><p id="weather-time"></p></div><div class="weather-advice"><h2>স্থানীয় প্রস্তুতি</h2><p>বৃষ্টি, তাপপ্রবাহ ও নদীর পানি বৃদ্ধির সময় সরকারি নির্দেশনা এবং স্থানীয় প্রশাসনের বার্তা অনুসরণ করুন।</p></div></section></div><script is:inline>fetch('https://api.open-meteo.com/v1/forecast?latitude=23.81&longitude=90.41&current=temperature_2m,relative_humidity_2m,wind_speed_10m&timezone=Asia%2FDhaka').then(r=>r.json()).then(d=>{document.getElementById('weather-temp').textContent=`${Math.round(d.current.temperature_2m)}°C · আর্দ্রতা ${d.current.relative_humidity_2m}%`;document.getElementById('weather-time').textContent=`সর্বশেষ: ${d.current.time.replace('T',' ')}`}).catch(()=>document.getElementById('weather-temp').textContent='তথ্য পাওয়া যাচ্ছে না');</script></Layout>
