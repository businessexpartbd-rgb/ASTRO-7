---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="About Creavix iT Solution | Creative Digital & AI Agency" description="Learn about Creavix iT Solution — premium digital agency for AI video marketing, web development and growth services.">
  <Nav active="about" />
  <section class="hero-premium" style="min-height:auto;padding-top:8rem;padding-bottom:4rem">
    <div class="hero-bg"><div class="orb orb-1"></div><div class="orb orb-2"></div><div class="grid-overlay"></div></div>
    <div class="container" style="position:relative;z-index:2;max-width:720px">
      <div class="reveal">
        <div class="eyebrow"><span class="dot"></span> About Us</div>
        <h1 class="hero-title">Creative Power Meets<br /><span class="text-gradient">Technical Excellence</span></h1>
        <p class="hero-lead">Creavix iT Solution is a premium digital agency delivering AI video marketing, web & app development, authentication systems and Facebook growth services.</p>
      </div>
    </div>
  </section>
  <section class="section-soft">
    <div class="container grid-2">
      <div class="reveal">
        <h2 class="mb-6">Who We Are</h2>
        <p class="mb-4">We combine high-end creative production with solid engineering. Our team builds campaigns, websites and systems that look premium and perform in the market.</p>
        <p>From AI-powered video ads to secure authentication and full Facebook campaigns — we focus on quality, speed and measurable results.</p>
      </div>
      <div class="reveal">
        <div class="glass-card" style="padding:2rem">
          <h3 class="mb-6">Our Focus</h3>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:.85rem;color:var(--text-2)">
            <li>✓ Premium creative output</li>
            <li>✓ Modern tech & fast delivery</li>
            <li>✓ Clear communication</li>
            <li>✓ Results-focused work</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
  <section class="section-warm">
    <div class="container text-center reveal" style="max-width:40rem">
      <h2 class="mb-4">Work With Us</h2>
      <p class="mb-8">Ready to grow with Creavix iT? Tell us about your project.</p>
      <a href="/contact" class="btn btn-primary">Contact Us</a>
    </div>
  </section>
  <Footer />
</Layout>
