{
  "name": "astro-7-creavixit",
  "type": "module",
  "version": "1.0.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-sitemap.mjs",
    "verify:routes": "node scripts/verify-route-quality.mjs",
    "verify:reviews": "node scripts/verify-reviews.mjs",
    "verify:premium": "node scripts/verify-premium-upgrade.mjs",
    "verify:performance": "node scripts/verify-performance.mjs",
    "verify:integrity": "node scripts/verify-creavix-integrity.mjs",
    "verify:cloudflare": "wrangler deploy --dry-run --outdir .wrangler/verification",
    "preview": "astro preview",
    "cf-deploy": "wrangler deploy --assets=./dist",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
